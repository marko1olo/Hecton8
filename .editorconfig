# Hecton8 — editor defaults (IDE / Rider / VS). Does not replace Unity .meta rules.
root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,csx}]
indent_style = space
indent_size = 4

# Project / tooling JSON
[*.json]
indent_style = space
indent_size = 2
