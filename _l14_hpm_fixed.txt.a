10103|        private PlayerTransportPreset PrepareTransportAndFrameState(float fixedDeltaTime, out float currentVerticalVelocity, out bool initialExosuitKinematicAuthority)
10104|        {
10105|            RefreshVrComfortSettingsCache();
10106|            AdvanceMovementProbeCacheFrame();
10107|
10108|            if (_transportEvaLockTicks > 0)
10109|                _transportEvaLockTicks--;
10110|
10111|            if (_transportBailoutCooldownTimer > 0f)
10112|            {
10113|                _transportBailoutCooldownTimer -= fixedDeltaTime;
10114|                if (_transportBailoutCooldownTimer < 0f)
10115|                    _transportBailoutCooldownTimer = 0f;
10116|            }
10117|
10118|            _currentFixedDeltaTime = fixedDeltaTime;
10119|            RefreshActiveGravity(fixedDeltaTime);
10120|            Vector3 bodyRuntimePosition = ResolveBodyRuntimePosition();
10121|            Vector3 authoritativeVelocity = ResolveAuthoritativeLinearVelocity(Vector3.zero);
10122|            currentVerticalVelocity = authoritativeVelocity.y;
10123|
10124|            _playerState.SyncKinematic(bodyRuntimePosition, authoritativeVelocity);
10125|            _lastPlayerKinematicsIntendedMovement = ResolveRawInputIntentVector();
10126|            WritePlayerKinematicsSnapshot(bodyRuntimePosition, authoritativeVelocity, _lastPlayerKinematicsIntendedMovement);
10127|            _useFixedFrameSpatialCache = true;
10128|
10129|            PlayerTransportPreset activeTransportPreset = PrepareFixedTickDependencies();
10130|            _stateMachine?.AdvanceFixed(fixedDeltaTime);
10131|
10132|            ITransportPlatform previousTransportPlatform = _activeTransportPlatform;
10133|            Transform previousTransportPlatformTransform = _activeTransportPlatformTransform;
10134|            ResolveActiveTransportPlatform();
10135|            if (_transportEvaLockTicks <= 0 &&
10136|                previousTransportPlatform != null &&
10137|                _activeTransportPlatform == null)
10138|            {
10139|                ExecuteTransportEvaHandoff(previousTransportPlatform, previousTransportPlatformTransform);
10140|            }
10141|
10142|            bool exosuitActive = IsExosuitTransportActive();
10143|            initialExosuitKinematicAuthority = exosuitActive && ExosuitKinematicAuthority.HasActiveAuthority();
10144|
10145|            SyncTransportPlatformRotation();
10146|            RefreshFixedFrameSpatialCache();
10147|            ApplyTransportPlatformCarrierMotion(fixedDeltaTime, initialExosuitKinematicAuthority);
10148|            RefreshFixedFrameSpatialCache();
10149|            RefreshSharedGroundSweepBuffer();
