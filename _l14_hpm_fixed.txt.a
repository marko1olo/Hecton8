9900|
9901|            currentGravity = ResolveAupCenterGravity(UnityEngine.Physics.gravity);
9902|            if (currentGravity.sqrMagnitude > MinLocalGravitySqr)
9903|                return currentGravity;
9904|
9905|            return Vector3.down * HectonPhysicsContract.GravityMetersPerSecondSquaredConst;
9906|        }
9907|
9908|        private static Vector3 BlendGravityVectorCheap(Vector3 startGravity, Vector3 targetGravity, float blend01)
9909|        {
9910|            float t = math.saturate(blend01);
9911|            Vector3 blended = startGravity + ((targetGravity - startGravity) * t);
9912|            if (blended.sqrMagnitude > MinLocalGravitySqr)
9913|                return blended;
9914|
9915|            return t < 0.5f ? startGravity : targetGravity;
9916|        }
9917|
9918|        private Vector3 ResolveBodyRuntimePosition()
9919|        {
9920|            if (_useFixedFrameSpatialCache && MathGuard.IsFinite(_fixedFrameBodyPosition))
9921|                return HectonPlayerMotor.SafeVelocity(_fixedFrameBodyPosition);
9922|
9923|            Vector3 statePosition = ResolvePlayerAupRuntimePosition();
9924|            if (MathGuard.IsFinite(statePosition))
9925|                return HectonPlayerMotor.SafeVelocity(statePosition);
9926|
9927|            return _rb != null ? HectonPlayerMotor.SafeVelocity(_rb.position) : Vector3.zero;
9928|        }
