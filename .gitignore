# ---- Unity generated folders ----
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]serSettings/

# ---- Unity generated files ----
/[Mm]emoryCaptures/
/[Rr]ecordings/
/[Aa]ssets/AssetStoreTools*

# ---- Agent / local verification artifacts ----
/.codexbuild/
/.codex-build/
/.codex-artifacts/
/CodexArtifacts/
/.codex_tmp/
/codex_tmp/
/Assets/_Recovery/
/playmode_metrics.json
*.log
*.diff
*.patch
*.sarif
*.rsp
*.mmf
*.orig

# ---- Python tooling caches ----
__pycache__/
*.py[cod]
*$py.class

# ---- Auto-generated VS/MD/Rider solution and project files ----
ExportedObj/
.consoleapp.meta
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# ---- Unity3D generated meta files (should be committed, but not these) ----
# NOTE: We DO commit .meta files. This section only covers edge cases.

# ---- Crashlytics / crash reports ----
crashlytics-build.properties
sysinfo.txt

# ---- Builds ----
*.apk
*.aab
*.unitypackage
*.app

