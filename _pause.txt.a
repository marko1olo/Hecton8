33|        [RuntimeInitializeOnLoadMethod(RuntimeInitializeLoadType.SubsystemRegistration)]
34|        private static void ResetActiveRuntimeForSubsystemRegistration()
35|        {
36|            // Domain reload may be disabled (Editor Enter Play Mode Options).
37|            // Sticky open-count must not leak across play sessions - otherwise
38|            // IsAnyOpen stays true, HPM SampleGameplay zeros input without GetState (hop2 starve).
39|            ActiveRuntimeInstance = null;
40|            _openMenuCount = 0;
41|        }
