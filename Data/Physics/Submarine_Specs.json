{
  "schema_id": "hecton8.submarine_hydrodynamics.v1",
  "status": "HYDRODYNAMICS DEFINED",
  "expensive_weight_feel": {
    "design_intent": "Submarines are heavy pressure vessels pushing water, not free-flying spacecraft in blue fog.",
    "control_rule": "Forward acceleration is limited by operational mass plus surge added mass; lateral and vertical motion pay larger added-mass penalties.",
    "drag_rule": "Steady speed costs cubic power because drag is quadratic and shaft power is drag force times speed.",
    "rotation_rule": "Pitch, yaw, and roll use separate angular damping tensors so hull shape controls attitude feel.",
    "cavitation_rule": "Speed and depth thresholds drive acoustic/VFX feedback; bubble microphysics remains a premium presentation approximation."
  },
  "physics_derivation": {
    "density_contract": "SEA_WATER_DENSITY_KG_M3 is 1025.0 to match the runtime ocean physics contract; the baker and consumer must not disagree on rho.",
    "drag_force": "F_drag_axis = 0.5 * rho * Cd_axis * projected_area_axis * v_axis * abs(v_axis)",
    "square_drag_acceleration": "k_axis = 0.5 * rho * CdA_axis / (operational_mass + added_mass_axis); analytical velocity decay v1 = v0 / (1 + k_axis * abs(v0) * dt)",
    "steady_power": "shaft_power_watts = F_drag_x * speed / propulsive_efficiency",
    "added_mass": "m_added_axis = C_A_axis * rho * displaced_volume",
    "displaced_volume": "volume = length * beam * height * block_coefficient",
    "lift": "Cl_axis = clamp(Cl_alpha_axis * angle_radians, -Cl_max, Cl_max)",
    "cavitation": "sigma = (p_atm + rho*g*depth - p_vapor) / (0.5*rho*v_effective_prop^2); cavitation threshold occurs when sigma <= sigma_critical",
    "angular_damping": "torque_drag_axis = 0.5 * rho * angular_Cd_axis * reference_area_axis * lever_axis^3 * omega * abs(omega)",
    "rigid_inertia": "I_axis = operational_mass * (a^2 + b^2) / 12",
    "added_angular_inertia": "I_added_axis = displaced_water_mass * (a^2 + b^2) * C_added_axis / 12"
  },
  "constant_pedigree": {
    "SEA_WATER_DENSITY_KG_M3": {
      "value": 1025.0,
      "unit": "kg/m^3",
      "source_type": "runtime_contract",
      "derivation": "Matches SubmarineFluidDynamics seawater rho so baked drag, added mass, pressure, and cavitation agree with runtime force math."
    },
    "GRAVITY_M_S2": {
      "value": 9.80665,
      "unit": "m/s^2",
      "source_type": "physical_constant",
      "derivation": "Standard gravity used in hydrostatic pressure p=rho*g*depth for cavitation sigma."
    },
    "ATM_PRESSURE_PA": {
      "value": 101325.0,
      "unit": "Pa",
      "source_type": "physical_constant",
      "derivation": "One standard atmosphere in the cavitation ambient-pressure term."
    },
    "WATER_VAPOR_PRESSURE_PA": {
      "value": 1700.0,
      "unit": "Pa",
      "source_type": "physical_constant_rounded",
      "derivation": "Cold seawater vapor pressure rounded for conservative cavitation onset thresholds."
    },
    "POWER_SPEED_STEP_MPS": {
      "value": 0.5,
      "unit": "m/s",
      "source_type": "offline_sampling_grid",
      "derivation": "0.5 m/s graph step keeps speed-power CSV dense enough for monotonic audit without bloating cold artifacts."
    },
    "POWER_SPEED_MAX_MPS": {
      "value": 35.0,
      "unit": "m/s",
      "source_type": "offline_sampling_grid",
      "derivation": "35 m/s plot ceiling exceeds all accepted terminal speeds while staying below the failed 50 m/s arcade-speed gate."
    },
    "ACCELERATION_DT_SECONDS": {
      "value": 0.02,
      "unit": "s",
      "source_type": "fixed_step_contract",
      "derivation": "50 Hz offline integration mirrors a conventional Unity fixed-step cadence for acceleration self-audit."
    },
    "ACCELERATION_DURATION_SECONDS": {
      "value": 90.0,
      "unit": "s",
      "source_type": "gameplay_gate",
      "derivation": "90 s full-thrust window catches instant-speed failures without pretending to be an endurance simulation."
    },
    "STOP_TARGET_SPEED_RATIO": {
      "value": 0.05,
      "unit": "ratio",
      "source_type": "analytical_stop_gate",
      "derivation": "Stop distance integrates quadratic drag until 5 percent of terminal speed, avoiding infinite asymptotic zero-speed distance."
    },
    "MIN_STOP_DISTANCE_HULL_LENGTHS": {
      "value": 3.0,
      "unit": "hull_lengths",
      "source_type": "xml_acceptance_gate",
      "derivation": "Recovered XML explicitly requires stop distance from full speed to be at least 3x hull length."
    },
    "MAX_ACCEPTED_TERMINAL_SPEED_MPS": {
      "value": 49.0,
      "unit": "m/s",
      "source_type": "xml_self_audit_guard",
      "derivation": "One m/s below the 50 m/s failure threshold so floating-point rounding cannot pass a near-50 m/s arcade hull."
    },
    "INSTANT_50MPS_SECONDS": {
      "value": 10.0,
      "unit": "s",
      "source_type": "xml_self_audit_guard",
      "derivation": "Any hull reaching 50 m/s inside 10 s is classified as instant acceleration and fails the Square_Drag gate."
    },
    "LIFT_SAMPLE_ANGLES_DEGREES": {
      "value": [
        -15.0,
        -10.0,
        -5.0,
        0.0,
        5.0,
        10.0,
        15.0
      ],
      "unit": "degrees",
      "source_type": "control_surface_sampling_grid",
      "derivation": "Symmetric -15 to +15 degree samples bound pitch/yaw Cl without runtime curve fitting."
    },
    "CAVITATION_SAMPLE_DEPTHS_M": {
      "value": [
        0.0,
        25.0,
        50.0,
        100.0,
        300.0
      ],
      "unit": "m",
      "source_type": "hydrostatic_sampling_grid",
      "derivation": "Surface, shallow, mid, 100 m, and 300 m rows expose sigma depth dependence for lookup tiers."
    },
    "RUNTIME_PACK_ALIGNMENT_BYTES": {
      "value": 16,
      "unit": "bytes",
      "source_type": "binary_cache_contract",
      "derivation": "SHINOBU ingest requires every runtime .bin/.h8bin blob and record offset to be 16-byte aligned."
    }
  },
  "units": {
    "density": "kg/m^3",
    "drag_tensor": "Cd * projected_area in m^2",
    "square_drag_accel_tensor": "1/m; runtime analytical drag v=v0/(1+k*abs(v0)*dt)",
    "added_mass_tensor": "kg",
    "angular_damping_tensor": "N*m per (rad/s)^2"
  },
  "runtime_contract": {
    "force_application": "Route final force packets through PhysicsApplySystem; do not call Rigidbody.AddForce from vehicle gameplay code.",
    "integration_hint": "Use force * rcp(operational_mass + added_mass_axis) and analytical quadratic drag.",
    "hot_path_gc": "Load this data into preallocated structs or NativeArrays. Do not parse JSON in Tick/FixedTick.",
    "black_box": "Runtime vehicle physics owner must write 300 fixed frames of state to Dump_HYDRODYNAMIC_DRAG_MATRIX_BAKER.bin on NaN/crash."
  },
  "quality_tier_runtime_usage": {
    "Low": "Axial CdA, surge added mass, binary cavitation state, scalar yaw damping. Minimal VFX.",
    "Middle": "Full XYZ drag/effective mass tensors, cavitation intensity ramps, pitch/yaw lift curves.",
    "High": "Angular damping tensors, added angular inertia, wake/acoustic feedback driven by thresholds.",
    "Ultra": "Same physics truth as High plus visual overkill: denser wake sheets, cockpit vibration, sonar bloom, and hull creak audio."
  },
