#if UNITY_EDITOR && UNITY_INCLUDE_TESTS
using NUnit.Framework;
using UnityEngine;
using UnityEngine.TestTools;
using MoreMountains.Tools;
using System.IO;

namespace MoreMountains.Tools.Tests
{
    public class MMSaveLoadManagerMethodJsonEncryptedTests
    {
        private string testFilePath;
        private MMSaveLoadManagerMethodJsonEncrypted saveMethod;

        [SetUp]
        public void SetUp()
        {
            testFilePath = Path.Combine(Application.temporaryCachePath, "test_json_encrypted.save");
            saveMethod = new MMSaveLoadManagerMethodJsonEncrypted();
        }

        [TearDown]
        public void TearDown()
        {
            if (File.Exists(testFilePath))
            {
                File.Delete(testFilePath);
            }
        }

        [Test]
        public void Load_WithInvalidEncryptionKey_ReturnsNullAndLogsError()
        {
            // Arrange
            var testObj = new TestData { value = "test string" };

            // Save with Key A
            saveMethod.Key = "ValidKey123";
            using (var writeStream = new FileStream(testFilePath, FileMode.Create, FileAccess.Write))
            {
                saveMethod.Save(testObj, writeStream);
            }

            // Act & Assert
            saveMethod.Key = "InvalidKey456";
            object loadedObj = null;

            // Using LogAssert to verify the exact error message that should be logged
            // The try-catch block logs a message starting with "[MMSaveLoadManager] Encryption key error: "
            LogAssert.Expect(LogType.Error, new System.Text.RegularExpressions.Regex(@"^\[MMSaveLoadManager\] Encryption key error:.*"));

            using (var readStream = new FileStream(testFilePath, FileMode.Open, FileAccess.Read))
            {
                loadedObj = saveMethod.Load(typeof(TestData), readStream);
            }

            Assert.IsNull(loadedObj, "Should return null when decryption fails due to invalid key.");
        }

        [System.Serializable]
        private class TestData
        {
            public string value;
        }
    }
}
#endif
