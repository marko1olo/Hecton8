#pragma kernel CS_InitParasites
#pragma kernel CS_ClearArgs
#pragma kernel CS_AdvectParasites
#pragma kernel CS_RebaseParasites
#pragma kernel CS_CullParasites

#define THREAD_GROUP_SIZE 64
#define MAX_PARASITE_TARGETS 16
#define H8_PI 3.14159265
#define H8_HALF_PI 1.57079633
#define H8_TAU 6.28318531
#define H8_INV_TAU 0.15915494

struct ParasiteGpuParticleDTO
{
    float3 Position;
    float Life01;
    float3 Velocity;
    uint Flags;
};

struct ParasiteTargetDTO
{
    float3 LocalPosition;
    float ThermalSignature;
    float3 Velocity;
    float AttractionRadius;
};

struct ParasiteFrameParamsDTO
{
    float4 Frame0;
    float4 Frame1;
    float4 Frame2;
    float4 Reserved;
};

StructuredBuffer<ParasiteGpuParticleDTO> _H8ParasiteRead;
RWStructuredBuffer<ParasiteGpuParticleDTO> _H8ParasiteWrite;
StructuredBuffer<ParasiteTargetDTO> _H8ParasiteTargets;
StructuredBuffer<ParasiteFrameParamsDTO> _H8ParasiteFrameParams;
RWStructuredBuffer<uint> _H8ParasiteVisibleIndices;
RWByteAddressBuffer _H8ParasiteIndirectArgs;
Texture3D<float4> _H8AbyssalFlowField;
SamplerState sampler_H8AbyssalFlowField;

#define _H8ParasiteFrameParams0 _H8ParasiteFrameParams[0].Frame0
#define _H8ParasiteFrameParams1 _H8ParasiteFrameParams[0].Frame1
#define _H8ParasiteFrameParams2 _H8ParasiteFrameParams[0].Frame2
float4 _H8ParasiteAupShiftDelta;

uint Hash(uint x)
{
    x ^= x >> 16;
    x *= 0x7feb352du;
    x ^= x >> 15;
    x *= 0x846ca68bu;
    x ^= x >> 16;
    return x;
}

float Hash01(uint x)
{
    return (Hash(x) & 0x00FFFFFFu) * (1.0 / 16777215.0);
}

bool H8FiniteScalar(float v)
{
    return abs(v) <= 3.402823e+38;
}

bool H8Finite3(float3 v)
{
    return all(abs(v) <= 3.402823e+38);
}

float H8WrapPi(float x)
{
    return x - (H8_TAU * floor((x + H8_PI) * H8_INV_TAU));
}

float H8FastSin(float x)
{
    x = H8WrapPi(x);
    float x2 = x * x;
    return x * (1.0 - (x2 * (0.16666667 - (x2 * (0.008333331 - (x2 * 0.0001984127))))));
}

float H8FastCos(float x)
{
    return H8FastSin(x + H8_HALF_PI);
}

float3 SafeNormalize(float3 v, float3 fallback)
{
    float rawLenSq = dot(v, v);
    bool valid = H8Finite3(v) && rawLenSq > 0.000001;
    if (!valid)
        return fallback;

    return v * rsqrt(max(rawLenSq, 0.000001));
}

float3 FastCurl(float3 p, uint seed, float quality)
{
    float3 total = 0.0;
    float amplitude = 1.0;
    float frequency = max(_H8ParasiteFrameParams1.z, 0.001);
    float octaveCurve = smoothstep(0.18, 1.0, saturate(quality));
    int octaveLimit = clamp((int)ceil(lerp(1.0, 4.0, octaveCurve)), 1, 4);

    [loop]
    for (int octave = 0; octave < octaveLimit; octave++)
    {
        float octaveWeight = saturate((quality * 4.0) - octave);
        float3 q = p * frequency + (float3(Hash01(seed + octave * 17u), Hash01(seed + octave * 31u), Hash01(seed + octave * 47u)) * 11.0);
        float3 wave = float3(
            H8FastSin(q.y + H8FastCos(q.z)),
            H8FastSin(q.z + H8FastCos(q.x)),
            H8FastSin(q.x + H8FastCos(q.y)));
        total += wave * (amplitude * octaveWeight);
        frequency *= 1.91;
        amplitude *= 0.53;
    }

    return total;
}

float3 ResolveDormantPosition(uint id, float time)
{
    float a = Hash01(id * 13u + 7u) * 6.2831853;
    float b = Hash01(id * 29u + 11u) * 6.2831853;
    float radius = lerp(18.0, 42.0, Hash01(id * 71u + 19u));
    return float3(H8FastCos(a) * radius, H8FastSin(b) * 8.0, H8FastSin(a) * radius) + float3(0.0, H8FastSin(time + a) * 0.35, 0.0);
}

[numthreads(THREAD_GROUP_SIZE, 1, 1)]
void CS_InitParasites(uint3 id : SV_DispatchThreadID)
{
    uint index = id.x;
    uint particleBudget = (uint)max(_H8ParasiteFrameParams0.z, 0.0);
    if (index >= particleBudget)
        return;

    ParasiteGpuParticleDTO p;
    p.Position = ResolveDormantPosition(index, _H8ParasiteFrameParams0.y);
    p.Life01 = Hash01(index * 101u + 3u);
    p.Velocity = SafeNormalize(p.Position, float3(0.0, 0.0, 1.0)) * 0.4;
    p.Flags = 1u;
    _H8ParasiteWrite[index] = p;
}

[numthreads(1, 1, 1)]
void CS_ClearArgs(uint3 id : SV_DispatchThreadID)
{
    _H8ParasiteIndirectArgs.Store(0, 6u);
    _H8ParasiteIndirectArgs.Store(4, 0u);
    _H8ParasiteIndirectArgs.Store(8, 0u);
    _H8ParasiteIndirectArgs.Store(12, 0u);
}

[numthreads(THREAD_GROUP_SIZE, 1, 1)]
void CS_AdvectParasites(uint3 id : SV_DispatchThreadID)
{
    uint index = id.x;
    uint particleBudget = (uint)max(_H8ParasiteFrameParams0.z, 0.0);
    if (index >= particleBudget)
        return;

    float dt = min(max(_H8ParasiteFrameParams0.x, 0.0001), 0.05);
    float time = _H8ParasiteFrameParams0.y;
    int targetCount = clamp((int)round(_H8ParasiteFrameParams0.w), 0, MAX_PARASITE_TARGETS);
    float quality = saturate(_H8ParasiteFrameParams1.x);
    float attractionMultiplier = max(_H8ParasiteFrameParams1.y, 0.0);
    float maxSpeed = max(_H8ParasiteFrameParams1.w, 0.1);
    float curlStrength = max(_H8ParasiteFrameParams2.x, 0.0);
    float flowWeight = max(_H8ParasiteFrameParams2.y, 0.0);
    float shellRadius = max(_H8ParasiteFrameParams2.z, 0.05);
    float targetVelocityBlend = saturate(_H8ParasiteFrameParams2.w);

    ParasiteGpuParticleDTO p = _H8ParasiteRead[index];
    float3 dormant = ResolveDormantPosition(index, time);
    bool finiteState = H8Finite3(p.Position) && H8Finite3(p.Velocity) && H8FiniteScalar(p.Life01);
    if (!finiteState)
    {
        p.Position = dormant;
        p.Velocity = SafeNormalize(dormant, float3(0.0, 0.0, 1.0)) * 0.4;
        p.Life01 = Hash01(index * 101u + 3u);
        p.Flags = 1u;
    }
    else
    {
        float validLife = saturate(p.Life01 + 0.0001);
        p.Position = lerp(dormant, p.Position, validLife);
    }

    float3 acceleration = 0.0;
    float3 latchPosition = p.Position;
    float3 latchVelocity = p.Velocity;
    float latchWeight = 0.0;

    [unroll]
    for (int i = 0; i < MAX_PARASITE_TARGETS; i++)
    {
        if (i >= targetCount)
            continue;

        ParasiteTargetDTO target = _H8ParasiteTargets[i];
        if (!H8Finite3(target.LocalPosition) ||
            !H8Finite3(target.Velocity) ||
            !H8FiniteScalar(target.ThermalSignature) ||
            !H8FiniteScalar(target.AttractionRadius))
        {
            continue;
        }

        float3 delta = target.LocalPosition - p.Position;
        float distSq = max(dot(delta, delta), 0.0001);
        float invDist = rsqrt(distSq);
        float3 direction = delta * invDist;
        float radius = max(target.AttractionRadius, 0.05);
        float heat = max(target.ThermalSignature, 0.0);
        float radiusSqFloor = max(radius * radius * 0.35, 0.0001);
        float force = heat * attractionMultiplier / max(distSq, radiusSqFloor);
        acceleration += direction * force;

        float dist = distSq * invDist;
        float attached = saturate((radius - dist) / max(radius, 0.0001));
        float3 shellPoint = target.LocalPosition - direction * min(radius, shellRadius);
        latchPosition = lerp(latchPosition, shellPoint, attached);
        latchVelocity = lerp(latchVelocity, target.Velocity, attached * targetVelocityBlend);
        latchWeight = max(latchWeight, attached);
    }

    float3 curl = FastCurl(p.Position + time * 0.17, Hash(index + 313u), quality) * curlStrength;
    float3 flow = _H8AbyssalFlowField.SampleLevel(sampler_H8AbyssalFlowField, frac((p.Position * 0.006) + 0.5), 0).xyz;
    acceleration += curl + (flow * flowWeight);

    p.Velocity += acceleration * dt;
    float speedSq = max(dot(p.Velocity, p.Velocity), 0.0001);
    float speedScale = min(1.0, maxSpeed * rsqrt(speedSq));
    p.Velocity *= speedScale;
    p.Position += p.Velocity * dt;

    p.Position = lerp(p.Position, latchPosition, latchWeight);
    p.Velocity = lerp(p.Velocity, latchVelocity, latchWeight);
    p.Life01 = saturate(p.Life01 + dt * lerp(0.02, 0.16, quality));
    p.Flags = 1u | ((latchWeight > 0.001) ? 2u : 0u);
    if (!H8Finite3(p.Position) || !H8Finite3(p.Velocity) || !H8FiniteScalar(p.Life01))
    {
        p.Position = dormant;
        p.Velocity = SafeNormalize(dormant, float3(0.0, 0.0, 1.0)) * 0.4;
        p.Life01 = Hash01(index * 101u + 3u);
        p.Flags = 1u;
    }

    _H8ParasiteWrite[index] = p;
}

[numthreads(THREAD_GROUP_SIZE, 1, 1)]
void CS_RebaseParasites(uint3 id : SV_DispatchThreadID)
{
    uint index = id.x;
    uint particleBudget = (uint)max(_H8ParasiteFrameParams0.z, 0.0);
    if (index >= particleBudget)
        return;

    ParasiteGpuParticleDTO p = _H8ParasiteRead[index];
    p.Position -= _H8ParasiteAupShiftDelta.xyz;
    _H8ParasiteWrite[index] = p;
}

[numthreads(THREAD_GROUP_SIZE, 1, 1)]
void CS_CullParasites(uint3 id : SV_DispatchThreadID)
{
    uint index = id.x;
    uint particleBudget = (uint)max(_H8ParasiteFrameParams0.z, 0.0);
    if (index >= particleBudget)
        return;

    ParasiteGpuParticleDTO p = _H8ParasiteRead[index];
    float finite = (H8Finite3(p.Position) && H8FiniteScalar(p.Life01)) ? 1.0 : 0.0;
    float targetPresence = step(0.5, _H8ParasiteFrameParams0.w);
    float alive = finite * targetPresence * step(0.001, p.Life01);
    if (alive > 0.5)
    {
        uint writeIndex;
        _H8ParasiteIndirectArgs.InterlockedAdd(4, 1u, writeIndex);
        if (writeIndex < particleBudget)
            _H8ParasiteVisibleIndices[writeIndex] = index;
    }
}
