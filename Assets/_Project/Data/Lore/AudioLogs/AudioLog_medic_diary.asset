  # VO STUB: assign EN clip to defaultClip and add RU override in variants once voiced files exist.
  subtitleText: "\u0421\u0438\u043d\u0434\u0440\u043e\u043c \u0433\u043b\u0443\u0431\u0438\u043d\u044b \u0431\u043e\u043b\u044c\u0448\u0435 \u043d\u0435 \u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044f \u0432\u0430\u0445\u0442\u0430\u043c\u0438 \u0434\u0430\u043b\u044c\u043d\u0435\u0433\u043e \u0441\u0435\u043a\u0442\u043e\u0440\u0430. \u0413\u0430\u043b\u043b\u044e\u0446\u0438\u043d\u0430\u0446\u0438\u0438 \u043d\u0430\u0447\u0438\u043d\u0430\u044e\u0442\u0441\u044f \u0435\u0449\u0451 \u0434\u043e \u0442\u043e\u0433\u043e, \u043a\u0430\u043a \u0441\u0440\u0430\u0431\u0430\u0442\u044b\u0432\u0430\u044e\u0442 \u0442\u0440\u0435\u0432\u043e\u0433\u0438 \u0434\u0430\u0432\u043b\u0435\u043d\u0438\u044f."
  localizedSubtitleText:
    tableKey: LOG_MEDIC_DIARY_SUBTITLE
    fallbackText: "\u0421\u0438\u043d\u0434\u0440\u043e\u043c \u0433\u043b\u0443\u0431\u0438\u043d\u044b \u0431\u043e\u043b\u044c\u0448\u0435 \u043d\u0435 \u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044f \u0432\u0430\u0445\u0442\u0430\u043c\u0438 \u0434\u0430\u043b\u044c\u043d\u0435\u0433\u043e \u0441\u0435\u043a\u0442\u043e\u0440\u0430. \u0413\u0430\u043b\u043b\u044e\u0446\u0438\u043d\u0430\u0446\u0438\u0438 \u043d\u0430\u0447\u0438\u043d\u0430\u044e\u0442\u0441\u044f \u0435\u0449\u0451 \u0434\u043e \u0442\u043e\u0433\u043e, \u043a\u0430\u043a \u0441\u0440\u0430\u0431\u0430\u0442\u044b\u0432\u0430\u044e\u0442 \u0442\u0440\u0435\u0432\u043e\u0433\u0438 \u0434\u0430\u0432\u043b\u0435\u043d\u0438\u044f."
    variants: []
  durationOverride: 39
  archiveSummary: "\u0417\u0430\u043f\u0438\u0441\u044c \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u043e\u0433\u043e \u0434\u043d\u0435\u0432\u043d\u0438\u043a\u0430 \u043e\u0431 \u0443\u0441\u043a\u043e\u0440\u044f\u044e\u0449\u0435\u043c\u0441\u044f \u0441\u0438\u043d\u0434\u0440\u043e\u043c\u0435 \u0434\u0430\u0432\u043b\u0435\u043d\u0438\u044f \u0443 \u044d\u043a\u0438\u043f\u0430\u0436\u0430. \u041d\u0430\u043c\u0435\u043a\u0430\u0435\u0442, \u0447\u0442\u043e \u0430\u043d\u043e\u043c\u0430\u043b\u0438\u044f \u0440\u0430\u0441\u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u044f\u043b\u0430\u0441\u044c \u0431\u044b\u0441\u0442\u0440\u0435\u0435, \u0447\u0435\u043c \u043f\u0440\u0438\u0437\u043d\u0430\u0432\u0430\u043b\u043e \u043a\u043e\u043c\u0430\u043d\u0434\u043e\u0432\u0430\u043d\u0438\u0435."
  localizedArchiveSummary:
    tableKey: LOG_MEDIC_DIARY_SUMMARY
    fallbackText: "\u0417\u0430\u043f\u0438\u0441\u044c \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u043e\u0433\u043e \u0434\u043d\u0435\u0432\u043d\u0438\u043a\u0430 \u043e\u0431 \u0443\u0441\u043a\u043e\u0440\u044f\u044e\u0449\u0435\u043c\u0441\u044f \u0441\u0438\u043d\u0434\u0440\u043e\u043c\u0435 \u0434\u0430\u0432\u043b\u0435\u043d\u0438\u044f \u0443 \u044d\u043a\u0438\u043f\u0430\u0436\u0430. \u041d\u0430\u043c\u0435\u043a\u0430\u0435\u0442, \u0447\u0442\u043e \u0430\u043d\u043e\u043c\u0430\u043b\u0438\u044f \u0440\u0430\u0441\u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u044f\u043b\u0430\u0441\u044c \u0431\u044b\u0441\u0442\u0440\u0435\u0435, \u0447\u0435\u043c \u043f\u0440\u0438\u0437\u043d\u0430\u0432\u0430\u043b\u043e \u043a\u043e\u043c\u0430\u043d\u0434\u043e\u0432\u0430\u043d\u0438\u0435."
    variants: []
