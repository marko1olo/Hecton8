  logId: medic_diary
  displayTitle: "\u0414\u041d\u0415\u0412\u041d\u0418\u041a \u0421\u0418\u041c\u041f\u0422\u041e\u041c\u041e\u0412 - \u041c\u0415\u0414\u0418\u041a"
  localizedDisplayTitle:
    tableKey: LOG_MEDIC_DIARY_TITLE
    fallbackText: "\u0414\u041d\u0415\u0412\u041d\u0418\u041a \u0421\u0418\u041c\u041f\u0422\u041e\u041c\u041e\u0412 - \u041c\u0415\u0414\u0418\u041a"
    variants: []
  author: "\u041c\u0435\u0434\u0438\u043a"
  localizedAuthor:
    tableKey: LOG_MEDIC_DIARY_AUTHOR
