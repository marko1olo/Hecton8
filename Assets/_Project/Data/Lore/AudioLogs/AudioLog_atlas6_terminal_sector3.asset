  displayTitle: "\u0422\u0415\u0420\u041c\u0418\u041d\u0410\u041b - \u041d\u0415\u0423\u0414\u0410\u0427\u041d\u041e\u0415 \u041e\u0422\u041a\u0420\u042b\u0422\u0418\u0415 \u0421\u0415\u041a\u0422\u041e\u0420\u0410 3"
  localizedDisplayTitle:
    tableKey: LOG_ATLAS6_TERMINAL_SECTOR3_TITLE
    fallbackText: "\u0422\u0415\u0420\u041c\u0418\u041d\u0410\u041b - \u041d\u0415\u0423\u0414\u0410\u0427\u041d\u041e\u0415 \u041e\u0422\u041a\u0420\u042b\u0422\u0418\u0415 \u0421\u0415\u041a\u0422\u041e\u0420\u0410 3"
    variants: []
