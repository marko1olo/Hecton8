  # VO STUB: assign EN clip to defaultClip and add RU override in variants once voiced files exist.
  subtitleText: "\u0414\u043e\u0441\u0442\u0443\u043f \u0437\u0430\u043a\u0440\u044b\u0442. \u0410\u0440\u0445\u0438\u0432 \u0441\u0435\u043a\u0442\u043e\u0440\u0430 3 \u043f\u043e-\u043f\u0440\u0435\u0436\u043d\u0435\u043c\u0443 \u0437\u0430\u043f\u0435\u0440\u0442 \u043f\u0440\u043e\u0432\u0435\u0440\u043a\u0430\u043c\u0438 \u043f\u043e\u043b\u043d\u043e\u043c\u043e\u0447\u0438\u0439 Atlas-6. \u0420\u0443\u0447\u043d\u043e\u0439 \u043c\u0430\u0440\u0448\u0440\u0443\u0442 \u0442\u043e\u0436\u0435 \u043c\u0451\u0440\u0442\u0432."
  localizedSubtitleText:
    tableKey: LOG_ATLAS6_TERMINAL_SECTOR3_SUBTITLE
    fallbackText: "\u0414\u043e\u0441\u0442\u0443\u043f \u0437\u0430\u043a\u0440\u044b\u0442. \u0410\u0440\u0445\u0438\u0432 \u0441\u0435\u043a\u0442\u043e\u0440\u0430 3 \u043f\u043e-\u043f\u0440\u0435\u0436\u043d\u0435\u043c\u0443 \u0437\u0430\u043f\u0435\u0440\u0442 \u043f\u0440\u043e\u0432\u0435\u0440\u043a\u0430\u043c\u0438 \u043f\u043e\u043b\u043d\u043e\u043c\u043e\u0447\u0438\u0439 Atlas-6. \u0420\u0443\u0447\u043d\u043e\u0439 \u043c\u0430\u0440\u0448\u0440\u0443\u0442 \u0442\u043e\u0436\u0435 \u043c\u0451\u0440\u0442\u0432."
    variants: []
  durationOverride: 28
  archiveSummary: "\u0421\u043d\u0438\u043c\u043e\u043a \u0442\u0435\u0440\u043c\u0438\u043d\u0430\u043b\u0430 \u043f\u043e\u0441\u043b\u0435 \u043d\u0435\u0443\u0434\u0430\u0447\u043d\u043e\u0439 \u043f\u043e\u043f\u044b\u0442\u043a\u0438 \u0434\u043e\u0441\u0442\u0443\u043f\u0430 \u043a Atlas-6. \u041f\u043e\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u0435\u0442, \u0447\u0442\u043e Chen_M \u0434\u043e \u043a\u043e\u043d\u0446\u0430 \u043f\u044b\u0442\u0430\u043b\u0441\u044f \u0432\u0441\u043a\u0440\u044b\u0442\u044c \u0441\u0435\u043a\u0442\u043e\u0440 3 \u0447\u0435\u0440\u0435\u0437 \u0443\u0446\u0435\u043b\u0435\u0432\u0448\u0438\u0435 \u0442\u0435\u0445\u043c\u0430\u0440\u0448\u0440\u0443\u0442\u044b."
  localizedArchiveSummary:
    tableKey: LOG_ATLAS6_TERMINAL_SECTOR3_SUMMARY
    fallbackText: "\u0421\u043d\u0438\u043c\u043e\u043a \u0442\u0435\u0440\u043c\u0438\u043d\u0430\u043b\u0430 \u043f\u043e\u0441\u043b\u0435 \u043d\u0435\u0443\u0434\u0430\u0447\u043d\u043e\u0439 \u043f\u043e\u043f\u044b\u0442\u043a\u0438 \u0434\u043e\u0441\u0442\u0443\u043f\u0430 \u043a Atlas-6. \u041f\u043e\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u0435\u0442, \u0447\u0442\u043e Chen_M \u0434\u043e \u043a\u043e\u043d\u0446\u0430 \u043f\u044b\u0442\u0430\u043b\u0441\u044f \u0432\u0441\u043a\u0440\u044b\u0442\u044c \u0441\u0435\u043a\u0442\u043e\u0440 3 \u0447\u0435\u0440\u0435\u0437 \u0443\u0446\u0435\u043b\u0435\u0432\u0448\u0438\u0435 \u0442\u0435\u0445\u043c\u0430\u0440\u0448\u0440\u0443\u0442\u044b."
    variants: []
  recordDate: "844 \u0434\u043d\u044f \u043d\u0430\u0437\u0430\u0434"
