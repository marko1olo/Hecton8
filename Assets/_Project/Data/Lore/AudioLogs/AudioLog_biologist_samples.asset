  logId: biologist_samples
  displayTitle: "\u041e\u0411\u0420\u0410\u0417\u0426\u042b - \u041f\u041e\u041b\u0415\u0412\u0410\u042f \u0417\u0410\u041f\u0418\u0421\u042c \u0411\u0418\u041e\u041b\u041e\u0413\u0410"
  localizedDisplayTitle:
    tableKey: LOG_BIOLOGIST_SAMPLES_TITLE
    fallbackText: "\u041e\u0411\u0420\u0410\u0417\u0426\u042b - \u041f\u041e\u041b\u0415\u0412\u0410\u042f \u0417\u0410\u041f\u0418\u0421\u042c \u0411\u0418\u041e\u041b\u041e\u0413\u0410"
    variants: []
  author: "\u0411\u0438\u043e\u043b\u043e\u0433"
  localizedAuthor:
    tableKey: LOG_BIOLOGIST_SAMPLES_AUTHOR
    fallbackText: "\u0411\u0438\u043e\u043b\u043e\u0433"
    variants: []
