  audioClip: {fileID: 0}
  localizedAudioClips:
    defaultClip: {fileID: 0}
    variants: []
  # VO STUB: assign EN clip to defaultClip and add RU override in variants once voiced files exist.
  subtitleText: "\u041a\u0440\u0435\u043c\u043d\u0438\u0435\u0432\u0430\u044f \u0444\u043b\u043e\u0440\u0430 \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0430\u0435\u0442 \u0440\u0430\u0441\u0442\u0438 \u043f\u0440\u044f\u043c\u043e \u0447\u0435\u0440\u0435\u0437 \u0448\u0432\u044b \u0434\u0430\u0432\u043b\u0435\u043d\u0438\u044f. \u0415\u0441\u043b\u0438 \u043e\u043d\u0430 \u0436\u0438\u0432\u0451\u0442 \u043d\u0430 \u0442\u0430\u043a\u043e\u0439 \u0433\u043b\u0443\u0431\u0438\u043d\u0435, \u0437\u043d\u0430\u0447\u0438\u0442 \u043f\u0438\u0442\u0430\u0435\u0442\u0441\u044f \u0442\u0435\u043c, \u0447\u0442\u043e \u043c\u044b \u0432\u0441\u0451 \u0435\u0449\u0451 \u043d\u0435 \u0438\u0437\u043c\u0435\u0440\u0438\u043b\u0438."
  localizedSubtitleText:
    tableKey: LOG_BIOLOGIST_SAMPLES_SUBTITLE
    fallbackText: "\u041a\u0440\u0435\u043c\u043d\u0438\u0435\u0432\u0430\u044f \u0444\u043b\u043e\u0440\u0430 \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0430\u0435\u0442 \u0440\u0430\u0441\u0442\u0438 \u043f\u0440\u044f\u043c\u043e \u0447\u0435\u0440\u0435\u0437 \u0448\u0432\u044b \u0434\u0430\u0432\u043b\u0435\u043d\u0438\u044f. \u0415\u0441\u043b\u0438 \u043e\u043d\u0430 \u0436\u0438\u0432\u0451\u0442 \u043d\u0430 \u0442\u0430\u043a\u043e\u0439 \u0433\u043b\u0443\u0431\u0438\u043d\u0435, \u0437\u043d\u0430\u0447\u0438\u0442 \u043f\u0438\u0442\u0430\u0435\u0442\u0441\u044f \u0442\u0435\u043c, \u0447\u0442\u043e \u043c\u044b \u0432\u0441\u0451 \u0435\u0449\u0451 \u043d\u0435 \u0438\u0437\u043c\u0435\u0440\u0438\u043b\u0438."
    variants: []
  durationOverride: 36
  archiveSummary: "\u041f\u043e\u043b\u0435\u0432\u044b\u0435 \u0437\u0430\u043c\u0435\u0442\u043a\u0438 \u0431\u0438\u043e\u0441\u0442\u0430\u043d\u0446\u0438\u0438. \u041e\u0442\u0441\u043b\u0435\u0436\u0438\u0432\u0430\u044e\u0442 \u0430\u043d\u043e\u043c\u0430\u043b\u044c\u043d\u044b\u0439 \u0440\u043e\u0441\u0442 \u043a\u0440\u0435\u043c\u043d\u0438\u0435\u0432\u043e\u0439 \u0444\u043b\u043e\u0440\u044b \u0438 \u043d\u0430\u043c\u0435\u043a\u0430\u044e\u0442 \u043d\u0430 \u0431\u043e\u043b\u0435\u0435 \u0433\u043b\u0443\u0431\u043e\u043a\u0438\u0439 \u0438\u0441\u0442\u043e\u0447\u043d\u0438\u043a \u044d\u043d\u0435\u0440\u0433\u0438\u0438 \u0432 \u044d\u043a\u043e\u0441\u0438\u0441\u0442\u0435\u043c\u0435 \u0432\u043f\u0430\u0434\u0438\u043d\u044b."
  localizedArchiveSummary:
    tableKey: LOG_BIOLOGIST_SAMPLES_SUMMARY
    fallbackText: "\u041f\u043e\u043b\u0435\u0432\u044b\u0435 \u0437\u0430\u043c\u0435\u0442\u043a\u0438 \u0431\u0438\u043e\u0441\u0442\u0430\u043d\u0446\u0438\u0438. \u041e\u0442\u0441\u043b\u0435\u0436\u0438\u0432\u0430\u044e\u0442 \u0430\u043d\u043e\u043c\u0430\u043b\u044c\u043d\u044b\u0439 \u0440\u043e\u0441\u0442 \u043a\u0440\u0435\u043c\u043d\u0438\u0435\u0432\u043e\u0439 \u0444\u043b\u043e\u0440\u044b \u0438 \u043d\u0430\u043c\u0435\u043a\u0430\u044e\u0442 \u043d\u0430 \u0431\u043e\u043b\u0435\u0435 \u0433\u043b\u0443\u0431\u043e\u043a\u0438\u0439 \u0438\u0441\u0442\u043e\u0447\u043d\u0438\u043a \u044d\u043d\u0435\u0440\u0433\u0438\u0438 \u0432 \u044d\u043a\u043e\u0441\u0438\u0441\u0442\u0435\u043c\u0435 \u0432\u043f\u0430\u0434\u0438\u043d\u044b."
