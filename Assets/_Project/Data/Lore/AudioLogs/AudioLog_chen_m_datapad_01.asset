  # VO STUB: temporary duplicated placeholder clips prove LocalizedAudioClipSet wiring for EN/RU until final voice masters arrive.
  subtitleText: "\u0415\u0441\u043b\u0438 \u0448\u043b\u044e\u0437 \u0437\u0430\u043a\u043b\u0438\u043d\u0438\u0442 \u0432\u0442\u043e\u0440\u043e\u0439 \u0440\u0430\u0437, \u044f \u0431\u0443\u0434\u0443 \u0432\u0435\u0441\u0442\u0438 \u0437\u0430\u043f\u0438\u0441\u0438 \u0432\u0440\u0443\u0447\u043d\u0443\u044e. \u042f \u0431\u043e\u043b\u044c\u0448\u0435 \u043d\u0435 \u0434\u043e\u0432\u0435\u0440\u044f\u044e \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u043a\u0435 \u0432 \u044d\u0442\u043e\u043c \u043e\u0442\u0441\u0435\u043a\u0435."
  localizedSubtitleText:
    tableKey: LOG_CHEN_M_DATAPAD_01_SUBTITLE
    fallbackText: "\u0415\u0441\u043b\u0438 \u0448\u043b\u044e\u0437 \u0437\u0430\u043a\u043b\u0438\u043d\u0438\u0442 \u0432\u0442\u043e\u0440\u043e\u0439 \u0440\u0430\u0437, \u044f \u0431\u0443\u0434\u0443 \u0432\u0435\u0441\u0442\u0438 \u0437\u0430\u043f\u0438\u0441\u0438 \u0432\u0440\u0443\u0447\u043d\u0443\u044e. \u042f \u0431\u043e\u043b\u044c\u0448\u0435 \u043d\u0435 \u0434\u043e\u0432\u0435\u0440\u044f\u044e \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u043a\u0435 \u0432 \u044d\u0442\u043e\u043c \u043e\u0442\u0441\u0435\u043a\u0435."
    variants: []
  durationOverride: 31
  archiveSummary: "\u0422\u0435\u0445\u043d\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0438 \u043b\u0438\u0447\u043d\u0430\u044f \u0437\u0430\u043f\u0438\u0441\u044c \u0438\u043d\u0436\u0435\u043d\u0435\u0440\u0430 Chen_M. \u0424\u0438\u043a\u0441\u0438\u0440\u0443\u0435\u0442 \u043f\u043e\u0432\u0442\u043e\u0440\u043d\u044b\u0435 \u043f\u043e\u043b\u043e\u043c\u043a\u0438 \u0448\u043b\u044e\u0437\u0430 \u0438 \u043f\u0435\u0440\u0432\u044b\u0435 \u043f\u0440\u0438\u0437\u043d\u0430\u043a\u0438 \u0441\u0430\u0431\u043e\u0442\u0430\u0436\u0430 \u0432 \u0436\u0438\u043b\u043e\u043c \u043a\u043e\u043d\u0442\u0443\u0440\u0435."
  localizedArchiveSummary:
    tableKey: LOG_CHEN_M_DATAPAD_01_SUMMARY
    fallbackText: "\u0422\u0435\u0445\u043d\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0438 \u043b\u0438\u0447\u043d\u0430\u044f \u0437\u0430\u043f\u0438\u0441\u044c \u0438\u043d\u0436\u0435\u043d\u0435\u0440\u0430 Chen_M. \u0424\u0438\u043a\u0441\u0438\u0440\u0443\u0435\u0442 \u043f\u043e\u0432\u0442\u043e\u0440\u043d\u044b\u0435 \u043f\u043e\u043b\u043e\u043c\u043a\u0438 \u0448\u043b\u044e\u0437\u0430 \u0438 \u043f\u0435\u0440\u0432\u044b\u0435 \u043f\u0440\u0438\u0437\u043d\u0430\u043a\u0438 \u0441\u0430\u0431\u043e\u0442\u0430\u0436\u0430 \u0432 \u0436\u0438\u043b\u043e\u043c \u043a\u043e\u043d\u0442\u0443\u0440\u0435."
