  displayTitle: "\u041A\u041F\u041A \u2014 Chen_M (\u0417\u0430\u043F\u0438\u0441\u044C
    1/3)"
  author: Chen_M
  category: 0
  audioClip: {fileID: 0}
  subtitleText: "\u0415\u0441\u043B\u0438 \u0448\u043B\u044E\u0437 \u0437\u0430\u043A\u043B\u0438\u043D\u0438\u0442
    \u0432\u0442\u043E\u0440\u043E\u0439 \u0440\u0430\u0437, \u044F \u043D\u0430\u0447\u043D\u0443
    \u0432\u0435\u0441\u0442\u0438 \u0437\u0430\u043F\u0438\u0441\u0438 \u0432\u0440\u0443\u0447\u043D\u0443\u044E.
    \u041D\u0435 \u0434\u043E\u0432\u0435\u0440\u044F\u044E \u0431\u043E\u043B\u044C\u0448\u0435
    \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u043A\u0435 \u0432 \u044D\u0442\u043E\u043C
    \u043E\u0442\u0441\u0435\u043A\u0435."
  durationOverride: 31
  archiveSummary: "\u0422\u0435\u0445\u043D\u0438\u0447\u0435\u0441\u043A\u0430\u044F
    \u0438 \u043B\u0438\u0447\u043D\u0430\u044F \u0437\u0430\u043F\u0438\u0441\u044C
    \u0438\u043D\u0436\u0435\u043D\u0435\u0440\u0430 Chen_M. \u0424\u0438\u043A\u0441\u0438\u0440\u0443\u0435\u0442
    \u043F\u043E\u043B\u043E\u043C\u043A\u0438 \u0448\u043B\u044E\u0437\u0430 \u0438
    \u043F\u0440\u0438\u0437\u043D\u0430\u043A\u0438 \u0441\u0430\u0431\u043E\u0442\u0430\u0436\u0430
    \u043D\u0430 \u0436\u0438\u043B\u043E\u043C \u043A\u043E\u043D\u0442\u0443\u0440\u0435."
  recordDate: "847 \u0434\u043D\u0435\u0439 \u043D\u0430\u0437\u0430\u0434"
