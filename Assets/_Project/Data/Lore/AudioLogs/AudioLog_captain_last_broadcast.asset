  logId: captain_last_broadcast
  displayTitle: "\u041F\u043E\u0441\u043B\u0435\u0434\u043D\u044F\u044F \u0442\u0440\u0430\u043D\u0441\u043B\u044F\u0446\u0438\u044F
    \u2014 \u041A\u0430\u043F\u0438\u0442\u0430\u043D"
  author: Captain
  category: 2
  audioClip: {fileID: 0}
  subtitleText: "Atlas... \u043E\u043D \u043D\u0435 \u043E\u0442\u0432\u0435\u0447\u0430\u0435\u0442.
    \u041D\u043E \u043C\u044B \u0432\u0438\u0434\u0438\u043C, \u043A\u0430\u043A
    \u043E\u043D... \u0440\u0430\u0441\u0442\u0435\u0442. \u041D\u0435 \u043F\u043E\u0434\u043F\u0443\u0441\u043A\u0430\u0439\u0442\u0435
    \u0435\u0433\u043E \u043A \u0448\u043B\u044E\u0437\u0443."
  durationOverride: 42
  archiveSummary: "\u041F\u043E\u0441\u043B\u0435\u0434\u043D\u044F\u044F \u0436\u0438\u0432\u0430\u044F
    \u043F\u0435\u0440\u0435\u0434\u0430\u0447\u0430 \u0441 \u043A\u043E\u043C\u0430\u043D\u0434\u043D\u043E\u0433\u043E
    \u043C\u043E\u0434\u0443\u043B\u044F. \u041A\u043E\u043D\u0442\u0430\u043A\u0442
    \u0441 \u043E\u0431\u044A\u0435\u043A\u0442\u043E\u043C Atlas \u043F\u043E\u0442\u0435\u0440\u044F\u043D,
    \u0437\u0430\u0442\u0435\u043C \u043D\u0430\u0447\u0430\u043B\u0430\u0441\u044C
    \u043B\u043E\u043A\u0430\u043B\u044C\u043D\u0430\u044F \u0430\u0432\u0430\u0440\u0438\u044F
    \u043D\u0430 \u0448\u043B\u044E\u0437\u0435."
  recordDate: "847 \u0434\u043D\u0435\u0439 \u043D\u0430\u0437\u0430\u0434"
