    variants: []
  # VO STUB: assign EN clip to defaultClip and add RU override in variants once voiced files exist.
  subtitleText: "Atlas... \u043e\u0442\u0432\u0435\u0442\u0430 \u043d\u0435\u0442. \u0412\u0441\u0435\u043c \u043f\u043e\u043a\u0438\u043d\u0443\u0442\u044c \u0440\u0435\u0436\u0438\u043c \u0440\u0430\u0434\u0438\u043e\u043c\u043e\u043b\u0447\u0430\u043d\u0438\u044f \u0438 \u0438\u0434\u0442\u0438 \u0432 \u0433\u0435\u0440\u043c\u043e\u0443\u043a\u0440\u044b\u0442\u0438\u0435. \u042d\u0442\u043e \u043d\u0435 \u0443\u0447\u0435\u0431\u043d\u0430\u044f \u0442\u0440\u0435\u0432\u043e\u0433\u0430."
  localizedSubtitleText:
    tableKey: LOG_CAPTAIN_LAST_BROADCAST_SUBTITLE
    fallbackText: "Atlas... \u043e\u0442\u0432\u0435\u0442\u0430 \u043d\u0435\u0442. \u0412\u0441\u0435\u043c \u043f\u043e\u043a\u0438\u043d\u0443\u0442\u044c \u0440\u0435\u0436\u0438\u043c \u0440\u0430\u0434\u0438\u043e\u043c\u043e\u043b\u0447\u0430\u043d\u0438\u044f \u0438 \u0438\u0434\u0442\u0438 \u0432 \u0433\u0435\u0440\u043c\u043e\u0443\u043a\u0440\u044b\u0442\u0438\u0435. \u042d\u0442\u043e \u043d\u0435 \u0443\u0447\u0435\u0431\u043d\u0430\u044f \u0442\u0440\u0435\u0432\u043e\u0433\u0430."
    variants: []
  durationOverride: 42
  archiveSummary: "\u041f\u043e\u0441\u043b\u0435\u0434\u043d\u044f\u044f \u0436\u0438\u0432\u0430\u044f \u043a\u043e\u043c\u0430\u043d\u0434\u043d\u0430\u044f \u0442\u0440\u0430\u043d\u0441\u043b\u044f\u0446\u0438\u044f \u0438\u0437 \u0446\u0435\u043f\u043e\u0447\u043a\u0438 \u0443\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u044f. \u041e\u0442\u043c\u0435\u0447\u0430\u0435\u0442 \u043c\u043e\u043c\u0435\u043d\u0442, \u043a\u043e\u0433\u0434\u0430 \u0441\u0442\u0430\u043d\u0446\u0438\u044f \u043f\u0440\u0438\u0437\u043d\u0430\u043b\u0430 \u043f\u043e\u043b\u043d\u044b\u0439 \u0441\u0438\u0441\u0442\u0435\u043c\u043d\u044b\u0439 \u0441\u0440\u044b\u0432."
  localizedArchiveSummary:
    tableKey: LOG_CAPTAIN_LAST_BROADCAST_SUMMARY
    fallbackText: "\u041f\u043e\u0441\u043b\u0435\u0434\u043d\u044f\u044f \u0436\u0438\u0432\u0430\u044f \u043a\u043e\u043c\u0430\u043d\u0434\u043d\u0430\u044f \u0442\u0440\u0430\u043d\u0441\u043b\u044f\u0446\u0438\u044f \u0438\u0437 \u0446\u0435\u043f\u043e\u0447\u043a\u0438 \u0443\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u044f. \u041e\u0442\u043c\u0435\u0447\u0430\u0435\u0442 \u043c\u043e\u043c\u0435\u043d\u0442, \u043a\u043e\u0433\u0434\u0430 \u0441\u0442\u0430\u043d\u0446\u0438\u044f \u043f\u0440\u0438\u0437\u043d\u0430\u043b\u0430 \u043f\u043e\u043b\u043d\u044b\u0439 \u0441\u0438\u0441\u0442\u0435\u043c\u043d\u044b\u0439 \u0441\u0440\u044b\u0432."
    variants: []
  recordDate: "847 \u0434\u043d\u0435\u0439 \u043d\u0430\u0437\u0430\u0434"
