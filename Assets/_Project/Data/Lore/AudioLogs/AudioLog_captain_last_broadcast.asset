  displayTitle: "\u041a\u0410\u041f\u0418\u0422\u0410\u041d - \u041f\u041e\u0421\u041b\u0415\u0414\u041d\u042f\u042f \u0422\u0420\u0410\u041d\u0421\u041b\u042f\u0426\u0418\u042f"
  localizedDisplayTitle:
    tableKey: LOG_CAPTAIN_LAST_BROADCAST_TITLE
    fallbackText: "\u041a\u0410\u041f\u0418\u0422\u0410\u041d - \u041f\u041e\u0421\u041b\u0415\u0414\u041d\u042f\u042f \u0422\u0420\u0410\u041d\u0421\u041b\u042f\u0426\u0418\u042f"
    variants: []
  author: "\u041a\u0430\u043f\u0438\u0442\u0430\u043d"
