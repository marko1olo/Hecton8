  - creatureId: creature.atlas_builder
    displayName: "\u0421\u0442\u0440\u043E\u0438\u0442\u0435\u043B\u044C (Atlas Builder
      Drone)"
    faunaType: 4
    habitatZone: "\u0412\u0435\u0437\u0434\u0435 (80-3000\u043C)"
    sizeMeters: 3
    codexDescription: "\u041C\u0435\u0442\u0430\u043B\u043B\u0438\u0447\u0435\u0441\u043A\u0438\u0439
      \u043A\u043E\u0440\u043F\u0443\u0441 \u0441 \u043E\u0440\u0433\u0430\u043D\u0438\u0447\u0435\u0441\u043A\u0438\u043C\u0438
      \u0442\u0440\u0443\u0431\u043A\u0430\u043C\u0438. \u0422\u0430\u0449\u0438\u0442
      \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u044B \u043A \u0442\u043E\u0447\u043A\u0430\u043C
      \u0441\u0431\u043E\u0440\u043A\u0438. \u041D\u0435 \u0430\u0442\u0430\u043A\u0443\u0435\u0442
      \u0435\u0441\u043B\u0438 \u043D\u0435 \u043C\u0435\u0448\u0430\u0442\u044C.
      \u041F\u0440\u0438 \u0443\u0433\u0440\u043E\u0437\u0435 \u2014 \u0432\u044B\u0441\u043E\u043A\u043E\u0447\u0430\u0441\u0442\u043E\u0442\u043D\u044B\u0439
      \u043F\u0438\u0441\u043A, \u0432\u044B\u0437\u044B\u0432\u0430\u0435\u0442
      \u0417\u0430\u0449\u0438\u0442\u043D\u0438\u043A\u0430."
    gameplayRole: "\u041F\u0435\u0440\u0432\u0430\u044F \u0432\u0441\u0442\u0440\u0435\u0447\u0430
      \u0441 \u0434\u0440\u043E\u043D\u0430\u043C\u0438. \u041D\u0435\u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0451\u043D\u043D\u043E\u0441\u0442\u044C
      \u0441\u0442\u0440\u0430\u0448\u043D\u0435\u0435 \u0443\u0433\u0440\u043E\u0437\u044B."
    scientificBasis: "\u041F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u0430 \u041F\u043E\u0441\u0435\u0432\u0430
      \u0410\u0442\u043B\u0430\u0441-6."
