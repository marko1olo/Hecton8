  - discoveryId: captain_last_broadcast
    displayName: "\u041F\u043E\u0441\u043B\u0435\u0434\u043D\u044F\u044F \u0442\u0440\u0430\u043D\u0441\u043B\u044F\u0446\u0438\u044F
