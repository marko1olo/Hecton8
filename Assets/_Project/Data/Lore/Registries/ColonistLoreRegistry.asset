      fallbackText: ""
      variants: []
    objectType: 1
    linkedAudioLog: {fileID: 11400000, guid: ba3d7a00641b626478a2bd5543004528, type: 2}
    description: "\xAB\u0410\u0442\u043B\u0430\u0441... \u043E\u043D \u043D\u0435
      \u043E\u0442\u0432\u0435\u0447\u0430\u0435\u0442. \u041D\u043E \u043C\u044B
      \u0432\u0438\u0434\u0438\u043C, \u043A\u0430\u043A \u043E\u043D... \u0440\u0430\u0441\u0442\u0451\u0442.\xBB
      \u041E\u0431\u0440\u044B\u0432\u0430\u0435\u0442\u0441\u044F \u043D\u0430 \u0437\u0432\u0443\u043A\u0435
      \u0441\u043A\u0440\u0435\u0436\u0435\u0442\u0430."
    localizedDescription:
      tableKey: COLONIST_CAPTAIN_LAST_BROADCAST_DESCRIPTION
      fallbackText: ""
      variants: []
    locationHint: "\u041A\u043E\u043C\u0430\u043D\u0434\u043D\u044B\u0439 \u043C\u043E\u0434\u0443\u043B\u044C,
