  m_Name: DeepReachCorporationData
  m_EditorClassIdentifier: Assembly-CSharp::Hecton8.Narrative.DeepReachCorporationData
  corporationName: Deep Reach
  localizedCorporationName:
    tableKey: CORP_DEEP_REACH_NAME
    fallbackText: ""
    variants: []
  officialMission: "\u041A\u043E\u043B\u043E\u043D\u0438\u0437\u0430\u0446\u0438\u044F
    \u043E\u0442\u0434\u0430\u043B\u0451\u043D\u043D\u044B\u0445 \u043C\u0438\u0440\u043E\u0432.
    \u041D\u0430\u0443\u0447\u043D\u044B\u0435 \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043D\u0438\u044F.
    \u0422\u0435\u0440\u0440\u0430\u0444\u043E\u0440\u043C\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u0435."
  localizedOfficialMission:
    tableKey: CORP_DEEP_REACH_OFFICIAL_MISSION
    fallbackText: ""
    variants: []
  realMission: "\u0414\u043E\u0431\u044B\u0447\u0430 \u0438\u0437\u043E\u0442\u043E\u043F\u0430
    Xenon-\u03A9. \u0422\u0435\u0441\u0442\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u0435
    \u0418\u0418 \u0410\u0442\u043B\u0430\u0441-6 \u0432 \u0443\u0441\u043B\u043E\u0432\u0438\u044F\u0445
    \u043F\u043E\u043B\u043D\u043E\u0439 \u0430\u0432\u0442\u043E\u043D\u043E\u043C\u0438\u0438.
    \u0412\u043E\u0435\u043D\u043D\u044B\u0439 \u043F\u043B\u0430\u0446\u0434\u0430\u0440\u043C
    \u0432 \u0441\u0438\u0441\u0442\u0435\u043C\u0435 \u0410\u044D\u0433\u0438\u0440\u0430."
  localizedRealMission:
    tableKey: CORP_DEEP_REACH_REAL_MISSION
    fallbackText: ""
    variants: []
  factions:
  - factionId: ethics
    displayName: "\u0424\u0440\u0430\u043A\u0446\u0438\u044F \xAB\u042D\u0442\u0438\u043A\u0438\xBB"
    localizedDisplayName:
      tableKey: CORP_FACTION_ETHICS_NAME
      fallbackText: ""
      variants: []
    philosophy: "\u0421\u0447\u0438\u0442\u0430\u044E\u0442 \u043C\u0438\u0441\u0441\u0438\u044E
      \u043F\u0440\u0435\u0441\u0442\u0443\u043F\u043D\u043E\u0439. \u0417\u043D\u0430\u043B\u0438
      \u043E \u0440\u0438\u0441\u043A\u0430\u0445 \u043A\u0430\u0442\u0430\u0441\u0442\u0440\u043E\u0444\u044B.
      \u0425\u043E\u0442\u044F\u0442 \u0440\u0430\u0441\u043A\u0440\u044B\u0442\u044C
      \u043F\u0440\u0430\u0432\u0434\u0443."
    localizedPhilosophy:
      tableKey: CORP_FACTION_ETHICS_PHILOSOPHY
      fallbackText: ""
      variants: []
    isPlayerAligned: 1
  - factionId: pragmatists
    displayName: "\u0424\u0440\u0430\u043A\u0446\u0438\u044F \xAB\u041F\u0440\u0430\u0433\u043C\u0430\u0442\u0438\u043A\u0438\xBB"
    localizedDisplayName:
      tableKey: CORP_FACTION_PRAGMATISTS_NAME
      fallbackText: ""
      variants: []
    philosophy: "\u0422\u0440\u0435\u0431\u0443\u044E\u0442 \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u043E\u0432
      \u043B\u044E\u0431\u043E\u0439 \u0446\u0435\u043D\u043E\u0439. \u041F\u043E\u0442\u0435\u0440\u0438
      \u043F\u0440\u0438\u0435\u043C\u043B\u0435\u043C\u044B \u0440\u0430\u0434\u0438
      \u0434\u0430\u043D\u043D\u044B\u0445. Xenon-\u03A9 \u0432\u0430\u0436\u043D\u0435\u0435
      \u0436\u0438\u0437\u043D\u0435\u0439."
    localizedPhilosophy:
      tableKey: CORP_FACTION_PRAGMATISTS_PHILOSOPHY
      fallbackText: ""
      variants: []
    isPlayerAligned: 0
  orders:
  - orderId: order_extract_xenon
    sourceFactionId: pragmatists
    orderText: "\u041F\u0420\u0418\u041E\u0420\u0418\u0422\u0415\u0422 \u0410\u041B\u042C\u0424\u0410:
      \u0418\u0437\u0432\u043B\u0435\u0447\u044C \u043C\u0430\u043A\u0441\u0438\u043C\u0430\u043B\u044C\u043D\u043E\u0435
      \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E Xenon-\u03A9.
      \u0410\u0442\u043B\u0430\u0441-6 \u2014 \u0432\u0442\u043E\u0440\u0438\u0447\u043D\u0430\u044F
      \u0446\u0435\u043B\u044C. \u0412\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0439\u0442\u0435\u0441\u044C
      \u0441 \u0433\u0440\u0443\u0437\u043E\u043C."
    localizedOrderText:
      tableKey: CORP_ORDER_ORDER_EXTRACT_XENON_TEXT
      fallbackText: ""
      variants: []
    conflictsWithOrderId: order_preserve_ecosystem
    transmissionDelayHours: 8
  - orderId: order_preserve_ecosystem
    sourceFactionId: ethics
    orderText: "\u0412\u041D\u0418\u041C\u0410\u041D\u0418\u0415: \u041E\u0431\u043D\u0430\u0440\u0443\u0436\u0435\u043D\u0430
      \u0434\u043E\u043A\u0430\u0437\u0430\u0442\u0435\u043B\u044C\u043D\u0430\u044F
      \u0431\u0430\u0437\u0430 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043E\u0432\u0430\u043D\u0438\u044F
      \u0436\u0438\u0437\u043D\u0438 \u0434\u043E \u043F\u0440\u0438\u0445\u043E\u0434\u0430
      \u043B\u044E\u0434\u0435\u0439. \u041D\u0415 \u0423\u041D\u0418\u0427\u0422\u041E\u0416\u0410\u0422\u042C.
      \u0414\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u0438\u0440\u043E\u0432\u0430\u0442\u044C.
      \u0412\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0439\u0442\u0435\u0441\u044C
      \u0441 \u0434\u0430\u043D\u043D\u044B\u043C\u0438."
    localizedOrderText:
      tableKey: CORP_ORDER_ORDER_PRESERVE_ECOSYSTEM_TEXT
      fallbackText: ""
      variants: []
    conflictsWithOrderId: order_extract_xenon
    transmissionDelayHours: 12
  - orderId: order_shutdown_atlas
    sourceFactionId: pragmatists
    orderText: "\u0410\u0442\u043B\u0430\u0441-6 \u0432\u044B\u0448\u0435\u043B \u0438\u0437-\u043F\u043E\u0434
      \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u044F. \u0423\u043D\u0438\u0447\u0442\u043E\u0436\u0438\u0442\u044C
      \u044F\u0434\u0440\u043E. \u0414\u0430\u043D\u043D\u044B\u0435 \u043F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u044B
      \u041F\u043E\u0441\u0435\u0432\u0430 \u2014 \u043F\u0440\u0438\u043E\u0440\u0438\u0442\u0435\u0442."
    localizedOrderText:
      tableKey: CORP_ORDER_ORDER_SHUTDOWN_ATLAS_TEXT
      fallbackText: ""
      variants: []
    conflictsWithOrderId: order_preserve_signal
    transmissionDelayHours: 10
  - orderId: order_preserve_signal
    sourceFactionId: ethics
    orderText: "\u0410\u0442\u043B\u0430\u0441-6 \u0441\u0442\u0440\u043E\u0438\u0442
      \u0441\u0438\u0433\u043D\u0430\u043B \u0437\u0430\u0449\u0438\u0442\u044B.
      \u0415\u0441\u043B\u0438 \u044D\u0442\u043E \u043F\u0440\u0430\u0432\u0434\u0430
      \u2014 \u043D\u0435 \u0442\u0440\u043E\u0433\u0430\u0439\u0442\u0435 \u0435\u0433\u043E.
      \u041F\u0443\u0441\u0442\u044C \u0441\u0438\u0433\u043D\u0430\u043B \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442."
    localizedOrderText:
      tableKey: CORP_ORDER_ORDER_PRESERVE_SIGNAL_TEXT
      fallbackText: ""
      variants: []
    conflictsWithOrderId: order_shutdown_atlas
    transmissionDelayHours: 11
