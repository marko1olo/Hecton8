  playerBriefing: "\u0412\u044B \u2014 \u0438\u043D\u0436\u0435\u043D\u0435\u0440-\u043C\u0430\u0440\u043E\u0434\u0451\u0440.
    \u041C\u0438\u043D\u0438\u043C\u0430\u043B\u044C\u043D\u043E\u0435 \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0435\u043D\u0438\u0435.
    \u041E\u0434\u0438\u043D\u043E\u0447\u043D\u0430\u044F \u043C\u0438\u0441\u0441\u0438\u044F.
    \u041A\u043E\u0440\u043F\u043E\u0440\u0430\u0446\u0438\u044F \u0433\u043E\u0442\u043E\u0432\u0430
    \u043F\u043E\u0442\u0435\u0440\u044F\u0442\u044C 100 \u0441\u043A\u0430\u0432\u0435\u043D\u0434\u0436\u0435\u0440\u043E\u0432
    \u0440\u0430\u0434\u0438 1 \u043A\u0433 Xenon-\u03A9. \u0412\u044B \u043D\u0435
    \u0437\u043D\u0430\u0435\u0442\u0435 \u043F\u043E\u043B\u043D\u043E\u0439 \u0441\u0442\u043E\u0438\u043C\u043E\u0441\u0442\u0438
    \u0442\u043E\u0433\u043E, \u0447\u0442\u043E \u0441\u043E\u0431\u0438\u0440\u0430\u0435\u0442\u0435."
