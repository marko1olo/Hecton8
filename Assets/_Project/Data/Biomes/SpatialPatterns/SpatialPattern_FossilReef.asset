  m_Script: {fileID: 11500000, guid: dc939c2780ff26e4393c1c2ddcaca98c, type: 3}
  m_Name: SpatialPattern_FossilReef
  m_EditorClassIdentifier: Assembly-CSharp:Hecton8.Environment:HectonBiomeSpatialPatternProfile
  profileId: biome.spatial_pattern.fossil_reef
  profileLabel: Fossil Carbonate Shelf Spatial Pattern
  resourcePocketPattern: Organic pickups sit in holes, ribs, alcoves, and carbonate windows
    rather than in open space.
  nodeClusterPattern: Node clusters appear in semi-hidden chambers or at carbonate roots,
    rewarding controlled detours.
  safePocketPattern: Reorientation pockets exist behind fossil ribs and inside porous side chambers,
    but can turn into ambush pockets.
  routeAnchorPattern: Routes are remembered by unusual carbonate silhouettes and repeated
    porous gate shapes.
  rareObjectivePattern: Rare finds are tucked into pressure-shadowed interior spaces
    that look valuable before they look safe.
  explorationLoop: Circle the crown, slip through one opening, harvest a chamber,
    then escape back into a known silhouette line.
  spatialRead: Dense and memorable, but layered. It should read as reward first
    and trap second.
  playerMemoryHook: Remember the place by one crown shape and one distinctive pressure-shadow
    opening.
