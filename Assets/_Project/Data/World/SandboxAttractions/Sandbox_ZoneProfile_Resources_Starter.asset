  m_Script: {fileID: 11500000, guid: 63322aac130c2184297b699cb40fcd7a, type: 3}
  m_Name: Sandbox_ZoneProfile_Resources_Starter
  m_EditorClassIdentifier: Assembly-CSharp::Hecton8.World.WorldSandboxAttractionProfile
  profileId: sandbox.profile.resources.starter
  profileLabel: Resources Starter Sandbox
  entryRead: "\u0421\u0438\u043B\u044C\u043D\u044B\u0439 \u043E\u0440\u0438\u0435\u043D\u0442\u0438\u0440
    \u043F\u0440\u043E\u0441\u0442\u043E \u0433\u043E\u0432\u043E\u0440\u0438\u0442:
    \u044D\u0442\u0443 \u0432\u043E\u0434\u0443 \u0441\u0442\u043E\u0438\u0442 \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u0442\u044C."
  ambientValue: "\u0411\u0430\u0437\u043E\u0432\u0430\u044F \u0446\u0435\u043D\u043D\u043E\u0441\u0442\u044C
    \u043B\u0435\u0436\u0438\u0442 \u0448\u0438\u0440\u043E\u043A\u043E \u0438 \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u0442
    \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u044B\u0435 \u043A\u043E\u0440\u043E\u0442\u043A\u0438\u0435
    \u043A\u0440\u0443\u0433\u0438."
  detourValue: "\u041F\u043E\u0431\u043E\u0447\u043D\u044B\u0435 pockets \u0438 \u0443\u0437\u043B\u044B
    \u0441\u0438\u0434\u044F\u0442 \u0447\u0443\u0442\u044C \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0435
    \u0438 \u043D\u0430\u0433\u0440\u0430\u0436\u0434\u0430\u044E\u0442 \u043B\u044E\u0431\u043E\u043F\u044B\u0442\u0441\u0442\u0432\u043E."
  shelterRead: "\u0421\u043F\u043E\u043A\u043E\u0439\u043D\u044B\u0439 \u043A\u0430\u0440\u043C\u0430\u043D
    \u0434\u0430\u0451\u0442 \u0432\u044B\u0434\u043E\u0445 \u0438 \u043F\u043E\u043C\u043E\u0433\u0430\u0435\u0442
    \u0437\u0430\u043D\u043E\u0432\u043E \u043F\u0440\u043E\u0447\u0438\u0442\u0430\u0442\u044C
    \u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0441\u0442\u0432\u043E."
  pressureRead: "\u0413\u043B\u0443\u0431\u0436\u0435 \u0432\u043E\u0434\u0430 \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0442
    \u0447\u0435\u0441\u0442\u043D\u043E \u0434\u0430\u0432\u0438\u0442\u044C, \u043D\u043E
    \u043D\u0435 \u0437\u0430\u043F\u0438\u0440\u0430\u0435\u0442 \u0438\u0433\u0440\u043E\u043A\u0430."
  deepLure: "\u0427\u0443\u0442\u044C \u0434\u0430\u043B\u044C\u0448\u0435 \u0440\u0443\u0442\u0438\u043D\u044B
    \u043B\u0435\u0436\u0438\u0442 \u0431\u043E\u043B\u0435\u0435 \u0440\u0435\u0434\u043A\u0430\u044F
    \u043F\u0440\u0438\u0447\u0438\u043D\u0430 \u0440\u0438\u0441\u043A\u043D\u0443\u0442\u044C."
  storyLure: "\u0421\u0440\u0435\u0434\u0430 \u043D\u0430\u043C\u0435\u043A\u0430\u0435\u0442,
    \u0447\u0442\u043E \u0433\u043B\u0443\u0431\u0436\u0435 \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0442\u0441\u044F
    \u0447\u0442\u043E-\u0442\u043E \u0431\u043E\u043B\u0435\u0435 \u0432\u0430\u0436\u043D\u043E\u0435,
    \u0447\u0435\u043C \u043F\u0440\u043E\u0441\u0442\u043E\u0439 \u0444\u0430\u0440\u043C."
  returnValue: "\u041F\u043E\u0441\u043B\u0435 \u043F\u0435\u0440\u0432\u043E\u0433\u043E
    \u0437\u043D\u0430\u043A\u043E\u043C\u0441\u0442\u0432\u0430 \u0441\u044E\u0434\u0430
    \u0432\u044B\u0433\u043E\u0434\u043D\u043E \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0442\u044C\u0441\u044F
    \u0443\u0436\u0435 \u0443\u043C\u043D\u0435\u0435."
  freedomRule: "\u0418\u0433\u0440\u043E\u043A \u0432\u043E\u043B\u0435\u043D \u043A\u0440\u0443\u0436\u0438\u0442\u044C,
    \u0431\u0440\u0430\u0442\u044C \u043C\u0430\u043B\u044B\u0435 \u043A\u0440\u0443\u0433\u0438,
    \u0443\u0445\u043E\u0434\u0438\u0442\u044C \u0440\u0430\u043D\u044C\u0448\u0435
    \u0438\u043B\u0438 \u043D\u044B\u0440\u044F\u0442\u044C \u0433\u043B\u0443\u0431\u0436\u0435
    \u043F\u043E \u0441\u0432\u043E\u0435\u043C\u0443 \u0436\u0435\u043B\u0430\u043D\u0438\u044E."
  curiosityRule: "\u041B\u044E\u0431\u043E\u0439 \u0431\u043E\u043A\u043E\u0432\u043E\u0439
    \u0437\u0430\u0445\u043E\u0434 \u0434\u043E\u043B\u0436\u0435\u043D \u0434\u0430\u0432\u0430\u0442\u044C
    \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u0439, \u043D\u043E \u0432\u043D\u044F\u0442\u043D\u044B\u0439
    \u0441\u043C\u044B\u0441\u043B."
  crosslinkRule: "\u0421\u043E\u0441\u0435\u0434\u043D\u0438\u0435 pockets \u0434\u043E\u043B\u0436\u043D\u044B
    \u043F\u0435\u0440\u0435\u0441\u0435\u043A\u0430\u0442\u044C\u0441\u044F \u0442\u0430\u043A,
    \u0447\u0442\u043E\u0431\u044B \u0438\u0433\u0440\u043E\u043A \u0441\u0442\u0440\u043E\u0438\u043B
    \u043C\u0430\u0440\u0448\u0440\u0443\u0442 \u0432 \u0433\u043E\u043B\u043E\u0432\u0435
    \u0441\u0430\u043C."
  reentryRule: "\u041F\u043E\u0441\u043B\u0435 \u043F\u0435\u0440\u0432\u043E\u0433\u043E
    \u0437\u043D\u0430\u043A\u043E\u043C\u0441\u0442\u0432\u0430 \u043F\u043E\u0432\u0442\u043E\u0440\u043D\u044B\u0439
    \u0437\u0430\u0445\u043E\u0434 \u0434\u043E\u043B\u0436\u0435\u043D \u043E\u0449\u0443\u0449\u0430\u0442\u044C\u0441\u044F
    \u043F\u0440\u043E\u0449\u0435 \u0438 \u0431\u044B\u0441\u0442\u0440\u0435\u0435."
  masteryRule: "\u041C\u0430\u0441\u0442\u0435\u0440\u0441\u0442\u0432\u043E \u0437\u0434\u0435\u0441\u044C
    \u2014 \u0437\u043D\u0430\u0442\u044C \u043A\u043E\u0440\u043E\u0442\u043A\u0438\u0435
    \u0440\u0435\u0441\u0443\u0440\u0441\u043E\u0451\u043C\u043A\u0438\u0435 \u043A\u0440\u0443\u0433\u0438
    \u0431\u0435\u0437 \u043B\u0438\u0448\u043D\u0435\u0433\u043E \u0431\u043B\u0443\u0436\u0434\u0430\u043D\u0438\u044F."
  playerPromise: "\u041F\u043E\u043D\u044F\u0442\u043D\u0430\u044F \u0441\u0442\u0430\u0440\u0442\u043E\u0432\u0430\u044F
    \u0432\u043E\u0434\u0430 \u0441 \u0447\u0435\u0441\u0442\u043D\u044B\u043C \u0444\u0430\u0440\u043C\u043E\u043C
    \u0438 \u043C\u044F\u0433\u043A\u0438\u043C \u043D\u0430\u043C\u0451\u043A\u043E\u043C
    \u043D\u0430 \u0433\u043B\u0443\u0431\u0438\u043D\u0443."
  memoryRule: "\u041F\u0430\u043C\u044F\u0442\u044C \u0434\u0435\u0440\u0436\u0438\u0442\u0441\u044F
    \u043D\u0430 \u0430\u0440\u043A\u0430\u0445, \u0441\u0442\u0443\u043F\u0435\u043D\u044F\u0445,
    \u043F\u044F\u0442\u043D\u0430\u0445 \u0441\u0432\u0435\u0442\u0430 \u0438 \u043E\u0434\u043D\u043E\u043C
    \u0445\u043E\u0440\u043E\u0448\u0435\u043C \u043E\u0440\u0438\u0435\u043D\u0442\u0438\u0440\u0435."
  dangerRule: "\u041E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u044C \u0440\u0430\u0441\u0442\u0451\u0442
    \u043F\u043E \u043C\u0435\u0440\u0435 \u0443\u0434\u0430\u043B\u0435\u043D\u0438\u044F
    \u043E\u0442 \u0447\u0438\u0442\u0430\u0435\u043C\u043E\u0439 \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u0439
    \u0432\u043E\u0434\u044B."
