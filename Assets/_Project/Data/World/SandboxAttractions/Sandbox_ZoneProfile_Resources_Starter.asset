  m_Script: {fileID: 11500000, guid: 63322aac130c2184297b699cb40fcd7a, type: 3}
  m_Name: Sandbox_ZoneProfile_Resources_Starter
  m_EditorClassIdentifier: Assembly-CSharp::Hecton8.World.WorldSandboxAttractionProfile
  profileId: sandbox.profile.resources.starter
  profileLabel: Resources Starter Sandbox
  entryRead: 'Silnyy orientir prosto govorit: etu vodu stoit proverit.'
  ambientValue: Bazovaya tsennost lezhit shiroko i podderzhivaet svobodnye korotkie
    krugi.
  detourValue: Pobochnye pockets i uzly sidyat chut v storone i nagrazhdayut lyubopytstvo.
  shelterRead: Spokoynyy karman daet vydoh i pomogaet zanovo prochitat prostranstvo.
  pressureRead: Glubzhe voda nachinaet chestno davit, no ne zapiraet igroka.
  deepLure: Chut dalshe rutiny lezhit bolee redkaya prichina risknut.
  storyLure: Sreda namekaet, chto glubzhe nachinaetsya chto-to bolee vazhnoe, chem
    prostoy farm.
  returnValue: Posle pervogo znakomstva syuda vygodno vozvraschatsya uzhe umnee.
  freedomRule: Igrok volen kruzhit, brat malye krugi, uhodit ranshe ili nyryat glubzhe
    po svoemu zhelaniyu.
  curiosityRule: Lyuboy bokovoy zahod dolzhen davat malenkiy, no vnyatnyy smysl.
  crosslinkRule: Sosednie pockets dolzhny peresekatsya tak, chtoby igrok stroil marshrut
    v golove sam.
  reentryRule: Posle pervogo znakomstva povtornyy zahod dolzhen oschuschatsya prosche
    i bystree.
  masteryRule: "Masterstvo zdes \u2014 znat korotkie resursoemkie krugi bez lishnego
    bluzhdaniya."
  playerPromise: Ponyatnaya startovaya voda s chestnym farmom i myagkim namekom na
    glubinu.
  memoryRule: Pamyat derzhitsya na arkah, stupenyah, pyatnah sveta i odnom horoshem
    orientire.
  dangerRule: Opasnost rastet po mere udaleniya ot chitaemoy vody i route anchor.
