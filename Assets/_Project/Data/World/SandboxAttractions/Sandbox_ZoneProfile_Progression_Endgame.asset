  m_Script: {fileID: 11500000, guid: 63322aac130c2184297b699cb40fcd7a, type: 3}
  m_Name: Sandbox_ZoneProfile_Progression_Endgame
  m_EditorClassIdentifier: Assembly-CSharp::Hecton8.World.WorldSandboxAttractionProfile
  profileId: sandbox.profile.progression.endgame
  profileLabel: Progression Endgame Sandbox
  entryRead: 'Posledniy nadezhnyy orientir govorit: dalshe voda uzhe sereznee.'
  ambientValue: Obychnoy tsennosti malo, i dazhe melkie nahodki namekayut na dorogoy
    glubokiy smysl.
  detourValue: Bokovye karmany dayut signaly o glubokoy tseli, no ne vedut igroka
    za ruku.
  shelterRead: Redkiy spokoynyy karman nuzhen, chtoby reshitsya na novyy push, a
    ne rasslabitsya.
  pressureRead: Risk narastaet stupenyami i zaranee chitaetsya po srede.
  deepLure: Glubzhe manit dorogaya late-game nahodka, radi kotoroy i zatevaetsya
    zahod.
  storyLure: Sreda obeschaet istoriyu, taynu i oschuschenie po-nastoyaschemu vazhnogo
    mesta.
  returnValue: 'Dazhe othod ostavlyaet tsennost: pamyat, orientiry, redkuyu dobychu
    i novyy plan.'
  freedomRule: Igrok mozhet ne brat late-game tsel srazu i vernutsya pozzhe s drugim
    planom.
  curiosityRule: Pobochnye zahody dolzhny podkarmlivat lyubopytstvo, a ne lomat svobodu.
  crosslinkRule: Sosednie pockets i anchors dolzhny pozvolyat stroit svoy glubokiy
    marshrut.
  reentryRule: 'Dazhe otstuplenie dolzhno ostavlyat polzu: pamyat, orientiry, redkuyu
    dobychu.'
  masteryRule: "Masterstvo \u2014 sobirat svoy derzkiy marshrut iz neskolkih klyuchevyh
    anchor'ov."
  playerPromise: Glubokaya ekspeditsiya s redkoy tsennostyu, silnoy pamyatyu mesta
    i chestnym riskom.
  memoryRule: Pamyat derzhitsya na poslednem anchor, redkoy peredyshke i silnom preduprezhdenii
    o riske.
  dangerRule: 'Risk narastaet stupenyami: redkaya peredyshka, rezkiy rost davleniya,
    zatem dorogoy push.'
