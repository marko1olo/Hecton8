  m_Name: Sandbox_ZoneProfile_Power_Mid
  m_EditorClassIdentifier: Assembly-CSharp::Hecton8.World.WorldSandboxAttractionProfile
  profileId: sandbox.profile.power.mid
  profileLabel: Power Mid Sandbox
  entryRead: "\u0412\u0438\u0434\u0438\u043C\u044B\u0439 \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A
    \u0438\u043B\u0438 relay-\u043B\u0438\u043D\u0438\u044F \u0441\u0440\u0430\u0437\u0443
    \u0446\u0435\u043F\u043B\u044F\u044E\u0442 \u0432\u0437\u0433\u043B\u044F\u0434."
  ambientValue: "\u041E\u0431\u044B\u0447\u043D\u0430\u044F \u0446\u0435\u043D\u043D\u043E\u0441\u0442\u044C
    \u0441\u0438\u0434\u0438\u0442 \u043D\u0430 \u0447\u0438\u0442\u0430\u0435\u043C\u043E\u0439
    \u0441\u0432\u044F\u0437\u043A\u0435 \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A
    -> \u043F\u0435\u0440\u0435\u0434\u0430\u0447\u0430 -> \u043D\u0430\u0433\u0440\u0443\u0437\u043A\u0430."
  detourValue: "\u0411\u043E\u043A\u043E\u0432\u044B\u0435 power \u0438 service pockets
    \u043F\u043E\u043C\u043E\u0433\u0430\u044E\u0442 \u043F\u043E\u043D\u044F\u0442\u044C
    \u0441\u0438\u0441\u0442\u0435\u043C\u0443 \u0433\u043B\u0443\u0431\u0436\u0435."
  shelterRead: "\u041F\u0435\u0440\u0435\u0434\u044B\u0448\u043A\u0430 \u0442\u0443\u0442
    \u2014 \u044D\u0442\u043E \u044F\u0441\u043D\u043E\u0441\u0442\u044C \u0441\u0445\u0435\u043C\u044B,
    \u0430 \u043D\u0435 \u043F\u043E\u043B\u043D\u0430\u044F \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u044C."
  pressureRead: "\u0420\u0430\u0437\u0440\u044B\u0432 \u043B\u0438\u043D\u0438\u0438
    \u0438 \u043F\u043B\u043E\u0445\u0430\u044F \u0432\u043E\u0434\u0430 \u043E\u0442\u043C\u0435\u0447\u0430\u044E\u0442
    \u0443\u0447\u0430\u0441\u0442\u043E\u043A \u0441 \u0431\u043E\u043B\u0435\u0435
    \u0432\u044B\u0441\u043E\u043A\u0438\u043C \u0440\u0438\u0441\u043A\u043E\u043C."
  deepLure: "\u0414\u0430\u043B\u044C\u0448\u0435 \u043C\u0430\u043D\u0438\u0442
    \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u0435
    \u0432\u0430\u0436\u043D\u043E\u0439 \u043B\u0438\u043D\u0438\u0438 \u0438\u043B\u0438
    \u0434\u043E\u0441\u0442\u0443\u043F \u043A \u0431\u043E\u043B\u0435\u0435 \u0441\u0438\u043B\u044C\u043D\u043E\u0439
    \u0442\u043E\u0447\u043A\u0435 \u043F\u0438\u0442\u0430\u043D\u0438\u044F."
  storyLure: "\u042D\u043D\u0435\u0440\u0433\u0435\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439
    \u043A\u043E\u043D\u0442\u0443\u0440 \u043D\u0430\u043C\u0435\u043A\u0430\u0435\u0442,
    \u043A\u0430\u043A \u0436\u0438\u043B\u0430 \u0438\u043B\u0438 \u043B\u043E\u043C\u0430\u043B\u0430\u0441\u044C
    \u044D\u0442\u0430 \u0438\u043D\u0444\u0440\u0430\u0441\u0442\u0440\u0443\u043A\u0442\u0443\u0440\u0430."
  returnValue: "\u041F\u043E\u0432\u0442\u043E\u0440\u043D\u044B\u0439 \u0437\u0430\u0445\u043E\u0434
    \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F \u0432\u044B\u0433\u043E\u0434\u043D\u0435\u0435,
    \u043A\u043E\u0433\u0434\u0430 \u0438\u0433\u0440\u043E\u043A \u0443\u0436\u0435
    \u0432\u0438\u0434\u0438\u0442 \u0441\u0445\u0435\u043C\u0443 \u0446\u0435\u043B\u0438\u043A\u043E\u043C."
  freedomRule: "\u0418\u0433\u0440\u043E\u043A \u043D\u0435 \u043E\u0431\u044F\u0437\u0430\u043D
    \u0447\u0438\u043D\u0438\u0442\u044C \u0432\u0435\u0441\u044C power-\u043A\u043E\u043D\u0442\u0443\u0440
    \u0437\u0430 \u043E\u0434\u0438\u043D \u0437\u0430\u0445\u043E\u0434."
  curiosityRule: "\u0427\u0430\u0441\u0442\u0438 \u043B\u0438\u043D\u0438\u0438 \u0434\u043E\u043B\u0436\u043D\u044B
    \u0431\u044B\u0442\u044C \u043F\u043E\u043B\u0435\u0437\u043D\u044B \u0434\u0430\u0436\u0435
    \u043F\u043E \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u0438."
  crosslinkRule: "\u0420\u0435\u043B\u0435\u0439\u043D\u044B\u0435 \u0442\u043E\u0447\u043A\u0438
    \u0434\u043E\u043B\u0436\u043D\u044B \u0441\u0432\u044F\u0437\u044B\u0432\u0430\u0442\u044C
    \u0441\u043E\u0441\u0435\u0434\u043D\u0438\u0435 pockets \u0438 \u043C\u0430\u0440\u0448\u0440\u0443\u0442\u044B."
  reentryRule: "\u041F\u043E\u0432\u0442\u043E\u0440\u043D\u044B\u0439 \u0437\u0430\u0445\u043E\u0434
    \u0434\u043E\u043B\u0436\u0435\u043D \u0431\u044B\u0442\u044C \u043A\u043E\u0440\u043E\u0447\u0435
    \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u044F \u043F\u043E\u043D\u0438\u043C\u0430\u043D\u0438\u044E
    \u0432\u0441\u0435\u0439 \u043B\u0438\u043D\u0438\u0438."
  masteryRule: "\u041C\u0430\u0441\u0442\u0435\u0440\u0441\u0442\u0432\u043E \u2014
    \u0432\u0438\u0434\u0435\u0442\u044C \u0441\u0445\u0435\u043C\u0443 \u0446\u0435\u043B\u0438\u043A\u043E\u043C
    \u0438 \u0440\u0435\u0437\u0430\u0442\u044C \u043F\u0443\u0442\u044C \u043A \u043D\u0443\u0436\u043D\u043E\u0439
    \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u0435."
  playerPromise: "\u0422\u0435\u0445\u043D\u0438\u0447\u0435\u0441\u043A\u0430\u044F
    \u0437\u043E\u043D\u0430, \u0433\u0434\u0435 \u0441\u0438\u0441\u0442\u0435\u043C\u0430
    \u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044F \u043A\u0430\u043A \u0441\u0438\u0441\u0442\u0435\u043C\u0430,
    \u0430 \u043D\u0435 \u043A\u0430\u043A \u0448\u0443\u043C \u0438\u0437 \u043E\u0431\u044A\u0435\u043A\u0442\u043E\u0432."
  memoryRule: "\u041F\u0430\u043C\u044F\u0442\u044C \u0434\u0435\u0440\u0436\u0438\u0442\u0441\u044F
    \u043D\u0430 \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A\u0435, relay-\u0446\u0435\u043F\u043E\u0447\u043A\u0435
    \u0438 \u043E\u0434\u043D\u043E\u0439 \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u043D\u043E\u0439
    \u0442\u043E\u0447\u043A\u0435."
  dangerRule: "\u0414\u0430\u0432\u043B\u0435\u043D\u0438\u0435 \u0440\u0430\u0441\u0442\u0451\u0442
    \u0442\u0430\u043C, \u0433\u0434\u0435 \u043B\u0438\u043D\u0438\u044F \u0443\u0445\u043E\u0434\u0438\u0442
    \u0432 \u0442\u044F\u0436\u0451\u043B\u0443\u044E \u0432\u043E\u0434\u0443 \u0438\u043B\u0438
    \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0442 \u043B\u043E\u043C\u0430\u0442\u044C\u0441\u044F."
