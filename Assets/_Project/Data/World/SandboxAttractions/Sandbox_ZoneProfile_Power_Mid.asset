  m_Script: {fileID: 11500000, guid: 63322aac130c2184297b699cb40fcd7a, type: 3}
  m_Name: Sandbox_ZoneProfile_Power_Mid
  m_EditorClassIdentifier: Assembly-CSharp::Hecton8.World.WorldSandboxAttractionProfile
  profileId: sandbox.profile.power.mid
  profileLabel: Power Mid Sandbox
  entryRead: Vidimyy istochnik ili relay-liniya srazu tseplyayut vzglyad.
  ambientValue: Obychnaya tsennost sidit na chitaemoy svyazke istochnik -> peredacha
    -> nagruzka.
  detourValue: Bokovye power i service pockets pomogayut ponyat sistemu glubzhe.
  shelterRead: "Peredyshka tut \u2014 eto yasnost shemy, a ne polnaya bezopasnost."
  pressureRead: Razryv linii i plohaya voda otmechayut uchastok s bolee vysokim riskom.
  deepLure: Dalshe manit vosstanovlenie vazhnoy linii ili dostup k bolee silnoy tochke
    pitaniya.
  storyLure: Energeticheskiy kontur namekaet, kak zhila ili lomalas eta infrastruktura.
  returnValue: Povtornyy zahod stanovitsya vygodnee, kogda igrok uzhe vidit shemu
    tselikom.
  freedomRule: Igrok ne obyazan chinit ves power-kontur za odin zahod.
  curiosityRule: Chasti linii dolzhny byt polezny dazhe po otdelnosti.
  crosslinkRule: Releynye tochki dolzhny svyazyvat sosednie pockets i marshruty.
  reentryRule: Povtornyy zahod dolzhen byt koroche blagodarya ponimaniyu vsey linii.
  masteryRule: "Masterstvo \u2014 videt shemu tselikom i rezat put k nuzhnoy probleme."
  playerPromise: Tehnicheskaya zona, gde sistema chitaetsya kak sistema, a ne kak
    shum iz obektov.
  memoryRule: Pamyat derzhitsya na istochnike, relay-tsepochke i odnoy problemnoy
    tochke.
  dangerRule: Davlenie rastet tam, gde liniya uhodit v tyazheluyu vodu ili nachinaet
    lomatsya.
