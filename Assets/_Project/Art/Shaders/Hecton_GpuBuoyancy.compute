#pragma kernel EvaluateBuoyancy

#define HECTON_THREADS_PER_GROUP 64

struct GpuBuoyancyObjectData
{
    float Volume;
    float Height;
    float IsInAir;
    float SimplifiedSubmersion;
    float3 BoundsCenterWS;
    float BoundsPadding0;
    float3 BoundsExtentsWS;
    float BoundsPadding1;
};

StructuredBuffer<float3> _GpuBuoyancyPositions;
StructuredBuffer<GpuBuoyancyObjectData> _GpuBuoyancyObjectData;
RWStructuredBuffer<float4> _GpuBuoyancyResults;

int _GpuBuoyancyObjectCount;
float4 _GpuBuoyancyWaterParams;
float4 _GpuBuoyancyWave0A;
float4 _GpuBuoyancyWave0B;
float4 _GpuBuoyancyWave1A;
float4 _GpuBuoyancyWave1B;
float4 _GpuBuoyancyWave2A;
float4 _GpuBuoyancyWave2B;

static const float TwoPi = 6.28318530718;
static const float CinematicPhaseSpeedBase = 0.85;
static const float CinematicPhaseSpeedPerMeter = 0.23;

float FastTriangleSigned(float phase)
{
    float triangle01 = 1.0 - abs(frac(phase * 0.15915494 + 0.25) * 2.0 - 1.0);
    return triangle01 * 2.0 - 1.0;
}

float2 DominantAxisOrDefault(float2 value, float2 fallback)
{
    float2 absValue = abs(value);
    float maxComponent = max(absValue.x, absValue.y);
    if (maxComponent <= 0.000001)
        return fallback;

    return absValue.x >= absValue.y
        ? float2(value.x >= 0.0 ? 1.0 : -1.0, 0.0)
        : float2(0.0, value.y >= 0.0 ? 1.0 : -1.0);
}

float3 ComputeWaveDisplacement(float2 worldXZ, float4 waveA, float4 waveB, float timeSeconds)
{
    float amplitude = waveA.z;
    float wavelength = waveA.w;
    if (amplitude <= 0.0 || wavelength <= 0.01)
        return 0.0.xxx;

    float2 direction = DominantAxisOrDefault(waveA.xy, float2(1.0, 0.0));
    float waveNumber = TwoPi * rcp(max(0.01, wavelength));
    float phaseVelocity = (CinematicPhaseSpeedBase + wavelength * CinematicPhaseSpeedPerMeter) * max(0.01, waveB.z);
    float phase = waveNumber * dot(direction, worldXZ) - phaseVelocity * waveNumber * timeSeconds + waveB.y;
    float sinPhase = FastTriangleSigned(phase);
    float cosPhase = FastTriangleSigned(phase + 1.5707964);
    float horizontalDisplacement = waveB.x * amplitude;

    return float3(
        -direction.x * horizontalDisplacement * sinPhase,
        amplitude * cosPhase,
        -direction.y * horizontalDisplacement * sinPhase);
}

float3 ComputeTotalDisplacement(float2 worldXZ, float timeSeconds)
{
    float3 displacement = 0.0.xxx;
    displacement += ComputeWaveDisplacement(worldXZ, _GpuBuoyancyWave0A, _GpuBuoyancyWave0B, timeSeconds);
    displacement += ComputeWaveDisplacement(worldXZ, _GpuBuoyancyWave1A, _GpuBuoyancyWave1B, timeSeconds);
    displacement += ComputeWaveDisplacement(worldXZ, _GpuBuoyancyWave2A, _GpuBuoyancyWave2B, timeSeconds);
    return displacement;
}

float SampleWaveHeight(float2 worldXZ, float timeSeconds)
{
    float3 displacement = ComputeTotalDisplacement(worldXZ, timeSeconds);
    return displacement.y;
}

float SampleObjectWaveHeight(float3 positionWS, GpuBuoyancyObjectData objectData, float timeSeconds)
{
    bool centerFinite = all(abs(objectData.BoundsCenterWS) < float3(1.0e20, 1.0e20, 1.0e20));
    float2 centerXZ = centerFinite
        ? objectData.BoundsCenterWS.xz
        : positionWS.xz;
    return SampleWaveHeight(centerXZ, timeSeconds);
}

[numthreads(HECTON_THREADS_PER_GROUP, 1, 1)]
void EvaluateBuoyancy(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint instanceIndex = dispatchThreadId.x;
    if (instanceIndex >= (uint)_GpuBuoyancyObjectCount)
        return;

    float3 positionWS = _GpuBuoyancyPositions[instanceIndex];
    GpuBuoyancyObjectData objectData = _GpuBuoyancyObjectData[instanceIndex];
    if (objectData.IsInAir > 0.5)
    {
        _GpuBuoyancyResults[instanceIndex] = 0.0.xxxx;
        return;
    }

    float timeSeconds = _GpuBuoyancyWaterParams.w;
    float baseDepth = _GpuBuoyancyWaterParams.x - positionWS.y;
    float maxWaveEnvelope = abs(_GpuBuoyancyWave0A.z) + abs(_GpuBuoyancyWave1A.z) + abs(_GpuBuoyancyWave2A.z);
    if (baseDepth > max(objectData.Height, 0.01) + maxWaveEnvelope + 0.5)
    {
        float buoyancyForceY = _GpuBuoyancyWaterParams.y * objectData.Volume * _GpuBuoyancyWaterParams.z;
        _GpuBuoyancyResults[instanceIndex] = float4(0.0, buoyancyForceY, 0.0, 0.0);
        return;
    }

    float waveOffset = SampleObjectWaveHeight(positionWS, objectData, timeSeconds);
    float depthBelowSurface = _GpuBuoyancyWaterParams.x + waveOffset - positionWS.y;
    if (depthBelowSurface <= 0.0)
    {
        _GpuBuoyancyResults[instanceIndex] = float4(waveOffset, 0.0, 0.0, 0.0);
        return;
    }

    float submersion = objectData.SimplifiedSubmersion > 0.5
        ? 1.0
        : saturate(depthBelowSurface * rcp(max(objectData.Height, 0.01)));
    float buoyancyForceY = _GpuBuoyancyWaterParams.y * (objectData.Volume * submersion) * _GpuBuoyancyWaterParams.z;
    _GpuBuoyancyResults[instanceIndex] = float4(waveOffset, buoyancyForceY, 0.0, 0.0);
}
