#pragma kernel BuildVolumetricFogGrid DISABLE_TEXTURE2D_X_ARRAY
#pragma kernel RaymarchVolumetricFog DISABLE_TEXTURE2D_X_ARRAY
#pragma kernel RaymarchVolumetricFogXR
#pragma target 5.0

#include "Packages/com.unity.render-pipelines.core/ShaderLibrary/Common.hlsl"
#include "Packages/com.unity.render-pipelines.core/ShaderLibrary/UnityInstancing.hlsl"
#include "Packages/com.unity.render-pipelines.universal/ShaderLibrary/Core.hlsl"

#ifndef RW_TEXTURE2D_X
    #if defined(UNITY_STEREO_INSTANCING_ENABLED) || defined(UNITY_STEREO_MULTIVIEW_ENABLED)
        #define RW_TEXTURE2D_X(type, textureName) RW_TEXTURE2D_ARRAY(type, textureName)
    #else
        #define RW_TEXTURE2D_X(type, textureName) RW_TEXTURE2D(type, textureName)
    #endif
#endif

#ifndef COORD_TEXTURE2D_X
    #if defined(UNITY_STEREO_INSTANCING_ENABLED) || defined(UNITY_STEREO_MULTIVIEW_ENABLED)
        #define COORD_TEXTURE2D_X(pixelCoord) uint3(pixelCoord, SLICE_ARRAY_INDEX)
    #else
        #define COORD_TEXTURE2D_X(pixelCoord) pixelCoord
    #endif
#endif

#ifndef UNITY_XR_ASSIGN_VIEW_INDEX
    #if defined(UNITY_STEREO_INSTANCING_ENABLED) || defined(UNITY_STEREO_MULTIVIEW_ENABLED)
        #define UNITY_XR_ASSIGN_VIEW_INDEX(viewIndex) unity_StereoEyeIndex = viewIndex
    #else
        #define UNITY_XR_ASSIGN_VIEW_INDEX(viewIndex)
    #endif
#endif

#ifndef HECTON_VOLUMETRIC_FOG_MAX_STEPS
#define HECTON_VOLUMETRIC_FOG_MAX_STEPS 64
#endif

TEXTURE2D_X(_HectonVolumetricFogSourceDepth);
RW_TEXTURE2D_X(float4, _HectonVolumetricFogHalfResult);
RWTexture3D<float4> _HectonVolumetricFogVolumeRW;
Texture3D<float4> _HectonVolumetricFogVolume;

Texture2D<int> _HectonMarineSnowFogDensityTex;
Texture3D<float4> _AbyssalFlowFieldTexture;
Texture3D<float4> _HectonBakedFogDensityFlowTexture;
float4 _SunDirection;
float4 _FinalGiantAbyssLight;
float4 _H8AbyssAbsorptionColor;
float4 _H8AbyssAtmosphereParams;

struct PointLightDTO
{
    float4 PositionRadius;
    float4 ColorIntensity;
};

StructuredBuffer<PointLightDTO> _HectonVolumetricFogPointLights;

CBUFFER_START(HectonVolumetricFogParams)
    float4 _HectonVolumetricFogColorAndDensity;
    float4 _HectonVolumetricFogScatteringParams;
    float4 _HectonVolumetricFogFlowAdvection;
    float4 _HectonVolumetricFogQualityAndLimits;
CBUFFER_END

CBUFFER_START(_GlobalWaterOptics)
    float4 _H8WaterOpticsAbsorptionCoefficientsRGB;
    float4 _H8WaterOpticsScatteringCoefficientsRGB;
    float4 _H8WaterOpticsDirectionalLightColorAndIntensity;
    float4 _H8WaterOpticsQualityAndDepthLimits;
CBUFFER_END

CBUFFER_START(HectonVolumetricFogFrameParams)
    float4 _HectonVolumetricFogFullSize;
    float4 _HectonVolumetricFogHalfSize;
    float4 _HectonVolumetricFogCompositeParams; // x=bilateral depth scale, y=silt strength, z=light count, w=visual phase seconds
    float4 _HectonVolumetricFogDebugParams;     // x=heatmap weight, y=dither strength, z=render scale, w=estimated usec
    float4 _HectonMarineSnowFogDensityTexelSize;
    float4 _HectonMarineSnowFogDensityParams;   // x=strength, y=encoded scale, z=size gain, w=active
    float4 _AbyssalFlowCenter;
    float4 _AbyssalFlowSpacing;
    float4 _AbyssalFlowTextureParams;           // x=resolution, y=world size, z=dt, w=flow texture detail weight
    float _AbyssalFlowTextureActive;
    float3 _HectonVolumetricFogPad0;
    float4x4 _HectonVolumetricFogInverseViewProjection;
    float4 _HectonBakedFogDensityFlowCenter;
    float4 _HectonBakedFogDensityFlowParams;    // x=resolution, y=world size, z=active, w=flow detail weight
CBUFFER_END

float SafeRcp(float value)
{
    return abs(value) > 1e-5 ? rcp(value) : 0.0;
}

bool SafeFinite1(float value)
{
    return value == value && abs(value) < 3.402823e37;
}

bool SafeFinite2(float2 value)
{
    return all(value == value) && all(abs(value) < float2(3.402823e37, 3.402823e37));
}

bool SafeFinite3(float3 value)
{
    return all(value == value) && all(abs(value) < float3(3.402823e37, 3.402823e37, 3.402823e37));
}

float FastNegativeExp(float value)
{
    value = max(0.0, value);
    float value2 = value * value;
    return rcp(1.0 + value + 0.48 * value2 + 0.235 * value2 * value);
}

float3 SafeNormalize3(float3 value, float3 fallback)
{
    float lenSq = dot(value, value);
    return SafeFinite1(lenSq) && lenSq > 1e-6 ? value * rsqrt(lenSq) : fallback;
}

float SafeFiniteScalar(float value, float fallbackValue)
{
    return SafeFinite1(value) ? value : fallbackValue;
}

float SafeFiniteSaturate(float value)
{
    return SafeFinite1(value) ? saturate(value) : 0.0;
}

float3 SafeFiniteColor(float3 color, float3 fallbackColor)
{
    return SafeFinite3(color) ? color : fallbackColor;
}

float3 ResolveNoirFloorColor(float3 color)
{
    float3 authoredFloor = max(SafeFiniteColor(_HectonVolumetricFogColorAndDensity.rgb, float3(0.0015, 0.0023, 0.0031)), float3(0.0015, 0.0023, 0.0031));
    color = SafeFiniteColor(color, authoredFloor);
    return max(color, authoredFloor);
}

float WaterOpticsActive()
{
    return step(0.001, SafeFiniteScalar(_H8WaterOpticsQualityAndDepthLimits.w, 0.0));
}

float WaterOpticsQualityWeight()
{
    return SafeFiniteSaturate(_H8WaterOpticsQualityAndDepthLimits.x);
}

float WaterOpticsSmooth01(float value)
{
    value = SafeFiniteSaturate(value);
    return value * value * (3.0 - 2.0 * value);
}

float WaterOpticsSpectralAdmissionWeight(float quality)
{
    return WaterOpticsSmooth01(SafeFiniteSaturate((quality - 0.28) * 1.3888889));
}

float3 WaterOpticsAbsorption()
{
    float multiplier = max(0.0, SafeFiniteScalar(_H8WaterOpticsAbsorptionCoefficientsRGB.w, 1.0));
    return max(SafeFiniteColor(_H8WaterOpticsAbsorptionCoefficientsRGB.xyz, float3(0.42, 0.105, 0.028)), float3(0.0, 0.0, 0.0)) * multiplier;
}

float3 WaterOpticsScattering()
{
    return max(SafeFiniteColor(_H8WaterOpticsScatteringCoefficientsRGB.xyz, float3(0.035, 0.09, 0.16)), float3(0.0, 0.0, 0.0));
}

float3 WaterOpticsExtinction()
{
    return WaterOpticsAbsorption() + WaterOpticsScattering();
}

float WaterOpticsDepthGate(float3 positionWS)
{
    float3 cameraPositionWS = SafeFinite3(_WorldSpaceCameraPos.xyz) ? _WorldSpaceCameraPos.xyz : float3(0.0, 0.0, 0.0);
    float localSurfaceY = SafeFiniteScalar(_H8WaterOpticsQualityAndDepthLimits.y, 0.0);
    float depth = max(0.0, localSurfaceY - (positionWS.y - cameraPositionWS.y));
    return SafeFiniteSaturate(depth * 4.0);
}

float WaterOpticsCameraUnderwaterGate()
{
    return WaterOpticsActive() * step(0.001, SafeFiniteScalar(_H8WaterOpticsQualityAndDepthLimits.y, 0.0));
}

float3 WaterOpticsTransmittanceCompressed(float3 extinctionCoefficients, float travelMeters)
{
    float quality = WaterOpticsQualityWeight();
    float spectralWeight = WaterOpticsSpectralAdmissionWeight(quality);
    float maxTravel = max(1.0, SafeFiniteScalar(_H8WaterOpticsQualityAndDepthLimits.z, 5000.0));
    float distance = min(max(0.0, SafeFiniteScalar(travelMeters, 0.0)), maxTravel);
    float3 extinction = max(SafeFiniteColor(extinctionCoefficients, float3(0.0, 0.0, 0.0)), float3(0.0, 0.0, 0.0));
    float monoExtinction = max(dot(extinction, float3(0.299, 0.587, 0.114)), 0.000001);
    float monoTransmittance = FastNegativeExp(distance * monoExtinction);
    float3 monoExtinction3 = float3(monoExtinction, monoExtinction, monoExtinction);
    float3 monoTransmittance3 = float3(monoTransmittance, monoTransmittance, monoTransmittance);
    float3 resolvedTransmittance = monoTransmittance3;
    if (spectralWeight > 0.0001)
    {
        float3 spectralDelta = (extinction - monoExtinction3) * distance;
        float3 spectralApprox = monoTransmittance3 * rcp(max(float3(0.0625, 0.0625, 0.0625), float3(1.0, 1.0, 1.0) + spectralDelta * (0.58 + 0.42 * spectralWeight)));
        resolvedTransmittance = SafeFiniteColor(saturate(lerp(monoTransmittance3, spectralApprox, spectralWeight)), monoTransmittance3);
    }

    return resolvedTransmittance;
}

float4 ResolveSafeFogWrite(float3 color, float opacity)
{
    return float4(ResolveNoirFloorColor(color), SafeFiniteSaturate(opacity));
}

float ResolveVisualPhaseSeconds()
{
    return max(0.0, SafeFiniteScalar(_HectonVolumetricFogCompositeParams.w, 0.0));
}

float ResolveFarRawDepth()
{
#if UNITY_REVERSED_Z
    return 0.0;
#else
    return 1.0;
#endif
}

void ResolveDepthData(float2 screenUv, out float rawDepth, out float validMask, out float linearEyeDepth, out float3 positionWS)
{
    rawDepth = SAMPLE_TEXTURE2D_X_LOD(_HectonVolumetricFogSourceDepth, sampler_PointClamp, saturate(screenUv), 0).r;
#if UNITY_REVERSED_Z
    validMask = step(0.0001, rawDepth);
#else
    validMask = step(rawDepth, 0.9999);
#endif

    float resolvedRawDepth = validMask > 0.5 ? rawDepth : ResolveFarRawDepth();
    positionWS = ComputeWorldSpacePosition(screenUv, resolvedRawDepth, _HectonVolumetricFogInverseViewProjection);
    linearEyeDepth = LinearEyeDepth(resolvedRawDepth, _ZBufferParams);
    if (!SafeFinite1(linearEyeDepth) || linearEyeDepth < 0.0)
    {
        validMask = 0.0;
        linearEyeDepth = 0.0;
    }
}

float ResolveSafeLinearEyeDepth(float rawDepth)
{
    float safeRawDepth = SafeFinite1(rawDepth) ? rawDepth : ResolveFarRawDepth();
#if UNITY_REVERSED_Z
    safeRawDepth = safeRawDepth > 0.0001 ? safeRawDepth : ResolveFarRawDepth();
#else
    safeRawDepth = safeRawDepth < 0.9999 ? safeRawDepth : ResolveFarRawDepth();
#endif
    float linearDepth = LinearEyeDepth(safeRawDepth, _ZBufferParams);
    return SafeFinite1(linearDepth) && linearDepth >= 0.0 ? linearDepth : 0.0;
}

float ResolveInterleavedGradientNoise(float2 screenUv)
{
    float2 pixel = floor(screenUv * _HectonVolumetricFogFullSize.xy);
    float frameIndex = floor(ResolveVisualPhaseSeconds() * 60.0);
    float2 temporalPhase = float2(fmod(frameIndex, 2.0), fmod(floor(frameIndex * 0.5), 2.0)) * 0.5;
    return frac(52.9829189 * frac(dot(pixel + temporalPhase, float2(0.06711056, 0.00583715))));
}

uint ResolveBayer2(uint x, uint y)
{
    return ((x ^ y) << 1) | y;
}

float ResolveBayer4(uint2 pixel)
{
    uint x = pixel.x & 3u;
    uint y = pixel.y & 3u;
    uint low = ResolveBayer2(x & 1u, y & 1u);
    uint high = ResolveBayer2((x >> 1u) & 1u, (y >> 1u) & 1u);
    return ((float)(low * 4u + high) + 0.5) * rcp(16.0);
}

float ResolveProxyDither(float2 screenUv)
{
    uint2 pixel = (uint2)floor(screenUv * _HectonVolumetricFogFullSize.xy);
    float bayer = ResolveBayer4(pixel);
    float visualPhaseSeconds = ResolveVisualPhaseSeconds();
    float temporalNoise = ResolveInterleavedGradientNoise(screenUv + frac(visualPhaseSeconds * float2(0.031, 0.047)));
    return lerp(bayer, temporalNoise, SafeFiniteSaturate(_HectonVolumetricFogQualityAndLimits.x * 2.0));
}

float PhaseHG(float cosTheta, float anisotropy)
{
    float safeCosTheta = clamp(SafeFiniteScalar(cosTheta, 0.0), -1.0, 1.0);
    float g = clamp(SafeFiniteScalar(anisotropy, 0.0), -0.95, 0.95);
    float gSq = g * g;
    float denominator = max(1.0 + gSq - 2.0 * g * safeCosTheta, 1e-4);
    return (1.0 - gSq) * SafeRcp(4.0 * PI) * SafeRcp(denominator) * rsqrt(denominator);
}

float3 ApplyWaterOpticsToScattering(float3 scatterColor, float3 samplePositionWS, float3 viewDir, float travelMeters)
{
    float active = WaterOpticsActive();
    float depthGate = WaterOpticsDepthGate(samplePositionWS);
    float blend = active * depthGate;
    if (blend <= 0.0)
        return scatterColor;

    float3 extinction = WaterOpticsExtinction();
    float3 transmittance = WaterOpticsTransmittanceCompressed(extinction, travelMeters);
    float3 scattering = WaterOpticsScattering();
    float3 scatterRatio = saturate(scattering * rcp(max(extinction, float3(0.00001, 0.00001, 0.00001))));
    float3 sunDirection = SafeNormalize3(-_SunDirection.xyz, float3(0.0, -1.0, 0.0));
    float phase = PhaseHG(dot(sunDirection, -viewDir), _H8WaterOpticsScatteringCoefficientsRGB.w);
    float quality = WaterOpticsQualityWeight();
    float abyssDepthMask = SafeFiniteSaturate(_H8AbyssAbsorptionColor.w);
    float3 abyssFloor = max(SafeFiniteColor(_H8AbyssAbsorptionColor.rgb, float3(0.0, 0.0, 0.0)), float3(0.0, 0.0, 0.0)) * abyssDepthMask;
    float3 opticsLight = max(max(_H8WaterOpticsDirectionalLightColorAndIntensity.rgb, _FinalGiantAbyssLight.rgb), abyssFloor) *
        max(0.0, SafeFiniteScalar(_H8WaterOpticsDirectionalLightColorAndIntensity.w, 0.85));
    float3 inScatter = opticsLight * scatterRatio * (1.0 - transmittance) * phase * lerp(0.35, 1.85, quality);
    return SafeFiniteColor(lerp(scatterColor, scatterColor * transmittance + inScatter, blend), scatterColor);
}

float4 SampleBakedFogDensityFlow(float3 positionWS)
{
    float textureResolution = SafeFiniteScalar(_HectonBakedFogDensityFlowParams.x, 0.0);
    float worldSize = SafeFiniteScalar(_HectonBakedFogDensityFlowParams.y, 0.0);
    if (SafeFiniteScalar(_HectonBakedFogDensityFlowParams.z, 0.0) <= 0.5 || textureResolution <= 1.0 || worldSize <= 0.001 || !SafeFinite3(positionWS))
        return float4(0.72, 0.5, 0.5, 0.0);

    float invWorldSize = rcp(max(worldSize, 0.001));
    float3 flowCenter = SafeFinite3(_HectonBakedFogDensityFlowCenter.xyz) ? _HectonBakedFogDensityFlowCenter.xyz : float3(0.0, 0.0, 0.0);
    float3 volumeUv = (positionWS - flowCenter) * invWorldSize + 0.5;
    float inBounds = step(0.0, min(min(volumeUv.x, volumeUv.y), volumeUv.z)) * step(max(max(volumeUv.x, volumeUv.y), volumeUv.z), 1.0);
    float4 packed = SAMPLE_TEXTURE3D_LOD(_HectonBakedFogDensityFlowTexture, sampler_LinearClamp, saturate(volumeUv), 0);
    float density = SafeFinite1(packed.r) ? saturate(packed.r) : 0.72;
    float2 flow = SafeFinite2(packed.gb) ? saturate(packed.gb) : float2(0.5, 0.5);
    return float4(lerp(0.72, density, inBounds), lerp(float2(0.5, 0.5), flow, inBounds), inBounds);
}

float SampleMarineSnowDensity(float2 screenUv)
{
    if (SafeFiniteScalar(_HectonMarineSnowFogDensityParams.w, 0.0) <= 0.5)
        return 0.0;

    uint width;
    uint height;
    _HectonMarineSnowFogDensityTex.GetDimensions(width, height);
    if (width == 0 || height == 0)
        return 0.0;

    int2 pixel = clamp((int2)floor(saturate(screenUv) * float2(width, height)), int2(0, 0), int2((int)width - 1, (int)height - 1));
    int encoded = _HectonMarineSnowFogDensityTex.Load(int3(pixel, 0)).r;
    float scale = max(SafeFiniteScalar(_HectonMarineSnowFogDensityParams.y, 1.0), 1.0);
    float densityScale = max(0.0, SafeFiniteScalar(_HectonMarineSnowFogDensityParams.x, 0.0));
    float siltStrength = max(0.0, SafeFiniteScalar(_HectonVolumetricFogCompositeParams.y, 0.0));
    return max(0.0, (float)encoded * rcp(scale)) * densityScale * siltStrength;
}

float ResolveFogDensity(float3 samplePositionWS, float normalizedTravel, float siltDensity)
{
    float quality = SafeFiniteSaturate(_HectonVolumetricFogQualityAndLimits.x);
    float flowRamp = SafeFiniteSaturate((quality - 0.18) * rcp(0.57));
    flowRamp = flowRamp * flowRamp * (3.0 - 2.0 * flowRamp);
    float flowTextureDetailWeight = SafeFiniteSaturate(_HectonBakedFogDensityFlowParams.w);
    float flowWeight = flowRamp * lerp(0.25, 1.0, flowTextureDetailWeight);
    float advectionStrength = max(0.0, SafeFiniteScalar(_HectonVolumetricFogFlowAdvection.w, 0.0));
    float3 safeFlowOffset = SafeFinite3(_HectonVolumetricFogFlowAdvection.xyz) ? _HectonVolumetricFogFlowAdvection.xyz : float3(0.0, 0.0, 0.0);
    float4 densityFlow = SampleBakedFogDensityFlow(samplePositionWS + safeFlowOffset);
    float densitySample = densityFlow.x;
    if (flowWeight > 0.001 && advectionStrength > 0.001)
    {
        float2 decodedFlow = densityFlow.yz * 2.0 - 1.0;
        float3 flowWs = float3(decodedFlow.x, 0.0, decodedFlow.y);
        float3 advectedPositionWS = samplePositionWS + safeFlowOffset + flowWs * (flowWeight * advectionStrength * ResolveVisualPhaseSeconds());
        densitySample = lerp(densitySample, SampleBakedFogDensityFlow(advectedPositionWS).x, flowWeight);
    }

    float stratification = lerp(1.0, 0.38, SafeFiniteSaturate(normalizedTravel));
    float abyssFogBoost = max(0.0, SafeFiniteScalar(_H8AbyssAtmosphereParams.x, 0.0));
    return max(0.0, SafeFiniteScalar(_HectonVolumetricFogColorAndDensity.w, 0.0)) *
        (1.0 + abyssFogBoost) *
        (SafeFiniteSaturate(densitySample) * stratification + max(0.0, SafeFiniteScalar(siltDensity, 0.0)));
}

float3 ResolvePointLightScattering(float3 samplePositionWS, float3 viewDir)
{
    int lightCount = clamp((int)round(SafeFiniteScalar(_HectonVolumetricFogCompositeParams.z, 0.0)), 0, 8);
    float3 scattering = float3(0.0, 0.0, 0.0);
    [unroll]
    for (int i = 0; i < 8; i++)
    {
        if (i >= lightCount)
            break;

        PointLightDTO light = _HectonVolumetricFogPointLights[i];
        float radius = max(SafeFiniteScalar(light.PositionRadius.w, 1.0), 0.001);
        float3 toLight = light.PositionRadius.xyz - samplePositionWS;
        float distanceSq = max(0.0, SafeFiniteScalar(dot(toLight, toLight), 0.0));
        float attenuation = SafeFiniteSaturate(1.0 - distanceSq * rcp(radius * radius));
        attenuation *= attenuation;
        float3 lightDir = SafeNormalize3(toLight, -viewDir);
        float phase = PhaseHG(dot(lightDir, -viewDir), _HectonVolumetricFogScatteringParams.z);
        float3 lightColor = SafeFiniteColor(light.ColorIntensity.rgb, float3(0.0, 0.0, 0.0));
        float lightIntensity = max(0.0, SafeFiniteScalar(light.ColorIntensity.w, 0.0));
        scattering += lightColor * lightIntensity * attenuation * phase;
    }

    return scattering;
}

float3 ResolveDirectionalScattering(float3 viewDir)
{
    float3 sunDirection = SafeNormalize3(-_SunDirection.xyz, float3(0.0, -1.0, 0.0));
    float phase = PhaseHG(dot(sunDirection, -viewDir), _HectonVolumetricFogScatteringParams.z);
    float lightIntensity = max(SafeFiniteScalar(_FinalGiantAbyssLight.w, 0.08), 0.08);
    float abyssDepthMask = SafeFiniteSaturate(_H8AbyssAbsorptionColor.w);
    float3 abyssFloor = max(SafeFiniteColor(_H8AbyssAbsorptionColor.rgb, float3(0.0, 0.0, 0.0)), float3(0.0, 0.0, 0.0)) * abyssDepthMask;
    float3 lightColor = max(
        max(SafeFiniteColor(_FinalGiantAbyssLight.rgb, float3(0.025, 0.055, 0.075)), float3(0.025, 0.055, 0.075)),
        abyssFloor);
    return lightColor * lightIntensity * phase;
}

float3 HeatmapColor(float normalizedSteps)
{
    normalizedSteps = SafeFiniteSaturate(normalizedSteps);
    return lerp(float3(0.02, 0.18, 0.28), float3(0.85, 0.18, 0.05), normalizedSteps);
}

[numthreads(8, 8, 1)]
void BuildVolumetricFogGrid(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint volumeWidth;
    uint volumeHeight;
    uint volumeDepth;
    _HectonVolumetricFogVolumeRW.GetDimensions(volumeWidth, volumeHeight, volumeDepth);

    int raySteps = clamp((int)round(SafeFiniteScalar(_HectonVolumetricFogQualityAndLimits.y, 4.0)), 4, HECTON_VOLUMETRIC_FOG_MAX_STEPS);
    int activeDepth = min(raySteps, (int)volumeDepth);
    if (dispatchThreadId.x >= volumeWidth || dispatchThreadId.y >= volumeHeight || dispatchThreadId.z >= (uint)activeDepth)
        return;

    float2 screenUv = (dispatchThreadId.xy + 0.5) * rcp(float2(max(volumeWidth, 1u), max(volumeHeight, 1u)));
    float3 cameraPositionWS = SafeFinite3(_WorldSpaceCameraPos.xyz) ? _WorldSpaceCameraPos.xyz : float3(0.0, 0.0, 0.0);
    float3 farPositionWS = ComputeWorldSpacePosition(screenUv, ResolveFarRawDepth(), _HectonVolumetricFogInverseViewProjection);
    float3 rayDir = SafeNormalize3(farPositionWS - cameraPositionWS, float3(0.0, 0.0, 1.0));
    float maxRayDistance = max(0.25, SafeFiniteScalar(_HectonVolumetricFogQualityAndLimits.z, 70.0));
    float normalizedTravel = ((float)dispatchThreadId.z + 0.5) * rcp((float)max(activeDepth, 1));
    float travel = normalizedTravel * maxRayDistance;
    float3 samplePositionLocal = rayDir * travel;
    float3 samplePositionWS = cameraPositionWS + samplePositionLocal;
    float siltDensity = SampleMarineSnowDensity(screenUv);
    float density = ResolveFogDensity(samplePositionWS, normalizedTravel, siltDensity);
    float abyssDepthMask = SafeFiniteSaturate(_H8AbyssAbsorptionColor.w);
    float3 abyssFloor = max(SafeFiniteColor(_H8AbyssAbsorptionColor.rgb, float3(0.0, 0.0, 0.0)), float3(0.0, 0.0, 0.0)) * abyssDepthMask;
    float3 fogColor = max(ResolveNoirFloorColor(_HectonVolumetricFogColorAndDensity.rgb), abyssFloor);
    float scatterCoefficient = max(0.0, SafeFiniteScalar(_HectonVolumetricFogScatteringParams.x, 0.85));
    float3 localScatter = fogColor * scatterCoefficient + ResolveDirectionalScattering(rayDir) + ResolvePointLightScattering(samplePositionWS, rayDir);
    localScatter = ApplyWaterOpticsToScattering(localScatter, samplePositionWS, rayDir, travel);
    density *= lerp(1.0, 1.0 + dot(WaterOpticsExtinction(), float3(0.299, 0.587, 0.114)) * 0.18, WaterOpticsActive() * WaterOpticsDepthGate(samplePositionWS));
    _HectonVolumetricFogVolumeRW[dispatchThreadId] = float4(SafeFiniteColor(localScatter, fogColor), density);
}

void RaymarchVolumetricFogCore(uint3 dispatchThreadId)
{
    UNITY_XR_ASSIGN_VIEW_INDEX(dispatchThreadId.z);

    uint2 pixel = dispatchThreadId.xy;
    uint targetWidth = (uint)max(1.0, SafeFiniteScalar(_HectonVolumetricFogHalfSize.x, 1.0));
    uint targetHeight = (uint)max(1.0, SafeFiniteScalar(_HectonVolumetricFogHalfSize.y, 1.0));
    if (pixel.x >= targetWidth || pixel.y >= targetHeight)
        return;

    float2 screenUv = (pixel + 0.5) * _HectonVolumetricFogHalfSize.zw;
    float maxRayDistance = max(0.25, SafeFiniteScalar(_HectonVolumetricFogQualityAndLimits.z, 70.0));
    int raySteps = clamp((int)round(SafeFiniteScalar(_HectonVolumetricFogQualityAndLimits.y, 4.0)), 4, HECTON_VOLUMETRIC_FOG_MAX_STEPS);
    float proxyBlend = SafeFiniteSaturate(_HectonVolumetricFogQualityAndLimits.w);
    if (proxyBlend >= 0.999)
    {
        float rawDepth = SAMPLE_TEXTURE2D_X_LOD(_HectonVolumetricFogSourceDepth, sampler_PointClamp, saturate(screenUv), 0).r;
#if UNITY_REVERSED_Z
        float validMask = step(0.0001, rawDepth);
#else
        float validMask = step(rawDepth, 0.9999);
#endif
        float proxyDepth = ResolveSafeLinearEyeDepth(rawDepth);
        float rayDistance = validMask > 0.5 ? min(proxyDepth, maxRayDistance) : maxRayDistance;
        float proxyWaterExtinction = dot(WaterOpticsExtinction(), float3(0.299, 0.587, 0.114)) * WaterOpticsCameraUnderwaterGate();
        float proxyOpacity = SafeFiniteSaturate(1.0 - FastNegativeExp(max(0.0, SafeFiniteScalar(_HectonVolumetricFogColorAndDensity.w, 0.0)) * max(0.0001, SafeFiniteScalar(_HectonVolumetricFogScatteringParams.y, 0.12) + proxyWaterExtinction * 0.18) * rayDistance));
        float proxyDither = ResolveProxyDither(screenUv);
        proxyOpacity = SafeFiniteSaturate(proxyOpacity + (proxyDither - 0.5) * SafeFiniteSaturate(_HectonVolumetricFogDebugParams.y) * 0.08);
        float2 centeredUv = screenUv * 2.0 - 1.0;
        float shaftFake = SafeFiniteSaturate(1.0 - dot(centeredUv, centeredUv) * 0.65);
        float3 proxyColor = ResolveNoirFloorColor(_HectonVolumetricFogColorAndDensity.rgb) * proxyOpacity * (0.86 + 0.22 * shaftFake);
        float heatmapWeightProxy = SafeFiniteSaturate(_HectonVolumetricFogDebugParams.x);
        proxyColor = lerp(proxyColor, HeatmapColor((float)raySteps * rcp((float)HECTON_VOLUMETRIC_FOG_MAX_STEPS)), heatmapWeightProxy);
        proxyOpacity = SafeFiniteSaturate(lerp(proxyOpacity, max(proxyOpacity, 0.8), heatmapWeightProxy));
        _HectonVolumetricFogHalfResult[COORD_TEXTURE2D_X(pixel)] = ResolveSafeFogWrite(proxyColor, proxyOpacity);
        return;
    }

    float rawDepth;
    float validMask;
    float linearEyeDepth;
    float3 scenePositionWS;
    ResolveDepthData(screenUv, rawDepth, validMask, linearEyeDepth, scenePositionWS);

    float3 cameraPositionWS = SafeFinite3(_WorldSpaceCameraPos.xyz) ? _WorldSpaceCameraPos.xyz : float3(0.0, 0.0, 0.0);
    scenePositionWS = SafeFinite3(scenePositionWS) ? scenePositionWS : cameraPositionWS + float3(0.0, 0.0, 1.0);
    float3 toScene = scenePositionWS - cameraPositionWS;
    float sceneDistance = SafeFiniteScalar(length(toScene), 0.0);
    float rayDistance = validMask > 0.5 ? min(sceneDistance, maxRayDistance) : maxRayDistance;
    float3 rayDir = SafeNormalize3(toScene, float3(0.0, 0.0, 1.0));
    float proxyWaterExtinction = dot(WaterOpticsExtinction(), float3(0.299, 0.587, 0.114)) * WaterOpticsActive() * WaterOpticsDepthGate(scenePositionWS);
    float proxyOpacity = SafeFiniteSaturate(1.0 - FastNegativeExp(max(0.0, SafeFiniteScalar(_HectonVolumetricFogColorAndDensity.w, 0.0)) * max(0.0001, SafeFiniteScalar(_HectonVolumetricFogScatteringParams.y, 0.12) + proxyWaterExtinction * 0.18) * rayDistance));
    float proxyDither = ResolveProxyDither(screenUv);
    proxyOpacity = SafeFiniteSaturate(proxyOpacity + (proxyDither - 0.5) * SafeFiniteSaturate(_HectonVolumetricFogDebugParams.y) * 0.08);

    float stepLength = rayDistance * rcp((float)raySteps);
    float jitter = (ResolveInterleavedGradientNoise(screenUv) - 0.5) * SafeFiniteSaturate(_HectonVolumetricFogDebugParams.y);
    float3 fogColor = ResolveNoirFloorColor(_HectonVolumetricFogColorAndDensity.rgb);
    float extinction = max(0.0001, SafeFiniteScalar(_HectonVolumetricFogScatteringParams.y, 0.12) + proxyWaterExtinction * 0.12);
    uint volumeWidth;
    uint volumeHeight;
    uint volumeDepth;
    _HectonVolumetricFogVolume.GetDimensions(volumeWidth, volumeHeight, volumeDepth);
    int activeDepth = min(raySteps, (int)volumeDepth);
    float accumulatedOpacity = 0.0;
    float3 accumulatedLight = float3(0.0, 0.0, 0.0);
    int executedSteps = 0;

    [loop]
    for (int stepIndex = 0; stepIndex < HECTON_VOLUMETRIC_FOG_MAX_STEPS; stepIndex++)
    {
        if (stepIndex >= raySteps)
            break;

        float travel = (stepIndex + 0.5 + jitter) * stepLength;
        float normalizedTravel = SafeFiniteSaturate(travel * SafeRcp(max(rayDistance, 0.001)));
        int volumeZ = clamp((int)floor(normalizedTravel * (float)activeDepth), 0, max(activeDepth - 1, 0));
        int2 volumeXY = clamp((int2)floor(saturate(screenUv) * float2(volumeWidth, volumeHeight)), int2(0, 0), int2(max((int)volumeWidth - 1, 0), max((int)volumeHeight - 1, 0)));
        float4 volumeCell = activeDepth > 0 ? _HectonVolumetricFogVolume.Load(int4(volumeXY, volumeZ, 0)) : float4(fogColor, 0.0);
        float density = max(0.0, SafeFiniteScalar(volumeCell.a, 0.0));
        float stepOpacity = SafeFiniteSaturate(1.0 - FastNegativeExp(density * extinction * stepLength));
        float transmittance = 1.0 - accumulatedOpacity;
        accumulatedLight += transmittance * stepOpacity * SafeFiniteColor(volumeCell.rgb, fogColor);
        accumulatedOpacity += transmittance * stepOpacity;
        executedSteps++;

        if (accumulatedOpacity >= SafeFiniteSaturate(_HectonVolumetricFogScatteringParams.w))
            break;
    }

    float3 resolvedColor = lerp(accumulatedLight, fogColor * proxyOpacity, proxyBlend);
    float resolvedOpacity = lerp(accumulatedOpacity, proxyOpacity, proxyBlend);

    float heatmapWeight = SafeFiniteSaturate(_HectonVolumetricFogDebugParams.x);
    float normalizedSteps = (float)executedSteps * rcp((float)HECTON_VOLUMETRIC_FOG_MAX_STEPS);
    resolvedColor = lerp(resolvedColor, HeatmapColor(normalizedSteps), heatmapWeight);
    resolvedOpacity = SafeFiniteSaturate(lerp(resolvedOpacity, max(resolvedOpacity, 0.8), heatmapWeight));

    _HectonVolumetricFogHalfResult[COORD_TEXTURE2D_X(pixel)] = ResolveSafeFogWrite(resolvedColor, resolvedOpacity);
}

[numthreads(8, 8, 1)]
void RaymarchVolumetricFog(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    RaymarchVolumetricFogCore(dispatchThreadId);
}

[numthreads(8, 8, 1)]
void RaymarchVolumetricFogXR(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    RaymarchVolumetricFogCore(dispatchThreadId);
}
