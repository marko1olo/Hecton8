#pragma kernel KTranslateSonarTaps

struct SonarEchoTap
{
    float DelaySeconds;
    float PreviousDopplerRatio;
    float DopplerRatio;
    float Attenuation;
    float LeftPanDeltaGain;
    float RightPanDeltaGain;
    float LowPassCutoffHz;
    float LowPassB0;
    float LowPassB1;
    float LowPassB2;
    float LowPassA1;
    float LowPassA2;
    int DelaySamples;
    int UseLowPass;
    int Reserved0;
    int Reserved1;
};

struct RadarBlipGpuData
{
    float4 LocalPositionSize;
    float4 ColorAlpha;
};

StructuredBuffer<SonarEchoTap> _SonarEchoTaps;
RWStructuredBuffer<RadarBlipGpuData> _RadarBlips;

int _InputTapCount;
int _OutputPointCount;
int _OutputCapacity;
int _Sequence;
float _RadarRadiusMeters;
float _MaxDelaySeconds;
float _PowerLevel;
float _DamageFlicker;

static const float HECTON_PI = 3.14159265;
static const float HECTON_TWO_PI = 6.2831853;
static const float HECTON_FLOAT_MAX = 3.402823e38;

float HectonFiniteOrZero(float value)
{
    return (abs(value) <= HECTON_FLOAT_MAX) ? value : 0.0;
}

float HectonHash01(uint value)
{
    value ^= value >> 16;
    value *= 0x7feb352du;
    value ^= value >> 15;
    value *= 0x846ca68bu;
    value ^= value >> 16;
    return (float)(value & 0x00ffffffu) * (1.0 / 16777215.0);
}

float HectonWrapPi(float value)
{
    return value - floor((value + HECTON_PI) / HECTON_TWO_PI) * HECTON_TWO_PI;
}

float HectonSinApprox(float value)
{
    float x = HectonWrapPi(value);
    float x2 = x * x;
    return x * (1.0 - x2 * (0.16666667 - x2 * 0.00833333));
}

float HectonCosApprox(float value)
{
    return HectonSinApprox(value + 1.57079633);
}

[numthreads(64, 1, 1)]
void KTranslateSonarTaps(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint index = dispatchThreadId.x;
    uint inputCount = (uint)min(max(_InputTapCount, 0), max(_OutputCapacity, 0));
    uint outputCount = (uint)min(max(_OutputPointCount, 0), max(_OutputCapacity, 0));
    if (index >= outputCount || inputCount == 0u)
        return;

    uint tapIndex = index % inputCount;
    uint replicaIndex = index / inputCount;
    SonarEchoTap tap = _SonarEchoTaps[tapIndex];
    float maxDelay = max(HectonFiniteOrZero(_MaxDelaySeconds), 0.0001);
    float radarRadius = max(HectonFiniteOrZero(_RadarRadiusMeters), 0.001);
    float sequencePhase = (float)(_Sequence & 1023) * 0.071;
    float replicaSpiral = frac((float)replicaIndex * 0.6180339 + (float)tapIndex * 0.173 + sequencePhase);
    float replicaJitter = HectonHash01(index ^ ((uint)_Sequence * 747796405u));
    float radius01 = saturate((HectonFiniteOrZero(tap.DelaySeconds) / maxDelay) + (replicaJitter - 0.5) * 0.035);
    float radius = radius01 * radarRadius;
    float stereoPan = saturate((HectonFiniteOrZero(tap.RightPanDeltaGain) - HectonFiniteOrZero(tap.LeftPanDeltaGain)) * 0.5 + 0.5);
    float angle = (stereoPan * 2.0 - 1.0) * HECTON_PI;
    float dopplerLift = saturate(abs(HectonFiniteOrZero(tap.DopplerRatio) - HectonFiniteOrZero(tap.PreviousDopplerRatio)) * 6.0);
    float elevation = (dopplerLift - 0.5) * 0.22 * radarRadius;
    elevation += (replicaJitter - 0.5) * 0.16 * radarRadius;
    angle += (replicaSpiral - 0.5) * 0.72 + (float)(replicaIndex & 15u) * 0.013;

    float strength = saturate(HectonFiniteOrZero(tap.Attenuation));
    float power = saturate(HectonFiniteOrZero(_PowerLevel));
    float replicaFade = saturate(1.0 - (float)replicaIndex * 0.028);
    float damageFlicker = saturate(HectonFiniteOrZero(_DamageFlicker));
    float flicker = saturate(1.0 - damageFlicker * (0.35 + replicaSpiral * 0.65));
    float alpha = saturate((0.16 + strength * 0.84) * power * flicker * replicaFade);
    float size = lerp(0.009, 0.036, alpha) * lerp(0.75, 1.2, replicaJitter);

    RadarBlipGpuData blip;
    blip.LocalPositionSize = float4(HectonCosApprox(angle) * radius, elevation, HectonSinApprox(angle) * radius, size);
    blip.ColorAlpha = float4(0.18 + strength * 0.26, 0.82 + dopplerLift * 0.18, 1.0, alpha);
    _RadarBlips[index] = blip;
}
