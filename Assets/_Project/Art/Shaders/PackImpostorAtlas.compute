#pragma kernel CSMain

Texture2D<float4> _SourceAlbedo;
Texture2D<float4> _SourceNormalDepth;
RWTexture2D<float4> _AtlasAlbedoDepth;
RWTexture2D<float4> _AtlasNormalXY;

int _ViewIndex;
float4 _TileSize;
float4 _AtlasGrid;

[numthreads(8, 8, 1)]
void CSMain(uint3 id : SV_DispatchThreadID)
{
    int2 tileSize = max(int2(_TileSize.xy), int2(1, 1));
    int2 atlasGrid = max(int2(_AtlasGrid.xy), int2(1, 1));
    if (id.x >= (uint)tileSize.x || id.y >= (uint)tileSize.y)
        return;

    int tileX = _ViewIndex % atlasGrid.x;
    int tileY = _ViewIndex / atlasGrid.x;
    int2 sourcePixel = int2(id.xy);
    int2 atlasPixel = int2(tileX * tileSize.x, tileY * tileSize.y) + sourcePixel;

    float4 albedo = _SourceAlbedo.Load(int3(sourcePixel, 0));
    float4 normalDepth = _SourceNormalDepth.Load(int3(sourcePixel, 0));
    float depth = saturate(normalDepth.a);
    float occupancy = step(0.0005, depth);
    float2 normalXY = saturate(float2(normalDepth.r, normalDepth.b));

    _AtlasAlbedoDepth[atlasPixel] = float4(saturate(albedo.rgb), depth);
    _AtlasNormalXY[atlasPixel] = float4(normalXY, 0.5, occupancy);
}
