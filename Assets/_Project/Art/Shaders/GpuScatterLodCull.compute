#pragma kernel ScatterCullJob
#pragma target 4.5

#define HECTON_SCATTER_THREADS_PER_GROUP 64
#define HECTON_SCATTER_FRUSTUM_PLANES 6

#include "Packages/com.unity.render-pipelines.core/ShaderLibrary/Common.hlsl"

StructuredBuffer<float4x4> _HectonScatterSourceMatrices;
AppendStructuredBuffer<uint> _HectonScatterVisibleIndices;

struct HectonScatterVisibleMatrix
{
    float4 Row0;
    float4 Row1;
    float4 Row2;
    float4 Row3;
};

AppendStructuredBuffer<HectonScatterVisibleMatrix> _HectonScatterVisibleMatrices;
RWStructuredBuffer<float4> _HectonScatterMotionVectors;

CBUFFER_START(HectonScatterFrameConstants)
    float4 _HectonScatterParams0; // x=instance count, y=max distance sq, z=motion strength, w=frame index
    float4 _HectonScatterParams1; // xyz=AUP shift, w=crossfade enabled
    float4 _HectonScatterParams2; // xyz=camera position
    float4 _HectonScatterParams3; // xyz=local bounds center
    float4 _HectonScatterParams4; // xyz=local bounds extents, w=instance capacity guard
    float4 _HectonScatterFrustumPlane0;
    float4 _HectonScatterFrustumPlane1;
    float4 _HectonScatterFrustumPlane2;
    float4 _HectonScatterFrustumPlane3;
    float4 _HectonScatterFrustumPlane4;
    float4 _HectonScatterFrustumPlane5;
CBUFFER_END

float SanitizeNonNegative(float value, float fallbackValue)
{
    return isfinite(value) ? max(value, fallbackValue) : fallbackValue;
}

bool IsFiniteFloat3(float3 value)
{
    return all(isfinite(value));
}

bool IsFiniteFloat4(float4 value)
{
    return all(isfinite(value));
}

uint ResolveInstanceCount()
{
    uint instanceCount = (uint)SanitizeNonNegative(_HectonScatterParams0.x, 0.0);
    uint instanceCapacity = (uint)SanitizeNonNegative(_HectonScatterParams4.w, 0.0);
    return min(instanceCount, instanceCapacity);
}

uint ResolveFrameIndex()
{
    return (uint)SanitizeNonNegative(_HectonScatterParams0.w, 0.0);
}

float ResolveMaxDistanceSq()
{
    return SanitizeNonNegative(_HectonScatterParams0.y, 1.0);
}

float ResolveMotionStrength()
{
    return SanitizeNonNegative(_HectonScatterParams0.z, 0.0);
}

float ResolveCrossfadeEnabled()
{
    return isfinite(_HectonScatterParams1.w) ? saturate(_HectonScatterParams1.w) : 0.0;
}

float3 ResolveAupShiftOffset()
{
    return IsFiniteFloat3(_HectonScatterParams1.xyz) ? _HectonScatterParams1.xyz : float3(0.0, 0.0, 0.0);
}

float3 ResolveCameraPosition()
{
    return IsFiniteFloat3(_HectonScatterParams2.xyz) ? _HectonScatterParams2.xyz : float3(0.0, 0.0, 0.0);
}

float3 ResolveLocalBoundsCenter()
{
    return IsFiniteFloat3(_HectonScatterParams3.xyz) ? _HectonScatterParams3.xyz : float3(0.0, 0.0, 0.0);
}

float3 ResolveLocalBoundsExtents()
{
    float3 extents = IsFiniteFloat3(_HectonScatterParams4.xyz) ? _HectonScatterParams4.xyz : float3(0.01, 0.01, 0.01);
    return max(abs(extents), float3(0.01, 0.01, 0.01));
}

float4 ResolveFrustumPlane(int planeIndex)
{
    if (planeIndex == 0)
        return _HectonScatterFrustumPlane0;
    if (planeIndex == 1)
        return _HectonScatterFrustumPlane1;
    if (planeIndex == 2)
        return _HectonScatterFrustumPlane2;
    if (planeIndex == 3)
        return _HectonScatterFrustumPlane3;
    if (planeIndex == 4)
        return _HectonScatterFrustumPlane4;

    return _HectonScatterFrustumPlane5;
}

bool HasFiniteMatrix(float4x4 matrixValue)
{
    return IsFiniteFloat4(float4(matrixValue._m00, matrixValue._m01, matrixValue._m02, matrixValue._m03)) &&
           IsFiniteFloat4(float4(matrixValue._m10, matrixValue._m11, matrixValue._m12, matrixValue._m13)) &&
           IsFiniteFloat4(float4(matrixValue._m20, matrixValue._m21, matrixValue._m22, matrixValue._m23)) &&
           IsFiniteFloat4(float4(matrixValue._m30, matrixValue._m31, matrixValue._m32, matrixValue._m33));
}

float3 TransformPoint(float4x4 matrixValue, float3 localPosition)
{
    float4 transformed = mul(matrixValue, float4(localPosition, 1.0));
    return transformed.xyz;
}

bool HasUsableScale(float4x4 matrixValue)
{
    float3 axisX = float3(matrixValue._m00, matrixValue._m10, matrixValue._m20);
    float3 axisY = float3(matrixValue._m01, matrixValue._m11, matrixValue._m21);
    float3 axisZ = float3(matrixValue._m02, matrixValue._m12, matrixValue._m22);
    float scaleXSq = dot(axisX, axisX);
    float scaleYSq = dot(axisY, axisY);
    float scaleZSq = dot(axisZ, axisZ);
    return isfinite(scaleXSq) && isfinite(scaleYSq) && isfinite(scaleZSq) &&
           scaleXSq > 0.000001 && scaleYSq > 0.000001 && scaleZSq > 0.000001;
}

bool BoundsVisible(float4x4 matrixValue, float3 centerWS, float3 localBoundsExtents)
{
    float3 axisX = float3(matrixValue._m00, matrixValue._m10, matrixValue._m20) * localBoundsExtents.x;
    float3 axisY = float3(matrixValue._m01, matrixValue._m11, matrixValue._m21) * localBoundsExtents.y;
    float3 axisZ = float3(matrixValue._m02, matrixValue._m12, matrixValue._m22) * localBoundsExtents.z;

    [unroll]
    for (int planeIndex = 0; planeIndex < HECTON_SCATTER_FRUSTUM_PLANES; planeIndex++)
    {
        float4 plane = ResolveFrustumPlane(planeIndex);
        if (!IsFiniteFloat4(plane))
            return false;

        float signedDistance = dot(plane.xyz, centerWS) + plane.w;
        float radius = abs(dot(plane.xyz, axisX)) + abs(dot(plane.xyz, axisY)) + abs(dot(plane.xyz, axisZ));
        if (signedDistance + radius < 0.0)
            return false;
    }

    return true;
}

HectonScatterVisibleMatrix PackVisibleMatrix(float4x4 matrixValue)
{
    HectonScatterVisibleMatrix packed;
    packed.Row0 = float4(matrixValue._m00, matrixValue._m01, matrixValue._m02, matrixValue._m03);
    packed.Row1 = float4(matrixValue._m10, matrixValue._m11, matrixValue._m12, matrixValue._m13);
    packed.Row2 = float4(matrixValue._m20, matrixValue._m21, matrixValue._m22, matrixValue._m23);
    packed.Row3 = float4(matrixValue._m30, matrixValue._m31, matrixValue._m32, matrixValue._m33);
    return packed;
}

float HashSigned01(uint value)
{
    value ^= value >> 16;
    value *= 0x7feb352du;
    value ^= value >> 15;
    value *= 0x846ca68bu;
    value ^= value >> 16;
    return ((value & 0xFFFFu) * (1.0 / 32767.5)) - 1.0;
}

[numthreads(HECTON_SCATTER_THREADS_PER_GROUP, 1, 1)]
void ScatterCullJob(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint instanceIndex = dispatchThreadId.x;
    uint instanceCount = ResolveInstanceCount();
    if (instanceIndex >= instanceCount)
        return;

    float4x4 matrixValue = _HectonScatterSourceMatrices[instanceIndex];
    if (!HasFiniteMatrix(matrixValue) || !HasUsableScale(matrixValue))
        return;

    float3 localBoundsCenter = ResolveLocalBoundsCenter();
    float3 localBoundsExtents = ResolveLocalBoundsExtents();
    if (!IsFiniteFloat3(localBoundsCenter) || !IsFiniteFloat3(localBoundsExtents))
        return;

    float3 centerWS = TransformPoint(matrixValue, localBoundsCenter) + ResolveAupShiftOffset();
    if (!IsFiniteFloat3(centerWS))
        return;

    float3 toCamera = centerWS - ResolveCameraPosition();
    float distanceSq = dot(toCamera, toCamera);
    if (!isfinite(distanceSq) || distanceSq > ResolveMaxDistanceSq())
        return;

    if (!BoundsVisible(matrixValue, centerWS, localBoundsExtents))
        return;

    uint motionHash = instanceIndex * 747796405u + ResolveFrameIndex() * 2891336453u;
    float swaySigned = HashSigned01(motionHash);
    float3 axisX = float3(matrixValue._m00, 0.0, matrixValue._m20);
    float axisLenSq = dot(axisX, axisX);
    axisLenSq = isfinite(axisLenSq) ? max(axisLenSq, 0.000001) : 1.0;
    float3 swayDir = axisX * rsqrt(axisLenSq);
    float motionScale = ResolveMotionStrength() * lerp(0.65, 1.35, ResolveCrossfadeEnabled());
    _HectonScatterMotionVectors[instanceIndex] = float4(swayDir * (swaySigned * motionScale), distanceSq);

    _HectonScatterVisibleIndices.Append(instanceIndex);
    _HectonScatterVisibleMatrices.Append(PackVisibleMatrix(matrixValue));
}
