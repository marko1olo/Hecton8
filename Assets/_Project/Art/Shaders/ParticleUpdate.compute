#pragma kernel SimulateBloodDispersion
#pragma target 5.0

struct Particle
{
    float3 Pos;
    float Life;
    float3 Vel;
    float Size;
    float3 PrevPos;
    uint Flags;
    float2 UV;
    float2 Pad;
};

StructuredBuffer<Particle> _ParticlesRead;
RWStructuredBuffer<Particle> _ParticlesWrite;
StructuredBuffer<float3> _AbyssalFlowField;

float4 _FieldOriginCellSize;
float4 _FieldParams;
float4 _BloodParams0;
float4 _BloodParams1;

#define THREAD_GROUP_SIZE 64
#define EPSILON 0.0001

bool IsFiniteFloat(float value)
{
    return !isnan(value) && !isinf(value);
}

bool IsFiniteFloat2(float2 value)
{
    return !(any(isnan(value)) || any(isinf(value)));
}

bool IsFiniteFloat3(float3 value)
{
    return !(any(isnan(value)) || any(isinf(value)));
}

float ResolveFiniteFloat(float value, float fallbackValue)
{
    return IsFiniteFloat(value) ? value : fallbackValue;
}

float2 ResolveFiniteFloat2(float2 value, float2 fallbackValue)
{
    return IsFiniteFloat2(value) ? value : fallbackValue;
}

float3 ResolveFiniteFloat3(float3 value, float3 fallbackValue)
{
    return IsFiniteFloat3(value) ? value : fallbackValue;
}

float3 SafeNormalize(float3 value)
{
    value = ResolveFiniteFloat3(value, 0.0.xxx);
    float lenSq = dot(value, value);
    return lenSq > EPSILON ? value * rsqrt(lenSq) : 0.0.xxx;
}

float SafeRcp(float value)
{
    return abs(value) > EPSILON ? rcp(value) : 0.0;
}

float FastTriangleSigned(float phase)
{
    float triangle01 = 1.0 - abs(frac(phase * 0.15915494 + 0.25) * 2.0 - 1.0);
    return triangle01 * 2.0 - 1.0;
}

float3 SampleFlowField(float3 positionWS, uint flowSampleCount)
{
    int resolution = clamp((int)round(ResolveFiniteFloat(_FieldParams.x, 1.0)), 1, 512);
    uint stride = (uint)resolution;
    uint layerStride = stride * stride;
    uint requiredSamples = layerStride * stride;
    if (resolution <= 1 || requiredSamples == 0u || requiredSamples > flowSampleCount)
        return 0.0.xxx;

    float3 safePositionWS = ResolveFiniteFloat3(positionWS, 0.0.xxx);
    float3 fieldOrigin = ResolveFiniteFloat3(_FieldOriginCellSize.xyz, 0.0.xxx);
    float cellSize = max(abs(ResolveFiniteFloat(_FieldOriginCellSize.w, 1.0)), 0.001);
    float3 gridPosition = (safePositionWS - fieldOrigin) / cellSize;
    if (!IsFiniteFloat3(gridPosition))
        return 0.0.xxx;

    gridPosition = clamp(gridPosition, 0.0.xxx, (resolution - 1).xxx);

    int3 baseCell = (int3)floor(gridPosition);
    int3 nextCell = min(baseCell + 1, int3(resolution - 1, resolution - 1, resolution - 1));
    float3 fracValue = frac(gridPosition);

    uint index000 = (uint)baseCell.x + (uint)baseCell.z * stride + (uint)baseCell.y * layerStride;
    uint index100 = (uint)nextCell.x + (uint)baseCell.z * stride + (uint)baseCell.y * layerStride;
    uint index010 = (uint)baseCell.x + (uint)nextCell.z * stride + (uint)baseCell.y * layerStride;
    uint index110 = (uint)nextCell.x + (uint)nextCell.z * stride + (uint)baseCell.y * layerStride;
    uint index001 = (uint)baseCell.x + (uint)baseCell.z * stride + (uint)nextCell.y * layerStride;
    uint index101 = (uint)nextCell.x + (uint)baseCell.z * stride + (uint)nextCell.y * layerStride;
    uint index011 = (uint)baseCell.x + (uint)nextCell.z * stride + (uint)nextCell.y * layerStride;
    uint index111 = (uint)nextCell.x + (uint)nextCell.z * stride + (uint)nextCell.y * layerStride;

    float3 sample000 = _AbyssalFlowField[index000];
    float3 sample100 = _AbyssalFlowField[index100];
    float3 sample010 = _AbyssalFlowField[index010];
    float3 sample110 = _AbyssalFlowField[index110];
    float3 sample001 = _AbyssalFlowField[index001];
    float3 sample101 = _AbyssalFlowField[index101];
    float3 sample011 = _AbyssalFlowField[index011];
    float3 sample111 = _AbyssalFlowField[index111];

    sample000 = ResolveFiniteFloat3(sample000, 0.0.xxx);
    sample100 = ResolveFiniteFloat3(sample100, sample000);
    sample010 = ResolveFiniteFloat3(sample010, sample000);
    sample110 = ResolveFiniteFloat3(sample110, sample000);
    sample001 = ResolveFiniteFloat3(sample001, sample000);
    sample101 = ResolveFiniteFloat3(sample101, sample000);
    sample011 = ResolveFiniteFloat3(sample011, sample000);
    sample111 = ResolveFiniteFloat3(sample111, sample000);

    float3 sampleX00 = lerp(sample000, sample100, fracValue.x);
    float3 sampleX10 = lerp(sample010, sample110, fracValue.x);
    float3 sampleX01 = lerp(sample001, sample101, fracValue.x);
    float3 sampleX11 = lerp(sample011, sample111, fracValue.x);
    float3 sampleY0 = lerp(sampleX00, sampleX10, fracValue.z);
    float3 sampleY1 = lerp(sampleX01, sampleX11, fracValue.z);
    return lerp(sampleY0, sampleY1, fracValue.y);
}

[numthreads(THREAD_GROUP_SIZE, 1, 1)]
void SimulateBloodDispersion(uint3 dispatchThreadID : SV_DispatchThreadID)
{
    uint index = dispatchThreadID.x;
    uint readParticleCount;
    uint readParticleStride;
    uint writeParticleCount;
    uint writeParticleStride;
    uint flowSampleCount;
    uint flowSampleStride;
    _ParticlesRead.GetDimensions(readParticleCount, readParticleStride);
    _ParticlesWrite.GetDimensions(writeParticleCount, writeParticleStride);
    _AbyssalFlowField.GetDimensions(flowSampleCount, flowSampleStride);

    uint bufferParticleCount = min(readParticleCount, writeParticleCount);
    float requestedParticleCount = min(max(round(ResolveFiniteFloat(_FieldParams.y, 0.0)), 0.0), (float)bufferParticleCount);
    uint particleCount = (uint)requestedParticleCount;
    if (index >= particleCount)
        return;

    Particle particle = _ParticlesRead[index];
    particle.Pos = ResolveFiniteFloat3(particle.Pos, 0.0.xxx);
    particle.PrevPos = ResolveFiniteFloat3(particle.PrevPos, particle.Pos);
    particle.Vel = ResolveFiniteFloat3(particle.Vel, 0.0.xxx);
    particle.Life = max(0.0, ResolveFiniteFloat(particle.Life, 0.0));
    particle.Size = max(0.0, ResolveFiniteFloat(particle.Size, 0.0));
    particle.UV = ResolveFiniteFloat2(particle.UV, 0.0.xx);
    particle.Pad = ResolveFiniteFloat2(particle.Pad, 0.0.xx);
    if (particle.Life <= 0.0)
    {
        _ParticlesWrite[index] = particle;
        return;
    }

    float dt = min(max(ResolveFiniteFloat(_BloodParams0.x, 0.0), 0.0), 0.1);
    float flowBlend = saturate(ResolveFiniteFloat(_BloodParams0.y, 0.0));
    float baseDragCoeff = max(ResolveFiniteFloat(_BloodParams0.z, 0.0), 0.0);
    float turbulenceScale = max(ResolveFiniteFloat(_BloodParams0.w, 0.0), 0.0);
    float sizeGrowRate = max(ResolveFiniteFloat(_BloodParams1.x, 0.0), 0.0);
    float fadeRate = max(ResolveFiniteFloat(_BloodParams1.y, 0.0), 0.0);
    float maxSize = max(ResolveFiniteFloat(_BloodParams1.z, particle.Size), particle.Size);
    float buoyancy = ResolveFiniteFloat(_BloodParams1.w, 0.0);

    particle.PrevPos = particle.Pos;
    float3 flowSample = SampleFlowField(particle.Pos, flowSampleCount);
    particle.Vel += (flowSample - particle.Vel) * flowBlend * dt;

    float3 flowDirN = SafeNormalize(flowSample);
    float3 particleDirN = SafeNormalize(particle.Vel);
    float alignment = dot(particleDirN, flowDirN);
    float alignmentN = saturate((alignment + 1.0) * 0.5);
    float dragMultiplier = lerp(1.0, 0.1, alignmentN);
    float dragBase = saturate(1.0 - dragMultiplier * baseDragCoeff);
    float dragAttenuation = lerp(1.0, dragBase, saturate(dt * 60.0));
    particle.Vel *= dragAttenuation;

    float turbulencePhase = particle.Pad.x * 6.2831853 + _FieldParams.z;
    float3 turbulence = float3(
        FastTriangleSigned(turbulencePhase + particle.Pos.y * 0.13),
        FastTriangleSigned(turbulencePhase * 0.83 + particle.Pos.x * 0.09 + 1.5707963),
        FastTriangleSigned(turbulencePhase * 1.17 + particle.Pos.z * 0.11));
    particle.Vel += turbulence * (turbulenceScale * dt);
    particle.Vel.y += buoyancy * dt;

    particle.Vel = ResolveFiniteFloat3(particle.Vel, 0.0.xxx);
    particle.Pos += particle.Vel * dt;
    particle.Pos = ResolveFiniteFloat3(particle.Pos, particle.PrevPos);
    particle.Size = ResolveFiniteFloat(min(maxSize, particle.Size + sizeGrowRate * dt), particle.Size);
    particle.Life = max(0.0, ResolveFiniteFloat(particle.Life - fadeRate * dt, 0.0));
    _ParticlesWrite[index] = particle;
}
