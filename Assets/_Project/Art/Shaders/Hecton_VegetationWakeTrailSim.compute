#pragma kernel SimulateWakeTrail

// RG = encoded planar velocity in [-1, 1], B = current displacement, A = previous displacement.

struct WakeTrailStampCommand
{
    float4 UvEllipse;
    float4 DirectionStrengthVertical;
};

Texture2D<float4> _HectonWakeTrailSource;
RWTexture2D<float4> _HectonWakeTrailResult;
SamplerState sampler_HectonWakeTrailSource;
StructuredBuffer<WakeTrailStampCommand> _HectonWakeTrailStampCommands;

int _HectonWakeTrailStampCount;
float4 _HectonWakeTrailScrollUvOffset;
float _HectonWakeTrailFadeDelta;
float _HectonWakeTrailDiffusion;
float _HectonWakeTrailWaveStrength;
float _HectonWakeTrailDamping;
float _HectonWakeTrailCurlStrength;
float _HectonWakeTrailSimulationTime;
float4 _HectonWakeTrailTexelSize;

float2 DecodeVelocity(float2 encodedVelocity)
{
    return encodedVelocity * 2.0 - 1.0;
}

float2 EncodeVelocity(float2 velocity)
{
    return saturate(velocity * 0.5 + 0.5);
}

float Hash31(float3 value)
{
    float3 hash = frac(value * float3(0.1031, 0.1030, 0.0973));
    hash += dot(hash, hash.yzx + 33.33);
    return frac((hash.x + hash.y) * hash.z);
}

float ValueNoise3(float3 samplePosition)
{
    float3 cell = floor(samplePosition);
    float3 fracPart = frac(samplePosition);
    float3 smoothFrac = fracPart * fracPart * (3.0 - 2.0 * fracPart);

    float n000 = Hash31(cell + float3(0.0, 0.0, 0.0));
    float n100 = Hash31(cell + float3(1.0, 0.0, 0.0));
    float n010 = Hash31(cell + float3(0.0, 1.0, 0.0));
    float n110 = Hash31(cell + float3(1.0, 1.0, 0.0));
    float n001 = Hash31(cell + float3(0.0, 0.0, 1.0));
    float n101 = Hash31(cell + float3(1.0, 0.0, 1.0));
    float n011 = Hash31(cell + float3(0.0, 1.0, 1.0));
    float n111 = Hash31(cell + float3(1.0, 1.0, 1.0));

    float nx00 = lerp(n000, n100, smoothFrac.x);
    float nx10 = lerp(n010, n110, smoothFrac.x);
    float nx01 = lerp(n001, n101, smoothFrac.x);
    float nx11 = lerp(n011, n111, smoothFrac.x);
    float nxy0 = lerp(nx00, nx10, smoothFrac.y);
    float nxy1 = lerp(nx01, nx11, smoothFrac.y);
    return lerp(nxy0, nxy1, smoothFrac.z);
}

float2 ResolveCurlNoise(float2 uv)
{
    float epsilon = 0.35;
    float timePhase = _HectonWakeTrailSimulationTime * 0.12;
    float3 samplePosition = float3(uv * 14.0, timePhase);

    float noiseLeft = ValueNoise3(samplePosition - float3(epsilon, 0.0, 0.0));
    float noiseRight = ValueNoise3(samplePosition + float3(epsilon, 0.0, 0.0));
    float noiseDown = ValueNoise3(samplePosition - float3(0.0, epsilon, 0.0));
    float noiseUp = ValueNoise3(samplePosition + float3(0.0, epsilon, 0.0));

    float2 curl = float2(noiseUp - noiseDown, noiseLeft - noiseRight);
    float curlLengthSq = dot(curl, curl);
    return curlLengthSq > 0.000001 ? curl * rsqrt(curlLengthSq) : float2(0.0, 1.0);
}

float4 SampleScrolledWakeTrail(float2 uv)
{
    float2 sourceUv = uv + _HectonWakeTrailScrollUvOffset.xy;
    if (sourceUv.x < 0.0 || sourceUv.x > 1.0 || sourceUv.y < 0.0 || sourceUv.y > 1.0)
        return float4(0.5, 0.5, 0.0, 0.0);

    return _HectonWakeTrailSource.SampleLevel(sampler_HectonWakeTrailSource, sourceUv, 0);
}

float4 ApplyWakeTrailStamps(float2 uv, float4 currentValue)
{
    float currentIntensity = currentValue.b;
    float previousIntensity = currentValue.a;
    float2 currentVelocity = DecodeVelocity(currentValue.rg);

    [loop]
    for (int stampIndex = 0; stampIndex < _HectonWakeTrailStampCount; stampIndex++)
    {
        WakeTrailStampCommand stamp = _HectonWakeTrailStampCommands[stampIndex];
        float2 stampDirection = stamp.DirectionStrengthVertical.xy;
        float stampDirectionLengthSq = dot(stampDirection, stampDirection);
        stampDirection = stampDirectionLengthSq > 0.000001 ? stampDirection * rsqrt(stampDirectionLengthSq) : float2(0.0, 1.0);
        float2 stampBitangent = float2(-stampDirection.y, stampDirection.x);

        float2 delta = uv - stamp.UvEllipse.xy;
        float radius = max(stamp.UvEllipse.z, 0.0001);
        float halfLength = max(stamp.UvEllipse.w, 0.0001);
        float invRadius = rcp(radius);
        float invHalfLength = rcp(halfLength);
        float verticalImpulse = saturate(stamp.DirectionStrengthVertical.w);
        float along = dot(delta, stampDirection) * invHalfLength;
        float across = dot(delta, stampBitangent) * invRadius;
        float shape = saturate(1.0 - (along * along + across * across));
        float stampIntensity = shape * shape * saturate(stamp.DirectionStrengthVertical.z) * lerp(1.0, 1.55, verticalImpulse);
        if (stampIntensity <= 0.000001)
            continue;

        float2 stampVelocity = stampDirection * stampIntensity;
        stampVelocity += stampBitangent * (across * verticalImpulse * stampIntensity * 0.35);
        currentVelocity += stampVelocity;
        float velocityMagnitudeSq = dot(currentVelocity, currentVelocity);
        if (velocityMagnitudeSq > 1.0)
            currentVelocity *= rsqrt(velocityMagnitudeSq);

        float previousHeight = currentIntensity;
        currentIntensity = max(currentIntensity, stampIntensity);
        previousIntensity = lerp(previousHeight, currentIntensity, verticalImpulse * 0.35);
    }

    return float4(EncodeVelocity(currentVelocity), currentIntensity, previousIntensity);
}

float4 SampleStampedPixel(int2 pixel, float2 texelSize)
{
    float2 uv = (float2(pixel) + 0.5) * texelSize;
    return ApplyWakeTrailStamps(uv, SampleScrolledWakeTrail(uv));
}

[numthreads(8, 8, 1)]
void SimulateWakeTrail(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint width;
    uint height;
    _HectonWakeTrailResult.GetDimensions(width, height);
    if (dispatchThreadId.x >= width || dispatchThreadId.y >= height)
        return;

    int2 pixel = int2(dispatchThreadId.xy);
    int2 leftPixel = int2(max(pixel.x - 1, 0), pixel.y);
    int2 rightPixel = int2(min(pixel.x + 1, (int)width - 1), pixel.y);
    int2 downPixel = int2(pixel.x, max(pixel.y - 1, 0));
    int2 upPixel = int2(pixel.x, min(pixel.y + 1, (int)height - 1));

    float2 texelSize = _HectonWakeTrailTexelSize.xy;
    float4 center = SampleStampedPixel(pixel, texelSize);
    float4 left = SampleStampedPixel(leftPixel, texelSize);
    float4 right = SampleStampedPixel(rightPixel, texelSize);
    float4 down = SampleStampedPixel(downPixel, texelSize);
    float4 up = SampleStampedPixel(upPixel, texelSize);

    float currentDisplacement = center.b;
    float previousDisplacement = center.a;
    float neighborAverageDisplacement = (left.b + right.b + down.b + up.b) * 0.25;
    float2 currentVelocity = DecodeVelocity(center.rg);
    float2 leftVelocity = DecodeVelocity(left.rg);
    float2 rightVelocity = DecodeVelocity(right.rg);
    float2 downVelocity = DecodeVelocity(down.rg);
    float2 upVelocity = DecodeVelocity(up.rg);
    float2 neighborAverageVelocity = (leftVelocity + rightVelocity + downVelocity + upVelocity) * 0.25;
    float2 displacementGradient = float2(right.b - left.b, up.b - down.b) * 0.5;
    float divergence = ((rightVelocity.x - leftVelocity.x) + (upVelocity.y - downVelocity.y)) * 0.5;
    float inertialDisplacement = (currentDisplacement - previousDisplacement) * saturate(_HectonWakeTrailDamping);
    float2 uv = (float2(dispatchThreadId.xy) + 0.5) * texelSize;
    float2 curlNoise = ResolveCurlNoise(uv + currentDisplacement * 0.17);
    float curlInfluence = saturate(_HectonWakeTrailCurlStrength) * (0.2 + currentDisplacement * 0.8);
    float diffusion = saturate(_HectonWakeTrailDiffusion);
    float propagation = saturate(_HectonWakeTrailWaveStrength);
    float damping = saturate(_HectonWakeTrailDamping);

    float2 diffusedVelocity = lerp(currentVelocity, neighborAverageVelocity, diffusion);
    float2 nextVelocity = diffusedVelocity - displacementGradient * propagation;
    nextVelocity += curlNoise * curlInfluence;
    nextVelocity *= damping;

    float velocityLengthSq = dot(nextVelocity, nextVelocity);
    if (velocityLengthSq > 1.0)
        nextVelocity *= rsqrt(velocityLengthSq);

    float nextDisplacement = currentDisplacement + inertialDisplacement - divergence * propagation;
    nextDisplacement = lerp(nextDisplacement, neighborAverageDisplacement, diffusion * 0.35);
    nextDisplacement = saturate(nextDisplacement - _HectonWakeTrailFadeDelta);

    _HectonWakeTrailResult[pixel] = float4(EncodeVelocity(nextVelocity), nextDisplacement, currentDisplacement);
}
