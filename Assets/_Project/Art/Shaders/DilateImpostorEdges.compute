#pragma kernel CSMain

Texture2D<float4> _SourceAtlas;
Texture2D<float4> _SourceMaskAtlas;
RWTexture2D<float4> _OutputAtlas;

float4 _AtlasSize;
int _DilationRadius;

float HectonFiniteOr(float value, float fallback)
{
    return (isnan(value) || isinf(value)) ? fallback : value;
}

float2 HectonFiniteOr2(float2 value, float2 fallback)
{
    return (any(isnan(value)) || any(isinf(value))) ? fallback : value;
}

float4 HectonFiniteOr4(float4 value, float4 fallback)
{
    return (any(isnan(value)) || any(isinf(value))) ? fallback : value;
}

[numthreads(8, 8, 1)]
void CSMain(uint3 id : SV_DispatchThreadID)
{
    uint sourceWidth;
    uint sourceHeight;
    uint maskWidth;
    uint maskHeight;
    uint outputWidth;
    uint outputHeight;
    _SourceAtlas.GetDimensions(sourceWidth, sourceHeight);
    _SourceMaskAtlas.GetDimensions(maskWidth, maskHeight);
    _OutputAtlas.GetDimensions(outputWidth, outputHeight);

    if (sourceWidth == 0u || sourceHeight == 0u ||
        maskWidth == 0u || maskHeight == 0u ||
        outputWidth == 0u || outputHeight == 0u)
        return;

    int2 requestedAtlasSize = max(int2(HectonFiniteOr2(_AtlasSize.xy, float2(1.0, 1.0))), int2(1, 1));
    int2 realAtlasSize = int2(
        (int)min(min(sourceWidth, maskWidth), outputWidth),
        (int)min(min(sourceHeight, maskHeight), outputHeight));
    int2 atlasSize = max(min(requestedAtlasSize, realAtlasSize), int2(1, 1));
    if (id.x >= (uint)atlasSize.x || id.y >= (uint)atlasSize.y)
        return;

    int2 pixel = int2(id.xy);
    float4 current = HectonFiniteOr4(_SourceAtlas.Load(int3(pixel, 0)), float4(0.0, 0.0, 0.0, 0.0));
    float currentMask = HectonFiniteOr(_SourceMaskAtlas.Load(int3(pixel, 0)).a, 0.0);
    if (currentMask > 0.0005)
    {
        _OutputAtlas[pixel] = current;
        return;
    }

    int radius = clamp(_DilationRadius, 0, 32);
    float bestDistanceSq = 1048576.0;
    float4 best = current;

    [loop]
    for (int y = -radius; y <= radius; y++)
    {
        [loop]
        for (int x = -radius; x <= radius; x++)
        {
            int2 samplePixel = clamp(pixel + int2(x, y), int2(0, 0), atlasSize - int2(1, 1));
            float mask = HectonFiniteOr(_SourceMaskAtlas.Load(int3(samplePixel, 0)).a, 0.0);
            if (mask <= 0.0005)
                continue;

            float d = (float)(x * x + y * y);
            if (d < bestDistanceSq)
            {
                bestDistanceSq = d;
                best = HectonFiniteOr4(_SourceAtlas.Load(int3(samplePixel, 0)), current);
            }
        }
    }

    _OutputAtlas[pixel] = HectonFiniteOr4(best, current);
}
