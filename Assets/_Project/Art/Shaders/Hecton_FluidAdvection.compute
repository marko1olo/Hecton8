#pragma kernel AdvectFluidParticles
#pragma kernel AdvectCarveDebris
#pragma kernel ClearCarveDebrisIndirectArgs
#pragma kernel CullCarveDebrisForRender

#define HECTON_FLUID_ADVECTION_THREADS 64
#define HECTON_BUBBLE_POPPED_FLAG 256u
#define HECTON_DEBRIS_RESTING_FLAG 512u
#define HECTON_DYNAMIC_WAKE_CAPACITY 16
#define HECTON_DYNAMIC_WAKE_MIN_QUALITY_CAPACITY 4
#define HECTON_CARVE_DEBRIS_MAX_SPEED 3.5
#define HECTON_CARVE_DEBRIS_MAX_STEP 0.20
#define HECTON_CARVE_DEBRIS_DEFAULT_BOUNCE 0.4
#define HECTON_CARVE_DEBRIS_DEFAULT_SLEEP_SPEED_SQ 0.0025
// The 60 FPS frame that _FluidAdvectionBuoyancy.w was authored against. See IntegrateVelocity.
#define HECTON_FLUID_REFERENCE_DT 0.0166666667

struct Silt
{
    float3 PositionWS;
    float Life;
    float3 VelocityWS;
    uint Flags;
};

struct Bubble
{
    float3 PositionWS;
    float Life;
    float3 VelocityWS;
    uint Flags;
};

struct Debris
{
    float3 PositionWS;
    float Life;
    float3 VelocityWS;
    uint Flags;
};

StructuredBuffer<Silt> _SiltRead;
RWStructuredBuffer<Silt> _SiltWrite;
StructuredBuffer<Bubble> _BubbleRead;
RWStructuredBuffer<Bubble> _BubbleWrite;
StructuredBuffer<Debris> _DebrisRead;
RWStructuredBuffer<Debris> _DebrisWrite;
StructuredBuffer<float4> _CarveDebrisRead;
RWStructuredBuffer<float4> _CarveDebrisWrite;
StructuredBuffer<float4> _CarveDebrisVelocityRead;
RWStructuredBuffer<float4> _CarveDebrisVelocityWrite;
RWStructuredBuffer<uint> _CarveDebrisVisibleIndices;
RWByteAddressBuffer _CarveDebrisIndirectArgs;

StructuredBuffer<float4> _AbyssalFlowFieldResult;
StructuredBuffer<float4> _DynamicWakes;       // xyz=AUP/runtime position, w=intensity
StructuredBuffer<float4> _DynamicWakeVectors; // xyz=push axis, w=radius
Texture3D<float4> _AbyssalFlowFieldTexture;
SamplerState sampler_AbyssalFlowFieldTexture;

Texture3D<float> _VoxelSdfTexture3D;
SamplerState sampler_VoxelSdfTexture3D;

float4 _FluidAdvectionCounts;        // x=silt, y=bubbles, z=debris, w=max dispatch count
float4 _FluidAdvectionParams;        // x=dt, y=quality pressure, z=flow weight, w=sdf weight
float4 _FluidAdvectionBuoyancy;      // x=silt, y=bubble, z=debris, w=drag
float4 _FluidAdvectionAupShiftDelta; // xyz=runtime rebase delta applied before integration
float4 _CarveDebrisCounts;           // x=capacity, y=cpu-active mirror, z=max visible, w=frame
float4 _CarveDebrisParams;           // x=dt, y=quality pressure, z=sdf weight, w=flow drag
float4 _CarveDebrisForces;           // xyz=gravity, w=life decay per second
float4 _CarveDebrisAupShiftDelta;    // xyz=runtime rebase delta applied before integration
float4 _CarveDebrisCameraParams;     // xyz=camera, w=max render distance squared
float4 _CarveDebrisCullParams;       // xyz=camera forward, w=min forward dot
float4 _CarveDebrisDrawArgsParams;   // x=index count, y=start index, z=base vertex, w=max instances
float4 _DynamicWakeParams;           // x=slot limit, y=quality pressure, z=active count, w=stress
float4 _AbyssalGridResolution;       // xyz=grid resolution, w=flattened count
float4 _AbyssalFlowCenter;           // xyz=center
float4 _AbyssalFlowSpacing;          // xyz=spacing
float4 _AbyssalFlowTextureParams;    // x=resolution, y=world size, z=source world size, w=inv world size
float _AbyssalFlowTextureActive;
float4x4 _VoxelSdfWorldToLocal;
float4 _VoxelSdfInvDoubleHalfExtents;
// y is a signed-distance threshold: a sample BELOW it is solid rock. z/w are read by AdvectCarveDebris and
// are supplied by CarveDebrisComputeRenderer; HectonFluidEngine passes 0 there so the kernel defaults apply.
float4 _FluidAdvectionSdfParams;     // x=active, y=solid threshold, z=debris bounce, w=debris sleep speed sq

float3 Sanitize(float3 value)
{
    return all(isfinite(value)) ? value : float3(0.0, 0.0, 0.0);
}

float3 SafeNormalize(float3 value, float3 fallback)
{
    float lengthSq = dot(value, value);
    float validMask = step(0.000001, lengthSq);
    return lerp(fallback, value * rsqrt(max(lengthSq, 0.000001)), validMask);
}

float3 ClampCarveDebrisVelocity(float3 velocity, float dt)
{
    float maxStepSpeed = HECTON_CARVE_DEBRIS_MAX_STEP * rcp(max(dt, 0.0001));
    float maxSpeed = min(HECTON_CARVE_DEBRIS_MAX_SPEED, maxStepSpeed);
    float maxSpeedSq = maxSpeed * maxSpeed;
    float speedSq = dot(velocity, velocity);
    float clampMask = step(maxSpeedSq, speedSq) * step(0.000001, speedSq);
    velocity *= lerp(1.0, maxSpeed * rsqrt(max(speedSq, 0.000001)), clampMask);

    return Sanitize(velocity);
}

float3 BounceCarveDebrisVelocity(float3 velocity, float3 normalWS, float bounce)
{
    float3 normal = SafeNormalize(normalWS, float3(0.0, 1.0, 0.0));
    float3 reflected = velocity - (2.0 * dot(velocity, normal) * normal);
    return Sanitize(reflected * saturate(bounce));
}

float3 SampleAbyssalFlow(float3 positionWS)
{
    float flowWeight01 = saturate(_FluidAdvectionParams.z);
    if (flowWeight01 <= 0.0001)
        return float3(0.0, 0.0, 0.0);

    if (_AbyssalFlowTextureActive > 0.5 && _AbyssalFlowTextureParams.w > 0.0)
    {
        float3 uvw = (positionWS - _AbyssalFlowCenter.xyz) * _AbyssalFlowTextureParams.w + 0.5;
        if (all(uvw >= 0.0) && all(uvw <= 1.0))
            return Sanitize(_AbyssalFlowFieldTexture.SampleLevel(sampler_AbyssalFlowFieldTexture, uvw, 0.0).xyz) * flowWeight01;
    }

    if (_AbyssalGridResolution.w <= 0.5 || any(_AbyssalFlowSpacing.xyz <= 0.0))
        return float3(0.0, 0.0, 0.0);

    float3 halfExtent = (_AbyssalGridResolution.xyz - 1.0) * _AbyssalFlowSpacing.xyz * 0.5;
    float3 invSpacing = rcp(max(_AbyssalFlowSpacing.xyz, float3(0.001, 0.001, 0.001)));
    float3 localGrid = (positionWS - (_AbyssalFlowCenter.xyz - halfExtent)) * invSpacing;
    int3 cell = clamp((int3)round(localGrid), int3(0, 0, 0), (int3)_AbyssalGridResolution.xyz - 1);
    uint flatIndex = (uint)(cell.x + cell.y * (int)_AbyssalGridResolution.x + cell.z * (int)(_AbyssalGridResolution.x * _AbyssalGridResolution.y));
    if (flatIndex >= (uint)_AbyssalGridResolution.w)
        return float3(0.0, 0.0, 0.0);

    return Sanitize(_AbyssalFlowFieldResult[flatIndex].xyz) * flowWeight01;
}

float3 ApplyDynamicWakes(float3 positionWS, float3 flow)
{
    float qualityPressure01 = saturate(_DynamicWakeParams.y);
    float visualWakeChurn01 = smoothstep(0.35, 1.0, 1.0 - qualityPressure01);
    int rawSlotLimit = min((int)max(0.0, _DynamicWakeParams.x), HECTON_DYNAMIC_WAKE_CAPACITY);
    int qualitySlotLimit = max(0, (int)round(lerp((float)HECTON_DYNAMIC_WAKE_CAPACITY, (float)HECTON_DYNAMIC_WAKE_MIN_QUALITY_CAPACITY, qualityPressure01)));
    int slotLimit = min(rawSlotLimit, qualitySlotLimit);
    if (slotLimit <= 0)
        return Sanitize(flow);

    [unroll]
    for (int i = 0; i < HECTON_DYNAMIC_WAKE_CAPACITY; i++)
    {
        if (i >= slotLimit)
            continue;

        float4 wake = _DynamicWakes[i];
        float4 vectorRadius = _DynamicWakeVectors[i];
        float intensity = max(0.0, wake.w);
        float radius = max(0.0, vectorRadius.w);
        if (intensity <= 0.0001 || radius <= 0.0001)
            continue;

        float3 delta = positionWS - wake.xyz;
        float distSq = dot(delta, delta);
        float radiusSq = radius * radius;
        if (distSq >= radiusSq)
            continue;

        float3 pushAxis = SafeNormalize(vectorRadius.xyz, float3(0.0, 0.0, 1.0));
        float3 radial = SafeNormalize(delta, pushAxis);
        float falloff = saturate(1.0 - (distSq * rcp(max(radiusSq, 0.0001))));
        falloff *= falloff;
        float directionalGate = saturate(dot(radial, pushAxis) * 0.5 + 0.5);
        float3 vortex = cross(pushAxis, radial) * (intensity * falloff * 0.45);
        float3 push = pushAxis * (intensity * falloff * (0.55 + directionalGate * 0.45));
        flow += push + vortex;

        if (visualWakeChurn01 > 0.0001)
        {
            float core = saturate(1.0 - distSq * rcp(max(radiusSq * 0.18, 0.0001)));
            float3 sheetAxis = SafeNormalize(cross(pushAxis, float3(0.0, 1.0, 0.0)), float3(1.0, 0.0, 0.0));
            float3 shear = cross(radial, sheetAxis) * (intensity * falloff * core * 0.22);
            float3 billow = radial * (intensity * falloff * core * 0.18);
            float highIntensityGate = saturate((intensity - 0.55) * 2.2);
            float triangleA = abs(frac(dot(positionWS.xz, float2(0.091, 0.137)) + (float)i * 0.173) * 2.0 - 1.0);
            float triangleB = abs(frac(dot(positionWS.xy, float2(0.067, 0.109)) + (float)i * 0.211) * 2.0 - 1.0);
            float3 churnAxis = SafeNormalize(cross(radial + pushAxis, sheetAxis), pushAxis);
            float3 turbulence = (churnAxis * (triangleA - 0.5) + radial * (triangleB - 0.5)) * (intensity * falloff * highIntensityGate * 0.34);
            flow += (shear + billow + turbulence) * visualWakeChurn01;
        }
    }

    return Sanitize(flow);
}

bool IsSolidVoxel(float3 positionWS)
{
    if (_FluidAdvectionParams.w <= 0.0001 || _FluidAdvectionSdfParams.x <= 0.0001)
        return false;

    if (any(_VoxelSdfInvDoubleHalfExtents.xyz <= 0.0))
        return false;

    float3 localPosition = mul(_VoxelSdfWorldToLocal, float4(positionWS, 1.0)).xyz;
    float3 sampleUv = localPosition * _VoxelSdfInvDoubleHalfExtents.xyz + 0.5;
    if (any(sampleUv < 0.0) || any(sampleUv > 1.0))
        return false;

    // __HectonCaveVoxelSdfTex is a SIGNED DISTANCE field, not a density, so LOW values are solid.
    // Its producer, HectonCaveVoxelLightingVolume.EncodeSignedDistanceField, writes byte 0 or 115 for
    // occupied rock (normalized 0.0 / 0.451) and 140, 166 or 255 for empty water (0.549 / 0.651 / 1.0).
    // The 0.5 threshold is exactly the midpoint between the 115 and 140 shells. Hecton_DeferredCaustics
    // decodes the same texture the same way - lerp(-range, +range, encoded), where above 0.5 is a
    // positive distance, i.e. open space. Reading it as a density inverts every collision test.
    float signedDistance01 = _VoxelSdfTexture3D.SampleLevel(sampler_VoxelSdfTexture3D, sampleUv, 0.0);
    return signedDistance01 < _FluidAdvectionSdfParams.y;
}

float3 IntegrateVelocity(float3 velocity, float3 flow, float buoyancy, float dt)
{
    // _FluidAdvectionBuoyancy.w (FluidAdvectionVelocityBlend, 0.82) is a per-FRAME blend, not a rate.
    // Applied raw it makes drag framerate-dependent: the same constant pulls twice as hard per second at
    // 120 FPS as at 60, so particles lock to the flow field harder the faster the machine renders. Convert
    // it to a rate against the 60 FPS frame it was authored on, then re-integrate for the real dt. The
    // sibling AdvectCarveDebris kernel already does this correctly with a dt-scaled _CarveDebrisParams.w.
    //
    // Exactly identity at 60 FPS: -log(1 - 0.82) / (1/60) = 102.888/s, and 1 - exp(-102.888/60) = 0.82.
    // So the authored feel is preserved and only off-60 framerates change. This also removes an anomaly at
    // dt = 0, where the raw blend still moved velocity despite no time having passed.
    float blendAtReferenceDt = saturate(_FluidAdvectionBuoyancy.w);
    float retained = max(1.0 - blendAtReferenceDt, 0.000001);
    float dragRatePerSecond = -log(retained) * rcp(HECTON_FLUID_REFERENCE_DT);
    float drag = saturate(1.0 - exp(-dragRatePerSecond * max(dt, 0.0)));
    float3 targetVelocity = flow + float3(0.0, buoyancy, 0.0);
    return Sanitize(lerp(velocity, targetVelocity, drag));
}

[numthreads(HECTON_FLUID_ADVECTION_THREADS, 1, 1)]
void AdvectFluidParticles(uint3 id : SV_DispatchThreadID)
{
    uint index = id.x;
    uint siltCount = (uint)max(0.0, _FluidAdvectionCounts.x);
    uint bubbleCount = (uint)max(0.0, _FluidAdvectionCounts.y);
    uint debrisCount = (uint)max(0.0, _FluidAdvectionCounts.z);
    float dt = min(max(_FluidAdvectionParams.x, 0.0), 0.0666667);
    float3 shiftDelta = _FluidAdvectionAupShiftDelta.xyz;

    if (index < siltCount)
    {
        Silt particle = _SiltRead[index];
        float3 previousPosition = particle.PositionWS + shiftDelta;
        float3 flow = SampleAbyssalFlow(previousPosition);
        flow = ApplyDynamicWakes(previousPosition, flow);
        float3 velocity = IntegrateVelocity(particle.VelocityWS, flow, _FluidAdvectionBuoyancy.x, dt);
        float3 nextPosition = previousPosition + velocity * dt;

        if (IsSolidVoxel(nextPosition))
        {
            particle.PositionWS = previousPosition;
            particle.VelocityWS = float3(0.0, 0.0, 0.0);
        }
        else
        {
            particle.PositionWS = nextPosition;
            particle.VelocityWS = velocity;
        }

        _SiltWrite[index] = particle;
    }

    if (index < bubbleCount)
    {
        Bubble particle = _BubbleRead[index];
        float3 previousPosition = particle.PositionWS + shiftDelta;
        float3 flow = SampleAbyssalFlow(previousPosition) * saturate(1.0 - _FluidAdvectionParams.y);
        flow = ApplyDynamicWakes(previousPosition, flow);
        float3 velocity = IntegrateVelocity(particle.VelocityWS, flow, _FluidAdvectionBuoyancy.y, dt);
        float3 nextPosition = previousPosition + velocity * dt;

        if (IsSolidVoxel(nextPosition))
        {
            particle.PositionWS = previousPosition;
            particle.VelocityWS = float3(0.0, 0.0, 0.0);
            particle.Life = 0.0;
            particle.Flags |= HECTON_BUBBLE_POPPED_FLAG;
        }
        else
        {
            particle.PositionWS = nextPosition;
            particle.VelocityWS = velocity;
            particle.Life = max(0.0, particle.Life - dt * 0.05);
        }

        _BubbleWrite[index] = particle;
    }

    if (index < debrisCount)
    {
        Debris particle = _DebrisRead[index];
        float3 previousPosition = particle.PositionWS + shiftDelta;
        float3 flow = SampleAbyssalFlow(previousPosition) * saturate(1.0 - _FluidAdvectionParams.y);
        flow = ApplyDynamicWakes(previousPosition, flow);
        float3 velocity = IntegrateVelocity(particle.VelocityWS, flow, _FluidAdvectionBuoyancy.z, dt);
        float3 nextPosition = previousPosition + velocity * dt;

        if (IsSolidVoxel(nextPosition))
        {
            particle.PositionWS = previousPosition;
            particle.VelocityWS = float3(0.0, 0.0, 0.0);
            particle.Flags |= HECTON_DEBRIS_RESTING_FLAG;
        }
        else
        {
            particle.PositionWS = nextPosition;
            particle.VelocityWS = velocity;
        }

        _DebrisWrite[index] = particle;
    }
}

[numthreads(1, 1, 1)]
void ClearCarveDebrisIndirectArgs(uint3 id : SV_DispatchThreadID)
{
    uint indexCount = (uint)max(0.0, _CarveDebrisDrawArgsParams.x);
    uint startIndex = (uint)max(0.0, _CarveDebrisDrawArgsParams.y);
    uint baseVertex = (uint)max(0.0, _CarveDebrisDrawArgsParams.z);
    _CarveDebrisIndirectArgs.Store(0, indexCount);
    _CarveDebrisIndirectArgs.Store(4, 0u);
    _CarveDebrisIndirectArgs.Store(8, startIndex);
    _CarveDebrisIndirectArgs.Store(12, baseVertex);
    _CarveDebrisIndirectArgs.Store(16, 0u);
}

[numthreads(HECTON_FLUID_ADVECTION_THREADS, 1, 1)]
void AdvectCarveDebris(uint3 id : SV_DispatchThreadID)
{
    uint index = id.x;
    uint capacity = (uint)max(0.0, _CarveDebrisCounts.x);
    if (index >= capacity)
        return;

    float4 particle = _CarveDebrisRead[index];
    float4 velocityPacked = _CarveDebrisVelocityRead[index];

    float dt = min(max(_CarveDebrisParams.x, 0.0), 0.0666667);
    float liveMask = step(0.000001, particle.w);
    float3 previousPosition = particle.xyz + _CarveDebrisAupShiftDelta.xyz;
    float3 velocity = Sanitize(velocityPacked.xyz);
    float qualityPressure01 = saturate(_CarveDebrisParams.y);
    float flowInfluence01 = saturate(1.0 - qualityPressure01);
    float3 flow = ApplyDynamicWakes(previousPosition, SampleAbyssalFlow(previousPosition)) * flowInfluence01;
    float flowBlend = saturate(max(0.0, _CarveDebrisParams.w) * dt * flowInfluence01);
    velocity = Sanitize(lerp(velocity, flow, flowBlend) + _CarveDebrisForces.xyz * dt);
    velocity = ClampCarveDebrisVelocity(velocity, dt);
    float3 nextPosition = previousPosition + velocity * dt;
    float lifeDecay = max(0.0, _CarveDebrisForces.w) * dt;

    float sdfWeight01 = saturate(_CarveDebrisParams.z);
    float solidMask = (sdfWeight01 > 0.0001 && IsSolidVoxel(nextPosition)) ? sdfWeight01 : 0.0;
    float planeMask = (sdfWeight01 <= 0.0001 && nextPosition.y < 0.0) ? 1.0 : 0.0;
    float collisionMask = max(solidMask, planeMask);
    float3 resolvedPosition = lerp(Sanitize(nextPosition), previousPosition, collisionMask);
    resolvedPosition.y = lerp(resolvedPosition.y, max(resolvedPosition.y, 0.0), planeMask);
    float resolvedLife = max(0.0, particle.w - lifeDecay * lerp(1.0, 2.5, collisionMask));
    float bounce = _FluidAdvectionSdfParams.z > 0.0 ? _FluidAdvectionSdfParams.z : HECTON_CARVE_DEBRIS_DEFAULT_BOUNCE;
    float sleepSpeedSq = _FluidAdvectionSdfParams.w > 0.0 ? _FluidAdvectionSdfParams.w : HECTON_CARVE_DEBRIS_DEFAULT_SLEEP_SPEED_SQ;
    float3 bouncedVelocity = BounceCarveDebrisVelocity(velocity, float3(0.0, 1.0, 0.0), bounce);
    bouncedVelocity = lerp(bouncedVelocity, float3(0.0, 0.0, 0.0), step(dot(bouncedVelocity, bouncedVelocity), sleepSpeedSq));
    velocity = lerp(velocity, bouncedVelocity, collisionMask);
    particle.xyz = lerp(particle.xyz, resolvedPosition, liveMask);
    particle.w = lerp(particle.w, resolvedLife, liveMask);
    velocity = lerp(velocityPacked.xyz, velocity, liveMask);

    float finiteMask = (all(isfinite(particle)) && all(isfinite(velocity))) ? 1.0 : 0.0;
    particle = lerp(float4(0.0, 0.0, 0.0, 0.0), particle, finiteMask);
    velocity = lerp(float3(0.0, 0.0, 0.0), velocity, finiteMask);

    _CarveDebrisWrite[index] = particle;
    _CarveDebrisVelocityWrite[index] = float4(velocity, 0.0);
}

[numthreads(HECTON_FLUID_ADVECTION_THREADS, 1, 1)]
void CullCarveDebrisForRender(uint3 id : SV_DispatchThreadID)
{
    uint index = id.x;
    uint capacity = (uint)max(0.0, _CarveDebrisCounts.x);
    if (index >= capacity)
        return;

    float4 particle = _CarveDebrisRead[index];
    float finiteMask = all(isfinite(particle)) ? 1.0 : 0.0;
    float liveMask = step(0.000001, particle.w);
    float3 delta = particle.xyz - _CarveDebrisCameraParams.xyz;
    float distanceSq = dot(delta, delta);
    float maxDistanceSq = _CarveDebrisCameraParams.w;
    float distanceLimitMask = step(0.000001, maxDistanceSq);
    float distanceMask = lerp(1.0, step(distanceSq, maxDistanceSq), distanceLimitMask);
    float3 cameraForward = _CarveDebrisCullParams.xyz;
    float forwardLengthSq = dot(cameraForward, cameraForward);
    float coneEnabledMask = step(0.000001, forwardLengthSq);
    float forwardDot = dot(delta, cameraForward) * rsqrt(max(distanceSq * forwardLengthSq, 0.000001));
    float nearCameraMask = 1.0 - step(0.25, distanceSq);
    float coneMask = max(nearCameraMask, lerp(1.0, step(_CarveDebrisCullParams.w, forwardDot), coneEnabledMask));
    uint maxVisible = (uint)max(0.0, _CarveDebrisCounts.z);
    uint visibleIncrement = (uint)(finiteMask * liveMask * distanceMask * coneMask * step(0.5, (float)maxVisible));
    if (visibleIncrement == 0u)
        return;

    uint visibleSlot;
    _CarveDebrisIndirectArgs.InterlockedAdd(4, visibleIncrement, visibleSlot);
    if (visibleSlot >= maxVisible)
    {
        uint ignoredRollbackSlot;
        _CarveDebrisIndirectArgs.InterlockedAdd(4, 0xffffffffu, ignoredRollbackSlot);
        return;
    }

    _CarveDebrisVisibleIndices[visibleSlot] = index;
}
