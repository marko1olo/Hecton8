#pragma kernel CS_ClearArgs
#pragma kernel CS_CullDrones

struct DroneCullingState
{
    float3 Position;
    uint PackedStateFactionCorridor;
};

struct DroneRenderInstance
{
    float4x4 Matrix;
    float TransactionProgress;
    float3 Padding;
};

StructuredBuffer<DroneCullingState> _DroneStates;
StructuredBuffer<float4x4> _DroneMatrices;
StructuredBuffer<DroneRenderInstance> _DroneRenderInstances;
AppendStructuredBuffer<float4x4> _InstanceMatrices;
AppendStructuredBuffer<DroneRenderInstance> _DroneVisibleInstances;
AppendStructuredBuffer<uint> _DroneVisibleIndices;
RWByteAddressBuffer _IndirectArgsBuffer;

float4 _CameraFrustumPlanes[6];
int _DroneCount;
float _DroneCullRadius;
float3 _CameraPositionWS;
float _DroneRenderDistanceSq;

[numthreads(1, 1, 1)]
void CS_ClearArgs(uint3 id : SV_DispatchThreadID)
{
    _IndirectArgsBuffer.Store(4, 0u);
}

bool IsSphereVisible(float3 center, float radius)
{
    [unroll]
    for (uint i = 0u; i < 6u; i++)
    {
        float4 plane = _CameraFrustumPlanes[i];
        if (dot(plane.xyz, center) + plane.w < -radius)
            return false;
    }

    return true;
}

[numthreads(64, 1, 1)]
void CS_CullDrones(uint3 id : SV_DispatchThreadID)
{
    uint index = id.x;
    if (index >= (uint)_DroneCount)
        return;

    DroneCullingState drone = _DroneStates[index];
    uint runtimeState = drone.PackedStateFactionCorridor & 0xFFu;
    if (runtimeState == 0u || runtimeState == 8u || runtimeState == 9u)
        return;

    float3 cameraOffset = drone.Position - _CameraPositionWS;
    if (dot(cameraOffset, cameraOffset) > _DroneRenderDistanceSq)
        return;

    if (!IsSphereVisible(drone.Position, max(0.01, _DroneCullRadius)))
        return;

    _InstanceMatrices.Append(_DroneMatrices[index]);
    _DroneVisibleInstances.Append(_DroneRenderInstances[index]);
    _DroneVisibleIndices.Append(index);
}
