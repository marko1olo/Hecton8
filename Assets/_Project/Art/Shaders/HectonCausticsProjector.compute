#pragma kernel ProjectCaustics

RWTexture2D<float> _HectonCausticsOutput;

float4 _HectonCausticsSimulationParamsA;
float4 _HectonCausticsSimulationParamsB;
float4 _HectonCausticsSimulationParamsC;
float4 _HectonCausticsTexelSize;
float4 _HectonProjectedCausticsWorldRect;
float4 _HectonCaveVoxelHalfExtents;
float4x4 _HectonCaveVoxelWorldToLocal;
float _HectonCaveVoxelActive;

Texture3D<float> _HectonCaveVoxelSdfTex;
SamplerState sampler_HectonCaveVoxelSdfTex;
Texture2D<float> _HectonCausticsHeightTexture;

int _HectonCausticsHeightResolution;
float3 _HectonCausticsTerrainPosition;
float3 _HectonCausticsTerrainSize;
float _HectonCausticsHeightTextureAvailable;

float2 Hash22(float2 p)
{
    float3 p3 = frac(float3(p.xyx) * float3(0.1031, 0.1030, 0.0973));
    p3 += dot(p3, p3.yzx + 33.33);
    return frac((p3.xx + p3.yz) * p3.zy);
}

float VoronoiRidge(float2 uv, float cellDensity, float timePhase)
{
    float2 domain = uv * cellDensity;
    float2 baseCell = floor(domain);
    float2 fracCell = frac(domain);
    float nearest = 9999.0;
    float secondNearest = 9999.0;

    [unroll]
    for (int y = -1; y <= 1; y++)
    {
        [unroll]
        for (int x = -1; x <= 1; x++)
        {
            float2 offset = float2(x, y);
            float2 cell = baseCell + offset;
            float2 jitter = Hash22(cell);
            float2 animatedPoint = offset + jitter - fracCell;
            animatedPoint += float2(
                sin((jitter.x + timePhase) * 6.2831853),
                cos((jitter.y + timePhase * 1.37) * 6.2831853)) * 0.12;

            float distanceSq = dot(animatedPoint, animatedPoint);
            if (distanceSq < nearest)
            {
                secondNearest = nearest;
                nearest = distanceSq;
            }
            else if (distanceSq < secondNearest)
            {
                secondNearest = distanceSq;
            }
        }
    }

    float nearestDistance = sqrt(nearest);
    float secondNearestDistance = sqrt(secondNearest);
    return saturate(secondNearestDistance - nearestDistance);
}

float SampleCaveSignedDistance(float3 positionWS)
{
    if (_HectonCaveVoxelActive <= 0.5)
        return _HectonCaveVoxelHalfExtents.w;

    float3 halfExtents = max(_HectonCaveVoxelHalfExtents.xyz, float3(0.001, 0.001, 0.001));
    float3 localPosition = mul(_HectonCaveVoxelWorldToLocal, float4(positionWS, 1.0)).xyz;
    float3 sampleUv = localPosition / (halfExtents * 2.0) + 0.5;
    if (any(sampleUv < 0.0) || any(sampleUv > 1.0))
        return _HectonCaveVoxelHalfExtents.w;

    float encoded = _HectonCaveVoxelSdfTex.SampleLevel(sampler_HectonCaveVoxelSdfTex, sampleUv, 0).r;
    return lerp(-_HectonCaveVoxelHalfExtents.w, _HectonCaveVoxelHalfExtents.w, encoded);
}

float SampleHeight01(float2 uv)
{
    uv = saturate(uv);
    float resolutionMinusOne = max((float)_HectonCausticsHeightResolution - 1.0, 1.0);
    float2 sampleCoord = uv * resolutionMinusOne;
    int2 pixelMin = (int2)floor(sampleCoord);
    int2 pixelMax = min(pixelMin + 1, int2(_HectonCausticsHeightResolution - 1, _HectonCausticsHeightResolution - 1));
    float2 fracPart = frac(sampleCoord);

    float h00 = _HectonCausticsHeightTexture.Load(int3(pixelMin, 0));
    float h10 = _HectonCausticsHeightTexture.Load(int3(int2(pixelMax.x, pixelMin.y), 0));
    float h01 = _HectonCausticsHeightTexture.Load(int3(int2(pixelMin.x, pixelMax.y), 0));
    float h11 = _HectonCausticsHeightTexture.Load(int3(pixelMax, 0));

    float hx0 = lerp(h00, h10, fracPart.x);
    float hx1 = lerp(h01, h11, fracPart.x);
    return lerp(hx0, hx1, fracPart.y);
}

float3 SampleTerrainNormal(float2 uv)
{
    float texel = rcp(max((float)_HectonCausticsHeightResolution - 1.0, 1.0));
    float2 offsetX = float2(texel, 0.0);
    float2 offsetZ = float2(0.0, texel);

    float left = SampleHeight01(uv - offsetX);
    float right = SampleHeight01(uv + offsetX);
    float back = SampleHeight01(uv - offsetZ);
    float front = SampleHeight01(uv + offsetZ);

    float3 tangentX = float3(_HectonCausticsTerrainSize.x * texel * 2.0, (right - left) * _HectonCausticsTerrainSize.y, 0.0);
    float3 tangentZ = float3(0.0, (front - back) * _HectonCausticsTerrainSize.y, _HectonCausticsTerrainSize.z * texel * 2.0);
    return normalize(cross(tangentZ, tangentX));
}

float SampleProjectedFloorMask(float2 worldXZ)
{
    if (_HectonCausticsHeightTextureAvailable <= 0.5 || _HectonCausticsHeightResolution <= 1)
        return 1.0;

    float2 terrainUv = float2(
        (worldXZ.x - _HectonCausticsTerrainPosition.x) / max(_HectonCausticsTerrainSize.x, 0.001),
        (worldXZ.y - _HectonCausticsTerrainPosition.z) / max(_HectonCausticsTerrainSize.z, 0.001));
    if (any(terrainUv < 0.0) || any(terrainUv > 1.0))
        return 1.0;

    float3 normalWS = SampleTerrainNormal(terrainUv);
    return saturate(dot(normalWS, float3(0.0, 1.0, 0.0)));
}

[numthreads(8, 8, 1)]
void ProjectCaustics(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint width;
    uint height;
    _HectonCausticsOutput.GetDimensions(width, height);
    if (dispatchThreadId.x >= width || dispatchThreadId.y >= height)
        return;

    float2 texelSize = _HectonCausticsTexelSize.xy;
    float2 surfaceUv = (float2(dispatchThreadId.xy) + 0.5) * texelSize;
    float2 uv = surfaceUv;

    float primaryDensity = max(_HectonCausticsSimulationParamsA.x, 0.5);
    float secondaryDensity = max(_HectonCausticsSimulationParamsA.y, primaryDensity);
    float primarySpeed = _HectonCausticsSimulationParamsA.z;
    float secondarySpeed = _HectonCausticsSimulationParamsA.w;
    float sharpness = max(_HectonCausticsSimulationParamsB.x, 0.1);
    float secondaryWeight = saturate(_HectonCausticsSimulationParamsB.y);
    float timeValue = _HectonCausticsSimulationParamsB.z;
    float waveDisplacement = _HectonCausticsSimulationParamsC.x;
    float2 waveFlow = _HectonCausticsSimulationParamsC.yz;
    float wavePhase = _HectonCausticsSimulationParamsC.w;
    float waveDisplacementAbs = abs(waveDisplacement);
    float2 waveOffset = waveFlow * 0.0125 + float2(waveDisplacement * 0.018, -waveDisplacement * 0.013);
    uv += waveOffset;
    primaryDensity *= lerp(0.94, 1.08, saturate(waveDisplacementAbs * 0.2));
    secondaryDensity *= lerp(0.92, 1.12, saturate(length(waveFlow) * 0.08));

    float primaryTime = timeValue * primarySpeed + wavePhase;
    float secondaryTime = timeValue * secondarySpeed + wavePhase * 1.37 + 17.0;
    float primaryLayer = VoronoiRidge(uv + float2(primaryTime, -primaryTime * 0.61), primaryDensity, primaryTime);
    float secondaryLayer = VoronoiRidge(uv + float2(-secondaryTime * 0.73, secondaryTime), secondaryDensity, secondaryTime);
    float combined = lerp(primaryLayer, max(primaryLayer, secondaryLayer), secondaryWeight);
    combined = pow(saturate(combined * 2.3), sharpness);
    combined *= lerp(0.92, 1.18, saturate(waveDisplacementAbs * 0.14 + length(waveFlow) * 0.035));
    combined = saturate(combined * 1.35);

    float2 worldXZ = float2(
        lerp(_HectonProjectedCausticsWorldRect.x, _HectonProjectedCausticsWorldRect.x + rcp(max(_HectonProjectedCausticsWorldRect.z, 0.0001)), surfaceUv.x),
        lerp(_HectonProjectedCausticsWorldRect.y, _HectonProjectedCausticsWorldRect.y + rcp(max(_HectonProjectedCausticsWorldRect.w, 0.0001)), surfaceUv.y));
    float3 projectedWorldPosition = float3(worldXZ.x, _HectonCausticsSimulationParamsB.w, worldXZ.y);
    if (SampleCaveSignedDistance(projectedWorldPosition) <= 0.0)
        combined = 0.0;

    combined *= SampleProjectedFloorMask(worldXZ);

    _HectonCausticsOutput[dispatchThreadId.xy] = combined;
}
