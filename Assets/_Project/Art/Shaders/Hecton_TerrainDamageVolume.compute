#pragma kernel StampDamageVolume

struct DamageVolumeStampCommand
{
    float4 PositionRadius;
    float4 StrengthPadding;
};

Texture3D<float4> _HectonDamageVolumeSource;
RWTexture3D<float4> _HectonDamageVolumeResult;
StructuredBuffer<DamageVolumeStampCommand> _HectonDamageVolumeStampCommands;

int _HectonDamageVolumeStampCount;
float _HectonDamageVolumeRecovery;
float4 _HectonDamageVolumeWorldMinParam;
float4 _HectonDamageVolumeInvSizeParam;
int3 _HectonDamageVolumeResolution;

[numthreads(4, 4, 4)]
void StampDamageVolume(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    if (dispatchThreadId.x >= _HectonDamageVolumeResolution.x ||
        dispatchThreadId.y >= _HectonDamageVolumeResolution.y ||
        dispatchThreadId.z >= _HectonDamageVolumeResolution.z)
    {
        return;
    }

    float3 resolution = max((float3)_HectonDamageVolumeResolution, 1.0);
    float3 volumeUv = ((float3)dispatchThreadId + 0.5) / resolution;
    float3 worldPosition = _HectonDamageVolumeWorldMinParam.xyz + volumeUv / max(_HectonDamageVolumeInvSizeParam.xyz, 0.000001);

    float current = _HectonDamageVolumeSource.Load(int4(dispatchThreadId.xyz, 0)).r;
    current = max(0.0, current - _HectonDamageVolumeRecovery);

    [loop]
    for (int stampIndex = 0; stampIndex < _HectonDamageVolumeStampCount; stampIndex++)
    {
        float4 positionRadius = _HectonDamageVolumeStampCommands[stampIndex].PositionRadius;
        float radius = max(positionRadius.w, 0.0001);
        float normalized = saturate(1.0 - length(worldPosition - positionRadius.xyz) / radius);
        float stamp = normalized * normalized * saturate(_HectonDamageVolumeStampCommands[stampIndex].StrengthPadding.x);
        current = max(current, stamp);
    }

    _HectonDamageVolumeResult[dispatchThreadId.xyz] = float4(current, current, current, current);
}
