#define HECTON_GLOBAL_WAKE_CAPACITY 16

struct BoidData
{
    // Byte layout proof vs C# BoidData:
    // Position   -> offset  0, size 12
    // Velocity   -> offset 12, size 12
    // Panic      -> offset 24, size  4
    // StateFlags -> offset 28, size  4
    float3 Position;
    float3 Velocity;
    float Panic;
    uint StateFlags;
};

struct GrazingAnchorData
{
    float3 Position;
    float Radius;
    float Strength;
    float Phase;
    float2 Padding;
};

struct FormationBeaconData
{
    float3 Position;
    float Radius;
    float Strength;
    float Phase;
    float2 Padding;
};

struct FormationObstacleData
{
    float3 Position;
    float Radius;
    float Weight;
    float3 Padding;
};

struct LeviathanNodeData
{
    float3 Position;
    float Distance01;
    float3 Tangent;
    float Radius;
};

struct MassiveThreatData
{
    float3 Position;
    float InnerRadius;
    float PanicRadius;
    float Strength;
    float EndTime;
    float3 DirectionWS;
    uint ThreatFlags;
};

