#define _FormationMode (_ParasiteAndFormation0.y)
#define _FormationWeight (_ParasiteAndFormation0.z)
#define _FormationRingThickness (_ParasiteAndFormation0.w)
#define _FormationPulseAmplitude (_Formation1.x)
#define _FormationPulseSpeed (_Formation1.y)
#define _FormationBreakPanicThreshold (_Formation1.z)
#define _FormationObstacleWeight (_Formation1.w)
