#define THREAD_GROUP_SIZE 64
#define EPSILON 0.0001
#define TAU 6.28318530718
#define PANIC_CONTAGION_GAIN 0.10
#define PANIC_CONTAGION_THRESHOLD 0.35
#define DENSITY_CAP_MAX_BOIDS 8.0
#define DENSITY_CAP_RADIUS_SQ 4.0
#define BOID_FLAG_ACTIVE 1u
#define BOID_FLAG_HUNTING 2u
#define BOID_FLAG_FLEEING 4u
#define BOID_FLAG_CONSUMED 8u
#define SIM_LOD_TIER_FULL 0
#define SIM_LOD_TIER_SIMPLIFIED 1
#define SIM_LOD_TIER_SLEEP 2
#define THREAT_VOXEL_DDA_MAX_STEPS 128

float Hash11(float inputValue);

float GetPhaseTime()
{
    return _SimulationTime + _PhaseOffset;
}

uint BuildAliveStateFlags()
{
    return BOID_FLAG_ACTIVE | BOID_FLAG_HUNTING;
}

uint BuildFleeStateFlags()
{
    return BOID_FLAG_ACTIVE | BOID_FLAG_FLEEING;
}

bool IsConsumedState(uint stateFlags)
{
    return (stateFlags & BOID_FLAG_CONSUMED) != 0u;
}

bool IsFleeState(uint stateFlags)
{
    return (stateFlags & BOID_FLAG_FLEEING) != 0u;
}

float SeedFromIndex(uint index)
{
    return Hash11((float)index * 0.6180339 + 0.12345);
}

float Hash11(float inputValue)
{
    return frac(sin(inputValue * 12.9898 + 78.233) * 43758.5453);
}

float Hash21(float2 value)
{
    value = frac(value * float2(0.1031, 0.1030));
    value += dot(value, value.yx + 33.33);
    return frac((value.x + value.y) * value.x);
}

float ValueNoise2(float2 value)
{
    float2 cell = floor(value);
    float2 fracValue = frac(value);
    float2 smoothValue = fracValue * fracValue * (3.0 - 2.0 * fracValue);

    float n00 = Hash21(cell + float2(0.0, 0.0));
    float n10 = Hash21(cell + float2(1.0, 0.0));
    float n01 = Hash21(cell + float2(0.0, 1.0));
    float n11 = Hash21(cell + float2(1.0, 1.0));

    float nx0 = lerp(n00, n10, smoothValue.x);
    float nx1 = lerp(n01, n11, smoothValue.x);
    return lerp(nx0, nx1, smoothValue.y);
}

float3 ResolveFlowField(float3 positionWS, float phaseTime)
{
    float time = phaseTime * 0.12;
    float sx = positionWS.x * 0.018;
    float sz = positionWS.z * 0.018;
    float nx = ValueNoise2(float2(sx + time, sz + 31.71)) * 2.0 - 1.0;
    float nz = ValueNoise2(float2(sz + time + 67.30, sx + 149.20)) * 2.0 - 1.0;
    float ny = (ValueNoise2(float2(sx + time * 0.7 + 211.50, sz + time * 0.3)) * 2.0 - 1.0) * 0.12;
    float3 driftVelocity = _DeltaTime > 0.0001 ? (_GlobalDriftDelta / max(_DeltaTime, 0.0001)) : float3(0.0, 0.0, 0.0);
    float3 weatherCurrent = _AbyssalFlowWeatherCurrent.xyz;
    if (dot(weatherCurrent, weatherCurrent) > 1.0e+16)
        weatherCurrent = float3(0.0, 0.0, 0.0);

    float proceduralStrength = max(length(driftVelocity) * 0.5, max(_CruiseSpeed * 0.18, 0.22));
    return driftVelocity + weatherCurrent + float3(nx, ny, nz) * proceduralStrength;
}

float3 ResolveFlowTurbulence(float3 positionWS, float phaseTime)
{
    float3 samplePosition = positionWS * 0.3 + phaseTime;
    return float3(
        ValueNoise2(samplePosition.xz + float2(17.1, 3.4)),
        ValueNoise2(samplePosition.xy + float2(11.7, 29.8)),
        ValueNoise2(samplePosition.zy + float2(7.3, 19.4))) * 2.0 - 1.0;
}

bool IsFiniteFloat3(float3 value)
{
    return dot(value, value) < 1.0e+32;
}

bool IsFiniteFloat(float value)
{
    return abs(value) < 1.0e+16;
}

float3 ToCameraRelative(float3 worldPositionWS)
{
    return worldPositionWS - _CameraPosition.xyz;
}

float3 ToWorldSpace(float3 cameraRelativePosition)
{
    return cameraRelativePosition + _CameraPosition.xyz;
}

float WrapAngle(float angle)
{
    if (!IsFiniteFloat(angle))
        return 0.0;

    angle = fmod(angle, TAU);
    if (angle < 0.0)
        angle += TAU;
    return angle;
}

float SafeSin(float angle)
{
    return sin(WrapAngle(angle));
}

float SafeCos(float angle)
{
    return cos(WrapAngle(angle));
}

float3 SafeNormalize(float3 value)
{
    if (!IsFiniteFloat3(value))
        return float3(0.0, 0.0, 0.0);

    float lengthSq = dot(value, value);
    if (!IsFiniteFloat(lengthSq) || lengthSq <= EPSILON)
        return float3(0.0, 0.0, 0.0);

    return value * rsqrt(lengthSq);
}

float3 ClosestPointOnSegment(float3 samplePosition, float3 start, float3 end)
{
    float3 segment = end - start;
    float segmentLengthSq = dot(segment, segment);
    if (segmentLengthSq <= EPSILON)
        return start;

    float t = saturate(dot(samplePosition - start, segment) / segmentLengthSq);
    return start + (segment * t);
}

int3 ResolveGridResolution()
{
    return max(int3(1, 1, 1), _SpatialGridMeta.xyz);
}

int FlattenGridCell(int3 cell, int3 resolution)
{
    return cell.x + cell.y * resolution.x + cell.z * resolution.x * resolution.y;
}

uint FlattenGridCellUnsigned(int3 cell, int3 resolution)
{
    uint rx = (uint)resolution.x;
    uint ry = (uint)resolution.y;
    return (uint)cell.x + ((uint)cell.y * rx) + ((uint)cell.z * rx * ry);
}

float ResolveGridCellSize()
{
    return max(_SpatialGridCellSize, 0.001);
}

bool TryResolveGridCell(float3 positionWS, int3 resolution, out int3 cell)
{
    cell = int3(0, 0, 0);
    if (!IsFiniteFloat3(positionWS))
        return false;

    float safeCellSize = ResolveGridCellSize();
    float3 boundsMin = _SpatialGridOrigin.xyz;
    float3 local = (positionWS - boundsMin) / safeCellSize;
    if (!IsFiniteFloat3(local))
        return false;

    int3 resolvedCell = (int3)floor(local);
    if (any(resolvedCell < 0) || resolvedCell.x >= resolution.x || resolvedCell.y >= resolution.y || resolvedCell.z >= resolution.z)
        return false;

    cell = resolvedCell;
    return true;
}

bool HasThreatVoxelData()
{
    return _ThreatVoxelSolidThreshold > 0 &&
           _ThreatVoxelDimensions.x > 0 &&
           _ThreatVoxelDimensions.y > 0 &&
           _ThreatVoxelDimensions.z > 0 &&
           _ThreatVoxelCellSizeWS.x > 0.0 &&
           _ThreatVoxelCellSizeWS.y > 0.0 &&
           _ThreatVoxelCellSizeWS.z > 0.0;
}

bool HasThreatGridData()
{
    return _ThreatGridActive > 0 &&
           _ThreatGridResolution > 1 &&
           _ThreatGridCellSizeWS > 0.0;
}

bool IsThreatGridInside(int2 cell)
{
    return cell.x >= 0 &&
           cell.y >= 0 &&
           cell.x < _ThreatGridResolution &&
           cell.y < _ThreatGridResolution;
}

int FlattenThreatGridIndex(int2 cell)
{
    return cell.x + (cell.y * _ThreatGridResolution);
}

bool TryWorldToThreatGridCell(float3 worldPositionWS, out int2 cell)
{
    cell = int2(0, 0);
    if (!HasThreatGridData() || !IsFiniteFloat3(worldPositionWS))
        return false;

    float halfExtent = (_ThreatGridResolution - 1) * 0.5 * _ThreatGridCellSizeWS;
    float2 minCorner = _ThreatGridCenterWS.xz - float2(halfExtent, halfExtent);
    float2 local = worldPositionWS.xz - minCorner;
    if (any(local < 0.0))
        return false;

    int2 candidate = (int2)floor(local / max(_ThreatGridCellSizeWS, EPSILON));
    if (!IsThreatGridInside(candidate))
        return false;

    cell = candidate;
    return true;
}

float SampleThreatGridCell(int2 cell)
{
    if (!IsThreatGridInside(cell))
        return 0.0;

    int flatIndex = FlattenThreatGridIndex(cell);
    if (flatIndex < 0)
        return 0.0;

    return ((float)_ThreatGrid2D[flatIndex]) * (1.0 / 255.0);
}

float SampleThreatGridAtWorldPosition(float3 worldPositionWS)
{
    int2 cell;
    if (!TryWorldToThreatGridCell(worldPositionWS, cell))
        return 0.0;

    return SampleThreatGridCell(cell);
}

float2 ComputeThreatGridGradientAtWorldPosition(float3 worldPositionWS)
{
    int2 cell;
    if (!TryWorldToThreatGridCell(worldPositionWS, cell))
        return float2(0.0, 0.0);

    float invSpan = 1.0 / max(_ThreatGridCellSizeWS * 2.0, EPSILON);
    return float2(
        (SampleThreatGridCell(cell + int2(1, 0)) - SampleThreatGridCell(cell + int2(-1, 0))) * invSpan,
        (SampleThreatGridCell(cell + int2(0, 1)) - SampleThreatGridCell(cell + int2(0, -1))) * invSpan);
}

bool IsThreatVoxelInside(int3 voxel)
{
    return voxel.x >= 0 &&
           voxel.y >= 0 &&
           voxel.z >= 0 &&
           voxel.x < _ThreatVoxelDimensions.x &&
           voxel.y < _ThreatVoxelDimensions.y &&
           voxel.z < _ThreatVoxelDimensions.z;
}

int FlattenThreatVoxelIndex(int3 voxel)
{
    return voxel.x +
           (voxel.y * _ThreatVoxelDimensions.x) +
           (voxel.z * _ThreatVoxelDimensions.x * _ThreatVoxelDimensions.y);
}

bool TryWorldToThreatVoxel(float3 worldPositionWS, out int3 voxel)
{
    voxel = int3(0, 0, 0);
    if (!HasThreatVoxelData() || !IsFiniteFloat3(worldPositionWS))
        return false;

    float3 safeCellSize = max(_ThreatVoxelCellSizeWS, float3(EPSILON, EPSILON, EPSILON));
    float3 local = worldPositionWS - _ThreatVoxelOriginWS;
    if (!IsFiniteFloat3(local) || any(local < 0.0))
        return false;

    int3 candidate = (int3)floor(local / safeCellSize);
    if (!IsThreatVoxelInside(candidate))
        return false;

    voxel = candidate;
    return true;
}

uint SampleThreatVoxel(int3 voxel)
{
    int flatIndex = FlattenThreatVoxelIndex(voxel);
    if (flatIndex < 0)
        return 0u;

    return _ThreatVoxelGrid[flatIndex];
}

bool IsThreatVoxelSolid(uint voxelValue)
{
    return voxelValue >= (uint)max(_ThreatVoxelSolidThreshold, 1);
}

bool TryResolveThreatVoxelAvoidance(float3 positionWS, float3 velocityWS, out float3 avoidanceNormalWS, out float avoidanceGate)
{
    avoidanceNormalWS = float3(0.0, 0.0, 0.0);
    avoidanceGate = 0.0;
    if (!HasThreatVoxelData())
        return false;

    float speedSq = dot(velocityWS, velocityWS);
    if (!IsFiniteFloat(speedSq) || speedSq <= EPSILON)
        return false;

    float3 rayDirection = SafeNormalize(velocityWS);
    if (dot(rayDirection, rayDirection) <= EPSILON)
        return false;

    float bodyRadius = max(_BoidBodyRadius, 0.05);
    float rayStartOffset = bodyRadius;
    float lookAheadDistance = max(_ThreatVoxelLookAheadDistance + rayStartOffset, bodyRadius * 3.0);
    if (lookAheadDistance <= 0.0)
        return false;

    float3 rayStartWS = positionWS + (rayDirection * rayStartOffset);
    int3 currentVoxel = int3(0, 0, 0);
    if (!TryWorldToThreatVoxel(rayStartWS, currentVoxel))
    {
        rayStartWS = positionWS;
        if (!TryWorldToThreatVoxel(rayStartWS, currentVoxel))
            return false;
    }

    if (IsThreatVoxelSolid(SampleThreatVoxel(currentVoxel)))
    {
        avoidanceNormalWS = -rayDirection;
        avoidanceGate = 1.0;
        return true;
    }

    float3 safeCellSize = max(_ThreatVoxelCellSizeWS, float3(EPSILON, EPSILON, EPSILON));
    bool3 positiveMask = rayDirection >= 0.0;
    bool3 activeAxisMask = abs(rayDirection) > EPSILON;
    int3 step = int3(
        positiveMask.x ? 1 : -1,
        positiveMask.y ? 1 : -1,
        positiveMask.z ? 1 : -1);
    float3 cellMin = _ThreatVoxelOriginWS + (float3(currentVoxel.x, currentVoxel.y, currentVoxel.z) * safeCellSize);
    float3 voxelBoundary = cellMin + float3(
        positiveMask.x ? safeCellSize.x : 0.0,
        positiveMask.y ? safeCellSize.y : 0.0,
        positiveMask.z ? safeCellSize.z : 0.0);
    float3 safeAbsDirection = max(abs(rayDirection), float3(EPSILON, EPSILON, EPSILON));
    float3 rayDirectionInverse = 1.0 / safeAbsDirection;
    float3 tMax = abs((voxelBoundary - rayStartWS) * rayDirectionInverse);
    float3 tDelta = safeCellSize * rayDirectionInverse;
    tMax = float3(
        activeAxisMask.x ? tMax.x : 1000000.0,
        activeAxisMask.y ? tMax.y : 1000000.0,
        activeAxisMask.z ? tMax.z : 1000000.0);
    tDelta = float3(
        activeAxisMask.x ? tDelta.x : 1000000.0,
        activeAxisMask.y ? tDelta.y : 1000000.0,
        activeAxisMask.z ? tDelta.z : 1000000.0);

    float minCellExtent = min(safeCellSize.x, min(safeCellSize.y, safeCellSize.z));
    int maxSteps = min((int)ceil(lookAheadDistance / max(minCellExtent, EPSILON)) + 2, THREAT_VOXEL_DDA_MAX_STEPS);
    [loop]
    for (int stepIndex = 0; stepIndex < maxSteps; stepIndex++)
    {
        bool3 axisMask = (tMax <= tMax.yzx) & (tMax <= tMax.zxy);
        float nextDistance = min(tMax.x, min(tMax.y, tMax.z));
        if (nextDistance > lookAheadDistance)
            break;

        int3 axisStep = int3(
            axisMask.x ? step.x : 0,
            axisMask.y ? step.y : 0,
            axisMask.z ? step.z : 0);
        currentVoxel += axisStep;
        if (!IsThreatVoxelInside(currentVoxel))
            break;

        if (IsThreatVoxelSolid(SampleThreatVoxel(currentVoxel)))
        {
            float3 rawNormal = float3(-axisStep.x, -axisStep.y, -axisStep.z);
            avoidanceNormalWS = SafeNormalize(rawNormal);
            if (dot(avoidanceNormalWS, avoidanceNormalWS) <= EPSILON)
                avoidanceNormalWS = -rayDirection;

            float clearance = bodyRadius;
            avoidanceGate = 1.0 - saturate((nextDistance - clearance) / max(lookAheadDistance - clearance, 0.001));
            return true;
        }

        tMax += float3(
            axisMask.x ? tDelta.x : 0.0,
            axisMask.y ? tDelta.y : 0.0,
            axisMask.z ? tDelta.z : 0.0);
    }

    return false;
}

bool TryResolveThreatVoxelSurfaceRepulsion(float3 positionWS, out float3 surfaceNormalWS, out float surfaceGate)
{
    surfaceNormalWS = float3(0.0, 0.0, 0.0);
    surfaceGate = 0.0;
    if (!HasThreatVoxelData())
        return false;

    int3 centerVoxel = int3(0, 0, 0);
    if (!TryWorldToThreatVoxel(positionWS, centerVoxel))
        return false;

    float3 safeCellSize = max(_ThreatVoxelCellSizeWS, float3(EPSILON, EPSILON, EPSILON));
    float repulsionDistanceWS = 2.0;
    int3 axisStepBudget = max((int3)1, (int3)ceil(repulsionDistanceWS / safeCellSize));
    const int3 axisDirections[6] =
    {
        int3(1, 0, 0),
        int3(-1, 0, 0),
        int3(0, 1, 0),
        int3(0, -1, 0),
        int3(0, 0, 1),
        int3(0, 0, -1)
    };

    float3 accumulation = float3(0.0, 0.0, 0.0);
    float maxGate = 0.0;
    [unroll]
    for (int axisIndex = 0; axisIndex < 6; axisIndex++)
    {
        int3 axisDirection = axisDirections[axisIndex];
        int maxAxisSteps = axisDirection.x != 0
            ? axisStepBudget.x
            : (axisDirection.y != 0 ? axisStepBudget.y : axisStepBudget.z);
        [loop]
        for (int stepIndex = 0; stepIndex < maxAxisSteps; stepIndex++)
        {
            int3 sampleVoxel = centerVoxel + (axisDirection * stepIndex);
            if (!IsThreatVoxelInside(sampleVoxel))
                break;

            if (!IsThreatVoxelSolid(SampleThreatVoxel(sampleVoxel)))
                continue;

            float axisDistance = (stepIndex + 0.5) * (axisDirection.x != 0
                ? safeCellSize.x
                : (axisDirection.y != 0 ? safeCellSize.y : safeCellSize.z));
            float closeness = 1.0 - saturate(axisDistance / max(repulsionDistanceWS, 0.001));
            if (closeness <= 0.0)
                break;

            accumulation += float3(-axisDirection.x, -axisDirection.y, -axisDirection.z) * closeness;
            maxGate = max(maxGate, closeness);
            break;
        }
    }

    surfaceNormalWS = SafeNormalize(accumulation);
    surfaceGate = maxGate;
    return maxGate > 0.0 && dot(surfaceNormalWS, surfaceNormalWS) > EPSILON;
}

bool TryResolveTransportCapsuleAvoidance(float3 positionWS, float3 velocityWS, out float3 avoidanceNormalWS, out float3 vortexRepulsionWS, out float avoidanceGate)
{
    avoidanceNormalWS = float3(0.0, 0.0, 0.0);
    vortexRepulsionWS = float3(0.0, 0.0, 0.0);
    avoidanceGate = 0.0;
    if (_TransportCapsuleRadius <= EPSILON || _TransportCapsuleHalfLength <= EPSILON)
        return false;

    float3 capsuleForward = SafeNormalize(_TransportCapsuleVelocityWS);
    if (dot(capsuleForward, capsuleForward) <= EPSILON)
        capsuleForward = SafeNormalize(_PlayerForwardWS);
    if (dot(capsuleForward, capsuleForward) <= EPSILON)
        capsuleForward = float3(0.0, 0.0, 1.0);

    float halfLength = max(_TransportCapsuleHalfLength, _TransportCapsuleRadius);
    float3 segmentHalf = capsuleForward * halfLength;
    float3 segmentStart = _TransportCapsulePositionWS - segmentHalf;
    float3 segmentEnd = _TransportCapsulePositionWS + segmentHalf;
    float3 nearestPoint = ClosestPointOnSegment(positionWS, segmentStart, segmentEnd);
    float3 awayFromCapsule = positionWS - nearestPoint;
    float distanceSq = dot(awayFromCapsule, awayFromCapsule);
    float influenceRadius = _TransportCapsuleRadius + max(_PanicPlayerRadius * _PanicPlayerRadiusScale, _BoidBodyRadius * 2.0);
    float influenceRadiusSq = influenceRadius * influenceRadius;
    if (distanceSq >= influenceRadiusSq)
        return false;

    float distanceToAxis = sqrt(max(distanceSq, EPSILON));
    float signedDistance = distanceToAxis - _TransportCapsuleRadius;
    avoidanceNormalWS = distanceSq > EPSILON ? awayFromCapsule * rsqrt(distanceSq) : -capsuleForward;
    avoidanceGate = 1.0 - saturate(signedDistance / max(influenceRadius - _TransportCapsuleRadius, 0.001));
    float3 motionVector = dot(velocityWS, velocityWS) > EPSILON ? velocityWS : _TransportCapsuleVelocityWS;
    float3 swirlDirectionWS = SafeNormalize(cross(avoidanceNormalWS, motionVector));
    if (dot(swirlDirectionWS, swirlDirectionWS) <= EPSILON)
        swirlDirectionWS = SafeNormalize(cross(avoidanceNormalWS, capsuleForward));

    float axialOffset = dot(positionWS - _TransportCapsulePositionWS, capsuleForward);
    float trailingGate = saturate((-axialOffset + _TransportCapsuleRadius) / max(halfLength + influenceRadius, 0.001));
    float3 velocityDirectionWS = SafeNormalize(velocityWS);
    float velocityAlignment = dot(velocityDirectionWS, velocityDirectionWS) > EPSILON
        ? saturate(0.5 + 0.5 * dot(velocityDirectionWS, capsuleForward))
        : 0.5;
    float3 wakeCenterWS = _TransportCapsulePositionWS - capsuleForward * (halfLength + _TransportCapsuleRadius * 1.5);
    float3 wakePullWS = SafeNormalize(wakeCenterWS - positionWS);
    float wakeBlend = trailingGate * avoidanceGate * velocityAlignment;
    vortexRepulsionWS = SafeNormalize(swirlDirectionWS + wakePullWS * (0.75 + wakeBlend * 1.5));
    return avoidanceGate > 0.0;
}

bool TryResolveSubmarineWakeRepulsion(float3 positionWS, out float3 repulsionWS, out float3 vortexWS, out float wakeGate)
{
    repulsionWS = float3(0.0, 0.0, 0.0);
    vortexWS = float3(0.0, 0.0, 0.0);
    wakeGate = 0.0;
    if (_SubmarineWakeRadius <= EPSILON)
        return false;

    float3 hullVelocityWS = _SubmarineWakeVelocityWS;
    float hullSpeed = length(hullVelocityWS);
    if (hullSpeed <= EPSILON)
        return false;

    float3 wakeAxisWS = SafeNormalize(hullVelocityWS);
    float3 deltaToHullWS = positionWS - _SubmarineWakePositionWS;
    float distanceSq = dot(deltaToHullWS, deltaToHullWS);
    float radiusSq = _SubmarineWakeRadius * _SubmarineWakeRadius;
    if (distanceSq >= radiusSq)
        return false;

    float distance = sqrt(max(distanceSq, EPSILON));
    float3 radialNormalWS = distance > EPSILON ? deltaToHullWS / distance : -wakeAxisWS;
    float radialGate = 1.0 - saturate(distance / max(_SubmarineWakeRadius, 0.001));
    float minimumDistanceSq = max(_BoidBodyRadius * _BoidBodyRadius, EPSILON);
    float inverseSquareGate = saturate((_BoidBodyRadius * _SubmarineWakeRadius) / max(distanceSq, minimumDistanceSq));
    wakeGate = saturate((radialGate * 0.65 + inverseSquareGate * 0.35) * saturate(hullSpeed / 4.0));
    if (wakeGate <= 0.0)
        return false;

    float halfLength = max(_SubmarineWakeHalfLength, _SubmarineWakeRadius);
    float axialOffset = dot(deltaToHullWS, wakeAxisWS);
    float trailingGate = saturate((-axialOffset + _SubmarineWakeRadius) / max(halfLength + _SubmarineWakeRadius, 0.001));
    float propellerGate = trailingGate * saturate(hullSpeed / 18.0);
    float3 tangentWS = SafeNormalize(cross(wakeAxisWS, radialNormalWS));
    if (dot(tangentWS, tangentWS) <= EPSILON)
        tangentWS = SafeNormalize(cross(float3(0.0, 1.0, 0.0), radialNormalWS));
    if (dot(tangentWS, tangentWS) <= EPSILON)
        tangentWS = float3(1.0, 0.0, 0.0);

    repulsionWS = radialNormalWS;
    vortexWS = SafeNormalize((tangentWS * (0.85 + propellerGate * 1.65)) + (radialNormalWS * 0.35) - (wakeAxisWS * trailingGate * 0.22));
    return dot(repulsionWS, repulsionWS) > EPSILON && dot(vortexWS, vortexWS) > EPSILON;
}

float3 ResolveAcousticPanicChaos(float3 positionWS, uint boidIndex, out float panicGate)
{
    panicGate = 0.0;
    if (_AcousticPanicRadius <= EPSILON || _AcousticPanicStrength <= EPSILON || _AcousticPanicTimeRemaining <= EPSILON)
        return float3(0.0, 0.0, 0.0);

    float3 fromPing = positionWS - _AcousticPanicOriginWS;
    float distanceSq = dot(fromPing, fromPing);
    float radiusSq = _AcousticPanicRadius * _AcousticPanicRadius;
    if (distanceSq >= radiusSq)
        return float3(0.0, 0.0, 0.0);

    float distanceToPing = sqrt(max(distanceSq, EPSILON));
    float radialGate = 1.0 - smoothstep(_AcousticPanicRadius * 0.25, _AcousticPanicRadius, distanceToPing);
    panicGate = saturate(radialGate * _AcousticPanicStrength);
    if (panicGate <= EPSILON)
        return float3(0.0, 0.0, 0.0);

    float seed = _AcousticPanicSeed + (float)boidIndex * 17.131 + _SimulationTime * 11.719;
    float3 chaos = float3(
        Hash11(seed + positionWS.x * 0.317) * 2.0 - 1.0,
        Hash11(seed + positionWS.y * 0.373) * 2.0 - 1.0,
        Hash11(seed + positionWS.z * 0.419) * 2.0 - 1.0);
    float3 radialDirection = distanceSq > EPSILON ? fromPing * rsqrt(distanceSq) : SafeNormalize(chaos);
    float3 vortexDirection = SafeNormalize(cross(radialDirection, chaos));
    if (dot(vortexDirection, vortexDirection) <= EPSILON)
        vortexDirection = SafeNormalize(cross(radialDirection, float3(0.0, 1.0, 0.0)));
    if (dot(vortexDirection, vortexDirection) <= EPSILON)
        vortexDirection = float3(1.0, 0.0, 0.0);

    return SafeNormalize((chaos * 0.65) + (radialDirection * 0.55) + (vortexDirection * 0.85));
}

float3 ResolveHeadlightPhotophobiaForce(float3 positionWS, float headlightPanic01)
{
    float panicGate = saturate(headlightPanic01);
    if (panicGate <= 0.001)
        return float3(0.0, 0.0, 0.0);

    float3 lightDirectionWS = SafeNormalize(_PlayerForwardWS);
    if (dot(lightDirectionWS, lightDirectionWS) <= EPSILON)
        return float3(0.0, 0.0, 0.0);

    float3 toBoid = positionWS - _PlayerPositionWS;
    float axialDistance = dot(toBoid, lightDirectionWS);
    float coneLength = max(_PanicPlayerRadius * 2.6, 8.0);
    if (axialDistance <= 0.0 || axialDistance >= coneLength)
        return float3(0.0, 0.0, 0.0);

    float axial01 = saturate(axialDistance / coneLength);
    float coneRadius = lerp(max(_BoidBodyRadius * 4.0, 0.35), max(_PanicPlayerRadius, 0.5), axial01);
    float3 coneCenter = _PlayerPositionWS + lightDirectionWS * axialDistance;
    float3 radialOffset = positionWS - coneCenter;
    float radialDistanceSq = dot(radialOffset, radialOffset);
    float coneRadiusSq = coneRadius * coneRadius;
    if (radialDistanceSq >= coneRadiusSq)
        return float3(0.0, 0.0, 0.0);

    float radial01 = sqrt(max(radialDistanceSq, 0.0)) / max(coneRadius, EPSILON);
    float centerlineGate = 1.0 - saturate(radial01);
    float3 awayFromCenterline = SafeNormalize(radialOffset + lightDirectionWS * 0.12);
    if (dot(awayFromCenterline, awayFromCenterline) <= EPSILON)
        awayFromCenterline = SafeNormalize(positionWS - _PlayerPositionWS);

    float nearOriginFade = saturate(axialDistance / max(_PanicPlayerRadius * 0.35, 0.25));
    float force = centerlineGate * centerlineGate * panicGate * nearOriginFade * max(_PanicWeight, 1.0) * 2.2;
    return awayFromCenterline * force;
}

uint LoadSpatialGridCount(int flatIndex)
{
    uint maxCount = (uint)max(_SpatialGridMeta.w, 1);
    uint count = _SpatialGridCounts[flatIndex];
    return min(count, maxCount);
}

void AccumulatePBDCorrection(uint boidIndex, float3 correctionWS)
{
    int3 quantizedCorrection = int3(round(correctionWS * PBD_CORRECTION_QUANTIZE));
    InterlockedAdd(_PbdCorrections[boidIndex].x, quantizedCorrection.x);
    InterlockedAdd(_PbdCorrections[boidIndex].y, quantizedCorrection.y);
    InterlockedAdd(_PbdCorrections[boidIndex].z, quantizedCorrection.z);
}

float3 LoadPBDCorrection(uint boidIndex)
{
    int4 quantizedCorrection = _PbdCorrections[boidIndex];
    return float3(quantizedCorrection.x, quantizedCorrection.y, quantizedCorrection.z) / PBD_CORRECTION_QUANTIZE;
}

float SampleDensity01(float2 worldXZ)
{
    float2 sampleXZ = worldXZ - _GlobalDriftOffset.xz;
    float2 uv = (sampleXZ - _DensityWorldRect.xy) * _DensityWorldRect.zw;
    if (uv.x < 0.0 || uv.x > 1.0 || uv.y < 0.0 || uv.y > 1.0)
        return 0.0;

    return _DensityTex.SampleLevel(sampler_DensityTex, uv, 0).r;
}

float SampleCutMask01(float2 worldXZ)
{
    if (_CutMaskActive < 0.5)
        return 0.0;

    float2 uv = (worldXZ - _CutMaskWorldRect.xy) * _CutMaskWorldRect.zw;
    if (uv.x < 0.0 || uv.x > 1.0 || uv.y < 0.0 || uv.y > 1.0)
        return 0.0;

    return _CutMaskTex.SampleLevel(sampler_CutMaskTex, uv, 0).r;
}

float2 SampleDensityGradient(float2 worldXZ)
{
    float stepWorld = max(_GradientWorldStep, 0.05);
    float sampleXPos = SampleDensity01(worldXZ + float2(stepWorld, 0.0));
    float sampleXNeg = SampleDensity01(worldXZ - float2(stepWorld, 0.0));
    float sampleZPos = SampleDensity01(worldXZ + float2(0.0, stepWorld));
    float sampleZNeg = SampleDensity01(worldXZ - float2(0.0, stepWorld));
    return float2(sampleXPos - sampleXNeg, sampleZPos - sampleZNeg);
}

float2 SampleCutGradient(float2 worldXZ)
{
    if (_CutMaskActive < 0.5)
        return float2(0.0, 0.0);

    float stepWorld = max(_GradientWorldStep, 0.05);
    float sampleXPos = SampleCutMask01(worldXZ + float2(stepWorld, 0.0));
    float sampleXNeg = SampleCutMask01(worldXZ - float2(stepWorld, 0.0));
    float sampleZPos = SampleCutMask01(worldXZ + float2(0.0, stepWorld));
    float sampleZNeg = SampleCutMask01(worldXZ - float2(0.0, stepWorld));
    return float2(sampleXPos - sampleXNeg, sampleZPos - sampleZNeg);
}

void ApplyObstacleRepulsion(float3 positionCR, float bodyRadius, out float3 obstacleForce, inout float3 targetCR)
{
    obstacleForce = float3(0.0, 0.0, 0.0);
    [loop]
    for (int obstacleIndex = 0; obstacleIndex < _FormationObstacleCount; obstacleIndex++)
    {
        FormationObstacleData obstacle = _FormationObstacles[obstacleIndex];
        if (obstacle.Weight <= 0.0)
            continue;

        float3 obstaclePositionCR = ToCameraRelative(obstacle.Position);
        if (!IsFiniteFloat3(obstaclePositionCR))
            continue;

        float3 targetDelta = targetCR - obstaclePositionCR;
        float targetDistance = length(targetDelta);
        float targetRadius = obstacle.Radius + bodyRadius;
        if (targetDistance < targetRadius)
        {
            float3 targetNormal = SafeNormalize(targetDelta);
            if (dot(targetNormal, targetNormal) <= EPSILON)
                targetNormal = float3(0.0, 1.0, 0.0);

            targetCR = obstaclePositionCR + targetNormal * targetRadius;
        }

        float3 fromObstacle = positionCR - obstaclePositionCR;
        float distanceToObstacle = length(fromObstacle);
        float repelRadius = obstacle.Radius + bodyRadius * 2.0;
        float repelGate = 1.0 - saturate(distanceToObstacle / max(repelRadius, 0.001));
        if (repelGate > 0.0)
            obstacleForce += SafeNormalize(fromObstacle) * (repelGate * obstacle.Weight);
    }
}

[numthreads(THREAD_GROUP_SIZE, 1, 1)]
void ApplyOriginShift(uint3 dispatchThreadID : SV_DispatchThreadID)
{
    uint boidIndex = dispatchThreadID.x;
    if (boidIndex >= _BoidCount)
        return;

    BoidData boid = _BoidsBufferWrite[boidIndex];
    boid.Position += _OriginShiftDelta.xyz;
    _BoidsBufferWrite[boidIndex] = boid;
}

[numthreads(1, 1, 1)]
void ClearLatchStats(uint3 dispatchThreadID : SV_DispatchThreadID)
{
    if (dispatchThreadID.x != 0)
        return;

    _LatchStats[LATCH_STATS_COUNT_INDEX] = 0;
    _LatchStats[LATCH_STATS_SUM_X_INDEX] = 0;
    _LatchStats[LATCH_STATS_SUM_Y_INDEX] = 0;
    _LatchStats[LATCH_STATS_SUM_Z_INDEX] = 0;
    _LatchStats[4] = 0;
    _LatchStats[5] = 0;
    _LatchStats[6] = 0;
    _LatchStats[LATCH_STATS_WAKE_COUNT_INDEX] = 0;
    _LatchStats[LATCH_STATS_WAKE_SUM_X_INDEX] = 0;
    _LatchStats[LATCH_STATS_WAKE_SUM_Y_INDEX] = 0;
    _LatchStats[LATCH_STATS_WAKE_SUM_Z_INDEX] = 0;
    _LatchStats[LATCH_STATS_WAKE_VEL_X_INDEX] = 0;
    _LatchStats[LATCH_STATS_WAKE_VEL_Y_INDEX] = 0;
    _LatchStats[LATCH_STATS_WAKE_VEL_Z_INDEX] = 0;
}

[numthreads(THREAD_GROUP_SIZE, 1, 1)]
void ClearSpatialGrid(uint3 dispatchThreadID : SV_DispatchThreadID)
{
    int3 resolution = ResolveGridResolution();
    int cellCountInt = max(resolution.x * resolution.y * resolution.z, 0);
    uint cellCount = (uint)cellCountInt;
    uint cellIndex = dispatchThreadID.x;
    if (cellIndex >= cellCount)
        return;

    _SpatialGridCounts[cellIndex] = 0u;
}

[numthreads(THREAD_GROUP_SIZE, 1, 1)]
void BuildSpatialGrid(uint3 dispatchThreadID : SV_DispatchThreadID)
{
    uint index = dispatchThreadID.x;
    if (index >= _BoidCount)
        return;

    BoidData boid = _BoidsBufferRead[index];
    if (IsConsumedState(boid.StateFlags))
        return;

    float3 positionWS = boid.Position + _GlobalDriftDelta;
    if (!IsFiniteFloat3(positionWS))
        return;

    int3 resolution = ResolveGridResolution();
    int3 cell;
    if (!TryResolveGridCell(positionWS, resolution, cell))
        return;

    uint cellIndex = FlattenGridCellUnsigned(cell, resolution);
    uint previousCount = 0u;
    InterlockedAdd(_SpatialGridCounts[cellIndex], 1u, previousCount);
    if (previousCount >= (uint)max(_SpatialGridMeta.w, 1))
    {
        uint ignoredCount = 0u;
        InterlockedAdd(_SpatialGridCounts[cellIndex], 0xffffffffu, ignoredCount);
        return;
    }

    _SpatialGridCells[(int)(cellIndex * (uint)max(_SpatialGridMeta.w, 1)) + (int)previousCount] = index;
}

[numthreads(THREAD_GROUP_SIZE, 1, 1)]
void ClearPBDCorrections(uint3 dispatchThreadID : SV_DispatchThreadID)
{
    uint index = dispatchThreadID.x;
    if (index >= _BoidCount)
        return;

    _PbdCorrections[index] = int4(0, 0, 0, 0);
}

[numthreads(THREAD_GROUP_SIZE, 1, 1)]
void KernelPBDSolve(uint3 dispatchThreadID : SV_DispatchThreadID)
{
    uint index = dispatchThreadID.x;
    if (index >= _BoidCount)
        return;

    BoidData selfBoid = _BoidsBufferRead[index];
    if (IsConsumedState(selfBoid.StateFlags))
        return;

    float3 selfPositionWS = selfBoid.Position + _GlobalDriftDelta + selfBoid.Velocity * _DeltaTime;
    if (!IsFiniteFloat3(selfPositionWS))
        return;

    int3 gridResolution = ResolveGridResolution();
    int3 homeCell;
    if (!TryResolveGridCell(selfPositionWS, gridResolution, homeCell))
        return;

    float minDistance = max(_BoidBodyRadius * 2.0, 0.001);
    float minDistanceSq = minDistance * minDistance;

    float safeGridCellSize = max(ResolveGridCellSize(), 0.001);
    // Spatial-grid cell size is authored from C# with a 0.5m floor, so a 2m collision shell never needs
    // more than four cells of reach. Clamp anyway to fail closed if invalid frame constants slip through.
    int neighbourCellRange = max(0, (int)ceil(2.0 / safeGridCellSize));
    int gridBoundRange = max(max(gridResolution.x, max(gridResolution.y, gridResolution.z)) - 1, 0);
    neighbourCellRange = min(neighbourCellRange, gridBoundRange);
    neighbourCellRange = min(neighbourCellRange, 4);

    [loop]
    for (int offsetZ = -neighbourCellRange; offsetZ <= neighbourCellRange; offsetZ++)
    {
        [loop]
        for (int offsetY = -neighbourCellRange; offsetY <= neighbourCellRange; offsetY++)
        {
            [loop]
            for (int offsetX = -neighbourCellRange; offsetX <= neighbourCellRange; offsetX++)
            {
                int3 neighbourCell = homeCell + int3(offsetX, offsetY, offsetZ);
                if (any(neighbourCell < 0) || neighbourCell.x >= gridResolution.x || neighbourCell.y >= gridResolution.y || neighbourCell.z >= gridResolution.z)
                    continue;

                int cellIndex = FlattenGridCell(neighbourCell, gridResolution);
                uint cellCount = LoadSpatialGridCount(cellIndex);
                int cellBaseIndex = cellIndex * max(_SpatialGridMeta.w, 1);
                [loop]
                for (uint slotIndex = 0u; slotIndex < cellCount; slotIndex++)
                {
                    uint otherIndex = _SpatialGridCells[cellBaseIndex + (int)slotIndex];
                    if (otherIndex <= index || otherIndex >= _BoidCount)
                        continue;

                    BoidData otherBoid = _BoidsBufferRead[otherIndex];
                    if (IsConsumedState(otherBoid.StateFlags))
                        continue;

                    float3 otherPositionWS = otherBoid.Position + _GlobalDriftDelta + otherBoid.Velocity * _DeltaTime;
                    if (!IsFiniteFloat3(otherPositionWS))
                        continue;

                    float3 deltaWS = selfPositionWS - otherPositionWS;
                    float distanceSq = dot(deltaWS, deltaWS);
                    if (distanceSq >= minDistanceSq)
                        continue;

                    float3 directionWS;
                    if (distanceSq <= EPSILON)
                    {
                        float fallbackAngle = WrapAngle(((float)index + (float)otherIndex * 0.6180339) * TAU);
                        directionWS = float3(SafeCos(fallbackAngle), 0.0, SafeSin(fallbackAngle));
                    }
                    else
                    {
                        directionWS = deltaWS * rsqrt(distanceSq);
                    }

                    float distanceValue = sqrt(max(distanceSq, EPSILON));
                    float3 correctionWS = directionWS * ((minDistance - distanceValue) * 0.5);
                    AccumulatePBDCorrection(index, correctionWS);
                    AccumulatePBDCorrection(otherIndex, -correctionWS);
                }
            }
        }
    }
}

[numthreads(THREAD_GROUP_SIZE, 1, 1)]
void CSMain(uint3 dispatchThreadID : SV_DispatchThreadID)
{
    uint index = dispatchThreadID.x;
    if (index >= _BoidCount)
        return;

    BoidData selfBoid = _BoidsBufferRead[index];
    if (IsConsumedState(selfBoid.StateFlags))
    {
        BoidData consumedBoid = selfBoid;
        consumedBoid.Velocity = float3(0.0, 0.0, 0.0);
        consumedBoid.Panic = saturate(selfBoid.Panic + _DeltaTime * max(_ConsumedCollapseSpeed, 0.01));
        consumedBoid.StateFlags = BOID_FLAG_CONSUMED;
        if (!IsFiniteFloat3(consumedBoid.Position))
            consumedBoid.Position = _FieldCenterWS;
        _BoidsBufferWrite[index] = consumedBoid;
        return;
    }

    if (_SimulationLodTier == SIM_LOD_TIER_SLEEP)
    {
        BoidData sleepingBoid = selfBoid;
        sleepingBoid.Velocity = float3(0.0, 0.0, 0.0);
        if (!IsFiniteFloat3(sleepingBoid.Position))
            sleepingBoid.Position = _FieldCenterWS;
        _BoidsBufferWrite[index] = sleepingBoid;
        return;
    }

    float seed = SeedFromIndex(index);
    float3 positionWS = selfBoid.Position + _GlobalDriftDelta;
    float3 position = ToCameraRelative(positionWS);
    float3 velocity = selfBoid.Velocity;
    float panic = max(0.0, selfBoid.Panic - _PanicDecay * _DeltaTime);
    uint stateFlags = selfBoid.StateFlags;
    float phaseTime = GetPhaseTime();
    bool simplifiedTier = _SimulationLodTier == SIM_LOD_TIER_SIMPLIFIED;
    if (!IsFiniteFloat3(position) || !IsFiniteFloat3(velocity) || !IsFiniteFloat(panic))
    {
        position = ToCameraRelative(_FieldCenterWS);
        positionWS = _FieldCenterWS;
        velocity = float3(0.0, 0.0, 0.0);
        panic = 0.0;
        stateFlags = BuildAliveStateFlags();
    }

    if (stateFlags == 0u)
        stateFlags = BuildAliveStateFlags();

    int3 gridResolution = int3(1, 1, 1);
    int3 homeCell = int3(0, 0, 0);
    if (!simplifiedTier)
    {
        gridResolution = ResolveGridResolution();
        if (!TryResolveGridCell(positionWS, gridResolution, homeCell))
        {
            position = ToCameraRelative(_FieldCenterWS);
            positionWS = _FieldCenterWS;
            homeCell = clamp((int3)floor((positionWS - _SpatialGridOrigin.xyz) / ResolveGridCellSize()), int3(0, 0, 0), gridResolution - 1);
        }
    }

    if (!simplifiedTier)
    {
        float3 pbdCorrectionWS = LoadPBDCorrection(index);
        if (dot(pbdCorrectionWS, pbdCorrectionWS) > EPSILON)
        {
            position += pbdCorrectionWS;
            positionWS += pbdCorrectionWS;
            velocity += pbdCorrectionWS / max(_DeltaTime, 0.0001);
        }
    }

    float perceptionRadiusSq = _PerceptionRadius * _PerceptionRadius;
    float separationRadiusSq = _SeparationRadius * _SeparationRadius;
    float3 alignmentSum = float3(0.0, 0.0, 0.0);
    float3 cohesionSum = float3(0.0, 0.0, 0.0);
    float3 separationSum = float3(0.0, 0.0, 0.0);
    float neighbourCount = 0.0;
    float separationCount = 0.0;
    float panicContagion = 0.0;

    if (!simplifiedTier)
    {
        [loop]
        for (int offsetZ = -1; offsetZ <= 1; offsetZ++)
        {
            [loop]
            for (int offsetY = -1; offsetY <= 1; offsetY++)
            {
                [loop]
                for (int offsetX = -1; offsetX <= 1; offsetX++)
                {
                    int3 neighbourCell = homeCell + int3(offsetX, offsetY, offsetZ);
                    if (any(neighbourCell < 0) || neighbourCell.x >= gridResolution.x || neighbourCell.y >= gridResolution.y || neighbourCell.z >= gridResolution.z)
                        continue;

                    int cellIndex = FlattenGridCell(neighbourCell, gridResolution);
                    uint cellCount = LoadSpatialGridCount(cellIndex);
                    float densityOverflow01 = saturate(((float)cellCount - DENSITY_CAP_MAX_BOIDS) / DENSITY_CAP_MAX_BOIDS);
                    int cellBaseIndex = cellIndex * max(_SpatialGridMeta.w, 1);
                    [loop]
                    for (uint slotIndex = 0u; slotIndex < cellCount; slotIndex++)
                    {
                        uint otherIndex = _SpatialGridCells[cellBaseIndex + (int)slotIndex];
                        if ((uint)otherIndex != index)
                        {
                            BoidData otherBoid = _BoidsBufferRead[otherIndex];
                            if (!IsConsumedState(otherBoid.StateFlags))
                            {
                                float3 otherPosition = ToCameraRelative(otherBoid.Position + _GlobalDriftDelta);
                                if (!IsFiniteFloat3(otherPosition))
                                    continue;

                                float3 toOther = otherPosition - position;
                                float distanceSq = dot(toOther, toOther);
                                if (distanceSq <= perceptionRadiusSq && distanceSq > EPSILON)
                                {
                                    alignmentSum += otherBoid.Velocity;
                                    cohesionSum += otherPosition;
                                    neighbourCount += 1.0;

                                    float contagionThreshold = max(_PanicThreshold, PANIC_CONTAGION_THRESHOLD);
                                    float otherPanic = saturate(otherBoid.Panic);
                                    float contagionGate = saturate((otherPanic - contagionThreshold) / max(1.0 - contagionThreshold, 0.001));
                                    panicContagion = saturate(max(panicContagion, otherPanic * contagionGate * PANIC_CONTAGION_GAIN));

                                    if (distanceSq <= separationRadiusSq)
                                    {
                                        float clampedDistanceSq = max(distanceSq, 0.04);
                                        float3 awayDirection = -toOther * rsqrt(clampedDistanceSq);
                                        float falloff = saturate(1.0 - (distanceSq / max(separationRadiusSq, EPSILON)));
                                        float inverseSquare = rcp(clampedDistanceSq);
                                        float densityPenalty = densityOverflow01 > 0.0 && distanceSq <= DENSITY_CAP_RADIUS_SQ
                                            ? densityOverflow01 * 3.75 * inverseSquare
                                            : 0.0;
                                        separationSum += awayDirection * ((inverseSquare * falloff) + densityPenalty);
                                        separationCount += 1.0 + densityOverflow01;
                                    }
                                    else if (densityOverflow01 > 0.0 && distanceSq <= DENSITY_CAP_RADIUS_SQ)
                                    {
                                        float clampedDistanceSq = max(distanceSq, 0.04);
                                        float3 awayDirection = -toOther * rsqrt(clampedDistanceSq);
                                        float inverseSquarePenalty = densityOverflow01 * 3.75 * rcp(clampedDistanceSq);
                                        separationSum += awayDirection * inverseSquarePenalty;
                                        separationCount += densityOverflow01;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    float2 worldXZ = positionWS.xz;
    float3 fieldCenterCR = ToCameraRelative(_FieldCenterWS);
    float3 playerPositionCR = ToCameraRelative(_PlayerPositionWS);
    float3 cameraAvoidPositionCR = ToCameraRelative(_CameraAvoidPositionWS);
    float cutMask = SampleCutMask01(worldXZ);
    float panicFromCut = saturate((cutMask - _PanicThreshold) / max(1.0 - _PanicThreshold, 0.001));
    float playerDistance = distance(position, playerPositionCR);
    float effectivePlayerPanicRadius = max(_PanicPlayerRadius * _PanicPlayerRadiusScale, 0.001);
    float playerSpeedGate = saturate((_PlayerSpeed - _PanicPlayerSpeedThreshold) / max(_PanicPlayerSpeedThreshold, 0.001));
    float playerThreatGate = 1.0 - saturate(playerDistance / effectivePlayerPanicRadius);
    float panicFromPlayer = _ParasiteMode > 0.5
        ? 0.0
        : max(playerSpeedGate * playerThreatGate, _HeadlightPanic * playerThreatGate);
    float threatGridPanic = SampleThreatGridAtWorldPosition(positionWS);
    float2 threatGridGradient = ComputeThreatGridGradientAtWorldPosition(positionWS);
    float panicFromMassive = 0.0;
    float leviathanHuntPulse = 0.0;
    float panicFromSonar = 0.0;
    float panicFromAcoustic = 0.0;
    float3 bloomImpulse = float3(0.0, 0.0, 0.0);
    float3 collapseImpulse = float3(0.0, 0.0, 0.0);
    float3 fleeFromMassive = float3(0.0, 0.0, 0.0);
    float3 sonarScatterDirectionWS = float3(0.0, 0.0, 0.0);
    float3 acousticPanicDirectionWS = ResolveAcousticPanicChaos(positionWS, index, panicFromAcoustic);
    if (_SonarScatterStrength > 0.001)
    {
        float3 fromSonarOrigin = positionWS - _SonarScatterOriginWS;
        float sonarDistance = length(fromSonarOrigin);
        float sonarBandDelta = abs(sonarDistance - _SonarScatterWaveFrontWS);
        float sonarGate = 1.0 - saturate(sonarBandDelta / max(_SonarScatterBandWidth, 0.001));
        if (sonarGate > 0.0)
        {
            sonarScatterDirectionWS = SafeNormalize(fromSonarOrigin);
            panicFromSonar = sonarGate * _SonarScatterStrength;
        }
    }
    bool consumedByLeviathan = false;
    [loop]
    for (uint threatIndex = 0; threatIndex < _MassiveThreatCount; threatIndex++)
    {
        MassiveThreatData threat = _MassiveThreats[threatIndex];
        if (threat.Strength <= 0.0 || threat.EndTime <= phaseTime)
            continue;

        float3 threatPosition = ToCameraRelative(threat.Position);
        if (!IsFiniteFloat3(threatPosition))
            continue;

        float3 fieldDelta = abs(threatPosition - fieldCenterCR);
        float3 fieldLimit = _FieldExtents + threat.PanicRadius;
        if (any(fieldDelta > fieldLimit))
            continue;

        float3 awayFromThreat = position - threatPosition;
        float distanceToThreat = length(awayFromThreat);
        float panicRadius = max(threat.PanicRadius, threat.InnerRadius + 0.001);
        float threatGate = 1.0 - saturate((distanceToThreat - threat.InnerRadius) / max(panicRadius - threat.InnerRadius, 0.001));
        if (threatGate <= 0.0)
            continue;

        float threatPanic = threatGate * threat.Strength;
        panicFromMassive = max(panicFromMassive, threatPanic);
        fleeFromMassive += SafeNormalize(awayFromThreat) * threatPanic;
        bool isLeviathanHuntPulse = (threat.ThreatFlags & MASSIVE_THREAT_FLAG_LEVIATHAN_HUNT_PULSE) != 0u;
        if (isLeviathanHuntPulse)
        {
            float distanceSqToThreat = dot(positionWS - threat.Position, positionWS - threat.Position);
            float fleeGate = saturate(1.0 - (distanceSqToThreat / 1600.0));
            leviathanHuntPulse = max(leviathanHuntPulse, fleeGate * threat.Strength);
            stateFlags = distanceSqToThreat < 1600.0 ? BuildFleeStateFlags() : stateFlags;
            continue;
        }

        float3 threatDirection = SafeNormalize(threat.DirectionWS);
        if (dot(threatDirection, threatDirection) > EPSILON)
        {
            float axialOffset = dot(positionWS - threat.Position, threatDirection);
            float frontGate = threatGate * saturate(axialOffset / max(panicRadius, 0.001));
            float rearGate = threatGate * saturate(-axialOffset / max(panicRadius, 0.001));
            float3 radialOffset = (positionWS - threat.Position) - (threatDirection * axialOffset);
            float3 lateralFallback = SafeNormalize(cross(threatDirection, float3(0.0, 1.0, 0.0)));
            if (dot(lateralFallback, lateralFallback) <= EPSILON)
                lateralFallback = float3(1.0, 0.0, 0.0);
            if (frontGate > 0.0)
            {
                float3 lateralBloomDirection = SafeNormalize(radialOffset);
                if (dot(lateralBloomDirection, lateralBloomDirection) <= EPSILON)
                    lateralBloomDirection = lateralFallback;
                bloomImpulse += lateralBloomDirection * (frontGate * threat.Strength);
            }
            if (rearGate > 0.0)
                collapseImpulse += SafeNormalize(fieldCenterCR - position) * (rearGate * threat.Strength);
        }
        if (_LeviathanModeBlend < 0.001)
            stateFlags = BuildFleeStateFlags();

        float mouthRadius = max(threat.InnerRadius * 0.85, _SeparationRadius * 0.5);
        if (_LeviathanModeBlend < 0.001 && distanceToThreat <= mouthRadius)
        {
            consumedByLeviathan = true;
            break;
        }
    }

    float sourcePanic = saturate(max(panic, max(max(max(max(max(max(panicFromCut, panicFromPlayer), panicFromMassive), panicFromSonar), panicFromAcoustic), threatGridPanic), leviathanHuntPulse)));
    panic = saturate(sourcePanic + panicContagion);
    stateFlags = max(panic, leviathanHuntPulse) >= 0.05 ? BuildFleeStateFlags() : BuildAliveStateFlags();

    if (consumedByLeviathan)
    {
        BoidData consumedBoid;
        consumedBoid.Position = ToWorldSpace(position);
        consumedBoid.Velocity = float3(0.0, 0.0, 0.0);
        consumedBoid.Panic = 0.0;
        consumedBoid.StateFlags = BOID_FLAG_CONSUMED;
        _BoidsBufferWrite[index] = consumedBoid;
        return;
    }

    float density = _DeepMode > 0.5 ? 1.0 : SampleDensity01(worldXZ);
    float effectiveDensity = _DeepMode > 0.5 ? 1.0 : density * (1.0 - cutMask);
    float2 densityGradient = _DeepMode > 0.5 ? float2(0.0, 0.0) : SampleDensityGradient(worldXZ);

    float3 acceleration = float3(0.0, 0.0, 0.0);
    float3 grazingForce = float3(0.0, 0.0, 0.0);
    float grazingWeightSum = 0.0;
    float grazingHoldPeak = 0.0;
    float grazingHoldPhase = 0.0;
    float3 closestAnchorDelta = float3(0.0, 0.0, 0.0);

    if (panicFromSonar > 0.0 && dot(sonarScatterDirectionWS, sonarScatterDirectionWS) > EPSILON)
    {
        acceleration += sonarScatterDirectionWS * (_SonarScatterAcceleration * panicFromSonar);
    }

    acceleration += ResolveHeadlightPhotophobiaForce(positionWS, _HeadlightPanic);

    if (panicFromAcoustic > 0.0 && dot(acousticPanicDirectionWS, acousticPanicDirectionWS) > EPSILON)
    {
        float acousticImpulse = _SonarScatterAcceleration * (1.2 + panicFromAcoustic);
        acceleration += acousticPanicDirectionWS * (acousticImpulse * panicFromAcoustic);
        velocity += acousticPanicDirectionWS * (_MaxSpeed * panicFromAcoustic * _DeltaTime);
    }

    bool fleeState = IsFleeState(stateFlags);
    float separationWeight = _SeparationWeight * (fleeState ? 2.0 : 1.0);
    float fleeMaxSpeedMultiplier = fleeState ? 2.0 : 1.0;
    if (separationCount > 0.0)
    {
        float3 separationForce = separationSum / separationCount;
        float separationMagnitude = min(length(separationForce), 4.0);
        acceleration += SafeNormalize(separationForce) * (separationMagnitude * separationWeight);
    }

    if (neighbourCount > 0.0)
    {
        float3 averageVelocity = alignmentSum / neighbourCount;
        float3 averagePosition = cohesionSum / neighbourCount;
        float3 alignmentForce = SafeNormalize(averageVelocity);
        float3 cohesionForce = SafeNormalize(averagePosition - position);
        acceleration += alignmentForce * _AlignmentWeight;
        acceleration += cohesionForce * _CohesionWeight;
    }

    float densityDeficit = _DeepMode > 0.5 ? 0.0 : saturate((_DensityThreshold - effectiveDensity) / max(_DensityThreshold, 0.001));
    float cutIntrusion = _DeepMode > 0.5 ? 0.0 : saturate(cutMask / max(_WindowThreshold, 0.001));
    if (_DeepMode < 0.5 && (densityDeficit > 0.0 || cutIntrusion > 0.0))
    {
        float3 densityForce = SafeNormalize(float3(densityGradient.x, 0.0, densityGradient.y));
        float3 centerForce = SafeNormalize(float3(fieldCenterCR.x - position.x, 0.0, fieldCenterCR.z - position.z));
        acceleration += (densityForce * 0.7 + centerForce * 0.3) * max(densityDeficit, cutIntrusion) * _ContainmentWeight;
    }

    if (!simplifiedTier && _ThreatVoxelAvoidanceWeight > 0.0)
    {
        float3 voxelAvoidanceNormalWS;
        float voxelAvoidanceGate;
        if (TryResolveThreatVoxelAvoidance(positionWS, velocity, voxelAvoidanceNormalWS, voxelAvoidanceGate))
        {
            float3 voxelSteerForce = (voxelAvoidanceNormalWS * _MaxSpeed) - velocity;
            acceleration += voxelSteerForce * (voxelAvoidanceGate * _ThreatVoxelAvoidanceWeight);
        }

        float3 voxelSurfaceNormalWS;
        float voxelSurfaceGate;
        if (TryResolveThreatVoxelSurfaceRepulsion(positionWS, voxelSurfaceNormalWS, voxelSurfaceGate))
        {
            float3 voxelSurfaceSteerForce = (voxelSurfaceNormalWS * _MaxSpeed) - velocity;
            acceleration += voxelSurfaceSteerForce * (voxelSurfaceGate * _ThreatVoxelAvoidanceWeight * 0.85);
        }
    }

    if (!simplifiedTier)
    {
        float3 transportAvoidanceNormalWS;
        float3 transportVortexRepulsionWS;
        float transportAvoidanceGate;
        if (TryResolveTransportCapsuleAvoidance(positionWS, velocity, transportAvoidanceNormalWS, transportVortexRepulsionWS, transportAvoidanceGate))
        {
            float3 transportSteerForce = (transportAvoidanceNormalWS * _MaxSpeed) - velocity;
            float3 vortexSteerForce = (transportVortexRepulsionWS * _MaxSpeed) - velocity;
            float transportForceWeight = transportAvoidanceGate * max(_PanicWeight, 1.0);
            float vortexForceWeight = transportAvoidanceGate * transportAvoidanceGate * max(_AlignmentWeight, 0.35);
            acceleration += transportSteerForce * transportForceWeight;
            acceleration += vortexSteerForce * vortexForceWeight;
        }
    }

    if (!simplifiedTier)
    {
        float3 submarineRepulsionWS;
        float3 submarineVortexWS;
        float submarineWakeGate;
        if (TryResolveSubmarineWakeRepulsion(positionWS, submarineRepulsionWS, submarineVortexWS, submarineWakeGate))
        {
            float submarineSpeed01 = saturate(length(_SubmarineWakeVelocityWS) / 22.0);
            float wakeSpeedScale = 1.0 + submarineSpeed01;
            float3 repulsionSteerForce = (submarineRepulsionWS * _MaxSpeed * wakeSpeedScale) - velocity;
            float3 vortexSteerForce = (submarineVortexWS * _MaxSpeed * wakeSpeedScale) - velocity;
            float repulsionWeight = submarineWakeGate * max(_PanicWeight, 1.0) * (2.4 + submarineSpeed01 * 3.2);
            float vortexWeight = submarineWakeGate * submarineWakeGate * max(_AlignmentWeight, 0.5) * (1.6 + submarineSpeed01 * 2.8);
            acceleration += repulsionSteerForce * repulsionWeight;
            acceleration += vortexSteerForce * vortexWeight;
            velocity += (submarineRepulsionWS * repulsionWeight + submarineVortexWS * vortexWeight) * (_DeltaTime * 0.12);
            panic = max(panic, submarineWakeGate);
            stateFlags = BuildFleeStateFlags();
        }
    }

    if (_FragmentationStrength > 0.001 && _FragmentationWeight > 0.0)
    {
        float3 fragmentationCenterA = ToCameraRelative(_FragmentationCenterAWS);
        float3 fragmentationCenterB = ToCameraRelative(_FragmentationCenterBWS);
        float3 splitMidpoint = (fragmentationCenterA + fragmentationCenterB) * 0.5;
        float3 splitAxis = SafeNormalize(fragmentationCenterA - fragmentationCenterB);
        if (dot(splitAxis, splitAxis) > EPSILON)
        {
            float sideSign = dot(position - splitMidpoint, splitAxis) >= 0.0 ? 1.0 : -1.0;
            float3 fragmentTarget = sideSign >= 0.0 ? fragmentationCenterA : fragmentationCenterB;
            float3 toFragmentTarget = fragmentTarget - position;
            float distanceToFragment = length(toFragmentTarget);
            float fragmentationGate = 1.0 - saturate(distanceToFragment / max(_FragmentationRadiusWS, 0.001));
            float splitStrength = _FragmentationStrength * max(fragmentationGate, 0.35);
            acceleration += SafeNormalize(toFragmentTarget) * (_FragmentationWeight * splitStrength);
            acceleration += splitAxis * (sideSign * (_FragmentationWeight * 0.55 * splitStrength));
        }
    }

    if (!simplifiedTier)
    {
        [loop]
        for (uint anchorIndex = 0; anchorIndex < _GrazingAnchorCount; anchorIndex++)
        {
            GrazingAnchorData anchor = _GrazingAnchors[anchorIndex];
            if (anchor.Strength <= 0.0)
                continue;

            float3 anchorPosition = ToCameraRelative(anchor.Position);
            if (!IsFiniteFloat3(anchorPosition))
                continue;

            float3 toAnchor = anchorPosition - position;
            float anchorRadius = max(anchor.Radius, _GrazingRadius);
            float anchorDistanceSq = dot(toAnchor, toAnchor);
            if (anchorDistanceSq > anchorRadius * anchorRadius)
                continue;

            float anchorDistance = sqrt(anchorDistanceSq + EPSILON);
            float anchorFalloff = 1.0 - saturate(anchorDistance / max(anchorRadius, 0.001));
            float phase = WrapAngle(seed * TAU + anchor.Phase * TAU);
            float3 swirl = float3(-toAnchor.z, SafeSin(phase) * 0.18, toAnchor.x);
            float deepAnchorBlend = saturate(_DeepMode);
            float3 anchorForce = SafeNormalize(toAnchor) * lerp(0.78, 0.96, deepAnchorBlend) + SafeNormalize(swirl) * lerp(0.22, 0.04, deepAnchorBlend);
            float anchorHold = anchor.Strength * anchorFalloff;
            grazingForce += anchorForce * anchorHold;
            grazingWeightSum += anchorHold;
            if (anchorHold > grazingHoldPeak)
            {
                grazingHoldPeak = anchorHold;
                grazingHoldPhase = anchor.Phase;
                closestAnchorDelta = toAnchor;
            }
        }
    }

    float feedingHold = 0.0;
    float leviathanModeBlend = saturate(_LeviathanModeBlend);
    float nonLeviathanBlend = 1.0 - leviathanModeBlend;

    if (!simplifiedTier && grazingWeightSum > 0.0 && panic < 0.2 && nonLeviathanBlend > 0.001)
    {
        float grazingPullWeight = lerp(_GrazingWeight, max(_GrazingWeight, _DeepClusterWeight), saturate(_DeepMode));
        acceleration += SafeNormalize(grazingForce / grazingWeightSum) * ((1.0 - panic) * grazingPullWeight * nonLeviathanBlend);
        float grazePausePhase = WrapAngle(phaseTime * lerp(1.35, 1.85, saturate(_DeepMode)) + seed * 11.0 + grazingHoldPhase * TAU);
        float grazePauseSignal = SafeSin(grazePausePhase) * 0.5 + 0.5;
        float grazeHold = saturate((grazingHoldPeak - _GrazingRestHoldThreshold) / max(1.0 - _GrazingRestHoldThreshold, 0.001));
        feedingHold = grazeHold * saturate((grazePauseSignal - lerp(0.72, 0.6, saturate(_DeepMode))) / lerp(0.18, 0.24, saturate(_DeepMode))) * (1.0 - panic) * nonLeviathanBlend;
        if (feedingHold > 0.0)
            acceleration += SafeNormalize(closestAnchorDelta) * (feedingHold * grazingPullWeight * lerp(0.3, 0.6, saturate(_DeepMode)));
    }

    if (!simplifiedTier && _DeepMode < 0.5 && panic < 0.2 && _CanopyAffinityWeight > 0.0 && nonLeviathanBlend > 0.001)
    {
        float calmCanopyThreshold = saturate(_DensityThreshold * 0.85);
        float canopyAffinity = saturate((effectiveDensity - calmCanopyThreshold) / max(1.0 - calmCanopyThreshold, 0.001));
        if (canopyAffinity > 0.0)
        {
            float3 canopyForce = SafeNormalize(float3(densityGradient.x, 0.0, densityGradient.y));
            acceleration += canopyForce * ((1.0 - panic) * canopyAffinity * _CanopyAffinityWeight * nonLeviathanBlend);
        }
    }

    if (!simplifiedTier && _FormationMode > 0.5 && _FormationBeaconCount > 0 && panic < _FormationBreakPanicThreshold && nonLeviathanBlend > 0.001)
    {
        FormationBeaconData beacon = _FormationBeacons[index % _FormationBeaconCount];
        float3 beaconPosition = ToCameraRelative(beacon.Position);
        if (!IsFiniteFloat3(beaconPosition))
            beaconPosition = fieldCenterCR;

        float formationCalm = 1.0 - saturate(panic / max(_FormationBreakPanicThreshold, 0.001));
        float baseAngle = WrapAngle(seed * TAU + beacon.Phase * TAU + phaseTime * 0.18 + index * 0.03125);
        float pulse = SafeSin(phaseTime * _FormationPulseSpeed + beacon.Phase * TAU + seed * 9.0);
        float ringRadius = max(_FormationRingThickness, beacon.Radius * (1.0 + pulse * _FormationPulseAmplitude));
        float verticalWave = SafeSin(phaseTime * (_FormationPulseSpeed * 0.73) + seed * 13.0) * (_FormationRingThickness * 0.35);
        float3 ringOffset = float3(SafeCos(baseAngle), verticalWave, SafeSin(baseAngle)) * ringRadius;
        float3 ringTarget = beaconPosition + ringOffset;
        float3 obstacleForce = float3(0.0, 0.0, 0.0);
        ApplyObstacleRepulsion(position, _FormationRingThickness, obstacleForce, ringTarget);

        float3 toRingTarget = ringTarget - position;
        float3 radialForce = SafeNormalize(toRingTarget);
        float3 tangentForce = SafeNormalize(cross(float3(0.0, 1.0, 0.0), SafeNormalize(ringOffset)));
        float3 targetVelocity = tangentForce * (_CruiseSpeed * lerp(0.65, 1.05, formationCalm));
        acceleration += radialForce * (_FormationWeight * formationCalm * beacon.Strength * nonLeviathanBlend);
        acceleration += SafeNormalize(targetVelocity - velocity) * (_FormationWeight * 0.45 * formationCalm * beacon.Strength * nonLeviathanBlend);
        if (dot(obstacleForce, obstacleForce) > EPSILON)
            acceleration += SafeNormalize(obstacleForce) * (_FormationObstacleWeight * formationCalm * nonLeviathanBlend);
    }

    if (!simplifiedTier && leviathanModeBlend > 0.001 && _LeviathanNodeCount > 1)
    {
        float bodyT = _BoidCount > 1 ? (float)index / max((float)(_BoidCount - 1), 1.0) : 0.0;
        LeviathanNodeData previousNode = _LeviathanNodes[0];
        LeviathanNodeData nextNode = _LeviathanNodes[_LeviathanNodeCount - 1];
        [loop]
        for (int nodeIndex = 1; nodeIndex < _LeviathanNodeCount; nodeIndex++)
        {
            LeviathanNodeData candidate = _LeviathanNodes[nodeIndex];
            if (bodyT > candidate.Distance01 && nodeIndex < _LeviathanNodeCount - 1)
            {
                previousNode = candidate;
                continue;
            }

            nextNode = candidate;
            break;
        }

        float segmentLength01 = max(nextNode.Distance01 - previousNode.Distance01, 0.0001);
        float segmentT = saturate((bodyT - previousNode.Distance01) / segmentLength01);
        float3 splinePosition = lerp(ToCameraRelative(previousNode.Position), ToCameraRelative(nextNode.Position), segmentT);
        float3 splineTangent = SafeNormalize(lerp(previousNode.Tangent, nextNode.Tangent, segmentT));
        if (dot(splineTangent, splineTangent) <= EPSILON)
            splineTangent = float3(0.0, 0.0, 1.0);

        float bodyRadius = max(0.5, lerp(previousNode.Radius, nextNode.Radius, segmentT));
        float3 lateral = SafeNormalize(cross(float3(0.0, 1.0, 0.0), splineTangent));
        if (dot(lateral, lateral) <= EPSILON)
            lateral = float3(1.0, 0.0, 0.0);
        float3 vertical = SafeNormalize(cross(splineTangent, lateral));
        float wavePhase = WrapAngle((phaseTime * _LeviathanWaveFrequency) + bodyT * 18.0 + seed * TAU);
        float lateralWave = SafeSin(wavePhase) * (bodyRadius * _LeviathanWaveAmplitude);
        float verticalWaveOffset = SafeCos(wavePhase * 0.63) * (bodyRadius * _LeviathanWaveAmplitude * 0.35);
        float3 leviathanTarget = splinePosition + lateral * lateralWave + vertical * verticalWaveOffset;
        float leviathanCalm = 1.0 - saturate(panic);
        float leviathanThreatScale = lerp(0.85, 1.45, saturate(_LeviathanThreatLevel));
        float surroundAttack = saturate((_LeviathanThreatLevel - _LeviathanSurroundThreatThreshold) / max(1.0 - _LeviathanSurroundThreatThreshold, 0.001));

        float ringAngle = WrapAngle(bodyT * TAU + phaseTime * _LeviathanSurroundSpinSpeed + seed * 0.35);
        float ringRadius = max(_LeviathanSurroundRadius, bodyRadius * 2.4);
        float ringPulse = SafeSin(phaseTime * (_LeviathanWaveFrequency * 0.7) + bodyT * 12.0 + seed * 3.1415926);
        float3 ringOffset = float3(SafeCos(ringAngle), ringPulse * (bodyRadius * 0.18), SafeSin(ringAngle)) * (ringRadius + ringPulse * bodyRadius * 0.22);
        float3 ringTarget = playerPositionCR + ringOffset;
        float3 ringTangent = SafeNormalize(float3(-SafeSin(ringAngle), 0.0, SafeCos(ringAngle)));
        if (dot(ringTangent, ringTangent) <= EPSILON)
            ringTangent = splineTangent;

        float3 targetPosition = lerp(leviathanTarget, ringTarget, surroundAttack);
        float3 targetVelocity = lerp(
            splineTangent * (_CruiseSpeed * lerp(0.95, 1.45, saturate(_LeviathanThreatLevel))),
            ringTangent * (_CruiseSpeed * lerp(1.1, 1.6, surroundAttack)),
            surroundAttack);

        float3 obstacleForce = float3(0.0, 0.0, 0.0);
        ApplyObstacleRepulsion(position, bodyRadius, obstacleForce, targetPosition);

        float3 toLeviathanTarget = targetPosition - position;
        acceleration += SafeNormalize(toLeviathanTarget) * ((_LeviathanBodyWeight + _LeviathanSurroundWeight * surroundAttack) * leviathanCalm * leviathanThreatScale * leviathanModeBlend);
        acceleration += SafeNormalize(targetVelocity - velocity) * ((_LeviathanForwardWeight + _LeviathanSurroundWeight * surroundAttack * 0.35) * leviathanThreatScale * leviathanModeBlend);
        if (surroundAttack > 0.0)
        {
            float3 ringCenterForce = SafeNormalize(playerPositionCR - position);
            acceleration += ringCenterForce * (_LeviathanSurroundWeight * surroundAttack * leviathanCalm * 0.3 * leviathanModeBlend);
        }

        if (dot(obstacleForce, obstacleForce) > EPSILON)
            acceleration += SafeNormalize(obstacleForce) * (_FormationObstacleWeight * leviathanCalm * leviathanModeBlend);
    }

    if (!simplifiedTier && _ParasiteMode > 0.5 && _ParasiteAffinityWeight > 0.0 && nonLeviathanBlend > 0.001)
    {
        float3 toPlayer = playerPositionCR - position;
        float playerDistanceToHull = length(toPlayer);
        float parasiteRadius = max(_PanicPlayerRadius * lerp(1.4, 2.25, saturate(_ParasiteAggression)), _ParasiteLatchRadius + 0.001);
        float parasiteGate = 1.0 - saturate(playerDistanceToHull / parasiteRadius);
        if (parasiteGate > 0.0)
        {
            float3 orbitDirection = SafeNormalize(cross(float3(0.0, 1.0, 0.0), _PlayerVelocityWS));
            if (dot(orbitDirection, orbitDirection) <= EPSILON)
                orbitDirection = float3(0.0, 0.0, 1.0);

            float3 affinityDirection = SafeNormalize(toPlayer + orbitDirection * lerp(0.35, 0.08, saturate(_ParasiteAggression)));
            float affinityWeight = _ParasiteAffinityWeight * lerp(0.55, 1.85, saturate(_ParasiteAggression));
            acceleration += affinityDirection * parasiteGate * affinityWeight * nonLeviathanBlend;

            if (playerDistanceToHull < _ParasiteLatchRadius)
            {
                float latch01 = 1.0 - saturate(playerDistanceToHull / max(_ParasiteLatchRadius, 0.001));
                velocity = lerp(velocity, _PlayerVelocityWS, latch01 * lerp(0.28, 0.82, saturate(_ParasiteAggression)));
                if (_ParasiteAggression > 0.05)
                {
                    float3 localOffset = float3(
                        dot(position - playerPositionCR, _PlayerRightWS),
                        dot(position - playerPositionCR, _PlayerUpWS),
                        dot(position - playerPositionCR, _PlayerForwardWS));
                    if (IsFiniteFloat3(localOffset))
                    {
                        int3 quantizedLocalOffset = int3(round(localOffset * LATCH_STATS_QUANTIZE));
                        InterlockedAdd(_LatchStats[LATCH_STATS_COUNT_INDEX], 1);
                        InterlockedAdd(_LatchStats[LATCH_STATS_SUM_X_INDEX], quantizedLocalOffset.x);
                        InterlockedAdd(_LatchStats[LATCH_STATS_SUM_Y_INDEX], quantizedLocalOffset.y);
                        InterlockedAdd(_LatchStats[LATCH_STATS_SUM_Z_INDEX], quantizedLocalOffset.z);
                    }
                }
            }
        }
    }

    if (panic > 0.0)
    {
        float2 cutGradient = SampleCutGradient(worldXZ);
        float cutPanicWeight = panicFromCut;
        float playerPanicWeight = _ParasiteMode > 0.5
            ? panicFromPlayer
            : max(panicFromPlayer, _HeadlightPanic);
        float threatGridPanicWeight = threatGridPanic;
        float massivePanicWeight = panicFromMassive;
        float3 fleeFromCut = SafeNormalize(float3(-cutGradient.x, 0.0, -cutGradient.y));
        float3 fleeFromPlayer = SafeNormalize(position - playerPositionCR);
        float3 fleeFromThreatGrid = SafeNormalize(float3(-threatGridGradient.x, 0.0, -threatGridGradient.y));
        float3 fleeForce = fleeFromCut * cutPanicWeight +
                           fleeFromPlayer * playerPanicWeight +
                           fleeFromThreatGrid * threatGridPanicWeight +
                           SafeNormalize(fleeFromMassive) * massivePanicWeight;
        if (dot(fleeForce, fleeForce) <= EPSILON)
            fleeForce = SafeNormalize(float3(position.x - fieldCenterCR.x, 0.0, position.z - fieldCenterCR.z));
        else
            fleeForce = SafeNormalize(fleeForce);

        float panicWeight = lerp(_PanicWeight, _MassiveThreatWeight, saturate(massivePanicWeight));
        acceleration += fleeForce * panic * panicWeight;
    }

    if (!simplifiedTier && _CameraAvoidWeight > 0.0 && _CameraAvoidRadius > 0.0)
    {
        float3 fromCamera = position - cameraAvoidPositionCR;
        float cameraDistance = length(fromCamera);
        float cameraAvoidGate = 1.0 - saturate(cameraDistance / max(_CameraAvoidRadius, 0.001));
        if (cameraAvoidGate > 0.0)
            acceleration += SafeNormalize(fromCamera) * (cameraAvoidGate * _CameraAvoidWeight);
    }

    float noisePhase = seed * 17.0 + position.x * 0.13 + position.z * 0.21 + position.y * 0.09;
    float3 noiseForce = float3(
        Hash11(noisePhase + 1.0) * 2.0 - 1.0,
        Hash11(noisePhase + 2.0) * 2.0 - 1.0,
        Hash11(noisePhase + 3.0) * 2.0 - 1.0);
    acceleration += SafeNormalize(noiseForce) * _NoiseWeight;

    float3 minBounds = fieldCenterCR - _FieldExtents;
    float3 maxBounds = fieldCenterCR + _FieldExtents;
    float minY = _WaterLevel - _MaxDepthBelowSurface - _CameraPosition.y;
    float maxY = _WaterLevel - _MinDepthBelowSurface - _CameraPosition.y;
    if (position.y < minY)
    {
        acceleration.y += (minY - position.y) * _ContainmentWeight;
    }
    else if (position.y > maxY)
    {
        acceleration.y -= (position.y - maxY) * _ContainmentWeight;
    }

    float minX = minBounds.x;
    float maxX = maxBounds.x;
    float minZ = minBounds.z;
    float maxZ = maxBounds.z;

    if (position.x < minX)
        acceleration.x += (minX - position.x) * _ContainmentWeight;
    else if (position.x > maxX)
        acceleration.x -= (position.x - maxX) * _ContainmentWeight;

    if (position.z < minZ)
        acceleration.z += (minZ - position.z) * _ContainmentWeight;
    else if (position.z > maxZ)
        acceleration.z -= (position.z - maxZ) * _ContainmentWeight;

    velocity += acceleration * _DeltaTime;

    if (dot(bloomImpulse, bloomImpulse) > EPSILON)
    {
        float bloomImpulseMagnitude = _MaxBoidVelocity * _DeltaTime * max(1.35, panicFromMassive * 2.25);
        velocity += SafeNormalize(bloomImpulse) * bloomImpulseMagnitude;
    }

    if (dot(collapseImpulse, collapseImpulse) > EPSILON)
    {
        float collapseImpulseMagnitude = _CruiseSpeed * _DeltaTime * max(0.75, 1.0 - saturate(panic * 0.65));
        velocity += SafeNormalize(collapseImpulse) * collapseImpulseMagnitude;
    }

    float3 flowField = ResolveFlowField(positionWS, phaseTime);
    float3 flowDirection = SafeNormalize(flowField);
    if (dot(flowDirection, flowDirection) > EPSILON)
    {
        float3 particleDirection = SafeNormalize(velocity);
        float alignment = dot(particleDirection, flowDirection);
        float alignmentN = saturate((alignment + 1.0) * 0.5);
        float dragMultiplier = lerp(1.0, 0.1, alignmentN);
        float dragAttenuation = pow(saturate(1.0 - dragMultiplier * 0.15), _DeltaTime * 60.0);
        velocity *= dragAttenuation;

        float turbulenceScale = saturate((dragMultiplier - 0.7) / 0.3);
        if (turbulenceScale > 0.0)
        {
            velocity += ResolveFlowTurbulence(positionWS, phaseTime) * (turbulenceScale * 0.15);
        }
    }

    float grazingRestSpeedScale = lerp(1.0, _GrazingRestSpeedScale, feedingHold);
    float targetMinSpeed = max(0.02, _CruiseSpeed * 0.55 * grazingRestSpeedScale);
    float calmSpeedScale = grazingWeightSum > 0.0 ? lerp(0.82, _GrazingRestSpeedScale, feedingHold) : 1.0;
    float targetCruiseSpeed = _CruiseSpeed * lerp(calmSpeedScale, 1.0, saturate(panic * 2.0));
    float targetMaxSpeed = min(_MaxSpeed * fleeMaxSpeedMultiplier, (targetCruiseSpeed + panic * _PanicSpeedBoost) * fleeMaxSpeedMultiplier);
    float speed = length(velocity);
    if (speed <= EPSILON)
    {
        float fallbackAngle = WrapAngle(seed * TAU + index * 0.173);
        velocity = float3(SafeCos(fallbackAngle), 0.0, SafeSin(fallbackAngle)) * targetMinSpeed;
    }
    else
    {
        float clampedSpeed = clamp(speed, targetMinSpeed, max(targetMinSpeed, targetMaxSpeed));
        velocity = velocity * (clampedSpeed / speed);
    }

    float hardMaxBoidVelocity = max(_MaxBoidVelocity * fleeMaxSpeedMultiplier, targetMinSpeed);
    float hardClampedSpeed = length(velocity);
    if (hardClampedSpeed > hardMaxBoidVelocity)
    {
        velocity *= hardMaxBoidVelocity / max(hardClampedSpeed, EPSILON);
    }

    position += velocity * _DeltaTime;

    if (!simplifiedTier && _CameraAvoidRadius > 0.0)
    {
        float3 fromCamera = position - cameraAvoidPositionCR;
        float cameraDistanceSq = dot(fromCamera, fromCamera);
        float cameraRadiusSq = _CameraAvoidRadius * _CameraAvoidRadius;
        if (cameraDistanceSq < cameraRadiusSq)
        {
            float3 pushDirection = SafeNormalize(fromCamera);
            if (dot(pushDirection, pushDirection) <= EPSILON)
                pushDirection = float3(0.0, 0.0, 1.0);

            position = cameraAvoidPositionCR + pushDirection * _CameraAvoidRadius;
        }
    }

    position.x = clamp(position.x, minX, maxX);
    position.y = clamp(position.y, minY, maxY);
    position.z = clamp(position.z, minZ, maxZ);

    if (!IsFiniteFloat3(position) || !IsFiniteFloat3(velocity) || !IsFiniteFloat(panic))
    {
        position = fieldCenterCR;
        velocity = float3(0.0, 0.0, 0.0);
        panic = 0.0;
        stateFlags = BuildAliveStateFlags();
    }

    float speedAfterSolve = length(velocity);
    bool wakeEligible = IsFleeState(stateFlags) && speedAfterSolve > 10.0;
    if (wakeEligible)
    {
        float3 worldPositionWS = ToWorldSpace(position);
        int3 quantizedWakePosition = int3(round(worldPositionWS * WAKE_STATS_QUANTIZE));
        int3 quantizedWakeVelocity = int3(round(velocity * WAKE_STATS_QUANTIZE));
        InterlockedAdd(_LatchStats[LATCH_STATS_WAKE_COUNT_INDEX], 1);
        InterlockedAdd(_LatchStats[LATCH_STATS_WAKE_SUM_X_INDEX], quantizedWakePosition.x);
        InterlockedAdd(_LatchStats[LATCH_STATS_WAKE_SUM_Y_INDEX], quantizedWakePosition.y);
        InterlockedAdd(_LatchStats[LATCH_STATS_WAKE_SUM_Z_INDEX], quantizedWakePosition.z);
        InterlockedAdd(_LatchStats[LATCH_STATS_WAKE_VEL_X_INDEX], quantizedWakeVelocity.x);
        InterlockedAdd(_LatchStats[LATCH_STATS_WAKE_VEL_Y_INDEX], quantizedWakeVelocity.y);
        InterlockedAdd(_LatchStats[LATCH_STATS_WAKE_VEL_Z_INDEX], quantizedWakeVelocity.z);
    }

    BoidData result;
    result.Position = ToWorldSpace(position);
    result.Velocity = velocity;
    result.Panic = panic;
    result.StateFlags = stateFlags;
    _BoidsBufferWrite[index] = result;
}
