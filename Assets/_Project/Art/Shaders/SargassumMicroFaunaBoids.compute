#define _BoidCount ((uint)_Counts0.x)
#define _GrazingAnchorCount ((uint)_Counts0.y)
#define _MassiveThreatCount ((uint)_Counts0.z)
#define _FormationBeaconCount (_Counts0.w)
#define _FormationObstacleCount (_Counts1.x)
#define _LeviathanNodeCount (_Counts1.y)
#define _GlobalDriftOffset (_DriftOffset.xyz)
#define _DeepMode (_DriftOffset.w)
#define _GlobalDriftDelta (_DriftDelta.xyz)
#define _DeepClusterWeight (_DriftDelta.w)
