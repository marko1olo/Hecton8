#define _LeviathanWaveFrequency (_Leviathan1.x)
#define _LeviathanThreatLevel (_Leviathan1.y)
#define _LeviathanSurroundThreatThreshold (_Leviathan1.z)
#define _LeviathanSurroundRadius (_Leviathan1.w)
#define _LeviathanSurroundWeight (_Leviathan2.x)
#define _LeviathanSurroundSpinSpeed (_Leviathan2.y)
