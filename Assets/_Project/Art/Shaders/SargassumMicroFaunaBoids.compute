#define _SeparationRadius (_Neighbor0.y)
#define _BoidBodyRadius (_Neighbor0.z)
#define _ConsumedCollapseSpeed (_Neighbor0.w)
#define _SeparationWeight (_Flocking0.x)
#define _AlignmentWeight (_Flocking0.y)
#define _CohesionWeight (_Flocking0.z)
#define _ContainmentWeight (_Flocking0.w)
#define _PanicWeight (_Flocking1.x)
#define _NoiseWeight (_Flocking1.y)
#define _DensityThreshold (_Flocking1.z)
#define _WindowThreshold (_Flocking1.w)
