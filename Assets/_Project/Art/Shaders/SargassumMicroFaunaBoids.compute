#pragma kernel ClearLatchStats
#pragma kernel ClearSpatialGrid
#pragma kernel BuildSpatialGrid
#pragma kernel CSMain

struct BoidData
{
    float3 Position;
    float3 Velocity;
    float Panic;
    float State;
};

struct GrazingAnchorData
{
    float3 Position;
    float Radius;
    float Strength;
    float Phase;
    float2 Padding;
};

struct FormationBeaconData
{
    float3 Position;
    float Radius;
    float Strength;
    float Phase;
    float2 Padding;
};

struct FormationObstacleData
{
    float3 Position;
    float Radius;
    float Weight;
    float3 Padding;
};

struct LeviathanNodeData
{
    float3 Position;
    float Distance01;
    float3 Tangent;
    float Radius;
};

struct MassiveThreatData
{
    float3 Position;
    float InnerRadius;
    float PanicRadius;
    float Strength;
    float EndTime;
    float3 Padding;
};

StructuredBuffer<BoidData> _BoidsBufferRead;
RWStructuredBuffer<BoidData> _BoidsBufferWrite;
StructuredBuffer<GrazingAnchorData> _GrazingAnchors;
StructuredBuffer<FormationBeaconData> _FormationBeacons;
StructuredBuffer<FormationObstacleData> _FormationObstacles;
StructuredBuffer<LeviathanNodeData> _LeviathanNodes;
StructuredBuffer<MassiveThreatData> _MassiveThreats;
RWStructuredBuffer<int> _LatchStats;
RWByteAddressBuffer _SpatialGridCounts;
RWStructuredBuffer<uint> _SpatialGridCells;

Texture2D<float4> _DensityTex;
SamplerState sampler_DensityTex;

Texture2D<float4> _CutMaskTex;
SamplerState sampler_CutMaskTex;

