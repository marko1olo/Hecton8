#pragma kernel RaymarchVolumetricLight
#pragma kernel CompositeVolumetricLight
#pragma target 5.0
#pragma multi_compile _ _MAIN_LIGHT_SHADOWS _MAIN_LIGHT_SHADOWS_CASCADE

#include "Packages/com.unity.render-pipelines.core/ShaderLibrary/Common.hlsl"
#include "Packages/com.unity.render-pipelines.universal/ShaderLibrary/Core.hlsl"
#include "Packages/com.unity.render-pipelines.universal/ShaderLibrary/Shadows.hlsl"

#ifndef HECTON_VOLUMETRIC_LIGHT_MAX_STEPS
#define HECTON_VOLUMETRIC_LIGHT_MAX_STEPS 12
#endif

// Compute kernels sample the bound depth texture directly; DeclareDepthTexture maps incorrectly on cs_5_0.
TEXTURE2D_X(_HectonVolumetricSourceColor);
TEXTURE2D_X(_HectonVolumetricSourceDepth);
TEXTURE2D_X(_HectonVolumetricHalfInput);
RW_TEXTURE2D(float4, _HectonVolumetricHalfResult);
RW_TEXTURE2D(float4, _HectonVolumetricCompositeResult);

CBUFFER_START(HectonVolumetricLightParams)
    float4 _HectonVolumetricFullSize;
    float4 _HectonVolumetricHalfSize;
    float4 _HectonVolumetricMainLightDirection;
    float4 _HectonVolumetricMainLightColor;
    float4 _HectonFlashlightPositionWS;
    float4 _HectonFlashlightDirectionWS;
    float4 _HectonFlashlightColor;
    float4 _HectonFlashlightConeData;
    float4 _HectonFlashlightFailureState;
    float4 _HectonVolumetricScatteringParams;
    float4 _HectonHudFogPerturbation;
    float4 _HectonVolumetricMarchParams;
    float4 _HectonVolumetricShadowParams;
    float4 _HectonVolumetricCompositeParams;
    float _FogScatteringCoeff;
    float _HectonFlashlightActive;
    float _HectonFlashlightVolumetricOpacity;
    float _HectonFreezeFrameDither;
    float4x4 _HectonVolumetricInverseViewProjection;
    float4x4 _HectonVolumetricViewProjection;
CBUFFER_END

float4 _MeteorFogShadowPositions[4];
float4 _MeteorFogShadowParams;

float SafeRcp(float value)
{
    return abs(value) > 1e-5 ? rcp(value) : 0.0;
}

float FastNegativeExp(float x)
{
    x = max(0.0, x);
    float x2 = x * x;
    return rcp(1.0 + x + 0.48 * x2 + 0.235 * x2 * x);
}

float FastTrianglePulse01(float phase)
{
    return 1.0 - abs(frac(phase * 0.15915494 + 0.25) * 2.0 - 1.0);
}

float ResolveFlashlightFailureFlicker(float3 samplePositionWS)
{
    float battery01 = saturate(_HectonFlashlightFailureState.x);
    float thermal01 = saturate(_HectonFlashlightFailureState.y);
    float failure01 = saturate(_HectonFlashlightFailureState.z);
    float lowBatteryDrop = saturate((0.22 - battery01) * 4.5454545);
    float3 cell = floor(samplePositionWS * lerp(0.42, 1.85, thermal01)) + floor(_Time.y * lerp(5.0, 29.0, failure01));
    float3 hash = frac(cell * float3(0.1031, 0.1030, 0.0973));
    hash += dot(hash, hash.yzx + 33.33);
    float cellNoise = frac((hash.x + hash.y) * hash.z);
    float triangle = FastTrianglePulse01(_Time.y * lerp(3.0, 17.0, failure01) + cellNoise * 6.2831853);
    float dropout = lerp(0.72, 0.22, max(lowBatteryDrop, thermal01 * thermal01));
    return saturate(lerp(1.0, lerp(dropout, 1.0, triangle * triangle), max(failure01, lowBatteryDrop)));
}

float3 SafeNormalize3(float3 value)
{
    float lenSq = dot(value, value);
    return lenSq > 1e-5 ? value * rsqrt(lenSq) : float3(0.0, 1.0, 0.0);
}

float ResolveFarRawDepth()
{
#if UNITY_REVERSED_Z
    return 0.0;
#else
    return 1.0;
#endif
}

void ResolveDepthData(float2 screenUv, out float rawDepth, out float validMask, out float linearEyeDepth, out float3 positionWS)
{
    rawDepth = SAMPLE_TEXTURE2D_X_LOD(_HectonVolumetricSourceDepth, sampler_PointClamp, saturate(screenUv), 0).r;
#if UNITY_REVERSED_Z
    validMask = step(0.0001, rawDepth);
#else
    validMask = step(rawDepth, 0.9999);
#endif

    float resolvedRawDepth = validMask > 0.5 ? rawDepth : ResolveFarRawDepth();
    positionWS = ComputeWorldSpacePosition(screenUv, resolvedRawDepth, _HectonVolumetricInverseViewProjection);
    linearEyeDepth = LinearEyeDepth(resolvedRawDepth, _ZBufferParams);

    if (!isfinite(linearEyeDepth) || linearEyeDepth < 0.0)
    {
        validMask = 0.0;
        linearEyeDepth = 0.0;
    }
}

float Hash31(float3 value)
{
    float3 hash = frac(value * float3(0.1031, 0.1030, 0.0973));
    hash += dot(hash, hash.yzx + 33.33);
    return frac((hash.x + hash.y) * hash.z);
}

float ValueNoise3(float3 samplePosition)
{
    float3 cell = floor(samplePosition);
    float3 fracPart = frac(samplePosition);
    float3 smoothFrac = fracPart * fracPart * (3.0 - 2.0 * fracPart);

    float n000 = Hash31(cell + float3(0.0, 0.0, 0.0));
    float n100 = Hash31(cell + float3(1.0, 0.0, 0.0));
    float n010 = Hash31(cell + float3(0.0, 1.0, 0.0));
    float n110 = Hash31(cell + float3(1.0, 1.0, 0.0));
    float n001 = Hash31(cell + float3(0.0, 0.0, 1.0));
    float n101 = Hash31(cell + float3(1.0, 0.0, 1.0));
    float n011 = Hash31(cell + float3(0.0, 1.0, 1.0));
    float n111 = Hash31(cell + float3(1.0, 1.0, 1.0));

    float nx00 = lerp(n000, n100, smoothFrac.x);
    float nx10 = lerp(n010, n110, smoothFrac.x);
    float nx01 = lerp(n001, n101, smoothFrac.x);
    float nx11 = lerp(n011, n111, smoothFrac.x);
    float nxy0 = lerp(nx00, nx10, smoothFrac.y);
    float nxy1 = lerp(nx01, nx11, smoothFrac.y);
    return lerp(nxy0, nxy1, smoothFrac.z);
}

float Fbm3(float3 samplePosition)
{
    float amplitude = 0.5;
    float frequency = 1.0;
    float sum = 0.0;

    [unroll]
    for (int octave = 0; octave < 3; octave++)
    {
        sum += ValueNoise3(samplePosition * frequency) * amplitude;
        frequency *= 2.13;
        amplitude *= 0.48;
    }

    return sum;
}

float ResolveInterleavedGradientNoise(float2 screenUv)
{
    float2 pixel = floor(screenUv * _HectonVolumetricFullSize.xy);
    float frameIndex = floor(_Time.y * 60.0);
    float2 temporalPhase = float2(fmod(frameIndex, 2.0), fmod(floor(frameIndex * 0.5), 2.0)) * 0.5;
    return frac(52.9829189 * frac(dot(pixel + temporalPhase, float2(0.06711056, 0.00583715))));
}

float PhaseHG(float cosTheta, float anisotropy)
{
    float g = clamp(anisotropy, -0.95, 0.95);
    float gSq = g * g;
    float denominator = max(1.0 + gSq - 2.0 * g * cosTheta, 1e-4);
    return (1.0 - gSq) * SafeRcp(4.0 * PI) * SafeRcp(denominator) * rsqrt(denominator);
}

float SampleFogDensity(float3 samplePositionWS, float normalizedTravel)
{
    float density = max(_HectonVolumetricScatteringParams.x, 0.0);
    float timePhase = _Time.y * 0.12;
    float3 noisePosition = samplePositionWS * 0.045;
    noisePosition += float3(timePhase, -timePhase * 0.73, timePhase * 0.51);
    float coarse = Fbm3(noisePosition);
    float fine = Fbm3(noisePosition * 1.87 + 13.0);
    float stratification = lerp(1.0, 0.32, saturate(normalizedTravel));
    float noiseValue = saturate(coarse * 0.68 + fine * 0.32);
    return density * noiseValue * stratification;
}

float ResolveMainLightShadow(float3 samplePositionWS)
{
#if defined(_MAIN_LIGHT_SHADOWS) || defined(_MAIN_LIGHT_SHADOWS_CASCADE)
    float4 shadowCoord = TransformWorldToShadowCoord(samplePositionWS);
    return MainLightRealtimeShadow(shadowCoord);
#else
    return 1.0;
#endif
}

float ResolveDepthOcclusionAtWorldPosition(float3 samplePositionWS, float depthBias)
{
    float4 samplePositionCS = mul(_HectonVolumetricViewProjection, float4(samplePositionWS, 1.0));
    if (samplePositionCS.w <= 0.0001)
        return 0.0;

    float2 sampleUv = samplePositionCS.xy * SafeRcp(samplePositionCS.w) * 0.5 + 0.5;
    if (sampleUv.x <= 0.0 || sampleUv.x >= 1.0 || sampleUv.y <= 0.0 || sampleUv.y >= 1.0)
        return 0.0;

    float rawDepth;
    float validMask;
    float linearEyeDepth;
    float3 scenePositionWS;
    ResolveDepthData(sampleUv, rawDepth, validMask, linearEyeDepth, scenePositionWS);
    if (validMask <= 0.5)
        return 0.0;

    float sampleEyeDepth = samplePositionCS.w;
    return step(linearEyeDepth + depthBias, sampleEyeDepth);
}

float ResolveFlashlightConeMask(float3 samplePositionWS, float3 cameraToSampleDirectionWS, out float3 coneColor)
{
    coneColor = 0.0;
    if (_HectonFlashlightActive <= 0.5 || _HectonFlashlightColor.w <= 0.001 || _HectonFlashlightVolumetricOpacity <= 0.001)
        return 0.0;

    float3 lightPositionWS = _HectonFlashlightPositionWS.xyz;
    float lightRange = max(_HectonFlashlightPositionWS.w, 0.1);
    float lightRangeSq = lightRange * lightRange;
    float3 lightToSampleWS = samplePositionWS - lightPositionWS;
    float sampleDistanceSq = dot(lightToSampleWS, lightToSampleWS);
    if (sampleDistanceSq <= 1e-6 || sampleDistanceSq >= lightRangeSq)
        return 0.0;

    float3 lightDirectionWS = SafeNormalize3(_HectonFlashlightDirectionWS.xyz);
    float invSampleDistance = rsqrt(sampleDistanceSq);
    float3 sampleDirectionWS = lightToSampleWS * invSampleDistance;
    float innerCos = _HectonFlashlightDirectionWS.w;
    float outerCos = _HectonFlashlightConeData.x;
    float coneMask = saturate((dot(lightDirectionWS, sampleDirectionWS) - outerCos) * SafeRcp(max(innerCos - outerCos, 0.001)));
    coneMask *= coneMask;

    float rangeMask = saturate(1.0 - sampleDistanceSq * SafeRcp(lightRangeSq));
    rangeMask *= rangeMask;

    float viewAlignment = saturate(dot(SafeNormalize3(cameraToSampleDirectionWS), lightDirectionWS));
    float backscatter = lerp(0.18, 1.0, viewAlignment * viewAlignment);
    float pressureStripe = 0.94 + 0.06 * (FastTrianglePulse01(dot(samplePositionWS, float3(0.31, 1.73, -0.27)) + _Time.y * 3.1) * 2.0 - 1.0);
    float failureFlicker = ResolveFlashlightFailureFlicker(samplePositionWS);
    coneColor = _HectonFlashlightColor.rgb * _HectonFlashlightColor.w * failureFlicker * saturate(_HectonFlashlightVolumetricOpacity);
    return coneMask * rangeMask * backscatter * pressureStripe * failureFlicker;
}

float ResolveVolumetricShadowRaymarch(float3 samplePositionWS, float3 lightDirectionWS, float density)
{
    float strength = max(_HectonVolumetricShadowParams.w, 0.0);
    if (strength <= 0.0001 || density <= 0.0001)
        return 1.0;

    int stepCount = clamp((int)round(_HectonVolumetricShadowParams.x), 1, HECTON_VOLUMETRIC_LIGHT_MAX_STEPS);
    float marchDistance = max(_HectonVolumetricShadowParams.y, 0.1);
    float depthBias = max(_HectonVolumetricShadowParams.z, 0.001);
    float stepLength = marchDistance * SafeRcp((float)stepCount);
    float3 toLightDirectionWS = -SafeNormalize3(lightDirectionWS);
    float transmittance = 1.0;

    [loop]
    for (int stepIndex = 0; stepIndex < HECTON_VOLUMETRIC_LIGHT_MAX_STEPS; stepIndex++)
    {
        if (stepIndex >= stepCount)
            break;

        float travel = (stepIndex + 0.5) * stepLength;
        float3 raySampleWS = samplePositionWS + toLightDirectionWS * travel;
        float occlusion = ResolveDepthOcclusionAtWorldPosition(raySampleWS, depthBias);
        transmittance *= FastNegativeExp(occlusion * density * strength * stepLength);
        if (transmittance <= 0.02)
            return 0.02;
    }

    return saturate(transmittance);
}

float ResolveMeteorFogShadow(float3 samplePositionWS)
{
    int shadowCount = clamp((int)round(_MeteorFogShadowParams.x), 0, 4);
    float strength = saturate(_MeteorFogShadowParams.y);
    if (shadowCount <= 0 || strength <= 0.0001)
        return 1.0;

    float occlusion = 0.0;
    [unroll]
    for (int index = 0; index < 4; index++)
    {
        if (index >= shadowCount)
            break;

        float4 payload = _MeteorFogShadowPositions[index];
        float radius = max(payload.w, 1.0);
        float radiusSq = radius * radius;
        float3 meteorDelta = samplePositionWS - payload.xyz;
        float distanceSq = dot(meteorDelta, meteorDelta);
        float localShadow = saturate(1.0 - distanceSq * SafeRcp(radiusSq));
        occlusion = max(occlusion, localShadow * localShadow);
    }

    return saturate(1.0 - occlusion * strength);
}

[numthreads(8, 8, 1)]
void RaymarchVolumetricLight(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint2 pixel = dispatchThreadId.xy;
    uint2 halfResolution = (uint2)_HectonVolumetricHalfSize.xy;
    if (pixel.x >= halfResolution.x || pixel.y >= halfResolution.y)
        return;

    float mainLightAvailable = step(0.5, _HectonVolumetricMainLightDirection.w);
    float flashlightAvailable = step(0.5, _HectonFlashlightActive) * step(0.001, _HectonFlashlightColor.w) * step(0.001, _HectonFlashlightVolumetricOpacity);
    if (mainLightAvailable <= 0.0 && flashlightAvailable <= 0.0)
    {
        _HectonVolumetricHalfResult[pixel] = 0.0;
        return;
    }

    float2 screenUv = (pixel + 0.5) * _HectonVolumetricHalfSize.zw;
    float rawDepth;
    float validMask;
    float linearEyeDepth;
    float3 scenePositionWS;
    ResolveDepthData(screenUv, rawDepth, validMask, linearEyeDepth, scenePositionWS);
    if (validMask <= 0.5 || linearEyeDepth <= 0.0001)
    {
        _HectonVolumetricHalfResult[pixel] = 0.0;
        return;
    }

    float3 cameraPositionWS = _WorldSpaceCameraPos;
    float3 rayVectorWS = cameraPositionWS - scenePositionWS;
    float rayLengthSq = dot(rayVectorWS, rayVectorWS);
    if (rayLengthSq <= 1e-8)
    {
        _HectonVolumetricHalfResult[pixel] = 0.0;
        return;
    }

    float invRayLength = rsqrt(rayLengthSq);
    float rayLength = min(rayLengthSq * invRayLength, max(_HectonVolumetricMarchParams.x, 0.1));
    int stepCount = clamp((int)round(_HectonVolumetricMarchParams.y), 1, HECTON_VOLUMETRIC_LIGHT_MAX_STEPS);
    float stepSize = rayLength * SafeRcp((float)stepCount);
    float jitter = ResolveInterleavedGradientNoise(screenUv) * stepSize * saturate(_HectonVolumetricMarchParams.z);
    float3 rayDirectionWS = rayVectorWS * invRayLength;
    float3 lightDirectionWS = SafeNormalize3(_HectonVolumetricMainLightDirection.xyz);
    float3 lightColor = _HectonVolumetricMainLightColor.rgb;
    float scatterCoeff = max(_HectonVolumetricScatteringParams.y, 0.0);
    float anisotropy = _HectonVolumetricScatteringParams.z;
    float intensity = max(_HectonVolumetricScatteringParams.w, 0.0);
    float minTransmittance = saturate(_HectonVolumetricMarchParams.w);
    float transmittance = 1.0;
    float3 accumulatedLight = 0.0;

    [loop]
    for (int stepIndex = 0; stepIndex < HECTON_VOLUMETRIC_LIGHT_MAX_STEPS; stepIndex++)
    {
        if (stepIndex >= stepCount)
            break;

        float travelDistance = min(rayLength, jitter + (stepIndex + 0.5) * stepSize);
        float normalizedTravel = saturate(travelDistance * SafeRcp(max(rayLength, 0.0001)));
        float3 samplePositionWS = scenePositionWS + rayDirectionWS * travelDistance;
        float density = SampleFogDensity(samplePositionWS, normalizedTravel);
        if (density <= 0.0001)
            continue;

        float nearCameraHudMask = saturate(1.0 - normalizedTravel * 2.75);
        float hudFogLuminance = saturate(_HectonHudFogPerturbation.x);
        float hudDensityLift = 1.0 + hudFogLuminance * nearCameraHudMask * 0.18;
        float localScatterCoeff = scatterCoeff + max(_HectonHudFogPerturbation.z, 0.0) * nearCameraHudMask;
        localScatterCoeff += max(_FogScatteringCoeff, 0.0) * hudFogLuminance * nearCameraHudMask * 2.0;
        density *= hudDensityLift;

        float extinction = density * max(localScatterCoeff, 0.0001);
        transmittance *= FastNegativeExp(extinction * stepSize);

        if (mainLightAvailable > 0.0)
        {
            float cosTheta = saturate(dot(rayDirectionWS, lightDirectionWS));
            float phase = PhaseHG(cosTheta, anisotropy);
            float shadowTerm = ResolveMainLightShadow(samplePositionWS);
            shadowTerm *= ResolveVolumetricShadowRaymarch(samplePositionWS, lightDirectionWS, density);
            shadowTerm *= ResolveMeteorFogShadow(samplePositionWS);
            accumulatedLight += density * localScatterCoeff * phase * shadowTerm * transmittance * stepSize * lightColor;
        }

        if (flashlightAvailable > 0.0)
        {
            float3 flashlightColor;
            float flashlightCone = ResolveFlashlightConeMask(samplePositionWS, -rayDirectionWS, flashlightColor);
            float coneDither = lerp(0.58, 1.22, ResolveInterleavedGradientNoise(screenUv + float2(stepIndex * 0.071, stepIndex * 0.113)));
            accumulatedLight += density * localScatterCoeff * flashlightCone * coneDither * transmittance * stepSize * flashlightColor;
        }

        if (transmittance <= minTransmittance)
            break;
    }

    _HectonVolumetricHalfResult[pixel] = float4(accumulatedLight * intensity, 1.0 - transmittance);
}

[numthreads(8, 8, 1)]
void CompositeVolumetricLight(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint2 pixel = dispatchThreadId.xy;
    uint2 fullResolution = (uint2)_HectonVolumetricFullSize.xy;
    if (pixel.x >= fullResolution.x || pixel.y >= fullResolution.y)
        return;

    float2 centerUv = (pixel + 0.5) * _HectonVolumetricFullSize.zw;
    float rawDepth;
    float validMask;
    float linearEyeDepth;
    float3 positionWS;
    ResolveDepthData(centerUv, rawDepth, validMask, linearEyeDepth, positionWS);

    float4 sourceColor = LOAD_TEXTURE2D_X(_HectonVolumetricSourceColor, pixel);
    float mainLightAvailable = step(0.5, _HectonVolumetricMainLightDirection.w);
    float flashlightAvailable = step(0.5, _HectonFlashlightActive) * step(0.001, _HectonFlashlightColor.w) * step(0.001, _HectonFlashlightVolumetricOpacity);
    if ((mainLightAvailable <= 0.0 && flashlightAvailable <= 0.0) || validMask <= 0.5)
    {
        _HectonVolumetricCompositeResult[pixel] = sourceColor;
        return;
    }

    float2 halfPixel = centerUv * _HectonVolumetricHalfSize.xy - 0.5;
    float2 basePixel = floor(halfPixel);
    float4 accumulated = 0.0;
    float weightSum = 0.0;
    float depthScale = max(_HectonVolumetricCompositeParams.x, 0.01);

    [unroll]
    for (int tapY = -1; tapY <= 1; tapY++)
    {
        [unroll]
        for (int tapX = -1; tapX <= 1; tapX++)
        {
            float2 samplePixel = clamp(
                basePixel + float2(tapX, tapY) + 0.5,
                float2(0.5, 0.5),
                _HectonVolumetricHalfSize.xy - 0.5);
            float2 sampleUv = samplePixel * _HectonVolumetricHalfSize.zw;
            float tapRawDepth;
            float tapValidMask;
            float tapLinearEyeDepth;
            float3 tapPositionWS;
            ResolveDepthData(sampleUv, tapRawDepth, tapValidMask, tapLinearEyeDepth, tapPositionWS);
            float depthWeight = tapValidMask > 0.5
                ? FastNegativeExp(abs(tapLinearEyeDepth - linearEyeDepth) * depthScale)
                : 0.0;
            float2 offset = samplePixel - halfPixel;
            float spatialWeight = FastNegativeExp(dot(offset, offset) * 0.9);
            float weight = spatialWeight * depthWeight;
            accumulated += SAMPLE_TEXTURE2D_X_LOD(_HectonVolumetricHalfInput, sampler_LinearClamp, saturate(sampleUv), 0) * weight;
            weightSum += weight;
        }
    }

    float4 volumetric = weightSum > 1e-5 ? accumulated * SafeRcp(weightSum) : 0.0;
    float freeze = saturate(_HectonFreezeFrameDither);
    float freezeNoise = ResolveInterleavedGradientNoise(centerUv);
    float freezeKeep = lerp(1.0, step(freezeNoise, saturate(volumetric.a + 0.25)), freeze);
    volumetric.rgb = volumetric.rgb * freezeKeep + (freezeNoise - 0.5) * freeze * 0.018;
    _HectonVolumetricCompositeResult[pixel] = float4(sourceColor.rgb + volumetric.rgb, sourceColor.a);
}
