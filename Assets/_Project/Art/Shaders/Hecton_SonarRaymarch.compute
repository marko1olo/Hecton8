#pragma kernel CSClearArgs
#pragma kernel CSRaymarch
#pragma kernel CSDecayEchoes
#pragma target 5.0

struct SonarPointDTO
{
    float3 LocalPosition;
    uint ColorPacked;
};

RWStructuredBuffer<SonarPointDTO> _SonarPointBuffer;
StructuredBuffer<uint> _SonarMaterialColorLut;
Texture3D<float> _VoxelSdfTexture3D;
SamplerState sampler_VoxelSdfTexture3D;
RWByteAddressBuffer _IndirectArgs;

cbuffer TopographicalSonarParams
{
    float3 _PingRuntime;
    float _PadPing0;
    float3 _PingCameraLocal;
    float _PadPing1;
    float3 _VolumeOrigin;
    float _SdfRange;
    float3 _CellSize;
    float _MaxDistanceMeters;
    int3 _GridDimensions;
    int _RayCount;
    float _StepMeters;
    float _GlobalQualityWeight;
    float _Intensity01;
    float _FadeDelta01;
    uint _SequenceSeed;
    uint _IndexCountPerInstance;
    uint _Pad0;
    uint _Pad1;
};

uint PackColor(uint r, uint g, uint b, uint a)
{
    return (r & 255u) | ((g & 255u) << 8) | ((b & 255u) << 16) | ((a & 255u) << 24);
}

uint DefaultColor(uint materialId)
{
    if (materialId == 2u)
        return PackColor(255u, 190u, 68u, 230u);
    if (materialId == 3u)
        return PackColor(255u, 72u, 38u, 210u);
    if (materialId == 1u)
        return PackColor(78u, 196u, 255u, 205u);
    return PackColor(40u, 255u, 216u, 185u);
}

float3 FibonacciDirection(uint index, uint count, uint seed)
{
    float safeCount = max(1.0f, (float)count);
    float k = (float)index + 0.5f;
    float z = 1.0f - 2.0f * k / safeCount;
    float radius = sqrt(max(0.0f, 1.0f - z * z));
    float theta = k * 2.39996323f + (float)(seed & 1023u) * 0.006135923f;
    return float3(cos(theta) * radius, z, sin(theta) * radius);
}

float SampleSdf(float3 runtimePosition)
{
    float3 grid = (runtimePosition - _VolumeOrigin) / max(_CellSize, 0.0001f.xxx);
    if (any(grid < 0.0f.xxx) || grid.x > _GridDimensions.x - 1 || grid.y > _GridDimensions.y - 1 || grid.z > _GridDimensions.z - 1)
        return -_SdfRange;

    float3 uvw = grid / max((float3)(_GridDimensions - 1), 1.0f.xxx);
    float normalized = _VoxelSdfTexture3D.SampleLevel(sampler_VoxelSdfTexture3D, uvw, 0).r;
    return (normalized * 2.0f - 1.0f) * _SdfRange;
}

[numthreads(1, 1, 1)]
void CSClearArgs(uint3 id : SV_DispatchThreadID)
{
    _IndirectArgs.Store(0, _IndexCountPerInstance);
    _IndirectArgs.Store(4, 0u);
    _IndirectArgs.Store(8, 0u);
    _IndirectArgs.Store(12, 0u);
    _IndirectArgs.Store(16, 0u);
}

[numthreads(128, 1, 1)]
void CSRaymarch(uint3 id : SV_DispatchThreadID)
{
    uint rayIndex = id.x;
    if (rayIndex >= (uint)_RayCount)
        return;

    float3 direction = FibonacciDirection(rayIndex, (uint)_RayCount, _SequenceSeed);
    float stepMeters = max(0.05f, _StepMeters);
    float previous = SampleSdf(_PingRuntime);
    float previousDistance = 0.0f;
    uint maxSteps = (uint)ceil(_MaxDistanceMeters / stepMeters);

    [loop]
    for (uint stepIndex = 1u; stepIndex <= maxSteps; stepIndex++)
    {
        float distanceMeters = min(_MaxDistanceMeters, (float)stepIndex * stepMeters);
        float3 sampleRuntime = _PingRuntime + direction * distanceMeters;
        float signedDistance = SampleSdf(sampleRuntime);
        if (signedDistance >= 0.0f && previous < 0.0f)
        {
            float t = saturate(-previous / max(0.0001f, signedDistance - previous));
            float resolvedDistance = lerp(previousDistance, distanceMeters, t);
            float3 cameraLocal = _PingCameraLocal + direction * resolvedDistance;
            float distance01 = saturate(resolvedDistance / max(0.001f, _MaxDistanceMeters));
            uint color = DefaultColor(1u);
            uint alpha = (uint)clamp((float)((color >> 24) & 255u) * _Intensity01 * (1.0f - distance01 * 0.45f), 0.0f, 255.0f);
            _SonarPointBuffer[rayIndex].LocalPosition = cameraLocal;
            _SonarPointBuffer[rayIndex].ColorPacked = (color & 0x00FFFFFFu) | (alpha << 24);
            _IndirectArgs.Store(4, (uint)_RayCount);
            return;
        }

        previous = signedDistance;
        previousDistance = distanceMeters;
    }

    _SonarPointBuffer[rayIndex].LocalPosition = 0.0f.xxx;
    _SonarPointBuffer[rayIndex].ColorPacked = 0u;
}

[numthreads(128, 1, 1)]
void CSDecayEchoes(uint3 id : SV_DispatchThreadID)
{
    uint pointIndex = id.x;
    if (pointIndex >= (uint)_RayCount)
        return;

    SonarPointDTO point = _SonarPointBuffer[pointIndex];
    uint alpha = (point.ColorPacked >> 24) & 255u;
    uint faded = (uint)max(0.0f, (float)alpha - _FadeDelta01 * 255.0f);
    point.ColorPacked = (point.ColorPacked & 0x00FFFFFFu) | (faded << 24);
    _SonarPointBuffer[pointIndex] = point;
}
