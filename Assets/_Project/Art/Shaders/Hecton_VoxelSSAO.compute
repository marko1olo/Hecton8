#pragma kernel ResolveVoxelSSAO

#include "Packages/com.unity.render-pipelines.universal/ShaderLibrary/Core.hlsl"

RWTexture2D<float> _HectonVoxelSSAOResult;
Texture2D<float> _HectonVoxelSSAODepth;

float4 _HectonVoxelSSAOParamsA; // x=projection scale, y=radius meters, z=intensity, w=depth sigma

bool IsFiniteScalar(float value)
{
    return isfinite(value);
}

float ResolveFiniteOrDefault(float value, float fallback)
{
    return IsFiniteScalar(value) ? value : fallback;
}

static const float2 kKernelDirections[4] =
{
    float2(1.0, 0.0),
    float2(0.5, 0.8660254),
    float2(-0.5, 0.8660254),
    float2(-1.0, 0.0)
};

float ResolveInterleavedNoise(float2 pixelCoord)
{
    return frac(52.9829189 * frac(dot(pixelCoord, float2(0.06711056, 0.00583715))));
}

float2 ResolveOctantRotation(float noiseValue)
{
    static const float2 kOctantRotations[8] =
    {
        float2(1.0, 0.0),
        float2(0.7071068, 0.7071068),
        float2(0.0, 1.0),
        float2(-0.7071068, 0.7071068),
        float2(-1.0, 0.0),
        float2(-0.7071068, -0.7071068),
        float2(0.0, -1.0),
        float2(0.7071068, -0.7071068)
    };
    uint rotationIndex = (uint)(saturate(noiseValue) * 8.0) & 7u;
    return kOctantRotations[rotationIndex];
}

float2 ResolveFiniteFloat2(float2 value, float2 fallback)
{
    return all(isfinite(value)) ? value : fallback;
}

int2 FastRoundToInt2(float2 value)
{
    value = ResolveFiniteFloat2(value, float2(0.0, 0.0));
    return int2(
        value.x >= 0.0 ? (int)(value.x + 0.5) : (int)(value.x - 0.5),
        value.y >= 0.0 ? (int)(value.y + 0.5) : (int)(value.y - 0.5));
}

bool IsDepthValid(float rawDepth)
{
    if (!IsFiniteScalar(rawDepth))
        return false;

#if defined(UNITY_REVERSED_Z)
    return rawDepth > 0.0001;
#else
    return rawDepth < 0.9999;
#endif
}

int2 ResolveSourcePixel(uint2 outputPixel, uint2 outputSize, int2 fullResSize)
{
    int2 resolvedPixel = int2(
        ((outputPixel.x * fullResSize.x) + (outputSize.x >> 1)) / max(1u, outputSize.x),
        ((outputPixel.y * fullResSize.y) + (outputSize.y >> 1)) / max(1u, outputSize.y));
    return clamp(resolvedPixel, int2(0, 0), fullResSize - 1);
}

[numthreads(8, 8, 1)]
void ResolveVoxelSSAO(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint outputWidth;
    uint outputHeight;
    uint sourceWidth;
    uint sourceHeight;
    _HectonVoxelSSAOResult.GetDimensions(outputWidth, outputHeight);
    _HectonVoxelSSAODepth.GetDimensions(sourceWidth, sourceHeight);

    if (outputWidth == 0u || outputHeight == 0u || sourceWidth == 0u || sourceHeight == 0u)
        return;

    uint2 outputSize = uint2(outputWidth, outputHeight);
    if (dispatchThreadId.x >= outputSize.x || dispatchThreadId.y >= outputSize.y)
        return;

    int2 fullResSize = int2(sourceWidth, sourceHeight);
    int2 centerPixel = ResolveSourcePixel(dispatchThreadId.xy, outputSize, fullResSize);
    float centerDepthRaw = _HectonVoxelSSAODepth.Load(int3(centerPixel, 0));
    if (!IsDepthValid(centerDepthRaw))
    {
        _HectonVoxelSSAOResult[dispatchThreadId.xy] = 1.0;
        return;
    }

    float centerLinearDepth = ResolveFiniteOrDefault(LinearEyeDepth(centerDepthRaw, _ZBufferParams), 0.0);

    float projectionScale = ResolveFiniteOrDefault(_HectonVoxelSSAOParamsA.x, 8.0);
    float radiusPixels = clamp(projectionScale / max(centerLinearDepth, 0.5), 1.0, 24.0);
    float2 rotation = ResolveOctantRotation(ResolveFiniteOrDefault(ResolveInterleavedNoise(dispatchThreadId.xy), 0.0));
    float radiusMeters = max(ResolveFiniteOrDefault(_HectonVoxelSSAOParamsA.y, 1.0), 0.001);
    float radiusMetersSq = radiusMeters * radiusMeters;
    float invRadiusMetersSq = rcp(radiusMetersSq);
    float intensity = max(0.0, ResolveFiniteOrDefault(_HectonVoxelSSAOParamsA.z, 1.0));
    float depthSigma = max(0.01, ResolveFiniteOrDefault(_HectonVoxelSSAOParamsA.w, 1.0));

    float occlusion = 0.0;
    float weightSum = 0.0;

    [unroll(4)]
    for (int sampleIndex = 0; sampleIndex < 4; sampleIndex++)
    {
        float2 direction = kKernelDirections[sampleIndex];
        float2 rotatedDirection = float2(
            direction.x * rotation.x - direction.y * rotation.y,
            direction.x * rotation.y + direction.y * rotation.x);
        int2 samplePixel = centerPixel + FastRoundToInt2(rotatedDirection * radiusPixels);
        samplePixel = clamp(samplePixel, int2(0, 0), fullResSize - 1);

        float sampleDepthRaw = _HectonVoxelSSAODepth.Load(int3(samplePixel, 0));
        if (!IsDepthValid(sampleDepthRaw))
            continue;

        float sampleLinearDepth = ResolveFiniteOrDefault(LinearEyeDepth(sampleDepthRaw, _ZBufferParams), centerLinearDepth);
        float depthDelta = centerLinearDepth - sampleLinearDepth;
        if (depthDelta <= 0.0)
            continue;

        float depthDeltaSq = depthDelta * depthDelta;
        if (!IsFiniteScalar(depthDeltaSq) || depthDeltaSq >= radiusMetersSq)
            continue;

        float rangeWeight = 1.0 - saturate(depthDeltaSq * invRadiusMetersSq);
        float depthWeight = rcp(1.0 + depthDelta * depthSigma);
        float sampleWeight = rangeWeight * depthWeight;
        occlusion += saturate(depthDelta * intensity) * sampleWeight;
        weightSum += sampleWeight;
    }

    float normalizedOcclusion = weightSum > 0.0001 ? saturate(ResolveFiniteOrDefault(occlusion / weightSum, 0.0)) : 0.0;
    _HectonVoxelSSAOResult[dispatchThreadId.xy] = saturate(ResolveFiniteOrDefault(1.0 - normalizedOcclusion, 1.0));
}
