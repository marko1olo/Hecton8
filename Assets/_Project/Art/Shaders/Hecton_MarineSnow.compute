#pragma kernel CSMain
#pragma kernel ClearSonarGlow
#pragma kernel AccumulateSonarGlow

#include "Packages/com.unity.render-pipelines.universal/ShaderLibrary/Core.hlsl"

struct Particle
{
    float3 Pos;
    float Life;
    float3 Vel;
    float Size;
    float3 PrevPos;
    uint Flags;
    float2 UV;
    float2 Pad;
};

StructuredBuffer<Particle> _MarineSnowParticlesRead;
RWStructuredBuffer<Particle> _MarineSnowParticlesWrite;
StructuredBuffer<float2> _MarineSnowFlowField;
Texture2D<float4> _HectonShallowWaterFieldRT;
SamplerState sampler_HectonShallowWaterFieldRT;
Texture2D<float> _CameraDepthTexture;
SamplerState sampler_CameraDepthTexture;
RWTexture2D<int> _HectonMarineSnowSonarGlowResult;

struct MarineSnowFrameData
{
    float4 CameraPositionTime;
    float4 CameraRightDeltaTime;
    float4 CameraUpDensity;
    float4 FlowFieldCenterCellSize;
    float4 ShellParams;
    float4 MetaParams;
};

StructuredBuffer<MarineSnowFrameData> _HectonMarineSnowFrame;

#define _MarineSnowCameraPosition_Time (_HectonMarineSnowFrame[0].CameraPositionTime)
#define _MarineSnowCameraRight_DeltaTime (_HectonMarineSnowFrame[0].CameraRightDeltaTime)
#define _MarineSnowCameraUp_Density (_HectonMarineSnowFrame[0].CameraUpDensity)
#define _MarineSnowFlowFieldCenterCellSize (_HectonMarineSnowFrame[0].FlowFieldCenterCellSize)
#define _MarineSnowShellParams (_HectonMarineSnowFrame[0].ShellParams)
#define _MarineSnowMetaParams (_HectonMarineSnowFrame[0].MetaParams)

float4 _MarineSnowDriftParams;
float4 _MarineSnowFlowParams;
float4 _MarineSnowEmissionParams;
float4 _MarineSnowBubbleParams;
float4 _HectonFlowSynchronyParams;
float4 _HectonFloatingOriginOffset;
float4 _HectonShallowWaterFieldWorldRect;
float4 _HectonShallowWaterFieldTexelSize;
float _HectonShallowWaterFieldActive;
float4x4 _MarineSnowViewProjection;
float4x4 _MarineSnowViewMatrix;
float4 _MarineSnowZBufferParams;
float4 _MarineSnowDepthTextureTexelSize;
float4 _MarineSnowDepthCollisionParams;
float4 _SonarRevealOriginWS;
float4 _SonarRevealWaveParams;
float _SonarWaveFront;
float _SonarRevealExpireTime;
float4 _HectonMarineSnowSonarGlowTexelSize;
float4 _HectonMarineSnowSonarGlowParams;

#define THREAD_GROUP_SIZE 64
#define TAU 6.2831853
#define EPSILON 0.0001

bool HasMarineSnowFlag(uint flags, uint mask)
{
    return (flags & mask) != 0u;
}

float Hash11(float value)
{
    return frac(sin(value * 12.9898 + 78.233) * 43758.5453);
}

float Hash21(float2 value)
{
    value = frac(value * float2(0.1031, 0.1030));
    value += dot(value, value.yx + 33.33);
    return frac((value.x + value.y) * value.x);
}

float Hash31(float3 value)
{
    value = frac(value * 0.1031);
    value += dot(value, value.yzx + 31.32);
    return frac((value.x + value.y) * value.z);
}

float HashSin(float2 value)
{
    return sin(dot(value, float2(12.9898, 78.233))) * 0.5 + 0.5;
}

float3 SafeNormalizeMarineSnow(float3 value)
{
    float lengthSq = dot(value, value);
    if (!isfinite(lengthSq) || lengthSq <= EPSILON)
        return float3(0.0, 0.0, 0.0);

    return value * rsqrt(lengthSq);
}

float ValueNoise3(float3 value)
{
    float3 cell = floor(value);
    float3 fracValue = frac(value);
    float3 smoothValue = fracValue * fracValue * (3.0 - 2.0 * fracValue);

    float n000 = Hash31(cell + float3(0.0, 0.0, 0.0));
    float n100 = Hash31(cell + float3(1.0, 0.0, 0.0));
    float n010 = Hash31(cell + float3(0.0, 1.0, 0.0));
    float n110 = Hash31(cell + float3(1.0, 1.0, 0.0));
    float n001 = Hash31(cell + float3(0.0, 0.0, 1.0));
    float n101 = Hash31(cell + float3(1.0, 0.0, 1.0));
    float n011 = Hash31(cell + float3(0.0, 1.0, 1.0));
    float n111 = Hash31(cell + float3(1.0, 1.0, 1.0));

    float nx00 = lerp(n000, n100, smoothValue.x);
    float nx10 = lerp(n010, n110, smoothValue.x);
    float nx01 = lerp(n001, n101, smoothValue.x);
    float nx11 = lerp(n011, n111, smoothValue.x);
    float nxy0 = lerp(nx00, nx10, smoothValue.y);
    float nxy1 = lerp(nx01, nx11, smoothValue.y);
    return lerp(nxy0, nxy1, smoothValue.z);
}

float ResolveFlowSynchronyPhase(float3 positionWS)
{
    float3 absolutePositionWS = positionWS + _HectonFloatingOriginOffset.xyz;
    return _HectonFlowSynchronyParams.z + dot(absolutePositionWS.xz, float2(0.031, -0.027));
}

float3 ResolveFlowSynchronyOffset(float3 positionWS, float3 flowSample)
{
    float3 flowDirection = SafeNormalizeMarineSnow(flowSample);
    float flowMagnitude = length(flowSample.xz) * max(_HectonFlowSynchronyParams.x, 1.0);
    if (flowMagnitude <= EPSILON)
        return 0.0.xxx;

    float phase = ResolveFlowSynchronyPhase(positionWS);
    return flowDirection * (sin(phase) * flowMagnitude);
}

float3 ResolveTurbulence(float3 positionWS, float simulationTime)
{
    float turbulenceFrequency = max(_HectonFlowSynchronyParams.y, 0.01);
    float3 samplePosition = positionWS * turbulenceFrequency + simulationTime * turbulenceFrequency;
    return float3(
        ValueNoise3(samplePosition + float3(17.1, 3.4, 11.7)),
        ValueNoise3(samplePosition + float3(7.3, 19.4, 29.8)),
        ValueNoise3(samplePosition + float3(23.7, 5.1, 13.2))) * 2.0 - 1.0;
}

float ResolveBaseDescent(uint particleIndex)
{
    return lerp(_MarineSnowDriftParams.x, _MarineSnowDriftParams.y, Hash11(particleIndex * 17.0));
}

float2 SampleFlowFieldXZ(float3 positionWS)
{
    int resolution = (int)round(_MarineSnowMetaParams.y);
    float cellSize = max(_MarineSnowFlowFieldCenterCellSize.w, 0.001);
    if (resolution <= 1 || cellSize <= 0.0)
        return float2(0.0, 0.0);

    float halfExtent = (resolution - 1) * cellSize * 0.5;
    float2 centerXZ = _MarineSnowFlowFieldCenterCellSize.xz;
    float2 gridPosition = ((positionWS.xz - centerXZ) + halfExtent.xx) / cellSize;
    float2 minCoord = float2(0.0, 0.0);
    float2 maxCoord = float2(resolution - 1, resolution - 1);
    gridPosition = clamp(gridPosition, minCoord, maxCoord);

    int2 baseCell = (int2)floor(gridPosition);
    int2 nextCell = min(baseCell + 1, int2(resolution - 1, resolution - 1));
    float2 fracValue = frac(gridPosition);

    int index00 = baseCell.x + baseCell.y * resolution;
    int index10 = nextCell.x + baseCell.y * resolution;
    int index01 = baseCell.x + nextCell.y * resolution;
    int index11 = nextCell.x + nextCell.y * resolution;

    float2 sample00 = _MarineSnowFlowField[index00];
    float2 sample10 = _MarineSnowFlowField[index10];
    float2 sample01 = _MarineSnowFlowField[index01];
    float2 sample11 = _MarineSnowFlowField[index11];

    float2 sample0 = lerp(sample00, sample10, fracValue.x);
    float2 sample1 = lerp(sample01, sample11, fracValue.x);
    return lerp(sample0, sample1, fracValue.y);
}

float3 ResolveFlowField(float3 positionWS)
{
    float2 flowXZ = SampleFlowFieldXZ(positionWS);
    return float3(flowXZ.x, 0.0, flowXZ.y);
}

float ResolveEyeDepth(float3 positionWS)
{
    float3 positionVS = mul(_MarineSnowViewMatrix, float4(positionWS, 1.0)).xyz;
    return max(0.0, -positionVS.z);
}

bool TryResolveScreenUv(float3 positionWS, out float2 uv)
{
    float4 clipPosition = mul(_MarineSnowViewProjection, float4(positionWS, 1.0));
    if (!isfinite(clipPosition.w) || clipPosition.w <= EPSILON)
    {
        uv = 0.0.xx;
        return false;
    }

    uv = clipPosition.xy / clipPosition.w;
    uv = uv * 0.5 + 0.5;
    return all(uv >= 0.0.xx) && all(uv <= 1.0.xx);
}

float SampleSceneEyeDepth(float2 uv)
{
    float rawDepth = _CameraDepthTexture.SampleLevel(sampler_CameraDepthTexture, uv, 0.0);
#if defined(UNITY_REVERSED_Z)
    if (rawDepth <= EPSILON)
        return -1.0;
#else
    if (rawDepth >= 1.0 - EPSILON)
        return -1.0;
#endif
    return LinearEyeDepth(rawDepth, _MarineSnowZBufferParams);
}

float EvaluateSonarReactiveGlow(float3 positionWS)
{
    if (_Time.y > _SonarRevealExpireTime)
        return 0.0;

    float revealRadius = max(_SonarRevealOriginWS.w, 0.0);
    if (revealRadius <= 0.0)
        return 0.0;

    float distanceToOrigin = distance(positionWS, _SonarRevealOriginWS.xyz);
    if (distanceToOrigin > revealRadius)
        return 0.0;

    float sonarWaveSpeed = max(_SonarRevealWaveParams.y, 0.01);
    float sonarFadeDuration = max(_SonarRevealWaveParams.z, 0.05);
    float sonarPulseIntensity = saturate(_SonarRevealWaveParams.w);
    float arrivalTime = _SonarRevealWaveParams.x + distanceToOrigin / sonarWaveSpeed;
    float timeSinceArrival = _Time.y - arrivalTime;
    float decay = 1.0 - saturate(max(timeSinceArrival, 0.0) / sonarFadeDuration);
    float waveRadius = max(0.0, _SonarWaveFront);
    float waveBandWidth = lerp(6.0, 2.0, sonarPulseIntensity);
    float waveBand = 1.0 - saturate(abs(distanceToOrigin - waveRadius) / max(waveBandWidth, 0.25));
    float active = step(_Time.y, _SonarRevealExpireTime);
    return active * max(decay, waveBand * sonarPulseIntensity) * sonarPulseIntensity;
}

void AccumulateSonarGlowAtUv(float2 uv, float intensity, float size)
{
    int width = (int)round(_HectonMarineSnowSonarGlowTexelSize.z);
    int height = (int)round(_HectonMarineSnowSonarGlowTexelSize.w);
    if (width <= 0 || height <= 0 || intensity <= 0.0)
        return;

    int2 centerPixel = int2(saturate(uv) * float2(width - 1, height - 1) + 0.5);
    float splatScale = max(_HectonMarineSnowSonarGlowParams.x, 0.0);
    float encodedScale = max(_HectonMarineSnowSonarGlowParams.z, 1.0);
    float sizeInfluence = saturate(size * max(_HectonMarineSnowSonarGlowParams.w, 1.0) * 96.0);

    [unroll]
    for (int offsetY = -1; offsetY <= 1; offsetY++)
    {
        [unroll]
        for (int offsetX = -1; offsetX <= 1; offsetX++)
        {
            int2 pixel = clamp(centerPixel + int2(offsetX, offsetY), int2(0, 0), int2(width - 1, height - 1));
            float distanceWeight = 1.0 - saturate(length(float2(offsetX, offsetY)) * 0.5);
            float encoded = saturate(intensity * splatScale * lerp(0.45, 1.0, sizeInfluence) * distanceWeight) * encodedScale;
            if (encoded <= 0.0)
                continue;

            InterlockedAdd(_HectonMarineSnowSonarGlowResult[pixel], (int)round(encoded));
        }
    }
}

bool ResolveDepthCollision(float3 currentPositionWS, float3 nextPositionWS, out float sceneEyeDepth)
{
    sceneEyeDepth = -1.0;
    float maxCollisionDepth = max(_MarineSnowDepthCollisionParams.x, 0.0);
    float currentEyeDepth = ResolveEyeDepth(currentPositionWS);
    float nextEyeDepth = ResolveEyeDepth(nextPositionWS);
    if (currentEyeDepth <= EPSILON || nextEyeDepth <= EPSILON || currentEyeDepth > maxCollisionDepth || nextEyeDepth > maxCollisionDepth)
        return false;

    float2 currentUv;
    float2 nextUv;
    if (!TryResolveScreenUv(currentPositionWS, currentUv) || !TryResolveScreenUv(nextPositionWS, nextUv))
        return false;

    sceneEyeDepth = SampleSceneEyeDepth(nextUv);
    if (sceneEyeDepth <= EPSILON)
        return false;

    return currentEyeDepth < sceneEyeDepth && nextEyeDepth > sceneEyeDepth;
}

float2 DecodeShallowWaterVelocity(float2 encodedVelocity)
{
    return encodedVelocity * 2.0 - 1.0;
}

float4 EvaluateShallowWaterFieldData(float3 positionWS)
{
    if (_HectonShallowWaterFieldActive < 0.5)
        return 0.0.xxxx;

    float2 uv = float2(
        (positionWS.x - _HectonShallowWaterFieldWorldRect.x) * _HectonShallowWaterFieldWorldRect.z,
        (positionWS.z - _HectonShallowWaterFieldWorldRect.y) * _HectonShallowWaterFieldWorldRect.w);

    if (any(uv < 0.0) || any(uv > 1.0))
        return 0.0.xxxx;

    return _HectonShallowWaterFieldRT.SampleLevel(sampler_HectonShallowWaterFieldRT, uv, 0.0);
}

uint ResolveEmissionFlags(uint particleIndex)
{
    uint fluidType = (uint)round(_MarineSnowEmissionParams.w);
    if (fluidType == 1u)
        return 1u << 0;
    if (fluidType == 2u)
        return 1u << 2;

    float bubbleDrive = saturate(_MarineSnowBubbleParams.x + _MarineSnowBubbleParams.y);
    if (bubbleDrive > EPSILON)
    {
        float bubbleLane = Hash11(particleIndex * 9.17 + _MarineSnowMetaParams.z * 0.137);
        if (bubbleLane < saturate(bubbleDrive * 0.18))
            return 1u << 0;
    }

    return 1u << 3;
}

float ResolveBootstrapVerticalVelocity(float baseSpeed, uint particleIndex)
{
    uint flags = ResolveEmissionFlags(particleIndex);
    return HasMarineSnowFlag(flags, 1u << 0) ? max(0.02, baseSpeed) : -baseSpeed;
}

Particle BuildRespawnParticle(uint particleIndex)
{
    Particle particle = (Particle)0;
    float frameSeed = _MarineSnowMetaParams.z;
    float innerRadius = max(_MarineSnowShellParams.x + 0.1, 0.2);
    float outerRadius = max(innerRadius + 0.1, _MarineSnowShellParams.y);
    float respawnMinRadius = max(innerRadius, outerRadius - 4.0);
    float angle = Hash11(particleIndex * 0.6180339 + frameSeed * 0.037) * TAU;
    float radius = lerp(respawnMinRadius, outerRadius, sqrt(Hash11(particleIndex * 1.731 + frameSeed * 0.071)));
    float height = lerp(_MarineSnowShellParams.z, _MarineSnowShellParams.w, Hash11(particleIndex * 2.113 + frameSeed * 0.091));

    float3 cameraPosition = _MarineSnowCameraPosition_Time.xyz;
    particle.Pos = cameraPosition + float3(cos(angle), 0.0, sin(angle)) * radius;
    particle.Pos.y = cameraPosition.y + height;
    particle.PrevPos = particle.Pos;
    particle.Life = 1.0;
    particle.Size = lerp(0.0035, 0.0090, Hash11(particleIndex * 0.913 + frameSeed * 0.123));
    particle.Vel = float3(0.0, ResolveBootstrapVerticalVelocity(ResolveBaseDescent(particleIndex), particleIndex), 0.0);
    particle.Flags = ResolveEmissionFlags(particleIndex);
    particle.UV = float2(Hash11(particleIndex * 0.33), Hash11(particleIndex * 0.77));
    particle.Pad = float2(Hash11(particleIndex * 1.11), Hash11(particleIndex * 1.37));
    return particle;
}

Particle BuildBubbleTrailParticle(uint particleIndex, float bubbleDrive, float exhaleDrive)
{
    Particle particle = BuildRespawnParticle(particleIndex);
    float3 cameraPosition = _MarineSnowCameraPosition_Time.xyz;
    float3 cameraRight = SafeNormalizeMarineSnow(_MarineSnowCameraRight_DeltaTime.xyz);
    float3 cameraUp = SafeNormalizeMarineSnow(_MarineSnowCameraUp_Density.xyz);
    float3 cameraForward = SafeNormalizeMarineSnow(cross(cameraRight, cameraUp));

    float side = (Hash11(particleIndex * 1.23 + _MarineSnowMetaParams.z) - 0.5) * lerp(0.36, 0.58, exhaleDrive);
    float forward = lerp(0.10, 0.72, Hash11(particleIndex * 2.23 + _MarineSnowMetaParams.z * 0.41));
    float lower = lerp(0.18, 0.86, Hash11(particleIndex * 3.23 + _MarineSnowMetaParams.z * 0.67));
    particle.Pos = cameraPosition + cameraRight * side + cameraForward * forward - cameraUp * lower;
    particle.PrevPos = particle.Pos;
    particle.Flags = 1u << 0;
    particle.Life = 1.0;
    particle.Size = lerp(0.004, 0.018, Hash11(particleIndex * 4.23 + _MarineSnowMetaParams.z * 0.29)) * lerp(1.0, 1.7, exhaleDrive);
    particle.Vel =
        cameraUp * lerp(0.08, 0.28, bubbleDrive) +
        cameraRight * ((Hash11(particleIndex * 5.23) - 0.5) * 0.035) +
        cameraForward * lerp(0.02, 0.08, exhaleDrive);
    return particle;
}

[numthreads(8, 8, 1)]
void ClearSonarGlow(uint3 dispatchThreadID : SV_DispatchThreadID)
{
    int width = (int)round(_HectonMarineSnowSonarGlowTexelSize.z);
    int height = (int)round(_HectonMarineSnowSonarGlowTexelSize.w);
    if (dispatchThreadID.x >= (uint)width || dispatchThreadID.y >= (uint)height)
        return;

    _HectonMarineSnowSonarGlowResult[int2(dispatchThreadID.xy)] = 0;
}

[numthreads(THREAD_GROUP_SIZE, 1, 1)]
void AccumulateSonarGlow(uint3 dispatchThreadID : SV_DispatchThreadID)
{
    uint index = dispatchThreadID.x;
    uint particleCount = (uint)round(_MarineSnowMetaParams.x);
    if (index >= particleCount)
        return;

    Particle particle = _MarineSnowParticlesWrite[index];
    if (particle.Life <= 0.0)
        return;

    float sonarGlow = EvaluateSonarReactiveGlow(particle.Pos);
    if (sonarGlow <= 0.0001)
        return;

    float2 screenUv;
    if (!TryResolveScreenUv(particle.Pos, screenUv))
        return;

    AccumulateSonarGlowAtUv(screenUv, sonarGlow, particle.Size);
}

[numthreads(THREAD_GROUP_SIZE, 1, 1)]
void CSMain(uint3 dispatchThreadID : SV_DispatchThreadID)
{
    uint index = dispatchThreadID.x;
    uint particleCount = (uint)round(_MarineSnowMetaParams.x);
    if (index >= particleCount)
        return;

    Particle particle = _MarineSnowParticlesRead[index];
    if (particle.Life <= 0.0)
    {
        particle = BuildRespawnParticle(index);
    }

    float dt = max(_MarineSnowCameraRight_DeltaTime.w, 0.0);
    float simulationTime = _MarineSnowCameraPosition_Time.w;
    float densityScale = saturate(_MarineSnowCameraUp_Density.w);
    float3 cameraPosition = _MarineSnowCameraPosition_Time.xyz;
    bool isBubble = HasMarineSnowFlag(particle.Flags, 1u << 0);
    bool isDebris = HasMarineSnowFlag(particle.Flags, 1u << 2);
    float bubbleTrailDrive = saturate(_MarineSnowBubbleParams.x);
    float bubbleExhaleDrive = saturate(_MarineSnowBubbleParams.y);
    float bubbleDrive = saturate(bubbleTrailDrive + bubbleExhaleDrive);
    if (!isBubble && bubbleDrive > EPSILON)
    {
        float spawnGate = step(
            1.0 - saturate(bubbleDrive) * lerp(0.006, 0.065, bubbleExhaleDrive),
            Hash11(index * 37.17 + _MarineSnowMetaParams.z * 0.73));
        if (spawnGate > 0.5)
        {
            particle = BuildBubbleTrailParticle(index, bubbleDrive, bubbleExhaleDrive);
            isBubble = true;
            isDebris = false;
        }
    }
    float buoyancyModifier = _MarineSnowEmissionParams.x;
    float turbulenceModifier = max(_MarineSnowEmissionParams.y, 0.0);
    float wobbleScale = max(_MarineSnowEmissionParams.z, 0.0);

    particle.PrevPos = particle.Pos;

    float baseDescent = ResolveBaseDescent(index);
    float timeBase = simulationTime * 0.15 + index * 0.0001;
    float2 wander = float2(
        HashSin(float2(timeBase, particle.Pos.z * 0.4)),
        HashSin(float2(timeBase + 31.7, particle.Pos.x * 0.4))) * _MarineSnowDriftParams.z;

    float targetVerticalVelocity = isBubble ? max(0.02, baseDescent) : -baseDescent;
    particle.Vel.y = lerp(particle.Vel.y, targetVerticalVelocity, saturate(dt * 4.0));
    particle.Vel.xz += wander;

    float3 flowSample = ResolveFlowField(particle.Pos);
    float4 shallowWaterData = EvaluateShallowWaterFieldData(particle.Pos);
    float2 shallowWaterVelocity = DecodeShallowWaterVelocity(shallowWaterData.xy);
    float shallowWaterDisplacement = saturate(shallowWaterData.z);
    float3 shallowWaterFlow = float3(shallowWaterVelocity.x, 0.0, shallowWaterVelocity.y) *
        (0.45 + shallowWaterDisplacement * 1.35);
    float3 synchronizedFlow = (flowSample + shallowWaterFlow) * max(_HectonFlowSynchronyParams.x, 1.0) +
        ResolveFlowSynchronyOffset(particle.Pos, flowSample);
    particle.Vel += (synchronizedFlow - particle.Vel) * (_MarineSnowFlowParams.x + densityScale * _MarineSnowFlowParams.y) * dt;
    particle.Vel.y += shallowWaterDisplacement * 0.025 * dt;

    float3 flowDirN = SafeNormalizeMarineSnow(synchronizedFlow);
    if (dot(flowDirN, flowDirN) > EPSILON)
    {
        float3 particleDirN = SafeNormalizeMarineSnow(particle.Vel);
        float alignment = dot(particleDirN, flowDirN);
        float alignmentN = saturate((alignment + 1.0) * 0.5);
        float dragMultiplier = lerp(1.0, 0.1, alignmentN);
        float dragAttenuation = pow(saturate(1.0 - dragMultiplier * _MarineSnowDriftParams.w), dt * 60.0);
        particle.Vel *= dragAttenuation;

        if (dragMultiplier > 0.7)
        {
            float turbulenceScale = saturate((dragMultiplier - 0.7) / 0.3);
            particle.Vel += ResolveTurbulence(particle.Pos, simulationTime) * (turbulenceScale * _MarineSnowFlowParams.z * max(turbulenceModifier, 0.001));
        }
    }

    if (isBubble)
    {
        float phase = particle.Pad.x * TAU;
        float wobbleFrequency = 2.1 + particle.Size * 8.0;
        float wobbleMagnitude = 0.12 * particle.Size * wobbleScale;
        float wobbleAttenuation = 1.0 - saturate(length(synchronizedFlow) / 2.5);
        float2 lateralOscillation = float2(
            sin(simulationTime * wobbleFrequency + particle.Pos.y * 1.7 + phase),
            cos(simulationTime * wobbleFrequency * 0.83 + particle.Pos.y * 1.3 + phase + 1.1)) * wobbleMagnitude;
        particle.Vel.xz += lateralOscillation * (dt * 12.0 * wobbleAttenuation);
        particle.Vel.y += max(0.0, buoyancyModifier) * 9.81 * dt;
        particle.Size = clamp(particle.Size * (1.0 - saturate(ResolveEyeDepth(particle.Pos) / 400.0) * 0.015 * dt), 0.005, 0.12);
        particle.Vel.y = min(particle.Vel.y, 0.35 + particle.Size * 1.2);
    }
    else if (isDebris)
    {
        particle.Vel.y += min(0.0, buoyancyModifier) * 2.25 * dt;
    }
    else
    {
        particle.Vel.y += min(0.0, buoyancyModifier) * dt;
    }

    float3 nextPosition = particle.Pos + particle.Vel * dt;
    float sceneEyeDepth;
    bool depthCollision = ResolveDepthCollision(particle.Pos, nextPosition, sceneEyeDepth);
    if (depthCollision)
    {
        particle.Flags |= 1u << 4;
        particle.Pos = particle.PrevPos;
        if (isBubble)
        {
            particle.Vel *= -_MarineSnowDepthCollisionParams.y;
            particle.Vel.y = abs(particle.Vel.y);
        }
        else
        {
            particle.Vel *= _MarineSnowDepthCollisionParams.z;
            particle.Life = max(0.0, particle.Life - dt * 0.5);
        }
    }
    else
    {
        particle.Flags &= ~(1u << 4);
        particle.Pos = nextPosition;
    }

    float3 relativeToCamera = particle.Pos - cameraPosition;
    float planarDistance = length(relativeToCamera.xz);
    bool outOfShell =
        planarDistance > _MarineSnowShellParams.y ||
        planarDistance < _MarineSnowShellParams.x ||
        relativeToCamera.y < _MarineSnowShellParams.z ||
        relativeToCamera.y > _MarineSnowShellParams.w;

    if (outOfShell)
    {
        particle = BuildRespawnParticle(index);
    }

    particle.Life = 1.0;
    _MarineSnowParticlesWrite[index] = particle;
}
