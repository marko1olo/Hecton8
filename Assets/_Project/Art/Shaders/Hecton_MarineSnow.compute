static const float3 MARINE_SNOW_CEILING_SLAP_NORMAL = float3(0.0, -1.0, 0.0);

SiltParticle ComposeSiltParticle(ParticleDataDTO data, ParticleRenderMetaDTO meta)
{
    SiltParticle particle;
    particle.Pos = data.Position;
    particle.Life = data.Lifetime;
    particle.Vel = data.Velocity;
    particle.Size = data.Size;
    particle.PrevPos = meta.PreviousPosition;
    particle.Flags = meta.Flags;
    particle.UV = meta.Uv;
    particle.Pad = meta.Pad;
    return particle;
}

SiltParticle LoadSiltParticle(uint index)
{
    return ComposeSiltParticle(_MarineSnowParticlesRead[index], _MarineSnowParticleMetaRead[index]);
}

SiltParticle LoadWrittenSiltParticle(uint index)
{
    return ComposeSiltParticle(_MarineSnowParticlesWrite[index], _MarineSnowParticleMetaWrite[index]);
}

void StoreSiltParticle(uint index, SiltParticle particle)
{
    ParticleDataDTO data;
    data.Position = particle.Pos;
    data.Lifetime = particle.Life;
    data.Velocity = particle.Vel;
    data.Size = particle.Size;
    _MarineSnowParticlesWrite[index] = data;

    ParticleRenderMetaDTO meta;
    meta.PreviousPosition = particle.PrevPos;
    meta.Flags = particle.Flags;
    meta.Uv = particle.UV;
    meta.Pad = particle.Pad;
    _MarineSnowParticleMetaWrite[index] = meta;
}

bool HasMarineSnowFlag(uint flags, uint mask)
{
    return (flags & mask) != 0u;
}

float Hash11(float value)
{
    float3 hash = frac(float3(value, value + 19.19, value + 37.37) * float3(0.1031, 0.1030, 0.0973));
    hash += dot(hash, hash.yzx + 33.33);
    return frac((hash.x + hash.y) * hash.z);
}

float Hash21(float2 value)
{
    value = frac(value * float2(0.1031, 0.1030));
    value += dot(value, value.yx + 33.33);
    return frac((value.x + value.y) * value.x);
}

float Hash31(float3 value)
{
    value = frac(value * 0.1031);
    value += dot(value, value.yzx + 31.32);
    return frac((value.x + value.y) * value.z);
}

float HashSin(float2 value)
{
    return Hash21(value);
}

float DominantMagnitude2(float2 value)
{
    float2 absValue = abs(value);
    return max(absValue.x, absValue.y);
}

float DominantMagnitude3(float3 value)
{
    float3 absValue = abs(value);
    return max(absValue.x, max(absValue.y, absValue.z));
}

float2 DominantAxisDirection2(float2 value)
{
    float2 absValue = abs(value);
    if (absValue.x <= EPSILON && absValue.y <= EPSILON)
        return 0.0.xx;

    if (absValue.x >= absValue.y)
        return float2(value.x >= 0.0 ? 1.0 : -1.0, 0.0);

    return float2(0.0, value.y >= 0.0 ? 1.0 : -1.0);
}

float2 QuantizedOctDirection2(float2 value)
{
    float2 absValue = abs(value);
    if (absValue.x <= EPSILON && absValue.y <= EPSILON)
        return 0.0.xx;

    float2 axis = DominantAxisDirection2(value);
    float major = max(absValue.x, absValue.y);
    float minor = min(absValue.x, absValue.y);
    if (minor * 2.0 < major)
        return axis;

    return float2(
        value.x >= 0.0 ? 0.70710678 : -0.70710678,
        value.y >= 0.0 ? 0.70710678 : -0.70710678);
}

float3 DominantAxisDirection3(float3 value)
{
    float3 absValue = abs(value);
    if (absValue.x <= EPSILON && absValue.y <= EPSILON && absValue.z <= EPSILON)
        return float3(0.0, 0.0, 0.0);

    if (absValue.x >= absValue.y && absValue.x >= absValue.z)
        return float3(value.x >= 0.0 ? 1.0 : -1.0, 0.0, 0.0);

    if (absValue.y >= absValue.z)
        return float3(0.0, value.y >= 0.0 ? 1.0 : -1.0, 0.0);

    return float3(0.0, 0.0, value.z >= 0.0 ? 1.0 : -1.0);
}

float FastTriangleSigned(float phase)
{
    float triangle01 = 1.0 - abs(frac(phase * 0.15915494 + 0.25) * 2.0 - 1.0);
    return triangle01 * 2.0 - 1.0;
}

float ResolveFlowSynchronyPhase(float3 positionWS)
{
    float3 absolutePositionWS = positionWS + _HectonFloatingOriginOffset.xyz;
    return _HectonFlowSynchronyParams.z + dot(absolutePositionWS.xz, float2(0.031, -0.027));
}

float3 ResolveFlowSynchronyOffset(float3 positionWS, float3 flowSample)
{
    float3 flowDirection = DominantAxisDirection3(flowSample);
    float flowMagnitude = DominantMagnitude2(flowSample.xz) * max(_HectonFlowSynchronyParams.x, 1.0);
    if (flowMagnitude <= EPSILON)
        return float3(0.0, 0.0, 0.0);

    float phase = ResolveFlowSynchronyPhase(positionWS);
    return flowDirection * (FastTriangleSigned(phase) * flowMagnitude);
}

float3 ResolveTurbulence(float3 positionWS, float simulationTime)
{
    float turbulenceFrequency = max(_HectonFlowSynchronyParams.y, 0.01);
    float3 stablePosition = positionWS - _HectonFloatingOriginOffset.xyz;
    float3 samplePosition = floor(stablePosition * turbulenceFrequency + simulationTime * turbulenceFrequency);
    return float3(
        Hash31(samplePosition + float3(17.0, 3.0, 11.0)),
        Hash31(samplePosition + float3(7.0, 19.0, 29.0)),
        Hash31(samplePosition + float3(23.0, 5.0, 13.0))) * 2.0 - 1.0;
}

float ResolveBaseDescent(uint particleIndex)
{
    return lerp(_MarineSnowDriftParams.x, _MarineSnowDriftParams.y, Hash11(particleIndex * 17.0));
}

float2 SampleFlowFieldXZ(float3 positionWS)
{
    int resolution = (int)max(_MarineSnowMetaParams.y, 0.0);
    float cellSize = max(_MarineSnowFlowFieldCenterCellSize.w, 0.001);
    if (resolution <= 1 || cellSize <= 0.0)
        return float2(0.0, 0.0);

    float halfExtent = (resolution - 1) * cellSize * 0.5;
    float invCellSize = rcp(max(cellSize, EPSILON));
    float2 centerXZ = _MarineSnowFlowFieldCenterCellSize.xz;
    float2 gridPosition = ((positionWS.xz - centerXZ) + halfExtent.xx) * invCellSize;
    float2 minCoord = float2(0.0, 0.0);
    float2 maxCoord = float2(resolution - 1, resolution - 1);
    gridPosition = clamp(gridPosition, minCoord, maxCoord);

    int2 baseCell = (int2)floor(gridPosition);
    int2 nextCell = min(baseCell + 1, int2(resolution - 1, resolution - 1));
    float2 fracValue = frac(gridPosition);

    int index00 = baseCell.x + baseCell.y * resolution;
    int index10 = nextCell.x + baseCell.y * resolution;
    int index01 = baseCell.x + nextCell.y * resolution;
    int index11 = nextCell.x + nextCell.y * resolution;

    float2 sample00 = _MarineSnowFlowField[index00];
    float2 sample10 = _MarineSnowFlowField[index10];
    float2 sample01 = _MarineSnowFlowField[index01];
    float2 sample11 = _MarineSnowFlowField[index11];

    float2 sample0 = lerp(sample00, sample10, fracValue.x);
    float2 sample1 = lerp(sample01, sample11, fracValue.x);
    return lerp(sample0, sample1, fracValue.y);
}

// Single exit with an initialised result. Every branch here used to `return resolvedFlow`
// directly, and flattening those five returns is what made the compiler report
// "potentially uninitialized variable" for a value that is initialised on line one.
float3 SampleAbyssalFlowField(float3 positionWS)
{
    float3 resolvedFlow = float3(0.0, 0.0, 0.0);
    bool resolved = false;

    if (_AbyssalFlowTextureActive > 0.5 && _AbyssalFlowTextureParams.y > 0.001)
    {
        float3 uvw = (positionWS - _AbyssalFlowCenter.xyz) * rcp(max(_AbyssalFlowTextureParams.y, EPSILON)) + 0.5;
        if (all(uvw >= float3(0.0, 0.0, 0.0)) && all(uvw <= float3(1.0, 1.0, 1.0)))
        {
            int textureResolution = (int)max(_AbyssalFlowTextureParams.x, 1.0);
            int3 textureCoord = clamp((int3)floor(uvw * (float)textureResolution), int3(0, 0, 0), int3(textureResolution - 1, textureResolution - 1, textureResolution - 1));
            float3 textureFlow = _AbyssalFlowFieldTexture.Load(int4(textureCoord, 0)).xyz;
            if (dot(textureFlow, textureFlow) < 1.0e32)
            {
                resolvedFlow = textureFlow;
                resolved = true;
            }
        }
    }

    if (!resolved)
    {
        int resolutionX = (int)max(_AbyssalGridResolution.x, 0.0);
        int resolutionY = (int)max(_AbyssalGridResolution.y, 0.0);
        int resolutionZ = (int)max(_AbyssalGridResolution.z, 0.0);
        int nodeCount = (int)max(_AbyssalGridResolution.w, 0.0);
        if (resolutionX > 0 && resolutionY > 0 && resolutionZ > 0 && nodeCount > 0)
        {
            float horizontalCellSize = max(_AbyssalFlowSpacing.x, 0.001);
            float verticalCellSize = max(_AbyssalFlowSpacing.y, 0.001);
            float invHorizontalCellSize = rcp(max(horizontalCellSize, EPSILON));
            float invVerticalCellSize = rcp(max(verticalCellSize, EPSILON));
            int3 halfExtent = int3(resolutionX >> 1, resolutionY >> 1, resolutionZ >> 1);
            float3 localPosition = positionWS - _AbyssalFlowCenter.xyz;
            int3 coord = int3(
                (int)floor(localPosition.x * invHorizontalCellSize + (float)halfExtent.x + 0.5),
                (int)floor(localPosition.y * invVerticalCellSize + (float)halfExtent.y + 0.5),
                (int)floor(localPosition.z * invHorizontalCellSize + (float)halfExtent.z + 0.5));

            if (all(coord >= int3(0, 0, 0)) && coord.x < resolutionX && coord.y < resolutionY && coord.z < resolutionZ)
            {
                int index = coord.y * resolutionX * resolutionZ + coord.z * resolutionX + coord.x;
                if (index >= 0 && index < nodeCount)
                {
                    float3 flow = _AbyssalFlowFieldResult[index].xyz;
                    if (dot(flow, flow) < 1.0e32)
                        resolvedFlow = flow;
                }
            }
        }
    }

    return resolvedFlow;
}

bool ShouldRunQualityLane(uint particleIndex, float qualityWeight, float salt)
{
    float gate = saturate(qualityWeight);
    if (gate <= EPSILON)
        return false;
    if (gate >= 1.0 - EPSILON)
        return true;

    return Hash11((float)particleIndex * 19.37 + _MarineSnowMetaParams.z * 0.173 + salt) < gate;
}

bool ShouldRunStaggeredRate(uint particleIndex)
{
    return ShouldRunQualityLane(particleIndex, _MarineSnowScalabilityParams.y, 0.11);
}

float3 ResolveFlowField(float3 positionWS, uint particleIndex)
{
    float flowQuality = saturate(_MarineSnowScalabilityParams.x * 0.5);
    if (flowQuality <= EPSILON)
        return float3(0.0, 0.0, 0.0);

    float2 flowXZ = SampleFlowFieldXZ(positionWS);
    float3 abyssalFlow = ShouldRunStaggeredRate(particleIndex) ? SampleAbyssalFlowField(positionWS) : float3(0.0, 0.0, 0.0);
    float3 mockFlow = _MarineSnowMockFlowField.xyz * saturate(_MarineSnowMockFlowField.w);
    return (float3(flowXZ.x, 0.0, flowXZ.y) + abyssalFlow + mockFlow) * flowQuality;
}

float3 SafeNormalize3(float3 value)
{
    float magnitudeSq = dot(value, value);
    if (magnitudeSq <= EPSILON)
        return float3(0.0, 0.0, 0.0);

    return value * rsqrt(max(magnitudeSq, EPSILON));
}

float3 ResolveDynamicWakeFlow(float3 positionWS)
{
    uint rawSlotLimit = (uint)min(max(_DynamicWakeParams.x, 0.0), HECTON_DYNAMIC_WAKE_CAPACITY);
    float qualityPressure01 = saturate(_DynamicWakeParams.y);
    uint qualitySlotLimit = (uint)round(lerp((float)HECTON_DYNAMIC_WAKE_CAPACITY, (float)HECTON_DYNAMIC_WAKE_MIN_QUALITY_CAPACITY, qualityPressure01));
    uint slotLimit = min(rawSlotLimit, max(1u, qualitySlotLimit));
    if (slotLimit == 0u || _DynamicWakeParams.z <= 0.5)
        return float3(0.0, 0.0, 0.0);

    float wakeGain = _DynamicWakeParams.w > EPSILON ? _DynamicWakeParams.w : 1.0;
    float3 flow = float3(0.0, 0.0, 0.0);
    [loop]
    for (uint wakeIndex = 0u; wakeIndex < HECTON_DYNAMIC_WAKE_CAPACITY; wakeIndex++)
    {
        if (wakeIndex >= slotLimit)
            break;

        float4 wake = _DynamicWakes[wakeIndex];
        float4 wakeVector = _DynamicWakeVectors[wakeIndex];
        float radius = max(wakeVector.w, 0.001);
        float radiusSq = radius * radius;
        float3 fromWake = positionWS - wake.xyz;
        float distanceSq = dot(fromWake, fromWake);
        if (wake.w <= EPSILON || distanceSq >= radiusSq)
            continue;

        float falloff = saturate(1.0 - distanceSq * rcp(max(radiusSq, EPSILON)));
        falloff *= falloff;
        float3 radial = DominantAxisDirection3(fromWake);
        radial.y *= 0.25;
        float3 wakeAxis = SafeNormalize3(wakeVector.xyz);
        float3 highFlow = (wakeAxis + radial * 0.35) * (wake.w * falloff * wakeGain);
        float3 lowFlow = radial * (wake.w * falloff * wakeGain * 0.38);
        flow += lerp(highFlow, lowFlow, qualityPressure01);
    }

    uint dtoSlotLimit = (uint)min(max(_DynamicWakeDtoParams.x, 0.0), HECTON_DYNAMIC_WAKE_CAPACITY);
    uint dtoActive = (uint)min(max(_DynamicWakeDtoParams.z, 0.0), dtoSlotLimit);
    float dtoQualityPressure01 = saturate(_DynamicWakeDtoParams.y);
    float dtoGain = _DynamicWakeDtoParams.w > EPSILON ? _DynamicWakeDtoParams.w : 1.0;
    [loop]
    for (uint dtoIndex = 0u; dtoIndex < HECTON_DYNAMIC_WAKE_CAPACITY; dtoIndex++)
    {
        if (dtoIndex >= dtoActive)
            break;

        DynamicWakeDTO wake = _DynamicWakeDTOs[dtoIndex];
        float radius = max(wake.Radius, 0.001);
        float radiusSq = radius * radius;
        float3 fromWake = positionWS - wake.Position;
        float distanceSq = dot(fromWake, fromWake);
        if (distanceSq >= radiusSq)
            continue;

        float3 force = dot(wake.Force, wake.Force) < 1.0e32 ? wake.Force : float3(0.0, 0.0, 0.0);
        float forceMagnitude = DominantMagnitude3(force);
        if (forceMagnitude <= EPSILON)
            continue;

        float falloff = saturate(1.0 - distanceSq * rcp(max(radiusSq, EPSILON)));
        falloff = falloff * falloff * saturate(wake.Falloff) * dtoGain;
        float3 radial = DominantAxisDirection3(fromWake);
        radial.y *= 0.2;
        float3 highFlow = (force + radial * (forceMagnitude * 0.25)) * falloff;
        float3 lowFlow = radial * (forceMagnitude * falloff * 0.35);
        flow += lerp(highFlow, lowFlow, dtoQualityPressure01);
    }

    return dot(flow, flow) < 1.0e32 ? flow : float3(0.0, 0.0, 0.0);
}

uint ComputePropwashEventSampleBudget(uint activeCount)
{
    if (activeCount == 0u)
        return 0u;

    float quality = saturate(_PropwashEventParams.w);
    float curvedQuality = quality * quality * (3.0 - 2.0 * quality);
    float sampleBudgetF = min(
        (float)activeCount,
        max((float)HECTON_PROPWASH_EVENT_MIN_SAMPLE_CAPACITY, lerp((float)HECTON_PROPWASH_EVENT_MIN_SAMPLE_CAPACITY, (float)activeCount, curvedQuality)));
    return (uint)sampleBudgetF;
}

float3 ComputePropwashEventFlow(float3 positionWS)
{
    uint activeCount = (uint)min(max(_PropwashEventParams.y, 0.0), HECTON_PROPWASH_EVENT_CAPACITY);
    uint sampleBudget = ComputePropwashEventSampleBudget(activeCount);
    uint particleCount = (uint)max(_MarineSnowMetaParams.x, 0.0);
    sampleBudget = min(sampleBudget, particleCount);
    if (sampleBudget == 0u)
        return float3(0.0, 0.0, 0.0);

    float quality = saturate(_PropwashEventParams.w);
    float3 cameraPosition = _MarineSnowCameraPosition_Time.xyz;
    float3 flow = float3(0.0, 0.0, 0.0);

    [loop]
    for (uint i = 0u; i < HECTON_PROPWASH_EVENT_CAPACITY; i++)
    {
        if (i >= sampleBudget)
            break;

        PropwashEventDTO evt = _PropwashEvents[i];
        float radius = max(evt.Radius, 0.001);
        float radiusSq = radius * radius;
        float3 eventPosition = cameraPosition + evt.LocalPosition;
        float3 delta = positionWS - eventPosition;
        float distanceSq = dot(delta, delta);
        if (evt.Intensity <= EPSILON || distanceSq >= radiusSq)
            continue;

        float falloff = saturate(1.0 - distanceSq * rcp(max(radiusSq, EPSILON)));
        falloff *= falloff;
        float3 radial = DominantAxisDirection3(delta);
        radial.y *= 0.18;
        float3 thrust = dot(evt.ThrustVector, evt.ThrustVector) < 1.0e32 ? evt.ThrustVector : float3(0.0, 0.0, 0.0);
        float3 highFlow = (thrust + radial * (DominantMagnitude3(thrust) * 0.23)) * (evt.Intensity * falloff);
        float3 lowFlow = radial * (evt.Intensity * falloff * 0.34);
        flow += lerp(lowFlow, highFlow, quality);
    }

    return dot(flow, flow) < 1.0e32 ? flow : float3(0.0, 0.0, 0.0);
}

float3 ResolveMockAcousticImpulse(float3 positionWS)
{
    float radius = max(_MarineSnowMockAcousticPulse.w, 0.0);
    float magnitude = max(_MarineSnowMockAcousticParams.x, 0.0);
    if (radius <= EPSILON || magnitude <= EPSILON)
        return float3(0.0, 0.0, 0.0);

    float elapsed = _MarineSnowCameraPosition_Time.w - _MarineSnowMockAcousticParams.y;
    float duration = max(_MarineSnowMockAcousticParams.z, 0.01);
    if (elapsed < 0.0 || elapsed > duration)
        return float3(0.0, 0.0, 0.0);

    float3 fromPulse = positionWS - _MarineSnowMockAcousticPulse.xyz;
    float distanceSq = dot(fromPulse, fromPulse);
    float radiusSq = radius * radius;
    if (!(distanceSq > EPSILON && distanceSq < radiusSq))
        return float3(0.0, 0.0, 0.0);

    float distanceToPulse = distanceSq * rsqrt(max(distanceSq, EPSILON));
    float waveSpeed = max(_MarineSnowMockAcousticParams.w, 0.01);
    float waveFront = elapsed * waveSpeed;
    float bandWidth = max(1.0, radius * 0.09);
    float waveBand = saturate(1.0 - abs(distanceToPulse - waveFront) * rcp(max(bandWidth, EPSILON)));
    float fade = 1.0 - saturate(elapsed * rcp(max(duration, EPSILON)));
    float rangeFalloff = saturate(1.0 - distanceSq * rcp(max(radiusSq, EPSILON)));
    float impulse = magnitude * waveBand * fade * rangeFalloff;
    return SafeNormalize3(fromPulse) * impulse;
}

float3 ResolveCurlNoiseFake(float3 positionWS, float simulationTime)
{
    float3 stablePosition = positionWS - _HectonFloatingOriginOffset.xyz;
    float3 samplePosition = floor(stablePosition * 0.215 + simulationTime * 0.17);
    float a = Hash31(samplePosition + float3(11.0, 3.0, 23.0));
    float b = Hash31(samplePosition + float3(5.0, 29.0, 7.0));
    float c = Hash31(samplePosition + float3(31.0, 13.0, 17.0));
    return float3(b - c, c - a, a - b);
}

float ResolveHeadlightEmissionBoost(float3 positionWS)
{
    if (_HectonFlashlightActive <= 0.5 || _HectonFlashlightColor.w <= 0.001)
        return 0.0;

    float lightRange = max(_HectonFlashlightPositionWS.w, 0.1);
    float rangeSq = lightRange * lightRange;
    float3 toParticle = positionWS - _HectonFlashlightPositionWS.xyz;
    float distanceSq = dot(toParticle, toParticle);
    if (distanceSq >= rangeSq || distanceSq <= EPSILON)
        return 0.0;

    float3 lightDirection = SafeNormalize3(_HectonFlashlightDirectionWS.xyz);
    float3 particleDirection = toParticle * rsqrt(max(distanceSq, EPSILON));
    float innerCos = _HectonFlashlightDirectionWS.w;
    float outerCos = _HectonFlashlightConeData.x;
    float coneDenominator = max(innerCos - outerCos, 0.0001);
    float cone = saturate((dot(particleDirection, lightDirection) - outerCos) * rcp(max(coneDenominator, EPSILON)));
    float range = saturate(1.0 - distanceSq * rcp(max(rangeSq, EPSILON)));
    return cone * range * saturate(_HectonFlashlightColor.w * max(_MarineSnowVelocityParams.y, 0.0));
}

float3 ClampParticleVelocity(float3 velocityWS)
{
    float maxSpeed = max(_MarineSnowVelocityParams.x, 0.1);
    float maxSpeedSq = maxSpeed * maxSpeed;
    float speedSq = dot(velocityWS, velocityWS);
    if (!(speedSq < 1.0e32))
        return float3(0.0, 0.0, 0.0);

    if (speedSq > maxSpeedSq)
        return velocityWS * (maxSpeed * rsqrt(max(speedSq, EPSILON)));

    return velocityWS;
}

float ResolveEyeDepth(float3 positionWS)
{
    float3 positionVS = mul(_MarineSnowViewMatrix, float4(positionWS, 1.0)).xyz;
    return max(0.0, -positionVS.z);
}

bool TryResolveScreenUv(float3 positionWS, out float2 uv)
{
    float4 clipPosition = mul(_MarineSnowViewProjection, float4(positionWS, 1.0));
    if (!(clipPosition.w > EPSILON && clipPosition.w < 1.0e32))
    {
        uv = 0.0.xx;
        return false;
    }

    float invClipW = rcp(max(clipPosition.w, EPSILON));
    uv = clipPosition.xy * invClipW;
    uv = uv * 0.5 + 0.5;
    return all(uv >= 0.0.xx) && all(uv <= 1.0.xx);
}

float SampleSceneEyeDepth(float2 uv)
{
    float rawDepth = _CameraDepthTexture.SampleLevel(sampler_CameraDepthTexture, uv, 0.0);
#if defined(UNITY_REVERSED_Z)
    if (rawDepth <= EPSILON)
        return -1.0;
#else
    if (rawDepth >= 1.0 - EPSILON)
        return -1.0;
#endif
    return LinearEyeDepth(rawDepth, _MarineSnowZBufferParams);
}

float EvaluateSonarReactiveGlow(float3 positionWS)
{
    if (_Time.y > _SonarRevealExpireTime)
        return 0.0;

    float revealRadius = max(_SonarRevealOriginWS.w, 0.0);
    if (revealRadius <= 0.0)
        return 0.0;

    float3 toOrigin = positionWS - _SonarRevealOriginWS.xyz;
    float revealRadiusSq = revealRadius * revealRadius;
    float distanceToOriginSq = dot(toOrigin, toOrigin);
    if (distanceToOriginSq > revealRadiusSq)
        return 0.0;

    float sonarWaveSpeed = max(_SonarRevealWaveParams.y, 0.01);
    float sonarFadeDuration = max(_SonarRevealWaveParams.z, 0.05);
    float sonarPulseIntensity = saturate(_SonarRevealWaveParams.w);
    float invSonarWaveSpeed = rcp(max(sonarWaveSpeed, EPSILON));
    float invSonarFadeDuration = rcp(max(sonarFadeDuration, EPSILON));
    float arrivalTime = _SonarRevealWaveParams.x + distanceToOriginSq * rcp(max(revealRadiusSq, EPSILON)) * (revealRadius * invSonarWaveSpeed);
    float timeSinceArrival = _Time.y - arrivalTime;
    float decay = 1.0 - saturate(max(timeSinceArrival, 0.0) * invSonarFadeDuration);
    float waveRadius = max(0.0, _SonarWaveFront);
    float waveRadiusSq = waveRadius * waveRadius;
    float waveBandWidth = lerp(6.0, 2.0, sonarPulseIntensity);
    float waveBandSqWidth = max(waveBandWidth * max(waveRadius * 2.0 + waveBandWidth, 0.25), 0.25);
    float waveBand = 1.0 - saturate(abs(distanceToOriginSq - waveRadiusSq) * rcp(max(waveBandSqWidth, EPSILON)));
    float active = step(_Time.y, _SonarRevealExpireTime);
    return active * max(decay, waveBand * sonarPulseIntensity) * sonarPulseIntensity;
}

void AccumulateSonarGlowAtUv(float2 uv, float intensity, float size)
{
    int width = (int)max(_HectonMarineSnowSonarGlowTexelSize.z, 0.0);
    int height = (int)max(_HectonMarineSnowSonarGlowTexelSize.w, 0.0);
    if (width <= 0 || height <= 0 || intensity <= 0.0)
        return;

    int2 pixel = int2(saturate(uv) * float2(width - 1, height - 1) + 0.5);
    float splatScale = max(_HectonMarineSnowSonarGlowParams.x, 0.0);
    float encodedScale = max(_HectonMarineSnowSonarGlowParams.z, 1.0);
    float sizeInfluence = saturate(size * max(_HectonMarineSnowSonarGlowParams.w, 1.0) * 96.0);
    float encoded = min(
        saturate(intensity * splatScale * lerp(0.65, 1.0, sizeInfluence)) * encodedScale * 4.0,
        MARINE_SNOW_MAX_ENCODED_SPLAT);
    // Negated positive test on purpose: NaN fails every ordered comparison, so testing for the
    // valid band and inverting rejects NaN, whereas `encoded >= 1.0e32` would wave it through.
    if (!(encoded > 0.0 && encoded < 1.0e32))
        return;

    InterlockedAdd(_HectonMarineSnowSonarGlowResult[pixel], (int)(encoded + 0.5));
}

void AccumulateFogDensityAtUv(float2 uv, float size, uint particleIndex)
{
    if (_HectonMarineSnowFogDensityParams.w <= 0.5 || !ShouldRunStaggeredRate(particleIndex))
        return;

    int width = (int)max(_HectonMarineSnowFogDensityTexelSize.z, 0.0);
    int height = (int)max(_HectonMarineSnowFogDensityTexelSize.w, 0.0);
    if (width <= 0 || height <= 0)
        return;

    int2 pixel = int2(saturate(uv) * float2(width - 1, height - 1) + 0.5);
    float encodedScale = max(_HectonMarineSnowFogDensityParams.y, 1.0);
    float sizeInfluence = saturate(size * max(_HectonMarineSnowFogDensityParams.z, 1.0));
    float encoded = min(
        lerp(0.18, 1.0, sizeInfluence) * encodedScale * 4.0,
        MARINE_SNOW_MAX_ENCODED_SPLAT);
    // Negated positive test on purpose: NaN fails every ordered comparison, so testing for the
    // valid band and inverting rejects NaN, whereas `encoded >= 1.0e32` would wave it through.
    if (!(encoded > 0.0 && encoded < 1.0e32))
        return;

    InterlockedAdd(_HectonMarineSnowFogDensityResult[pixel], (int)(encoded + 0.5));
}

bool ResolveDepthCollision(float3 currentPositionWS, float3 nextPositionWS, out float sceneEyeDepth)
{
    sceneEyeDepth = -1.0;
    float maxCollisionDepth = max(_MarineSnowDepthCollisionParams.x, 0.0);
    float currentEyeDepth = ResolveEyeDepth(currentPositionWS);
    float nextEyeDepth = ResolveEyeDepth(nextPositionWS);
    if (currentEyeDepth <= EPSILON || nextEyeDepth <= EPSILON || currentEyeDepth > maxCollisionDepth || nextEyeDepth > maxCollisionDepth)
        return false;

    float2 currentUv;
    float2 nextUv;
    if (!TryResolveScreenUv(currentPositionWS, currentUv) || !TryResolveScreenUv(nextPositionWS, nextUv))
        return false;

    sceneEyeDepth = SampleSceneEyeDepth(nextUv);
    if (sceneEyeDepth <= EPSILON)
        return false;

    return currentEyeDepth < sceneEyeDepth && nextEyeDepth > sceneEyeDepth;
}

float2 DecodeShallowWaterVelocity(float2 encodedVelocity)
{
    return encodedVelocity * 2.0 - 1.0;
}

float4 EvaluateShallowWaterFieldData(float3 positionWS)
{
    if (_HectonShallowWaterFieldActive < 0.5)
        return float4(0.0, 0.0, 0.0, 0.0);

    float2 uv = float2(
        (positionWS.x - _HectonShallowWaterFieldWorldRect.x) * _HectonShallowWaterFieldWorldRect.z,
        (positionWS.z - _HectonShallowWaterFieldWorldRect.y) * _HectonShallowWaterFieldWorldRect.w);

    if (any(uv < 0.0) || any(uv > 1.0))
        return float4(0.0, 0.0, 0.0, 0.0);

    return _HectonShallowWaterFieldRT.SampleLevel(sampler_HectonShallowWaterFieldRT, uv, 0.0);
}

float SampleMarineSnowTerrainHeight(float3 positionWS)
{
    if (_MarineSnowTerrainHeightScale.z <= 0.5)
        return -100000.0;

    float2 uv = float2(
        (positionWS.x - _MarineSnowTerrainHeightRect.x) * _MarineSnowTerrainHeightRect.z,
        (positionWS.z - _MarineSnowTerrainHeightRect.y) * _MarineSnowTerrainHeightRect.w);
    if (any(uv < 0.0) || any(uv > 1.0))
        return -100000.0;

    float encodedHeight = _MarineSnowTerrainHeightTexture.SampleLevel(sampler_MarineSnowTerrainHeightTexture, saturate(uv), 0.0);
    return _MarineSnowTerrainHeightScale.x + encodedHeight * _MarineSnowTerrainHeightScale.y;
}

float3 ApplyPropwashSandForce(float3 positionWS, float3 velocityWS, float dt)
{
    float washRadius = max(_HectonSubmarineWashSphere.w, 0.0);
    float washSpeed = max(_HectonSubmarineWashVelocity.w, 0.0);
    if (washRadius <= EPSILON || washSpeed <= EPSILON || _MarineSnowPropwashParams.w <= 0.5)
        return velocityWS;

    float terrainHeight = SampleMarineSnowTerrainHeight(positionWS);
    float nearFloorMeters = max(_MarineSnowPropwashParams.x, 0.05);
    if (positionWS.y > terrainHeight + nearFloorMeters)
        return velocityWS;

    float3 lateralDelta = positionWS - _HectonSubmarineWashSphere.xyz;
    lateralDelta.y = 0.0;
    float distanceSq = dot(lateralDelta, lateralDelta);
    float radiusSq = washRadius * washRadius;
    if (distanceSq >= radiusSq)
        return velocityWS;

    float attenuation = saturate(1.0 - distanceSq * rcp(max(radiusSq, EPSILON)));
    float2 outward2 = DominantAxisDirection2(lateralDelta.xz);
    float3 outward = float3(outward2.x, 0.0, outward2.y);
    float radialGain = max(_MarineSnowPropwashParams.y, 0.0);
    float liftGain = max(_MarineSnowPropwashParams.z, 0.0);
    velocityWS += outward * (washSpeed * radialGain * attenuation * dt);
    velocityWS.y += washSpeed * liftGain * attenuation * dt;
    return velocityWS;
}

float3 ApplyMaelstromParticleForce(float3 positionWS, float3 velocityWS, float dt)
{
    uint maelstromCount = (uint)min(max(_MarineSnowMaelstromParams.x, 0.0), 2.0);
    if (maelstromCount == 0u || dt <= 0.0)
        return velocityWS;

    float sharedRadius = max(_MarineSnowMaelstromParams.y, 1.0);
    float radiusSq = sharedRadius * sharedRadius;
    float qualityPressure01 = saturate(_MarineSnowMaelstromParams.w);
    [loop]
    for (uint maelstromIndex = 0u; maelstromIndex < maelstromCount; maelstromIndex++)
    {
        float4 maelstrom = _MarineSnowMaelstroms[maelstromIndex];
        float3 toCenter = maelstrom.xyz - positionWS;
        toCenter.y = 0.0;
        float distanceSq = dot(toCenter, toCenter);
        if (distanceSq <= EPSILON || distanceSq > radiusSq)
            continue;

        float invDistance = rsqrt(max(distanceSq, EPSILON));
        float3 inward = toCenter * invDistance;
        float3 tangent = cross(float3(0.0, 1.0, 0.0), toCenter) * invDistance * (1.0 - qualityPressure01);
        float falloff = saturate(1.0 - distanceSq * rcp(max(radiusSq, EPSILON)));
        float strength = max(maelstrom.w * sharedRadius, 0.0);
        float invSqGain = min(5.0, radiusSq * rcp(max(distanceSq, 1.0)));
        velocityWS += (inward * strength + tangent * (strength * 0.7)) * (falloff * invSqGain * dt * 0.18);
        velocityWS.y -= strength * falloff * dt * 0.015;
    }

    return dot(velocityWS, velocityWS) < 1.0e32 ? velocityWS : float3(0.0, 0.0, 0.0);
}

float SampleCaveSignedDistance(float3 positionWS)
{
    if (_HectonCaveVoxelActive <= 0.5)
        return _HectonCaveVoxelHalfExtents.w;

    float3 invDoubleHalfExtents = _HectonCaveVoxelInvDoubleHalfExtents.xyz;
    if (any(invDoubleHalfExtents <= 0.0))
        return _HectonCaveVoxelHalfExtents.w;

    float3 localPosition = mul(_HectonCaveVoxelWorldToLocal, float4(positionWS, 1.0)).xyz;
    float3 sampleUv = localPosition * invDoubleHalfExtents + 0.5;
    if (any(sampleUv < 0.0) || any(sampleUv > 1.0))
        return _HectonCaveVoxelHalfExtents.w;

    float encoded = _HectonCaveVoxelSdfTex.SampleLevel(sampler_HectonCaveVoxelSdfTex, sampleUv, 0.0).r;
    return lerp(-_HectonCaveVoxelHalfExtents.w, _HectonCaveVoxelHalfExtents.w, encoded);
}

bool ResolveSdfParticleCollision(inout SiltParticle particle, uint particleIndex, float3 nextPosition, bool isBubble, float dt)
{
    if (_HectonCaveVoxelActive <= 0.5)
        return false;

    float signedDistance = SampleCaveSignedDistance(nextPosition);
    if (signedDistance >= 0.0)
        return false;

    particle.Flags |= 1u << 4;
    particle.Pos = particle.PrevPos;
    if (!isBubble)
    {
        particle.Vel = float3(0.0, 0.0, 0.0);
        particle.Life = max(0.0, particle.Life - dt * 0.35);
        return true;
    }

    particle.Vel = reflect(particle.Vel, MARINE_SNOW_CEILING_SLAP_NORMAL) * 0.35;
    float2 jitterSeed = float2(
        Hash21(particle.UV + float2((float)particleIndex * 0.017, _MarineSnowMetaParams.z * 0.013)),
        Hash21(particle.Pad + float2((float)particleIndex * 0.029, _MarineSnowMetaParams.z * 0.019))) * 2.0 - 1.0;
    particle.Vel.xz += DominantAxisDirection2(jitterSeed) * 0.045;
    return true;
}

bool TryResolveVisibleParticleScreenUv(float3 positionWS, float radiusWS, out float2 screenUv)
{
    float4 clipPosition = mul(_MarineSnowViewProjection, float4(positionWS, 1.0));
    if (!(clipPosition.w > EPSILON && clipPosition.w < 1.0e32))
    {
        screenUv = 0.0.xx;
        return false;
    }

    float clipPadding = max(radiusWS * 2.5, 0.025) * clipPosition.w;
    bool insideXY =
        clipPosition.x >= -clipPosition.w - clipPadding &&
        clipPosition.x <= clipPosition.w + clipPadding &&
        clipPosition.y >= -clipPosition.w - clipPadding &&
        clipPosition.y <= clipPosition.w + clipPadding;
    bool insideZ = clipPosition.z >= -clipPadding && clipPosition.z <= clipPosition.w + clipPadding;
    if (!insideXY || !insideZ)
    {
        screenUv = 0.0.xx;
        return false;
    }

    float invClipW = rcp(max(clipPosition.w, EPSILON));
    screenUv = clipPosition.xy * invClipW;
    screenUv = screenUv * 0.5 + 0.5;
    return true;
}

void AppendVisibleParticle(uint particleIndex, SiltParticle particle)
{
    float2 screenUv;
    if (!TryResolveVisibleParticleScreenUv(particle.Pos, particle.Size, screenUv))
        return;

    AccumulateFogDensityAtUv(screenUv, particle.Size, particleIndex);

    uint visibleIndex;
    _MarineSnowIndirectArgs.InterlockedAdd(4, 1u, visibleIndex);
    _MarineSnowVisibleParticleIndices[visibleIndex] = particleIndex;
}

uint ResolveEmissionFlags(uint particleIndex)
{
    uint fluidType = (uint)(_MarineSnowEmissionParams.w + 0.5);
    if (fluidType == 1u)
        return 1u << 0;
    if (fluidType == 2u)
        return 1u << 2;

    float bubbleDrive = saturate(_MarineSnowBubbleParams.x + _MarineSnowBubbleParams.y);
    if (bubbleDrive > EPSILON)
    {
        float bubbleLane = Hash11(particleIndex * 9.17 + _MarineSnowMetaParams.z * 0.137);
        if (bubbleLane < saturate(bubbleDrive * 0.18))
            return 1u << 0;
    }

    return 1u << 3;
}

float ResolveBootstrapVerticalVelocity(float baseSpeed, uint particleIndex)
{
    uint flags = ResolveEmissionFlags(particleIndex);
    return HasMarineSnowFlag(flags, 1u << 0) ? max(0.02, baseSpeed) : -baseSpeed;
}

SiltParticle BuildRespawnParticle(uint particleIndex)
{
    SiltParticle particle = (SiltParticle)0;
    float frameSeed = _MarineSnowMetaParams.z;
    float innerRadius = max(_MarineSnowShellParams.x + 0.1, 0.2);
    float outerRadius = max(innerRadius + 0.1, _MarineSnowShellParams.y);
    float3 cameraPosition = _MarineSnowCameraPosition_Time.xyz;
    float3 cameraRight = _MarineSnowCameraRight_DeltaTime.xyz;
    float3 cameraUp = _MarineSnowCameraUp_Density.xyz;
    float3 cameraForward = SafeNormalize3(cross(cameraRight, cameraUp));
    if (dot(cameraForward, cameraForward) <= EPSILON)
        cameraForward = float3(0.0, 0.0, 1.0);

    float forwardSeed = max(
        Hash11(particleIndex * 1.731 + frameSeed * 0.071),
        Hash11(particleIndex * 2.731 + frameSeed * 0.079));
    float forwardDistance = lerp(innerRadius + 0.35, outerRadius, forwardSeed);
    float cone01 = saturate(forwardDistance * rcp(max(outerRadius, EPSILON)));
    float coneRadius = lerp(0.35, outerRadius * 0.58, cone01);
    float2 radialDir = QuantizedOctDirection2(float2(
        Hash11(particleIndex * 0.6180339 + frameSeed * 0.037) * 2.0 - 1.0,
        Hash11(particleIndex * 1.2710339 + frameSeed * 0.053) * 2.0 - 1.0));
    float radialSeed = sqrt(max(Hash11(particleIndex * 2.2710339 + frameSeed * 0.063), 0.0));
    float2 radial = radialDir * (radialSeed * coneRadius);
    float verticalBias = lerp(_MarineSnowShellParams.z, _MarineSnowShellParams.w, Hash11(particleIndex * 2.113 + frameSeed * 0.091)) * 0.18;

    particle.Pos =
        cameraPosition +
        cameraForward * forwardDistance +
        cameraRight * radial.x +
        cameraUp * (radial.y + verticalBias);
    particle.PrevPos = particle.Pos;
    particle.Life = lerp(0.72, 1.0, Hash11(particleIndex * 0.571 + frameSeed * 0.101));
    particle.Size = lerp(0.0035, 0.0090, Hash11(particleIndex * 0.913 + frameSeed * 0.123));
    particle.Vel = float3(0.0, ResolveBootstrapVerticalVelocity(ResolveBaseDescent(particleIndex), particleIndex), 0.0);
    particle.Flags = ResolveEmissionFlags(particleIndex);
    particle.UV = float2(Hash11(particleIndex * 0.33), Hash11(particleIndex * 0.77));
    particle.Pad = float2(Hash11(particleIndex * 1.11), Hash11(particleIndex * 1.37));
    return particle;
}

float WrapAxis(float value, float minimumValue, float maximumValue)
{
    float range = max(maximumValue - minimumValue, 0.001);
    if (value < minimumValue)
        value += range;
    else if (value > maximumValue)
        value -= range;

    return value;
}

void WrapParticleAroundCameraShell(inout SiltParticle particle, uint particleIndex, float3 cameraPosition)
{
    float3 relative = particle.Pos - cameraPosition;
    float innerRadius = max(_MarineSnowShellParams.x, 0.05);
    float outerRadius = max(innerRadius + 0.1, _MarineSnowShellParams.y);
    float diameter = outerRadius * 2.0;
    float3 previousPosition = particle.Pos;

    if (relative.x > outerRadius)
        relative.x -= diameter;
    else if (relative.x < -outerRadius)
        relative.x += diameter;

    if (relative.z > outerRadius)
        relative.z -= diameter;
    else if (relative.z < -outerRadius)
        relative.z += diameter;

    relative.y = WrapAxis(relative.y, _MarineSnowShellParams.z, _MarineSnowShellParams.w);

    float planarDistanceSq = dot(relative.xz, relative.xz);
    float innerShellSq = innerRadius * innerRadius;
    float outerShellSq = outerRadius * outerRadius;
    if (planarDistanceSq < innerShellSq || planarDistanceSq > outerShellSq)
    {
        float2 seed = float2(
            Hash11(particleIndex * 2.317 + _MarineSnowMetaParams.z * 0.113) * 2.0 - 1.0,
            Hash11(particleIndex * 3.117 + _MarineSnowMetaParams.z * 0.157) * 2.0 - 1.0);
        float2 direction = QuantizedOctDirection2(planarDistanceSq > EPSILON ? relative.xz : seed);
        float radiusSeed = Hash11(particleIndex * 4.317 + _MarineSnowMetaParams.z * 0.191);
        relative.xz = direction * lerp(innerRadius + 0.2, outerRadius, radiusSeed);
    }

    particle.Pos = cameraPosition + relative;
    particle.PrevPos = particle.Pos;
    if (dot(previousPosition - particle.Pos, previousPosition - particle.Pos) > 2500.0)
        particle.PrevPos = particle.Pos;
}

SiltParticle BuildBubbleTrailParticle(uint particleIndex, float bubbleDrive, float exhaleDrive)
{
    SiltParticle particle = BuildRespawnParticle(particleIndex);
    float3 cameraPosition = _MarineSnowCameraPosition_Time.xyz;
    float3 cameraRight = _MarineSnowCameraRight_DeltaTime.xyz;
    float3 cameraUp = _MarineSnowCameraUp_Density.xyz;
    float3 cameraForward = cross(cameraRight, cameraUp);

    float side = (Hash11(particleIndex * 1.23 + _MarineSnowMetaParams.z) - 0.5) * lerp(0.36, 0.58, exhaleDrive);
    float forward = lerp(0.10, 0.72, Hash11(particleIndex * 2.23 + _MarineSnowMetaParams.z * 0.41));
    float lower = lerp(0.18, 0.86, Hash11(particleIndex * 3.23 + _MarineSnowMetaParams.z * 0.67));
    particle.Pos = cameraPosition + cameraRight * side + cameraForward * forward - cameraUp * lower;
    particle.PrevPos = particle.Pos;
    particle.Flags = 1u << 0;
    particle.Life = 1.0;
    particle.Size = lerp(0.004, 0.018, Hash11(particleIndex * 4.23 + _MarineSnowMetaParams.z * 0.29)) * lerp(1.0, 1.7, exhaleDrive);
    particle.Vel =
        cameraUp * lerp(0.08, 0.28, bubbleDrive) +
        cameraRight * ((Hash11(particleIndex * 5.23) - 0.5) * 0.035) +
        cameraForward * lerp(0.02, 0.08, exhaleDrive);
    return particle;
}

// Magnitude tests rather than isfinite: outside strict-IEEE mode the compiler is entitled to
// assume no operand is infinite and fold isfinite() to true, which would leave this returning
// a constant and make the two-stage recovery at CS_RebaseParticles dead code. A bounds test
// survives that fold, and NaN fails every ordered comparison, so both corruption modes are
// still caught. Same idiom the flow, wake and thrust reads in this file already use.
bool IsFiniteSiltParticle(SiltParticle particle)
{
    return dot(particle.Pos, particle.Pos) < 1.0e32 &&
        dot(particle.PrevPos, particle.PrevPos) < 1.0e32 &&
        dot(particle.Vel, particle.Vel) < 1.0e32 &&
        dot(particle.UV, particle.UV) < 1.0e32 &&
        dot(particle.Pad, particle.Pad) < 1.0e32 &&
        abs(particle.Life) < 1.0e32 &&
        abs(particle.Size) < 1.0e32;
}

SiltParticle BuildHardFallbackParticle(uint particleIndex, float3 cameraPosition)
{
    float3 safeCameraPosition = dot(cameraPosition, cameraPosition) < 1.0e32 ? cameraPosition : float3(0.0, 0.0, 0.0);
    SiltParticle particle;
    particle.Pos = safeCameraPosition;
    particle.Life = 1.0;
    particle.Vel = float3(0.0, -0.02, 0.0);
    particle.Size = 0.006;
    particle.PrevPos = safeCameraPosition;
    particle.Flags = 1u << 3;
    particle.UV = float2(Hash11(particleIndex * 0.37), Hash11(particleIndex * 0.53));
    particle.Pad = float2(Hash11(particleIndex * 0.71), 0.0);
    return particle;
}

[numthreads(8, 8, 1)]
void ClearSonarGlow(uint3 dispatchThreadID : SV_DispatchThreadID)
{
    uint2 texel = (uint2)max(_MarineSnowDispatchTileOffset.xy, 0.0.xx) + dispatchThreadID.xy;
    int width = (int)max(_HectonMarineSnowSonarGlowTexelSize.z, 0.0);
    int height = (int)max(_HectonMarineSnowSonarGlowTexelSize.w, 0.0);
    if (texel.x >= (uint)width || texel.y >= (uint)height)
        return;

    _HectonMarineSnowSonarGlowResult[int2(texel)] = 0;
}

[numthreads(8, 8, 1)]
void ClearFogDensity(uint3 dispatchThreadID : SV_DispatchThreadID)
{
    uint2 texel = (uint2)max(_MarineSnowDispatchTileOffset.xy, 0.0.xx) + dispatchThreadID.xy;
    int width = (int)max(_HectonMarineSnowFogDensityTexelSize.z, 0.0);
    int height = (int)max(_HectonMarineSnowFogDensityTexelSize.w, 0.0);
    if (texel.x >= (uint)width || texel.y >= (uint)height)
        return;

    _HectonMarineSnowFogDensityResult[int2(texel)] = 0;
}

[numthreads(1, 1, 1)]
void ClearVisibleParticles(uint3 dispatchThreadID : SV_DispatchThreadID)
{
    _MarineSnowIndirectArgs.Store(0, 6u);
    _MarineSnowIndirectArgs.Store(4, 0u);
    _MarineSnowIndirectArgs.Store(8, 0u);
    _MarineSnowIndirectArgs.Store(12, 0u);
}

[numthreads(THREAD_GROUP_SIZE, 1, 1)]
void AccumulateSonarGlow(uint3 dispatchThreadID : SV_DispatchThreadID)
{
    uint index = (uint)max(_MarineSnowDispatchOffset, 0) + dispatchThreadID.x;
    uint particleCount = (uint)max(_MarineSnowMetaParams.x, 0.0);
    if (index >= particleCount)
        return;
    if (!ShouldRunStaggeredRate(index))
        return;

    SiltParticle particle = LoadWrittenSiltParticle(index);
    if (particle.Life <= 0.0)
        return;

    float sonarGlow = EvaluateSonarReactiveGlow(particle.Pos);
    if (sonarGlow <= 0.0001)
        return;

    float2 screenUv;
    if (!TryResolveScreenUv(particle.Pos, screenUv))
        return;

    AccumulateSonarGlowAtUv(screenUv, sonarGlow, particle.Size);
}

[numthreads(THREAD_GROUP_SIZE, 1, 1)]
void InitializeParticles(uint3 dispatchThreadID : SV_DispatchThreadID)
{
    uint index = (uint)max(_MarineSnowDispatchOffset, 0) + dispatchThreadID.x;
    uint particleCount = (uint)max(_MarineSnowInitializationParams.x, 0.0);
    if (index >= particleCount)
        return;

    StoreSiltParticle(index, BuildRespawnParticle(index));
}

[numthreads(THREAD_GROUP_SIZE, 1, 1)]
void CSMain(uint3 dispatchThreadID : SV_DispatchThreadID)
{
    uint index = (uint)max(_MarineSnowDispatchOffset, 0) + dispatchThreadID.x;
    uint particleCount = (uint)max(_MarineSnowMetaParams.x, 0.0);
    if (index >= particleCount)
        return;

    SiltParticle particle = LoadSiltParticle(index);
    float aupShiftSq = dot(_AupShiftOffset.xyz, _AupShiftOffset.xyz);
    if (particle.Life > 0.0 && aupShiftSq > EPSILON)
    {
        particle.Pos += _AupShiftOffset.xyz;
        particle.PrevPos += _AupShiftOffset.xyz;
    }

    if (particle.Life <= 0.0)
    {
        particle = BuildRespawnParticle(index);
    }

    float dt = min(max(_MarineSnowCameraRight_DeltaTime.w, 0.0), MARINE_SNOW_MAX_DT);
    float simulationTime = _MarineSnowCameraPosition_Time.w;
    float densityScale = saturate(_MarineSnowCameraUp_Density.w);
    float3 cameraPosition = _MarineSnowCameraPosition_Time.xyz;
    bool isBubble = HasMarineSnowFlag(particle.Flags, 1u << 0);
    bool isDebris = HasMarineSnowFlag(particle.Flags, 1u << 2);
    float bubbleTrailDrive = saturate(_MarineSnowBubbleParams.x);
    float bubbleExhaleDrive = saturate(_MarineSnowBubbleParams.y);
    float bubbleDrive = saturate(bubbleTrailDrive + bubbleExhaleDrive);
    if (!isBubble && bubbleDrive > EPSILON)
    {
        float spawnGate = step(
            1.0 - saturate(bubbleDrive) * lerp(0.006, 0.065, bubbleExhaleDrive),
            Hash11(index * 37.17 + _MarineSnowMetaParams.z * 0.73));
        if (spawnGate > 0.5)
        {
            particle = BuildBubbleTrailParticle(index, bubbleDrive, bubbleExhaleDrive);
            isBubble = true;
            isDebris = false;
        }
    }
    float buoyancyModifier = _MarineSnowEmissionParams.x;
    float turbulenceModifier = max(_MarineSnowEmissionParams.y, 0.0);
    float wobbleScale = max(_MarineSnowEmissionParams.z, 0.0);

    particle.PrevPos = particle.Pos;

    float baseDescent = ResolveBaseDescent(index);
    float timeBase = simulationTime * 0.15 + index * 0.0001;
    float2 wander = float2(
        HashSin(float2(timeBase, particle.Pos.z * 0.4)),
        HashSin(float2(timeBase + 31.7, particle.Pos.x * 0.4))) * 2.0 - 1.0;
    wander *= _MarineSnowDriftParams.z;

    float targetVerticalVelocity = isBubble ? max(0.02, baseDescent) : -baseDescent;
    particle.Vel.y = lerp(particle.Vel.y, targetVerticalVelocity, saturate(dt * 4.0));
    particle.Vel.xz += wander;

    float scalabilityQuality = saturate(_MarineSnowScalabilityParams.x * 0.5);
    float highDetailWeight = smoothstep(0.5, 1.0, scalabilityQuality);
    bool flowAdvectionEnabled = scalabilityQuality > EPSILON ||
        _DynamicWakeParams.z > 0.5 ||
        _DynamicWakeDtoParams.z > 0.5 ||
        _PropwashEventParams.y > 0.5 ||
        _MarineSnowMockAcousticParams.x > 0.5;
    float3 synchronizedFlow = float3(0.0, 0.0, 0.0);
    if (flowAdvectionEnabled)
    {
        float3 flowSample = ResolveFlowField(particle.Pos, index);
        float3 dynamicWakeFlow = ResolveDynamicWakeFlow(particle.Pos);
        float3 propwashFlow = ComputePropwashEventFlow(particle.Pos);
        flowSample += dynamicWakeFlow + propwashFlow;
        particle.Vel += ResolveMockAcousticImpulse(particle.Pos);
        float4 shallowWaterData = EvaluateShallowWaterFieldData(particle.Pos);
        float2 shallowWaterVelocity = DecodeShallowWaterVelocity(shallowWaterData.xy);
        float shallowWaterDisplacement = saturate(shallowWaterData.z);
        float3 shallowWaterFlow = float3(shallowWaterVelocity.x, 0.0, shallowWaterVelocity.y) *
            (0.45 + shallowWaterDisplacement * 1.35);
        if (highDetailWeight > EPSILON && _AbyssalFlowTextureActive > 0.5)
            flowSample += ResolveCurlNoiseFake(particle.Pos, simulationTime) * (_MarineSnowFlowParams.z * 0.45 * highDetailWeight);
        synchronizedFlow = (flowSample + shallowWaterFlow) * max(_HectonFlowSynchronyParams.x, 1.0) +
            ResolveFlowSynchronyOffset(particle.Pos, flowSample);
        particle.Vel += (synchronizedFlow - particle.Vel) * (_MarineSnowFlowParams.x + densityScale * _MarineSnowFlowParams.y) * dt;
        particle.Vel.y += shallowWaterDisplacement * 0.025 * dt;
    }
    else
    {
        particle.Vel.xz *= saturate(1.0 - dt * 2.0);
    }
    particle.Vel = ApplyPropwashSandForce(particle.Pos, particle.Vel, dt);
    particle.Vel = ApplyMaelstromParticleForce(particle.Pos, particle.Vel, dt);

    float3 flowDirN = DominantAxisDirection3(synchronizedFlow);
    if (dot(flowDirN, flowDirN) > EPSILON)
    {
        float3 particleDirN = DominantAxisDirection3(particle.Vel);
        float alignment = dot(particleDirN, flowDirN);
        float alignmentN = saturate((alignment + 1.0) * 0.5);
        float dragMultiplier = lerp(1.0, 0.1, alignmentN);
        float dragBase = saturate(1.0 - dragMultiplier * _MarineSnowDriftParams.w);
        float dragAttenuation = lerp(1.0, dragBase, saturate(dt * 60.0));
        particle.Vel *= dragAttenuation;

        if (highDetailWeight > EPSILON && dragMultiplier > 0.7)
        {
            float turbulenceScale = saturate((dragMultiplier - 0.7) * 3.3333333);
            particle.Vel += ResolveTurbulence(particle.Pos, simulationTime) * (turbulenceScale * highDetailWeight * _MarineSnowFlowParams.z * max(turbulenceModifier, 0.001));
        }
    }

    if (isBubble)
    {
        float phase = particle.Pad.x * TAU;
        float wobbleFrequency = 2.1 + particle.Size * 8.0;
        float wobbleMagnitude = 0.12 * particle.Size * wobbleScale;
        float wobbleAttenuation = 1.0 - saturate(DominantMagnitude3(synchronizedFlow) * 0.5);
        float2 lateralOscillation = float2(
            FastTriangleSigned(simulationTime * wobbleFrequency + particle.Pos.y * 1.7 + phase),
            FastTriangleSigned(simulationTime * wobbleFrequency * 0.83 + particle.Pos.y * 1.3 + phase + 2.6707963)) * wobbleMagnitude;
        particle.Vel.xz += lateralOscillation * (dt * 12.0 * wobbleAttenuation);
        particle.Vel.y += max(0.0, buoyancyModifier) * 9.81 * dt;
        float depthResolvedSize = clamp(particle.Size * (1.0 - saturate(ResolveEyeDepth(particle.Pos) * 0.0025) * 0.015 * dt), 0.005, 0.12);
        particle.Size = lerp(particle.Size, depthResolvedSize, highDetailWeight);
        particle.Vel.y = min(particle.Vel.y, 0.35 + particle.Size * 1.2);
    }
    else if (isDebris)
    {
        particle.Vel.y += min(0.0, buoyancyModifier) * 2.25 * dt;
    }
    else
    {
        particle.Vel.y += min(0.0, buoyancyModifier) * dt;
    }

    particle.Pad.y = ResolveHeadlightEmissionBoost(particle.Pos);
    particle.Vel = ClampParticleVelocity(particle.Vel);
    float3 nextPosition = particle.Pos + particle.Vel * dt;
    float sceneEyeDepth;
    bool allowSceneCollision = isBubble || isDebris;
    bool sdfCollision = ShouldRunQualityLane(index, _MarineSnowScalabilityParams.z, 0.37) && ResolveSdfParticleCollision(particle, index, nextPosition, isBubble, dt);
    bool depthCollision = allowSceneCollision && !sdfCollision && ShouldRunQualityLane(index, _MarineSnowScalabilityParams.w, 0.73) && ResolveDepthCollision(particle.Pos, nextPosition, sceneEyeDepth);
    if (depthCollision)
    {
        particle.Flags |= 1u << 4;
        particle.Pos = particle.PrevPos;
        if (isBubble)
        {
            particle.Vel *= -_MarineSnowDepthCollisionParams.y;
            particle.Vel.y = abs(particle.Vel.y);
        }
        else
        {
            particle.Vel *= _MarineSnowDepthCollisionParams.z;
            particle.Life = max(0.0, particle.Life - dt * 0.5);
        }
    }
    else
    {
        if (!sdfCollision)
        {
            particle.Flags &= ~(1u << 4);
            particle.Pos = nextPosition;
        }
    }

    float3 relativeToCamera = particle.Pos - cameraPosition;
    float planarDistanceSq = dot(relativeToCamera.xz, relativeToCamera.xz);
    float cameraDistanceSq = dot(relativeToCamera, relativeToCamera);
    float innerShellSq = _MarineSnowShellParams.x * _MarineSnowShellParams.x;
    float outerShellSq = _MarineSnowShellParams.y * _MarineSnowShellParams.y;
    float hardWrapSq = 50.0 * 50.0;
    bool outOfShell =
        planarDistanceSq > outerShellSq ||
        planarDistanceSq < innerShellSq ||
        cameraDistanceSq > hardWrapSq ||
        relativeToCamera.y < _MarineSnowShellParams.z ||
        relativeToCamera.y > _MarineSnowShellParams.w;

    if (outOfShell)
    {
        WrapParticleAroundCameraShell(particle, index, cameraPosition);
    }

    if (!IsFiniteSiltParticle(particle))
    {
        particle = BuildRespawnParticle(index);
        if (!IsFiniteSiltParticle(particle))
            particle = BuildHardFallbackParticle(index, cameraPosition);
    }

    float lifeDecay = isBubble ? 0.10 : lerp(0.018, 0.045, saturate(densityScale));
    particle.Life = max(0.0, particle.Life - dt * lifeDecay);
    if (particle.Life <= 0.0)
        particle = BuildRespawnParticle(index);
    StoreSiltParticle(index, particle);
    AppendVisibleParticle(index, particle);
}

[numthreads(THREAD_GROUP_SIZE, 1, 1)]
void CS_EvaluateWakeProximity(uint3 dispatchThreadID : SV_DispatchThreadID)
{
    uint eventIndex = (uint)max(_MarineSnowDispatchOffset, 0) + dispatchThreadID.x;
    uint activeCount = (uint)min(max(_PropwashEventParams.y, 0.0), HECTON_PROPWASH_EVENT_CAPACITY);
    uint sampleBudget = ComputePropwashEventSampleBudget(activeCount);
    uint particleCount = (uint)max(_MarineSnowMetaParams.x, 0.0);
    sampleBudget = min(sampleBudget, particleCount);
    if (eventIndex >= sampleBudget || particleCount == 0u)
        return;

    PropwashEventDTO evt = _PropwashEvents[eventIndex];
    if (evt.Intensity <= EPSILON || evt.Radius <= EPSILON)
        return;

    float3 positionWS = _MarineSnowCameraPosition_Time.xyz + evt.LocalPosition;
    float sdfDistance = abs(SampleCaveSignedDistance(positionWS));
    float terrainHeight = SampleMarineSnowTerrainHeight(positionWS);
    float terrainDistance = terrainHeight > -99999.0 ? abs(positionWS.y - terrainHeight) : 99999.0;
    float proximity = min(sdfDistance, terrainDistance);
    float threshold = max(_PropwashEventParams.z, 0.05);
    if (proximity > threshold)
        return;

    uint particleIndex = eventIndex % particleCount;
    float lift01 = saturate(1.0 - proximity * rcp(max(threshold, EPSILON)));
    SiltParticle particle = BuildRespawnParticle(particleIndex);
    particle.Pos = positionWS + SafeNormalize3(evt.ThrustVector + float3(0.0, 0.35, 0.0)) * (evt.Radius * 0.08);
    particle.PrevPos = particle.Pos;
    particle.Vel = evt.ThrustVector * (0.12 + lift01 * 0.55) + float3(0.0, lift01 * 0.08, 0.0);
    particle.Size = max(particle.Size, lerp(0.006, 0.028, saturate(evt.Intensity)));
    particle.Life = max(particle.Life, lerp(0.55, 1.0, lift01));
    particle.Flags |= 1u << 3;
    particle.Pad = _PropwashBiomeTint.xy;
    StoreSiltParticle(particleIndex, particle);
}

[numthreads(THREAD_GROUP_SIZE, 1, 1)]
void CS_IntegrateSiltParticles(uint3 dispatchThreadID : SV_DispatchThreadID)
{
    uint index = (uint)max(_MarineSnowDispatchOffset, 0) + dispatchThreadID.x;
    uint particleCount = (uint)max(_MarineSnowMetaParams.x, 0.0);
    if (index >= particleCount)
        return;

    SiltParticle particle = LoadWrittenSiltParticle(index);
    if (particle.Life <= 0.0)
        particle = BuildRespawnParticle(index);

    float dt = min(max(_MarineSnowCameraRight_DeltaTime.w, 0.0), MARINE_SNOW_MAX_DT);
    particle.PrevPos = particle.Pos;
    particle.Vel += ComputePropwashEventFlow(particle.Pos) * dt;
    particle.Vel = ClampParticleVelocity(particle.Vel);
    particle.Pos += particle.Vel * dt;
    particle.Pad = _PropwashBiomeTint.xy;
    StoreSiltParticle(index, particle);
    AppendVisibleParticle(index, particle);
}

[numthreads(THREAD_GROUP_SIZE, 1, 1)]
void CS_RebaseParticles(uint3 dispatchThreadID : SV_DispatchThreadID)
{
    uint index = (uint)max(_MarineSnowDispatchOffset, 0) + dispatchThreadID.x;
    uint particleCount = (uint)max(_MarineSnowMetaParams.x, 0.0);
    if (index >= particleCount)
        return;

    SiltParticle particle = LoadWrittenSiltParticle(index);
    if (particle.Life > 0.0)
    {
        particle.Pos += _AupShiftOffset.xyz;
        particle.PrevPos += _AupShiftOffset.xyz;
    }

    StoreSiltParticle(index, particle);
}
