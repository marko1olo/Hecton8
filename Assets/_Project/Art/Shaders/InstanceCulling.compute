#pragma kernel CullInstances

#define HECTON_THREADS_PER_GROUP 64
#define HECTON_FLAG_VOXEL_SDF_CULL 1u
#define HECTON_FLAG_VRAM_DOWNSAMPLE 2u

StructuredBuffer<float4x4> _HectonAllInstances;
AppendStructuredBuffer<float4x4> _HectonVisibleInstances;
Texture3D<float> _HectonVoxelSdfTexture3D;

uint _HectonInstanceCount;
float3 _HectonCameraPosition;
float3 _HectonCameraForward;
float4x4 _HectonViewProjection;
float4 _HectonFrustumPlane0;
float4 _HectonFrustumPlane1;
float4 _HectonFrustumPlane2;
float4 _HectonFrustumPlane3;
float4 _HectonFrustumPlane4;
float4 _HectonFrustumPlane5;
float _HectonBoundsRadius;
float _HectonCullDistanceMeters;
int _HectonQualityTier;
float _HectonVramUsedMb;
uint _HectonCullingFlags;
float3 _HectonVoxelSdfOrigin;
float3 _HectonVoxelSdfInvSize;

bool IsFiniteFloat(float value)
{
    return value == value && abs(value) <= 3.402823466e+38;
}

bool IsFiniteFloat3(float3 value)
{
    return IsFiniteFloat(value.x) && IsFiniteFloat(value.y) && IsFiniteFloat(value.z);
}

float3 ResolveInstancePosition(float4x4 matrixValue)
{
    return float3(matrixValue._m03, matrixValue._m13, matrixValue._m23);
}

float ResolveInstanceRadius(float4x4 matrixValue)
{
    float packedRadius = abs(matrixValue._m31);
    return packedRadius > 0.001 ? packedRadius : max(0.001, _HectonBoundsRadius);
}

bool PassesPlane(float4 plane, float3 center, float radius)
{
    float signedDistance = dot(plane.xyz, center) + plane.w;
    return signedDistance >= -radius;
}

bool PassesFrustum(float3 center, float radius)
{
    bool visible = true;
    visible = visible && PassesPlane(_HectonFrustumPlane0, center, radius);
    visible = visible && PassesPlane(_HectonFrustumPlane1, center, radius);
    visible = visible && PassesPlane(_HectonFrustumPlane2, center, radius);
    visible = visible && PassesPlane(_HectonFrustumPlane3, center, radius);
    visible = visible && PassesPlane(_HectonFrustumPlane4, center, radius);
    visible = visible && PassesPlane(_HectonFrustumPlane5, center, radius);
    return visible;
}

bool PassesVoxelSdf(float3 center)
{
    if ((_HectonCullingFlags & HECTON_FLAG_VOXEL_SDF_CULL) == 0u)
        return true;

    uint width;
    uint height;
    uint depth;
    _HectonVoxelSdfTexture3D.GetDimensions(width, height, depth);
    if (width == 0u || height == 0u || depth == 0u)
        return true;

    float3 uvw = saturate((center - _HectonVoxelSdfOrigin) * _HectonVoxelSdfInvSize);
    int3 voxel = int3(
        min((uint)floor(uvw.x * (float)width), width - 1u),
        min((uint)floor(uvw.y * (float)height), height - 1u),
        min((uint)floor(uvw.z * (float)depth), depth - 1u));
    float sdf = _HectonVoxelSdfTexture3D.Load(int4(voxel, 0));
    return sdf > 0.0;
}

[numthreads(HECTON_THREADS_PER_GROUP, 1, 1)]
void CullInstances(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint instanceId = dispatchThreadId.x;
    if (instanceId >= _HectonInstanceCount)
        return;

    if ((_HectonCullingFlags & HECTON_FLAG_VRAM_DOWNSAMPLE) != 0u && ((instanceId & 1u) != 0u))
        return;

    float4x4 matrixValue = _HectonAllInstances[instanceId];
    float3 center = ResolveInstancePosition(matrixValue);
    if (!IsFiniteFloat3(center))
        return;

    float3 toInstance = center - _HectonCameraPosition;
    float distanceSq = dot(toInstance, toInstance);
    float cullDistance = max(0.01, _HectonCullDistanceMeters);
    float cullDistanceSq = cullDistance * cullDistance;
    float radius = ResolveInstanceRadius(matrixValue);

    bool visible = IsFiniteFloat(distanceSq);
    visible = visible && distanceSq <= cullDistanceSq;
    visible = visible && PassesFrustum(center, radius);
    visible = visible && PassesVoxelSdf(center);

    if (visible)
        _HectonVisibleInstances.Append(matrixValue);
}
