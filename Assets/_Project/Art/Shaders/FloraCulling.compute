#pragma kernel CullFloraInstances
#pragma kernel CullFloraShadowInstances
#pragma kernel ClearIndirectArgs

#include "Packages/com.unity.render-pipelines.universal/ShaderLibrary/Core.hlsl"

#define HECTON_THREADS_PER_GROUP 64
#define HECTON_MAX_SCOOTER_HEADLIGHTS 2
#define HECTON_FRUSTUM_PLANES 6

StructuredBuffer<float4x4> _HectonSourceInstanceMatrices;
struct HectonVegetationInstanceGpuData
{
    float Type;
    float HeightScale;
    float WidthScale;
    float Variation;
    float TemplateIndex;
    float RuntimeState;
    float RuntimeFlags;
    float PulseFrequency;
    float4 BioluminescenceColor;
    float SwaySpeed;
    float BendAmplitude;
    float HealthNormalized;
    float Reserved0;
};

StructuredBuffer<HectonVegetationInstanceGpuData> _HectonSourceVegetationInstanceData;
StructuredBuffer<float> _HectonFloraAges01;
AppendStructuredBuffer<uint> _HectonVisibleInstanceIndicesLOD0;
AppendStructuredBuffer<uint> _HectonVisibleInstanceIndicesLOD1;
AppendStructuredBuffer<uint> _HectonVisibleInstanceIndicesShadow;
Texture2D<float> _HectonDepthPyramid;
RWByteAddressBuffer _HectonIndirectArgsBuffer;

uint _HectonSourceInstanceCount;
float4x4 _HectonViewProjection;
float4x4 _HectonViewMatrix;
float3 _HectonCameraPosition;
float3 _HectonCameraForward;
float4 _GlobalFloatingOffset;
float _HectonLodNearDistance;
float _HectonLodFarDistance;
float _HectonLodTransitionRange;
float _HectonPeripheralCullDot;
float _HectonPeripheralCullDistanceSq;
float4 _HectonZBufferParams;
float _HectonOcclusionDepthBias;
uint _HectonOcclusionEnabled;
uint _HectonFarLodAppendEnabled;
uint _HectonDarknessCullEnabled;
int _HectonScooterHeadlightCount;
float4 _HectonScooterHeadlightPositionsWS[HECTON_MAX_SCOOTER_HEADLIGHTS];
float4 _HectonScooterHeadlightDirectionsWS[HECTON_MAX_SCOOTER_HEADLIGHTS];
float4 _HectonScooterHeadlightColors[HECTON_MAX_SCOOTER_HEADLIGHTS];
float4 _HectonScooterHeadlightConeData[HECTON_MAX_SCOOTER_HEADLIGHTS];
float _HectonFloorBiolumStrength;
float _HectonOceanBiolumStrength;
float _BiolumIntensity;
float _HectonDarknessBiolumThreshold;
float4 _HectonFrustumPlanes[HECTON_FRUSTUM_PLANES];
int _HectonDepthPyramidMipCount;
float4 _HectonDepthPyramidTexelSize;
uint _HectonIndirectIndexCountPerInstance;
uint _HectonIndirectStartIndex;
uint _HectonIndirectBaseVertexIndex;

float4x4 _MainLightWorldToShadow[5];
float4 _CascadeShadowSplitSpheres0;
float4 _CascadeShadowSplitSpheres1;
float4 _CascadeShadowSplitSpheres2;
float4 _CascadeShadowSplitSpheres3;
float4 _CascadeShadowSplitSphereRadii;

bool IsFiniteScalar(float value)
{
    return value == value && abs(value) <= 3.402823466e+38;
}

bool IsFiniteFloat3(float3 value)
{
    return all(isfinite(value));
}

bool IsFiniteFloat4(float4 value)
{
    return all(isfinite(value));
}

float3 TransformPoint(float4x4 matrixValue, float3 localPosition)
{
    float4 transformed = mul(matrixValue, float4(localPosition, 1.0));
    return IsFiniteFloat4(transformed) ? transformed.xyz : 0.0.xxx;
}

float3 ResolveInstanceOrigin(float4x4 matrixValue)
{
    return float3(matrixValue._m03, matrixValue._m13, matrixValue._m23);
}

float3 ResolveShiftedWorldPosition(float3 positionWS)
{
    return positionWS + _GlobalFloatingOffset.xyz;
}

void ResolveInstanceShape(float instanceType, float heightScale, float widthScale, out float instanceHeight, out float instanceWidth)
{
    if (instanceType < 0.5)
    {
        instanceHeight = lerp(0.35, 1.4, saturate(heightScale));
        instanceWidth = lerp(0.65, 1.25, saturate(widthScale));
        return;
    }

    if (instanceType < 1.5)
    {
        instanceHeight = lerp(10.0, 20.0, saturate(heightScale));
        instanceWidth = lerp(0.55, 1.6, saturate(widthScale));
        return;
    }

    instanceHeight = lerp(0.75, 2.4, saturate(heightScale));
    instanceWidth = lerp(0.75, 1.35, saturate(widthScale));
}

float ResolveFloraAge01(uint instanceIndex)
{
    float age01 = _HectonFloraAges01[instanceIndex];
    return IsFiniteScalar(age01) ? age01 : -1.0;
}

bool IsSphereVisibleInFrustumSq(float3 centerWS, float radiusSq)
{
    [unroll]
    for (int planeIndex = 0; planeIndex < HECTON_FRUSTUM_PLANES; planeIndex++)
    {
        float4 plane = _HectonFrustumPlanes[planeIndex];
        float signedDistance = dot(plane.xyz, centerWS) + plane.w;
        if (signedDistance < 0.0 && signedDistance * signedDistance > radiusSq)
            return false;
    }

    return true;
}

bool IsVisibleInFrustum(float4 clipRoot, float4 clipCenter, float4 clipTop, float4 clipSideA, float4 clipSideB)
{
    if (!IsFiniteFloat4(clipRoot) ||
        !IsFiniteFloat4(clipCenter) ||
        !IsFiniteFloat4(clipTop) ||
        !IsFiniteFloat4(clipSideA) ||
        !IsFiniteFloat4(clipSideB))
    {
        return false;
    }

    if (clipRoot.w <= 0.0001 &&
        clipCenter.w <= 0.0001 &&
        clipTop.w <= 0.0001 &&
        clipSideA.w <= 0.0001 &&
        clipSideB.w <= 0.0001)
    {
        return false;
    }

    float2 ndcRoot = clipRoot.xy / max(clipRoot.w, 0.0001);
    float2 ndcCenter = clipCenter.xy / max(clipCenter.w, 0.0001);
    float2 ndcTop = clipTop.xy / max(clipTop.w, 0.0001);
    float2 ndcSideA = clipSideA.xy / max(clipSideA.w, 0.0001);
    float2 ndcSideB = clipSideB.xy / max(clipSideB.w, 0.0001);

    float minX = min(ndcRoot.x, min(ndcCenter.x, min(ndcTop.x, min(ndcSideA.x, ndcSideB.x))));
    float maxX = max(ndcRoot.x, max(ndcCenter.x, max(ndcTop.x, max(ndcSideA.x, ndcSideB.x))));
    float minY = min(ndcRoot.y, min(ndcCenter.y, min(ndcTop.y, min(ndcSideA.y, ndcSideB.y))));
    float maxY = max(ndcRoot.y, max(ndcCenter.y, max(ndcTop.y, max(ndcSideA.y, ndcSideB.y))));

    if (maxX < -1.06)
        return false;

    if (minX > 1.06)
        return false;

    if (maxY < -1.08)
        return false;

    if (minY > 1.08)
        return false;

    float ndcRootZ = clipRoot.z / max(clipRoot.w, 0.0001);
    float ndcCenterZ = clipCenter.z / max(clipCenter.w, 0.0001);
    float ndcTopZ = clipTop.z / max(clipTop.w, 0.0001);
    float ndcSideAZ = clipSideA.z / max(clipSideA.w, 0.0001);
    float ndcSideBZ = clipSideB.z / max(clipSideB.w, 0.0001);

    float maxZ = max(ndcRootZ, max(ndcCenterZ, max(ndcTopZ, max(ndcSideAZ, ndcSideBZ))));
    float minZ = min(ndcRootZ, min(ndcCenterZ, min(ndcTopZ, min(ndcSideAZ, ndcSideBZ))));

    if (maxZ < -1.1)
        return false;

    if (minZ > 1.1)
        return false;

    return true;
}

float ResolveEyeDepth(float3 positionWS)
{
    float3 positionVS = mul(_HectonViewMatrix, float4(positionWS, 1.0)).xyz;
    return max(0.0, -positionVS.z);
}

float2 ResolveClipUv(float4 clipPosition)
{
    float2 uv = clipPosition.xy / clipPosition.w;
    return uv * 0.5 + 0.5;
}

float SampleDepthPyramid(float2 uv, int mipLevel)
{
    if (_HectonDepthPyramidMipCount <= 0)
        return 0.0;

    int2 mipSize = max(int2(1, 1), int2(_HectonDepthPyramidTexelSize.zw) >> mipLevel);
    int2 pixel = clamp(int2(uv * mipSize), int2(0, 0), mipSize - 1);
    return _HectonDepthPyramid.Load(int3(pixel, mipLevel));
}

bool IsOccludedByDepth(
    float3 originWS,
    float3 centerWS,
    float3 topWS,
    float3 sideAWS,
    float3 sideBWS,
    float4 clipRoot,
    float4 clipCenter,
    float4 clipTop,
    float4 clipSideA,
    float4 clipSideB)
{
    if (_HectonOcclusionEnabled == 0 || _HectonDepthPyramidMipCount <= 0)
        return false;

    float2 uvRoot = ResolveClipUv(clipRoot);
    float2 uvCenter = ResolveClipUv(clipCenter);
    float2 uvTop = ResolveClipUv(clipTop);
    float2 uvSideA = ResolveClipUv(clipSideA);
    float2 uvSideB = ResolveClipUv(clipSideB);
    float2 minUv = max(0.0.xx, min(uvRoot, min(uvCenter, min(uvTop, min(uvSideA, uvSideB)))));
    float2 maxUv = min(1.0.xx, max(uvRoot, max(uvCenter, max(uvTop, max(uvSideA, uvSideB)))));
    if (minUv.x >= maxUv.x || minUv.y >= maxUv.y)
        return false;

    float2 rectPixels = (maxUv - minUv) * _HectonDepthPyramidTexelSize.zw;
    float rectExtent = max(rectPixels.x, rectPixels.y);
    int mipLevel = (int)clamp(floor(log2(max(rectExtent, 1.0))), 0.0, (float)(_HectonDepthPyramidMipCount - 1));
    float rawDepth = SampleDepthPyramid((minUv + maxUv) * 0.5, mipLevel);
#if defined(UNITY_REVERSED_Z)
    if (rawDepth <= 0.0001)
        return false;
#else
    if (rawDepth >= 0.9999)
        return false;
#endif

    float sceneEyeDepth = LinearEyeDepth(rawDepth, _HectonZBufferParams);
    if (sceneEyeDepth <= 0.0001)
        return false;

    float nearestObjectDepth = min(
        ResolveEyeDepth(originWS),
        min(
            ResolveEyeDepth(centerWS),
            min(
                ResolveEyeDepth(topWS),
                min(ResolveEyeDepth(sideAWS), ResolveEyeDepth(sideBWS)))));
    return nearestObjectDepth - sceneEyeDepth > _HectonOcclusionDepthBias;
}

float4 GetCascadeSphere(int cascadeIndex)
{
    if (cascadeIndex == 0)
        return _CascadeShadowSplitSpheres0;
    if (cascadeIndex == 1)
        return _CascadeShadowSplitSpheres1;
    if (cascadeIndex == 2)
        return _CascadeShadowSplitSpheres2;
    return _CascadeShadowSplitSpheres3;
}

float GetCascadeSphereRadiusSq(int cascadeIndex)
{
    if (cascadeIndex == 0)
        return _CascadeShadowSplitSphereRadii.x;
    if (cascadeIndex == 1)
        return _CascadeShadowSplitSphereRadii.y;
    if (cascadeIndex == 2)
        return _CascadeShadowSplitSphereRadii.z;
    return _CascadeShadowSplitSphereRadii.w;
}

bool IsInShadowCascade(float3 positionWS, int cascadeIndex)
{
    float4 sphere = GetCascadeSphere(cascadeIndex);
    float3 delta = positionWS - sphere.xyz;
    if (dot(delta, delta) > GetCascadeSphereRadiusSq(cascadeIndex))
        return false;

    float4 shadowCoord = mul(_MainLightWorldToShadow[cascadeIndex], float4(positionWS, 1.0));
    if (shadowCoord.w <= 0.0001)
        return false;

    float3 shadowNdc = shadowCoord.xyz / shadowCoord.w;
    return shadowNdc.x >= 0.0 && shadowNdc.x <= 1.0 &&
        shadowNdc.y >= 0.0 && shadowNdc.y <= 1.0 &&
        shadowNdc.z > 0.0 && shadowNdc.z < 1.0;
}

bool IsVisibleInAnyShadowCascade(float3 rootWS, float3 centerWS, float3 topWS, float3 sideAWS, float3 sideBWS)
{
    [unroll]
    for (int cascadeIndex = 0; cascadeIndex < 4; cascadeIndex++)
    {
        if (IsInShadowCascade(rootWS, cascadeIndex) ||
            IsInShadowCascade(centerWS, cascadeIndex) ||
            IsInShadowCascade(topWS, cascadeIndex) ||
            IsInShadowCascade(sideAWS, cascadeIndex) ||
            IsInShadowCascade(sideBWS, cascadeIndex))
        {
            return true;
        }
    }

    return false;
}

bool PassesDotThresholdSq(float dotValue, float threshold, float lengthProductSq)
{
    if (!IsFiniteScalar(dotValue) || !IsFiniteScalar(threshold) || !IsFiniteScalar(lengthProductSq) || lengthProductSq <= 0.00000001)
        return true;

    float thresholdSq = threshold * threshold;
    float dotSq = dotValue * dotValue;
    return threshold >= 0.0
        ? dotValue >= 0.0 && dotSq >= thresholdSq * lengthProductSq
        : dotValue >= 0.0 || dotSq <= thresholdSq * lengthProductSq;
}

bool IsVisibleInDarkness(float3 samplePositionWS)
{
    if (_HectonDarknessCullEnabled == 0)
        return true;

    float globalBiolum = max(_BiolumIntensity, max(_HectonFloorBiolumStrength, _HectonOceanBiolumStrength));
    globalBiolum = IsFiniteScalar(globalBiolum) ? globalBiolum : 0.0;
    if (globalBiolum >= _HectonDarknessBiolumThreshold)
        return true;

    [unroll(HECTON_MAX_SCOOTER_HEADLIGHTS)]
    for (int headlightIndex = 0; headlightIndex < HECTON_MAX_SCOOTER_HEADLIGHTS; headlightIndex++)
    {
        if (headlightIndex >= _HectonScooterHeadlightCount)
            break;

        float3 lightPositionWS = _HectonScooterHeadlightPositionsWS[headlightIndex].xyz;
        float lightRange = max(0.1, _HectonScooterHeadlightPositionsWS[headlightIndex].w);
        if (!IsFiniteFloat3(lightPositionWS) || !IsFiniteScalar(lightRange))
            continue;

        float3 toSampleWS = samplePositionWS - lightPositionWS;
        float sampleDistanceSq = dot(toSampleWS, toSampleWS);
        float lightRangeSq = lightRange * lightRange;
        if (!IsFiniteScalar(sampleDistanceSq) || sampleDistanceSq <= 0.00000001 || sampleDistanceSq >= lightRangeSq)
            continue;

        float3 lightDirectionWS = _HectonScooterHeadlightDirectionsWS[headlightIndex].xyz;
        float dotLight = dot(lightDirectionWS, toSampleWS);
        if (!PassesDotThresholdSq(dotLight, _HectonScooterHeadlightConeData[headlightIndex].x, sampleDistanceSq))
            continue;

        float invRange = _HectonScooterHeadlightConeData[headlightIndex].z;
        float rangeAttenuation = saturate(1.0 - sampleDistanceSq * invRange * invRange);
        rangeAttenuation *= rangeAttenuation;
        float intensity = _HectonScooterHeadlightColors[headlightIndex].w * _HectonScooterHeadlightConeData[headlightIndex].y;
        if (rangeAttenuation * intensity >= 0.02)
            return true;
    }

    return false;
}

bool IsVisibleInPeripheralCone(float3 samplePositionWS)
{
    if (_HectonPeripheralCullDistanceSq <= 0.0)
        return true;

    float3 toSampleWS = samplePositionWS - _HectonCameraPosition;
    float distanceSq = dot(toSampleWS, toSampleWS);
    if (!IsFiniteScalar(distanceSq) || distanceSq <= _HectonPeripheralCullDistanceSq)
        return true;

    float dotForward = dot(toSampleWS, _HectonCameraForward);
    return PassesDotThresholdSq(dotForward, _HectonPeripheralCullDot, distanceSq);
}

[numthreads(1, 1, 1)]
void ClearIndirectArgs(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    _HectonIndirectArgsBuffer.Store(0, _HectonIndirectIndexCountPerInstance);
    _HectonIndirectArgsBuffer.Store(4, 0u);
    _HectonIndirectArgsBuffer.Store(8, _HectonIndirectStartIndex);
    _HectonIndirectArgsBuffer.Store(12, _HectonIndirectBaseVertexIndex);
    _HectonIndirectArgsBuffer.Store(16, 0u);
}

[numthreads(HECTON_THREADS_PER_GROUP, 1, 1)]
void CullFloraInstances(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint instanceIndex = dispatchThreadId.x;
    if (instanceIndex >= _HectonSourceInstanceCount)
        return;

    float4x4 instanceMatrix = _HectonSourceInstanceMatrices[instanceIndex];
    float3 originWS = ResolveShiftedWorldPosition(ResolveInstanceOrigin(instanceMatrix));
    if (!IsFiniteFloat3(originWS))
        return;

    float3 cameraDelta = originWS - _HectonCameraPosition;
    float distanceSq = dot(cameraDelta, cameraDelta);
    if (!IsFiniteScalar(distanceSq))
        return;

    float lod0Distance = max(_HectonLodNearDistance, 0.01);
    float lod1Distance = max(_HectonLodFarDistance, lod0Distance);
    float lodTransition = max(_HectonLodTransitionRange, 0.01);
    float lod0MaxDistance = lod0Distance + lodTransition;
    float lod1MinDistance = max(0.0, lod0Distance - lodTransition);
    float lod1MaxDistance = lod1Distance + lodTransition;
    float lod0MaxDistanceSq = lod0MaxDistance * lod0MaxDistance;
    float lod1MinDistanceSq = lod1MinDistance * lod1MinDistance;
    float lod1MaxDistanceSq = lod1MaxDistance * lod1MaxDistance;

    if (_HectonFarLodAppendEnabled == 0 && distanceSq > lod0MaxDistanceSq)
        return;

    if (distanceSq > lod1MaxDistanceSq)
        return;

    HectonVegetationInstanceGpuData instanceData = _HectonSourceVegetationInstanceData[instanceIndex];
    float age01 = ResolveFloraAge01(instanceIndex);
    if (age01 < 0.0)
        return;

    age01 = saturate(age01);
    float instanceType = clamp(round(instanceData.Type), 0.0, 2.0);

    float instanceHeight;
    float instanceWidth;
    ResolveInstanceShape(instanceType, instanceData.HeightScale, instanceData.WidthScale, instanceHeight, instanceWidth);
    instanceHeight *= age01;
    instanceWidth *= sqrt(max(age01, 0.0));

    float3 centerWS = ResolveShiftedWorldPosition(TransformPoint(instanceMatrix, float3(0.0, instanceHeight * 0.5, 0.0)));
    float3 topWS = ResolveShiftedWorldPosition(TransformPoint(instanceMatrix, float3(0.0, instanceHeight, 0.0)));
    float3 sideAWS = ResolveShiftedWorldPosition(TransformPoint(instanceMatrix, float3(instanceWidth, instanceHeight * 0.5, 0.0)));
    float3 sideBWS = ResolveShiftedWorldPosition(TransformPoint(instanceMatrix, float3(-instanceWidth, instanceHeight * 0.5, 0.0)));
    if (!IsFiniteFloat3(centerWS) ||
        !IsFiniteFloat3(topWS) ||
        !IsFiniteFloat3(sideAWS) ||
        !IsFiniteFloat3(sideBWS))
    {
        return;
    }

    float radiusSq = max(
        dot(centerWS - originWS, centerWS - originWS),
        max(
            dot(centerWS - topWS, centerWS - topWS),
            max(
                dot(centerWS - sideAWS, centerWS - sideAWS),
                dot(centerWS - sideBWS, centerWS - sideBWS))));
    if (!IsSphereVisibleInFrustumSq(centerWS, max(0.0625, radiusSq)))
        return;

    float4 clipRoot = mul(_HectonViewProjection, float4(originWS, 1.0));
    float4 clipCenter = mul(_HectonViewProjection, float4(centerWS, 1.0));
    float4 clipTop = mul(_HectonViewProjection, float4(topWS, 1.0));
    float4 clipSideA = mul(_HectonViewProjection, float4(sideAWS, 1.0));
    float4 clipSideB = mul(_HectonViewProjection, float4(sideBWS, 1.0));

    if (!IsVisibleInFrustum(clipRoot, clipCenter, clipTop, clipSideA, clipSideB))
        return;

    if (IsOccludedByDepth(originWS, centerWS, topWS, sideAWS, sideBWS, clipRoot, clipCenter, clipTop, clipSideA, clipSideB))
        return;

    if (!IsVisibleInDarkness(centerWS))
        return;

    if (!IsVisibleInPeripheralCone(centerWS))
        return;

    if (distanceSq <= lod0MaxDistanceSq)
        _HectonVisibleInstanceIndicesLOD0.Append(instanceIndex);

    if (_HectonFarLodAppendEnabled != 0 && distanceSq >= lod1MinDistanceSq && distanceSq <= lod1MaxDistanceSq)
        _HectonVisibleInstanceIndicesLOD1.Append(instanceIndex);
}

[numthreads(HECTON_THREADS_PER_GROUP, 1, 1)]
void CullFloraShadowInstances(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint instanceIndex = dispatchThreadId.x;
    if (instanceIndex >= _HectonSourceInstanceCount)
        return;

    float4x4 instanceMatrix = _HectonSourceInstanceMatrices[instanceIndex];
    HectonVegetationInstanceGpuData instanceData = _HectonSourceVegetationInstanceData[instanceIndex];
    float age01 = ResolveFloraAge01(instanceIndex);
    if (age01 < 0.0)
        return;

    age01 = saturate(age01);
    float instanceType = clamp(round(instanceData.Type), 0.0, 2.0);

    float instanceHeight;
    float instanceWidth;
    ResolveInstanceShape(instanceType, instanceData.HeightScale, instanceData.WidthScale, instanceHeight, instanceWidth);
    instanceHeight *= age01;
    instanceWidth *= sqrt(max(age01, 0.0));

    float3 rootWS = ResolveShiftedWorldPosition(ResolveInstanceOrigin(instanceMatrix));
    float3 centerWS = ResolveShiftedWorldPosition(TransformPoint(instanceMatrix, float3(0.0, instanceHeight * 0.5, 0.0)));
    float3 topWS = ResolveShiftedWorldPosition(TransformPoint(instanceMatrix, float3(0.0, instanceHeight, 0.0)));
    float3 sideAWS = ResolveShiftedWorldPosition(TransformPoint(instanceMatrix, float3(instanceWidth, instanceHeight * 0.5, 0.0)));
    float3 sideBWS = ResolveShiftedWorldPosition(TransformPoint(instanceMatrix, float3(-instanceWidth, instanceHeight * 0.5, 0.0)));
    if (!IsFiniteFloat3(rootWS) ||
        !IsFiniteFloat3(centerWS) ||
        !IsFiniteFloat3(topWS) ||
        !IsFiniteFloat3(sideAWS) ||
        !IsFiniteFloat3(sideBWS))
    {
        return;
    }

    float radiusSq = max(
        dot(centerWS - rootWS, centerWS - rootWS),
        max(
            dot(centerWS - topWS, centerWS - topWS),
            max(
                dot(centerWS - sideAWS, centerWS - sideAWS),
                dot(centerWS - sideBWS, centerWS - sideBWS))));
    if (!IsSphereVisibleInFrustumSq(centerWS, max(0.0625, radiusSq)))
        return;

    if (!IsVisibleInAnyShadowCascade(rootWS, centerWS, topWS, sideAWS, sideBWS))
        return;

    if (!IsVisibleInPeripheralCone(centerWS))
        return;

    _HectonVisibleInstanceIndicesShadow.Append(instanceIndex);
}
