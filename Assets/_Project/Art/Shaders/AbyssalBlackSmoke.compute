#pragma kernel CSMain

struct AshParticleData
{
    float3 PositionWS;
    float Size;
    float3 VelocityWS;
    float Alpha;
    float Lifetime;
    float MaxLifetime;
    float Seed;
    float VentIndex;
};

struct ThermalVentGpuData
{
    float3 PositionWS;
    float RadiusWS;
    float HeightWS;
    float UpdraftVelocity;
    float HeatIntensity;
    float SmokeDensity;
    float2 Padding;
};

StructuredBuffer<AshParticleData> _ParticlesRead;
RWStructuredBuffer<AshParticleData> _ParticlesWrite;
StructuredBuffer<ThermalVentGpuData> _ThermalVents;

int _ParticleCount;
int _ActiveVentCount;
float _DeltaTime;
float _SimulationTime;
float3 _CameraPositionWS;
float4 _ParticleSizeRange;
float4 _NoiseParams;
float _MaxViewDistance;

#define THREAD_GROUP_SIZE 64
#define EPSILON 0.0001

// Same 15 FPS floor Hecton_FluidAdvection clamps dt to. Without it a hitch integrates one enormous step and
// throws the whole plume out of the vent column.
#define ABYSSAL_SMOKE_MAX_DT 0.0666667

// Ash in water is drag-dominated, not ballistic: it reaches terminal velocity in well under a second. This
// rate gives a ~0.35 s time constant, so the plume rises at the vent's authored updraft speed instead of
// accelerating past it. See the velocity integration for why this must exist.
#define ABYSSAL_SMOKE_DRAG_RATE_PER_SECOND 2.85

// Fraction of a particle's life spent fading in, so it does not pop into existence at the vent mouth.
#define ABYSSAL_SMOKE_BIRTH_FADE_FRACTION 0.12

float Hash11(float value)
{
    float3 hash = frac(float3(value, value + 19.19, value + 37.37) * float3(0.1031, 0.1030, 0.0973));
    hash += dot(hash, hash.yzx + 33.33);
    return frac((hash.x + hash.y) * hash.z);
}

float3 SafeNormalize(float3 value)
{
    float lengthSq = dot(value, value);
    if (lengthSq <= EPSILON)
        return float3(0.0, 1.0, 0.0);

    return value * rsqrt(lengthSq);
}

float3 BuildRespawnPosition(ThermalVentGpuData vent, uint particleIndex, float seed)
{
    float2 radialVector = float2(
        Hash11(particleIndex * 1.37 + vent.PositionWS.x * 0.003 + seed * 41.0) * 2.0 - 1.0,
        Hash11(particleIndex * 1.91 + vent.PositionWS.z * 0.005 + seed * 17.0) * 2.0 - 1.0);
    radialVector *= rsqrt(max(dot(radialVector, radialVector), EPSILON));
    float radialSeed = max(
        Hash11(particleIndex * 0.91 + vent.PositionWS.z * 0.005 + seed * 13.0),
        Hash11(particleIndex * 1.11 + vent.PositionWS.x * 0.007 + seed * 23.0));
    float radial = radialSeed * vent.RadiusWS * 0.45;
    float3 lateral = float3(radialVector.x, 0.0, radialVector.y) * radial;
    float vertical = lerp(0.15, 1.5, Hash11(particleIndex * 0.57 + seed * 7.3));
    return vent.PositionWS + lateral + float3(0.0, vertical, 0.0);
}

[numthreads(THREAD_GROUP_SIZE, 1, 1)]
void CSMain(uint3 dispatchThreadID : SV_DispatchThreadID)
{
    uint index = dispatchThreadID.x;
    if (index >= (uint)_ParticleCount)
        return;

    AshParticleData particle = _ParticlesRead[index];
    if (_ActiveVentCount <= 0)
    {
        particle.Alpha = 0.0;
        _ParticlesWrite[index] = particle;
        return;
    }

    uint ventIndex = (uint)clamp(particle.VentIndex, 0.0, max(0, _ActiveVentCount - 1));
    ThermalVentGpuData vent = _ThermalVents[ventIndex];
    float dt = min(max(_DeltaTime, 0.0), ABYSSAL_SMOKE_MAX_DT);

    particle.Lifetime += dt;
    float heightLimit = vent.PositionWS.y + vent.HeightWS;
    bool expired = particle.Lifetime >= particle.MaxLifetime || particle.PositionWS.y >= heightLimit;
    if (expired)
    {
        float respawnSeed = Hash11(index * 0.33 + particle.Seed * 19.0 + _SimulationTime * 0.11);
        particle.PositionWS = BuildRespawnPosition(vent, index, particle.Seed);
        particle.Size = lerp(_ParticleSizeRange.x, _ParticleSizeRange.y, respawnSeed);
        particle.VelocityWS = float3(0.0, vent.UpdraftVelocity * lerp(0.55, 1.05, respawnSeed), 0.0);
        particle.Lifetime = 0.0;
        particle.MaxLifetime = lerp(1.8, 5.6, Hash11(index * 0.73 + particle.Seed * 3.7));
        particle.VentIndex = ventIndex;
        // No Alpha reset here: it was a dead store, unconditionally overwritten by the alpha resolve below.
        // The fade-in it was reaching for is now a real birth ramp driven by Lifetime.
    }

    float lifeT = saturate(particle.Lifetime / max(particle.MaxLifetime, 0.001));
    float heightT = saturate((particle.PositionWS.y - vent.PositionWS.y) / max(vent.HeightWS, 0.001));
    float2 radialOffset = particle.PositionWS.xz - vent.PositionWS.xz;
    float radiusSq = max(vent.RadiusWS * vent.RadiusWS, 0.001);
    float radialT = saturate(dot(radialOffset, radialOffset) / radiusSq);
    float3 toCenter = float3(vent.PositionWS.x - particle.PositionWS.x, 0.0, vent.PositionWS.z - particle.PositionWS.z);
    float3 inward = SafeNormalize(toCenter);
    float noisePhase = particle.Seed * 37.0 + _SimulationTime * 0.91 + index * 0.013;
    float3 lateralNoise = float3(
        Hash11(noisePhase + 1.0) * 2.0 - 1.0,
        Hash11(noisePhase + 2.0) * 2.0 - 1.0,
        Hash11(noisePhase + 3.0) * 2.0 - 1.0);
    lateralNoise.y = 0.0;
    float3 turbulence = SafeNormalize(lateralNoise) * (_NoiseParams.x * vent.SmokeDensity);
    float upward = vent.UpdraftVelocity + (Hash11(noisePhase + 4.0) * 2.0 - 1.0) * _NoiseParams.y;
    float confinement = saturate((radialT - 0.3025) / 0.6975);

    // These three terms are VELOCITIES, so they resolve to a target the particle is dragged toward - they are
    // not an acceleration to integrate. UpdraftVelocity is a speed: it seeds VelocityWS directly at respawn
    // above. Adding it to velocity every frame as well made one field do duty as both m/s and m/s^2, and with
    // no drag anywhere the result grew without bound - a 2 m/s vent reached about 13 m/s across a 5.6 s life.
    // Particles then cleared vent.HeightWS almost immediately, so expiry was driven by height alone and
    // MaxLifetime was very nearly dead, which is why the plume read as a jet rather than buoyant smoke.
    // Water is drag-dominated: ash reaches terminal velocity fast, and terminal velocity here is the target.
    float3 targetVelocity =
        float3(0.0, upward, 0.0) +
        inward * (confinement * vent.UpdraftVelocity * 0.28) +
        turbulence;

    // Exponential relaxation, so the approach is framerate-independent rather than a raw per-frame blend.
    float dragBlend = saturate(1.0 - exp(-ABYSSAL_SMOKE_DRAG_RATE_PER_SECOND * dt));
    particle.VelocityWS = lerp(particle.VelocityWS, targetVelocity, dragBlend);
    particle.PositionWS += particle.VelocityWS * dt;

    float3 toCamera = particle.PositionWS - _CameraPositionWS;
    float maxViewDistanceSq = max(_MaxViewDistance * _MaxViewDistance, 0.001);
    float distanceFade = 1.0 - saturate(dot(toCamera, toCamera) / maxViewDistanceSq);
    float plumeFade = (1.0 - heightT) * (1.0 - radialT * 0.82);

    // Birth ramp. Respawned particles previously appeared at full plume alpha in the same frame they were
    // placed, because the Alpha = 0.0 written in the respawn branch was overwritten here before it ever
    // reached the buffer - ash popped into existence at the vent mouth. Ramping over the first slice of life
    // also keeps the transition C1 at t=0 rather than a step.
    float birthFade = saturate(lifeT * rcp(ABYSSAL_SMOKE_BIRTH_FADE_FRACTION));
    birthFade *= birthFade * (3.0 - 2.0 * birthFade);
    particle.Alpha = saturate(plumeFade * distanceFade * birthFade * vent.SmokeDensity * 0.42);

    // A non-finite particle never recovers on its own: it is read back next frame and re-integrated forever.
    // Park it invisibly at the vent so the slot recycles through the normal expiry path instead of leaking.
    bool finiteParticle = all(isfinite(particle.PositionWS)) && all(isfinite(particle.VelocityWS));
    if (!finiteParticle)
    {
        particle.PositionWS = vent.PositionWS;
        particle.VelocityWS = float3(0.0, 0.0, 0.0);
        particle.Lifetime = particle.MaxLifetime;
        particle.Alpha = 0.0;
    }

    _ParticlesWrite[index] = particle;
}
