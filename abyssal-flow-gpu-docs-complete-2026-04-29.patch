+            float verticalProbeOffset = math.max(abyssalHeatProbeRadius * 0.5f, abyssalFlowVerticalCellSize);
+            float sampleRadius = math.max(1f, abyssalFlowHorizontalCellSize * 0.5f);
+            int sourceCount = 0;
