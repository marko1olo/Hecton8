2680|                    UnityEngine.Object.FindFirstObjectByType<Hecton8.UI.HectonFabricatorUI>();
2681|                if (fab != null)
2682|                    fab.ForceCloseMenu();
2683|            }
2684|
2685|            IInputService input = GlobalRegistry.RegisteredInput;
2686|            if (input != null)
2687|            {
2688|                input.SwitchToPlayerInput();
2689|                _switchedToPlayerInput = true;
2690|            }
2691|
2692|            // L13: Re-assert HPM Player fixed-tick registration so SampleGameplay/GetState (hop2)
2693|            // runs during Swim. Suit/juice no longer gate sampling (HPM FixedTick L13), but a
2694|            // missed TryRegisterFixedTickable still starves the entire locomotion read path.
2695|            // Fully-qualify type: editor asm has no using Hecton8.Gameplay (CS0246 on bare name).
2696|            Hecton8.Gameplay.HectonPlayerMovement movement =
2697|                _movement
2698|                ?? UnityEngine.Object.FindFirstObjectByType<Hecton8.Gameplay.HectonPlayerMovement>();
2699|            if (movement != null)
2700|            {
2701|                movement.EnsureDispatcherRegistration();
2702|                if (_movement == null)
2703|                    _movement = movement;
2704|            }
2705|        }
2706|
2707|        private static void TickSettle()
2708|        {
2709|            IPlayerRuntimeContext player = GlobalRegistry.RegisteredPlayer;
2710|            if (player != null)
2711|            {
2712|                if (_survival == null)
2713|                    _survival = player.SurvivalSystem;
2714|                if (_movement == null)
2715|                    _movement = player.PlayerMovement;
2716|                if (_toolManager == null)
2717|                    _toolManager = player.ToolManager;
2718|            }
2719|
2720|            TryResolveInteraction();
2721|
2722|            // Force-close any leftover menu (PDA/Fab/Pause) and re-assert the player action map
2723|            // every settle tick. L10 measured hop2-starve: SampleGameplayLocomotionInputForFixedStep
2724|            // short-circuits on IsGameplayInputBlockedByMenu without calling GetState, and a single
2725|            // SwitchToPlayerInput at first settle loses to later SwitchToUIInput (MainMenu bind,
2726|            // sticky IsOpen). Product close APIs only ? no mock input path.
2727|            EnsureGameplayLocomotionInputReady();
2728|            IInputService input = GlobalRegistry.RegisteredInput;
2729|
2730|            bool ready = _survival != null && _movement != null && input != null;
2731|            if (!ready)
2732|            {
2733|                // Named PER GATE rather than as one "not ready", for the same reason the three booleans this
2734|                // row used to print were replaced: an empty registry slot and an unassembled player root are
2735|                // different defects with different owners.
2736|                _waitReason = input == null
2737|                    ? WaitReason.InputServiceNotRegistered
2738|                    : WaitReason.PlayerOwnersNotRegistered;
2739|
2740|                if (!PhaseCeilingReached())
2741|                    return;
2742|            }
2743|
2744|            if (!ready)
2745|            {
2746|                LatchSettleBlocked(input);
2747|                EnterPhase(DrivePhase.ResourceTarget, CeilingYield());
2748|                return;
2749|            }
2750|
2751|            _oxygenAtStart = _survival.Oxygen;
2752|            _pressureAtStart = _survival.Pressure;
2753|            _swimBaselineTaken = true;
2754|            EnterPhase(DrivePhase.SwimSurface, PhaseYield.Completed);
2755|        }
2756|
2757|        /// <summary>
2758|        /// Names the gate the settle phase died on. The previous version printed three bare booleans and
2759|        /// the third one, labelled "inputService", was the presence check - so a missing service and a
2760|        /// closed action map produced the SAME text and two cycles of work aimed at the wrong mechanism.
2761|        /// Every branch below states the mechanism and where its owner lives, because a row detail that
2762|        /// cannot be acted on is not a diagnostic.
2763|        ///
2764|        /// Runs at most once per run: the caller only reaches it after the settle budget expires, and Latch
2765|        /// refuses a second write to a latched row.
2766|        /// </summary>
2767|        private static void LatchSettleBlocked(IInputService input)
2768|        {
2769|            _detail.Clear();
2770|            _detail.Append("no drivable player after ").Append(F(PhaseElapsed))
2771|                .Append("s: survival=").Append(_survival != null)
2772|                .Append(" movement=").Append(_movement != null)
2773|                .Append(" inputServiceRegistered=").Append(input != null)
2774|                .Append(" inputEnabled=").Append(_inputEnabledEverObserved)
2775|                .Append(" switchToPlayerInputCalled=").Append(_switchedToPlayerInput)
2776|                .Append(" blockMask=0x").Append(_inputBlockMaskLast.ToString("X8", CultureInfo.InvariantCulture));
2777|
2778|            if (input == null)
2779|            {
2780|                _detail.Append(" - BLOCKER GATE 1 (service absent, NOT disabled): GlobalRegistry's Input ")
2781|                    .Append("slot is empty, so IsPlayerInputEnabled was never reachable and the leading ")
2782|                    .Append("null check in HectonPlayerInputHandler.cs:37 rejected every frame. The slot's ")
2783|                    .Append("only producer is GameBootstrapper.EnsureInputDispatcherRegistered ")
2784|                    .Append("(GameBootstrapper.cs:6309), which runs once in BootstrapPhase.Player - if the ")
2785|                    .Append("dispatcher it creates does not outlive the scene it was created in, ")
2786|                    .Append("OnDestroy -> TryUnregisterInputService empties the slot and nothing refills it");
2787|            }
2788|            else if (!_inputEnabledEverObserved)
2789|            {
2790|                _detail.Append(" - BLOCKER GATE 2 (service present, map closed): SwitchToPlayerInput was ")
2791|                    .Append("invoked on the registered service and IsPlayerInputEnabled still never read ")
2792|                    .Append("true, so InputManager.EnablePlayerInput did not leave the Player action map ")
2793|                    .Append("enabled (InputManager.cs:1019 and :277). Nothing this driver may legitimately ")
2794|                    .Append("do can open that gate - the owner has to");
2795|            }
2796|            else
2797|            {
2798|                _detail.Append(" - BLOCKER: the input route was OPEN; the missing owner is a player ")
2799|                    .Append("component (HectonSurvivalSystem / HectonPlayerMovement off ")
2800|                    .Append("GlobalRegistry.RegisteredPlayer), not input");
2801|            }
2802|
2803|            AppendPhaseCeilingNote();
2804|            Latch(RowSwim, RowVerdict.Blocked);
2805|        }
2806|
2807|        /// <summary>
2808|        /// Deterministic yaw sweep for the locomotion phases.
2809|        /// </summary>
2810|        /// <remarks>
2811|        /// LookDelta was hardwired to Vector2.zero in every phase, so the driver never turned the camera and
2812|        /// content discovery was confined to whatever the spawn orientation happened to face.
2813|        /// TryAdoptNearbyWorldNode gates on ExistingNodeMinForwardDot 0.5 - a 60 degree half-cone - within
2814|        /// ExistingNodeMaxDistanceMeters 3.5, and PlayerInteraction's hover raycast follows the same camera.
2815|        /// A node four metres away or seventy degrees off-axis was invisible, which is why the harness had to
2816|        /// register its own scatter point 1.75 m dead ahead to make the Resource row reachable at all: the
2817|        /// success path was content the driver placed for itself.
2818|        ///
2819|        /// Derived from the tick counter, never from a clock or Random, so two runs sweep identically -
2820|        /// determinism is already fragile enough on this lane without the driver adding to it. One full
2821|        /// revolution per 120 ticks at 3 degrees each, applied as a per-tick yaw delta because LookDelta is
2822|        /// a mouse-style delta rather than an absolute angle. Pitch stays zero: the vertical axis is driven
2823|        /// through VerticalDelta, and pitching the camera would fight the immersion and depth sampling the
2824|        /// Swim row measures.
2825|        /// </remarks>
2826|        private static Vector2 SweepLookDelta()
2827|        {
2828|            return new Vector2(SweepYawDegreesPerTick, 0f);
2829|        }
2830|
2831|        private static void TickSwimSurface()
2832|        {
2833|            // Keep menus closed and player map enabled for the whole hold. One-shot settle is not
2834|            // enough if anything re-opens UI mid-window (L10: hop2 never fired).
2835|            EnsureGameplayLocomotionInputReady();
2836|
2837|            // Forward plus ascend. VerticalDelta is the surface/dive axis
2838|            // (HectonPlayerInputHandler.cs:37-53 reads it straight off the snapshot).
2839|            _intent.MoveDelta = new Vector2(0f, 1f);
2840|            _intent.LookDelta = SweepLookDelta();
2841|            _intent.VerticalDelta = 1f;
2842|            _intent.ActionsBitmask = 0u;
2843|            _intent.CurrentInputSchemeHash = 0u;
2844|
2845|            // A hold is not blocked on anything, and saying so explicitly matters: without it a hold would
2846|            // report the previous phase's reason, and a reader would chase a precondition on a phase whose
2847|            // only job is to occupy wall time.
2848|            _waitReason = WaitReason.LocomotionHoldInProgress;
2849|
2850|            if (PhaseCeilingReached())
2851|                EnterPhase(DrivePhase.SwimDive, HoldYield());
2852|        }
2853|
2854|        private static void TickSwimDive()
2855|        {
2856|            EnsureGameplayLocomotionInputReady();
2857|
2858|            _intent.MoveDelta = new Vector2(0f, 1f);
2859|            _intent.LookDelta = SweepLookDelta();
2860|            _intent.VerticalDelta = -1f;
2861|            _intent.ActionsBitmask = (uint)PlayerInputAction.Sprint;
2862|            _intent.CurrentInputSchemeHash = 0u;
2863|            _waitReason = WaitReason.LocomotionHoldInProgress;
2864|
2865|            if (PhaseCeilingReached())
2866|            {
2867|                // Do not clear _intent here: Tick publishes after AdvancePhase, so the last dive
2868|                // frame must still ship MoveDelta. Non-authoring phases clear after publish.
2869|                EnterPhase(DrivePhase.SwimVerdict, HoldYield());
2870|            }
2871|        }
2872|
2873|        /// <summary>
2874|        /// Swim row acceptance. Three independent facts, and the row only passes when all three hold:
2875|        ///   1. the driver's MoveDelta reached the locomotion owner (CurrentMovementIntent01 moved),
2876|        ///   2. depth actually spanned a range (surface AND dive happened, not just one),
2877|        ///   3. oxygen/pressure were readable and moved, corroborated by the vitals lane.
2878|        /// Anything less is Partial or Blocked with the measured numbers attached, because "the harness
2879|        /// ran" is not the same claim as "the route is proven".
2880|        /// </summary>