2620|        /// <summary>
2621|        /// Waits for the owners the rows are judged against, then opens the gameplay input map through
2622|        /// the real entry point the UI layer uses when a menu closes.
2623|        ///
2624|        /// THREE INDEPENDENT GATES stand between this driver and locomotion, and collapsing them into one
2625|        /// boolean is exactly how this front stayed mis-diagnosed for a cycle - a row that printed
2626|        /// "inputService=False" was read as "input is disabled" when it meant "there is no input service
2627|        /// at all":
2628|        ///   GATE 1, service presence. GlobalRegistry.RegisteredInput (GlobalRegistry.cs:949) is the RAW
2629|        ///     slot and returns null when nothing is registered; it does not substitute the NoOp proxy the
2630|        ///     way GlobalRegistry.Input does. Every consumer null-checks it before anything else
2631|        ///     (HectonPlayerInputHandler.cs:37, HectonPlayerMovement.cs:7992, PlayerToolManager.cs:414), so
2632|        ///     a null slot suppresses input for a reason that has nothing to do with action maps.
2633|        ///   GATE 2, IInputService.IsPlayerInputEnabled. Resolves to
2634|        ///     _nativeInputManager.IsPlayerInputEnabled (InputDispatcher.cs:409) and from there to
2635|        ///     InputActionMap.enabled (InputManager.cs:277). SwitchToPlayerInput below is the same public
2636|        ///     entry PauseMenuController.cs:728 and HectonFabricatorUI.cs:644 use when a menu closes - the
2637|        ///     driver opens the gate the way a human's first input does, and never forces the flag or reads
2638|        ///     past it.
2639|        ///   GATE 3, the input block mask, sampled in SampleObservables and printed with the Swim row. It
2640|        ///     zeroes the folded override AFTER both gates above are open (InputDispatcher.cs:3060), so a
2641|        ///     nonzero mask is a third, separately named failure.
2642|        /// A settle that gives up now names the gate that was shut instead of printing one ambiguous flag.
2643|        /// </summary>
2644|
2645|        /// <summary>
2646|        /// Product-correct locomotion readiness for scripted swim/route holds:
2647|        /// force-close PDA / fabricator / pause via their real close APIs (restoring player maps),
2648|        /// then always SwitchToPlayerInput. Called every settle and swim hold tick so a mid-window
2649|        /// SwitchToUIInput or sticky IsOpen cannot starve hop2 (GetState) for the whole phase.
2650|        /// </summary>
2651|        private static void EnsureGameplayLocomotionInputReady()
2652|        {
2653|            // PDA ? public ForceClose restores player input map.
2654|            if (Hecton8.UI.PlayerPDA.IsOpen)
2655|            {
2656|                Hecton8.UI.PlayerPDA pda = Hecton8.UI.PlayerPDA.ActiveRuntimeInstance;
2657|                if (pda == null)
2658|                {
2659|                    IPlayerRuntimeContext player = GlobalRegistry.RegisteredPlayer;
2660|                    if (player != null)
2661|                        pda = player.PlayerPDA as Hecton8.UI.PlayerPDA;
2662|                }
2663|
2664|                if (pda != null)
2665|                    pda.ForceClose();
2666|            }
2667|
2668|            // Pause ? public Close -> ApplyClosedState(restorePlayerInput: true).
2669|            if (Hecton8.UI.PauseMenuController.IsAnyOpen)
2670|            {
2671|                Hecton8.UI.PauseMenuController pause = Hecton8.UI.PauseMenuController.ActiveRuntimeInstance;
2672|                if (pause != null)
2673|                    pause.Close();
2674|            }
2675|
2676|            // Fabricator ? public ForceCloseMenu (product API added for this path).
2677|            if (Hecton8.UI.HectonFabricatorUI.IsMenuOpen)
2678|            {
2679|                Hecton8.UI.HectonFabricatorUI fab =
2680|                    UnityEngine.Object.FindFirstObjectByType<Hecton8.UI.HectonFabricatorUI>();
2681|                if (fab != null)
2682|                    fab.ForceCloseMenu();
2683|            }
2684|
2685|            IInputService input = GlobalRegistry.RegisteredInput;
2686|            if (input != null)
2687|            {
2688|                input.SwitchToPlayerInput();
2689|                _switchedToPlayerInput = true;
2690|            }
2691|
2692|            // L13: Re-assert HPM Player fixed-tick registration so SampleGameplay/GetState (hop2)
2693|            // runs during Swim. Suit/juice no longer gate sampling (HPM FixedTick L13), but a
2694|            // missed TryRegisterFixedTickable still starves the entire locomotion read path.
2695|            // Fully-qualify type: editor asm has no using Hecton8.Gameplay (CS0246 on bare name).
2696|            Hecton8.Gameplay.HectonPlayerMovement movement =
2697|                _movement
2698|                ?? UnityEngine.Object.FindFirstObjectByType<Hecton8.Gameplay.HectonPlayerMovement>();
2699|            if (movement != null)
2700|            {
2701|                movement.EnsureDispatcherRegistration();
2702|                if (_movement == null)
2703|                    _movement = movement;
2704|            }
2705|        }
