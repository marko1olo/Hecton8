8000|        /// GlobalRegistry.Register only queues that hot-swap callback when the slot ALREADY held a service
8001|        /// (GlobalRegistry.cs:7352-7353), so a FIRST registration into an empty Input slot notifies nobody.
8002|        /// Any player that resolved input while the slot was empty got GlobalRegistry.Input's non-null
8003|        /// NoOpInputService null object (GlobalRegistry.cs:920-936) and kept it for the whole session -
8004|        /// its IsPlayerInputEnabled is a hardcoded false (GlobalRegistry.cs:8431) and its GetState()
8005|        /// returns default (:8450), which sends ProcessPlayerInputFrame (:8079) down its else branch every
8006|        /// render tick, zeroing _inputH/_inputV/_inputVertical and therefore the intent vector published at
8007|        /// :10019. The InputDispatcher's own history says this window is real: its Input slot has already
8008|        /// been observed emptied by a scene transition (InputDispatcher.cs:2838-2863).
8009|        ///
8010|        /// RegisteredInput is the raw slot (GlobalRegistry.cs:949) and never substitutes the null object, so
8011|        /// binding off it cannot latch onto a service that is disabled by construction; a null slot leaves
8012|        /// _inputManager null, which every consumer here already null-checks, and the next call rebinds.
8013|        /// Cost is one static field read plus two ReferenceEquals - this method already ran every render
8014|        /// tick through PrepareRenderTickDependencies (:4722), it just returned early.
8015|        /// </summary>
8016|        private void ResolveInputManagerBinding()
8017|        {
8018|            IInputService currentManager = GlobalRegistry.RegisteredInput;
8019|            _inputServiceRuntime = currentManager;
8020|            if (_resolvedInputManager &&
8021|                ReferenceEquals(_inputManager, currentManager) &&
8022|                ReferenceEquals(_subscribedInputManager, currentManager))
8023|            {
8024|                return;
8025|            }
8026|
8027|            UnsubscribeFromInput();
8028|            _inputManager = currentManager;
8029|            _resolvedInputManager = true;
8030|            SubscribeToInput();
8031|        }
