8076|        public void Tick(float deltaTime)
8077|        {
8078|            SuitData suit = currentSuitData;
8079|            if (suit == null) return;
8080|            if (_juiceProcessor == null) return;
8081|
8082|            using (_tickProfilerMarker.Auto())
8083|            {
8084|                _currentRenderDeltaTime = math.max(0.0001f, deltaTime);
8085|                RefreshVrComfortSettingsCache();
8086|                PrepareRenderTickDependencies();
8087|                if (ConsumeInventoryLoadSignals())
8088|                    HandleInventoryLoadChanged();
8089|
8090|                DrainNarrativeFocusSignals();
8091|                AdvanceCinematicFocus(deltaTime);
8092|                if (_activeSonarPingCooldownTimer > 0f)
8093|                {
8094|                    _activeSonarPingCooldownTimer -= deltaTime;
8095|                    if (_activeSonarPingCooldownTimer < 0f)
8096|                        _activeSonarPingCooldownTimer = 0f;
8097|                }
8098|
8099|                if (IsGameplayInputBlockedByMenu())
8100|                {
8101|                    HandleMenuBlockedInput(deltaTime, suit);
8102|                    return;
8103|                }
8104|
8105|                if (_inputCleared || Cursor.lockState != CursorLockMode.Locked)
8106|                {
8107|                    Cursor.lockState = CursorLockMode.Locked;
8108|                    Cursor.visible = false;
8109|                    _inputCleared = false;
8110|                }
8111|
8112|                ProcessPlayerInputFrame();
8113|                ProcessWipeoutInputOverride();
8114|                ProcessLocomotionPresentationAndJuice(deltaTime, suit);
8115|            }
8116|        }
8117|
8118|        private void HandleMenuBlockedInput(float deltaTime, SuitData suit)
8119|        {
8120|            _currentInputState = default;
8121|            _pendingLookInput = Vector2.zero;
8122|            _inputH = 0f; _inputV = 0f; _inputVertical = 0f; _mouseXDelta = 0f;
8123|            SetSprintingState(false);
8124|            _inputCleared = true;
8125|            _lastKinematicRepairProbe = default;
8126|            _lastKinematicRepairSnapPoint = default;
8127|            _kinematicRepairStateBits &= ~KinematicRepairStateHasSnapBit;
8128|            ResetKinematicRepairProbeReuseGate();
8129|            Cursor.lockState = CursorLockMode.None;
8130|            Cursor.visible = true;
8131|            UpdateRenderInterpolationState();
8132|            BuildJuiceInput(deltaTime, suit);
8133|            _juiceOutput = _juiceProcessor.Process(in _juiceInput, suit);
8134|            UpdateUnderwaterSomaticCameraOffsets(deltaTime);
8135|            ApplyCameraState();
8136|            UpdateVrComfortSignals(deltaTime, Vector3.zero, 0f);
8137|        }
8138|
8139|        private void ProcessPlayerInputFrame()
8140|        {
8141|            if (_inputManager != null && _inputManager.IsPlayerInputEnabled)
8142|            {
8143|                _inputHandler.TryReadFrame(
8144|                    _inputManager,
8145|                    jumpBufferTime,
8146|                    out HectonPlayerInputFrame inputFrame,
8147|                    out bool jumpBuffered);
8148|                _currentInputState = inputFrame.State;
8149|                _cachedMoveInput = inputFrame.MoveInput;
8150|                _cachedVerticalInput = inputFrame.VerticalInput;
8151|                _pendingLookInput = inputFrame.LookInput;
8152|                if (jumpBuffered)
8153|                {
8154|                    _jumpRequested = true;
8155|                    _jumpBufferTimer = jumpBufferTime;
8156|                }
8157|
8158|                Vector2 lookDelta = _pendingLookInput;
8159|                _pendingLookInput = Vector2.zero;
8160|                ApplyLookInput(lookDelta);
8161|
8162|                _inputH = _cachedMoveInput.x;
8163|                _inputV = _cachedMoveInput.y;
8164|                _inputVertical = _isWalking ? 0f : ResolveVerticalInput();
8165|                if (IsAuthoritativeVehicleTransportActive())
8166|                {
8167|                    _inputH = 0f;
8168|                    _inputV = 0f;
8169|                    _inputVertical = 0f;
8170|                }
8171|                SetSprintingState(inputFrame.SprintHeld != 0);
8172|            }
8173|            else
8174|            {
8175|                _currentInputState = default;
8176|                _pendingLookInput = Vector2.zero;
8177|                _inputH = 0f;
8178|                _inputV = 0f;
8179|                _inputVertical = 0f;
8180|                SetSprintingState(false);
8181|                _mouseXDelta = 0f;
8182|            }
8183|        }
8184|
8185|        private void ProcessWipeoutInputOverride()
8186|        {
8187|            if (_wipeoutTimer > 0f || _fatalPressureSequenceTimer > 0f)
8188|            {
8189|                _currentInputState = default;
8190|                _pendingLookInput = Vector2.zero;
8191|                _mouseXDelta = 0f;
8192|                _inputH = 0f;
8193|                _inputV = 0f;
8194|                _inputVertical = 0f;
8195|                SetSprintingState(false);
8196|                _jumpRequested = false;
8197|                _jumpBufferTimer = 0f;
8198|            }
8199|        }
8200|
8201|        /// <summary>
8202|        /// Samples MoveDelta / vertical / sprint into the fixed-step locomotion fields that
8203|        /// <see cref="ResolveRawInputIntentVector"/> and swim thrust read.
8204|        ///
8205|        /// WHY THIS EXISTS ON FixedTick. ProcessPlayerInputFrame historically ran only from the
8206|        /// render IUpdatable.Tick path. Batchmode and physics-heavy schedules (headless V0 probe,
8207|        /// long fixed steps) drive locomotion almost entirely through FixedTick while render Tick
8208|        /// rarely runs, so _inputH/_inputV/_inputVertical stayed zero even when InputDispatcher
8209|        /// had already published a non-zero MoveDelta (L08: publishOk>0, movementIntent01max=0,
8210|        /// final readHop=0). Sampling here keeps kinematics authoritative on the fixed step without
8211|        /// mocking input or bypassing menu / vehicle / wipeout gates.
8212|        ///
8213|        /// Look / juice / cursor remain render-owned on Tick. Menu block zeros locomotion only -
8214|        /// full HandleMenuBlockedInput stays on Tick so camera/cursor presentation is not driven
8215|        /// from the physics step.
8216|        /// </summary>
8217|        private void SampleGameplayLocomotionInputForFixedStep()
8218|        {
8219|            ResolveInputManagerBinding();
8220|
8221|            if (IsGameplayInputBlockedByMenu())
8222|            {
8223|                _currentInputState = default;
8224|                _pendingLookInput = Vector2.zero;
8225|                _inputH = 0f;
8226|                _inputV = 0f;
8227|                _inputVertical = 0f;
8228|                _mouseXDelta = 0f;
8229|                SetSprintingState(false);
8230|                return;
8231|            }
8232|
8233|            ProcessPlayerInputFrame();
8234|            ProcessWipeoutInputOverride();
8235|        }
8236|
8237|        private void ProcessLocomotionPresentationAndJuice(float deltaTime, SuitData suit)
8238|        {
8239|            ConsumeKinematicRepairTargetProbe();
8240|            ScheduleKinematicRepairTargetProbe();
8241|            UpdateRenderInterpolationState();
8242|            _feedbackVelocity = ResolveFeedbackVelocity(_renderInterpolatedLinearVelocity);
8243|            _velocity = _feedbackVelocity;
8244|            float currentSpeed = ApproximateVectorMagnitude(_velocity);
8245|            float renderCameraYaw = CameraYaw;
8246|            float yawDelta = DeltaAngleDegrees(_prevYawForMomentum, renderCameraYaw);
8247|            UpdateVrComfortSignals(deltaTime, _velocity, yawDelta);
8248|
8249|            if (_swimPresentationController != null)
8250|            {
8251|                _swimPresentationController.SyncFromLocomotion(deltaTime, true);
8252|                _debugLastSwimPresentationDriveFrame = SystemDispatcher.CurrentFrameIndex;
8253|            }
8254|
8255|            BuildJuiceInput(deltaTime, suit);
8256|            _juiceInput.speedDelta = currentSpeed - _prevSpeed;
8257|            _juiceInput.yawDelta = yawDelta;
8258|            _juiceOutput = _juiceProcessor.Process(in _juiceInput, suit);
8259|
8260|            _prevSpeed = currentSpeed;
8261|            _prevYawForMomentum = renderCameraYaw;
8262|
8263|            if (_juiceOutput.stepEvent != 0)
8264|            {
8265|                PublishPlayerFootstepSignal();
8266|                TryEmitSurfaceFootstepAudio();
8267|                EmitExosuitFootstepSeismicPing();
8268|                UpdateStepDiagnostics();
8269|            }
8270|
8271|            if (_juiceProcessor.SplashThisFrame)
8272|            {
8273|                PublishPlayerWaterSplashSignal(
8274|                    _juiceProcessor.SplashIntensity,
8275|                    _juiceProcessor.IsSubmerged,
8276|                    EffectiveWaterSurfaceY,
8277|                    math.abs(ResolveAuthoritativeLinearVelocity(Vector3.zero).y));
8278|                PublishWaterTransitionSignal(
8279|                    WaterTransitionKind.Splash,
8280|                    _juiceProcessor.IsSubmerged,
8281|                    _juiceProcessor.SplashIntensity,
8282|                    EffectiveWaterSurfaceY,
8283|                    math.abs(ResolveAuthoritativeLinearVelocity(Vector3.zero).y));
8284|            }
8285|
8286|            if (_juiceProcessor.SubmergeChangedThisFrame)
8287|            {
8288|                PublishWaterTransitionSignal(
8289|                    WaterTransitionKind.SubmergeChanged,
8290|                    _juiceProcessor.IsSubmerged,
8291|                    _juiceProcessor.IsSubmerged ? 1f : 0.65f,
8292|                    EffectiveWaterSurfaceY,
8293|                    math.abs(ResolveAuthoritativeLinearVelocity(Vector3.zero).y));
8294|            }
8295|
8296|            if (_juiceProcessor.ExhaleThisFrame)
8297|            {
8298|                PublishPlayerExhaleSignal();
8299|            }
8300|