8052|        private void SeedInputStateFromService(IInputService inputService)
8053|        {
8054|            if (inputService == null || !inputService.IsPlayerInputEnabled)
8055|            {
8056|                _currentInputState = default;
8057|                _cachedMoveInput = Vector2.zero;
8058|                _cachedVerticalInput = 0f;
8059|                _pendingLookInput = Vector2.zero;
8060|                SetSprintingState(false);
8061|                return;
8062|            }
8063|
8064|            _inputHandler.TryReadFrame(inputService, jumpBufferTime, false, out HectonPlayerInputFrame frame, out _);
8065|            _currentInputState = frame.State;
8066|            _cachedMoveInput = frame.MoveInput;
8067|            _cachedVerticalInput = frame.VerticalInput;
8068|            _pendingLookInput = Vector2.zero;
8069|            SetSprintingState(frame.SprintHeld != 0);
8070|        }
