8037|        private void SetSprintingState(bool isSprinting)
8038|        {
8039|            if (isSprinting)
8040|            {
8041|                float stamina = _survivalSystem != null ? _survivalSystem.EnergyNormalized : 1f;
8042|                isSprinting = Hecton8.PureLogic.Kinematics.SprintStaminaGate.EvaluateGate(stamina, 0.25f, 0.05f, _isSprinting);
8043|            }
8044|
8045|            if (_isSprinting == isSprinting)
8046|                return;
8047|
8048|            _isSprinting = isSprinting;
8049|            PublishPlayerSprintStateSignal(isSprinting);
8050|        }
