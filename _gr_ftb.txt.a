6535|        /// <summary>
6536|        /// Registers a fixed-update owner into both the global bucket and its fixed dispatcher lane.
6537|        /// </summary>
6538|        /// <param name="item">Fixed-update owner.</param>
6539|        /// <param name="layer">Dispatcher priority lane.</param>
6540|        /// <returns>True when both registry and dispatcher lane accepted the item.</returns>
6541|        public static bool TryRegisterFixedTickable(IFixedTickable item, PriorityLayer layer)
6542|        {
6543|            if (item == null)
6544|                return false;
6545|
6546|            if (!Application.isPlaying)
6547|                return false;
6548|
6549|            if (!TryEnsureDispatcherRegistration())
6550|                return false;
6551|            if (!_fixedTickables.TryRegister(item))
6552|                return false;
6553|
6554|            if (!SystemDispatcher.Register(item, layer))
6555|            {
6556|                _fixedTickables.Unregister(item);
6557|                return false;
6558|            }
6559|
6560|            return true;
6561|        }
