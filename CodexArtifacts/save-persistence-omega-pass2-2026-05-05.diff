+            return (((ulong)sectorHash) & mask) == prefix;
+        }
+
+        private static void WriteArtifact(
+            bool pass,
+            bool predictiveProjectionPass,
+            bool nanRejectionPass,
+            bool subtractionBoundsValidPass,
