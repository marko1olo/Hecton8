+    internal static bool ReleaseVoxelPhysicsBakeMesh(Mesh mesh)
+    {
+        if (mesh == null)
+            return false;
+
+        for (int i = 0; i < _voxelPhysicsBakeMeshPool.Length; i++)
+        {
+            if (!ReferenceEquals(_voxelPhysicsBakeMeshPool[i], mesh))
+                continue;
+
+            mesh.Clear(false);
+            _voxelPhysicsBakeMeshPoolInUse[i] = false;
+            return true;
+        }
+
+        return false;
+    }
