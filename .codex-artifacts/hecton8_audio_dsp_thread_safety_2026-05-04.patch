+                AcousticOcclusionUtility.MinimumLowPassCutoffHertz,
+                AcousticOcclusionUtility.OpenLowPassCutoffHertz);
+            float snapExcitation = math.saturate(audible01 * 0.42f);
+            float echoExcitation = math.saturate(audible01 * 0.55f);
