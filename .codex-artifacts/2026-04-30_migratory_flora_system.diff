+        private static bool ExceedsFloraChunkHardCap(
+            int candidateCellX,
+            int candidateCellZ,
+            int hardCap,
+            NativeParallelMultiHashMap<int, int> metadataBuckets,
+            NativeArray<ScatterPlacementSpatialMetadata> spatialMetadata)
+        {
