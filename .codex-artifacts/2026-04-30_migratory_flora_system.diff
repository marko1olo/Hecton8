+            public void Execute(int index)
+            {
+                if (index < 0 || index >= NodeCount || index >= Nodes.Length)
+                    return;
+
+                ParasiteNode node = Nodes[index];
+                if (node.State == ParasiteNodeStateDead)
+                    return;
+
+                float defoliant = SampleDefoliant(node.PositionWS);
