+                BaseModule module = modules[i];
+                if (module == null)
+                    continue;
+
+                if (!module.TryGetInteriorHazardBounds(out Vector3 worldCenter, out float radius))
+                    continue;
+
+                if ((runtimePosition - worldCenter).sqrMagnitude <= radius * radius)
+                    return true;
+            }
+
+            return false;
+        }
