+            waitFrames++;
+            try
+            {
+                await Awaitable.NextFrameAsync(cancellationToken: ct);
+            }
+            catch (OperationCanceledException)
+            {
+                EnqueueDeferredVoxelPhysicsBakeTeardown(handle, mesh, owner, renderer, collider, flags);
+                return false;
+            }
+        }
