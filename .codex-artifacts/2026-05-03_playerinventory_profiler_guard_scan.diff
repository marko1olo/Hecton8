+    $endIndex = [Math]::Min($Lines.Length - 1, $StartIndex + $WindowLength - 1)
+    $builder = [System.Text.StringBuilder]::new()
+    for ($i = $StartIndex; $i -le $endIndex; $i++) {
+        [void]$builder.Append($Lines[$i])
+        [void]$builder.Append(' ')
+    }
+
+    return $builder.ToString()
