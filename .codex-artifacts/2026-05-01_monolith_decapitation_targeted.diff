+        /// <summary>
+        /// Returns the current terrain-hole streaming payload for cave and interior streaming consumers.
+        /// </summary>
+
+        private void RebuildHLODRegistrySnapshot()
+        {
+            CompleteHLODCullJob(forceComplete: false);
+            if (_hlodCullScheduled)
+                return;
+
