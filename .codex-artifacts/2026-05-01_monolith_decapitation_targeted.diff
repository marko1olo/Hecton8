+                if (!foundPath)
+                    return;
+
+                Path.AddNoResize(new Vector3(EndPosition.x, EndPosition.y, EndPosition.z));
+                int nodeIndex = EndNode;
+                int pathIterations = 0;
+                while (nodeIndex >= 0 && pathIterations < MaxPathReconstructionIterations)
+                {
+                    pathIterations++;
