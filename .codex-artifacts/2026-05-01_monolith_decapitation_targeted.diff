+                    return;
+                }
+
+                OutputPath.AddNoResize(InputPath[0]);
+
+                int apexIndex = 0;
+                int leftIndex = 0;
+                int rightIndex = 0;
+                float3 apex = ToFloat3(InputPath[0]);
+                float3 left = apex;
+                float3 right = apex;
+                float3 fallbackAxis = ResolvePortalAxis(0);
