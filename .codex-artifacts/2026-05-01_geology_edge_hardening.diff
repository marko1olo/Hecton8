+            runtimeBounds.Encapsulate(cachedTransform.TransformPoint(new Vector3(min.x, max.y, min.z)));
+            runtimeBounds.Encapsulate(cachedTransform.TransformPoint(new Vector3(max.x, max.y, min.z)));
