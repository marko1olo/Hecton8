+    if (dot(vortexDirection, vortexDirection) <= EPSILON)
+        vortexDirection = float3(1.0, 0.0, 0.0);
+
+    return SafeNormalize((chaos * 0.65) + (radialDirection * 0.55) + (vortexDirection * 0.85));
