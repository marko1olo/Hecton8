5293|        private bool ConsumeInventoryLoadSignals()
5294|        {
5295|            RefreshInventoryLoadSignalFilter();
5296|            uint inventoryHash = _inventoryLoadSignalHash;
5297|            if (inventoryHash == 0u)
5298|                return false;
5299|
5300|            bool changed = false;
5301|            System.ReadOnlySpan<InventoryChangedSignal> signals = SignalBus<InventoryChangedSignal>.GetFrameSnapshot();
5302|            for (int i = 0; i < signals.Length; i++)
5303|            {
5304|                ref readonly InventoryChangedSignal signal = ref signals[i];
5305|                if (signal.InventoryHash != inventoryHash ||
5306|                    signal.Revision == 0u ||
5307|                    (_lastInventoryLoadSignalRevision != 0u && signal.Revision <= _lastInventoryLoadSignalRevision))
5308|                {
5309|                    continue;
5310|                }
5311|
5312|                _lastInventoryLoadSignalRevision = signal.Revision;
5313|                changed = true;
5314|            }
5315|
5316|            return changed;
5317|        }
