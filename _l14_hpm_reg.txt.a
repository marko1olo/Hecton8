5094|        private void CaptureLegacyCollisionContacts(Collision collision)
5095|        {
5096|            if (collision == null ||
5097|                HectonFloatingOrigin.IsShiftInProgress)
5098|            {
5099|                return;
5100|            }
5101|
5102|            int layerMask = ResolveMovementGroundLayerMask();
5103|            if (layerMask == 0)
5104|                return;
5105|
5106|            int contactCount = collision.GetContacts(_collisionContactBuffer);
5107|            if (contactCount <= 0)
5108|                return;
5109|
5110|            if (_legacyCollisionProbeShiftSequence != HectonFloatingOrigin.CurrentShiftSequence)
5111|                ResetLegacyCollisionProbeHits();
5112|
5113|            int currentFrame = SystemDispatcher.CurrentFrameIndex;
5114|            int safeContactCount = math.min(contactCount, _collisionContactBuffer.Length);
5115|            for (int i = 0; i < safeContactCount; i++)
5116|            {
5117|                ContactPoint contact = _collisionContactBuffer[i];
5118|                Collider hitCollider = ResolveOtherCollisionCollider(in contact, collision.collider);
5119|                if (hitCollider == null)
5120|                    continue;
5121|
5122|                int hitColliderId = unchecked((int)EntityId.ToULong(hitCollider.GetEntityId()));
5123|                if (hitColliderId == 0 || hitColliderId == _playerColliderInstanceId)
5124|                    continue;
5125|
5126|                int layerBit = 1 << hitCollider.gameObject.layer;
5127|                if ((layerMask & layerBit) == 0)
5128|                    continue;
5129|
5130|                Vector3 point = contact.point;
5131|                Vector3 normal = ResolveCollisionContactNormal(point, contact.normal);
5132|                if (!IsFiniteVector(point) || !IsFiniteVector(normal))
5133|                    continue;
5134|
5135|                int writeIndex = ResolveLegacyCollisionProbeWriteIndex(hitColliderId, currentFrame);
5136|                if (writeIndex < 0)
5137|                    continue;
5138|
5139|                float downwardDistance = math.max(0f, _groundCheckOrigin.y - point.y);
5140|                _legacyCollisionProbeHitBuffer[writeIndex] = new PlayerMovementSurfaceHit
5141|                {
5142|                    point = HectonPlayerMotor.SafeVelocity(point, _fixedFrameBodyPosition),
5143|                    normal = NormalizeVectorRsqrt(normal, Vector3.up),
5144|                    distance = downwardDistance,
5145|                    collider = hitCollider,
5146|                    ColliderInstanceId = hitColliderId
5147|                };
5148|                _legacyCollisionProbeFrameBuffer[writeIndex] = currentFrame;
5149|                _legacyCollisionProbeFrame = currentFrame;
5150|                _legacyCollisionProbeShiftSequence = HectonFloatingOrigin.CurrentShiftSequence;
5151|            }
5152|        }
5153|
5154|        private int ResolveLegacyCollisionProbeWriteIndex(int colliderInstanceId, int currentFrame)
5155|        {
5156|            if (colliderInstanceId == 0)
5157|                return -1;
5158|
5159|            int count = math.min(_legacyCollisionProbeHitCount, _legacyCollisionProbeHitBuffer.Length);
5160|            int staleIndex = -1;
5161|            int oldestIndex = count > 0 ? 0 : -1;
5162|            int oldestFrame = count > 0 ? _legacyCollisionProbeFrameBuffer[0] : int.MaxValue;
5163|
5164|            for (int i = 0; i < count; i++)
5165|            {
5166|                if (GetHitColliderInstanceId(in _legacyCollisionProbeHitBuffer[i]) == colliderInstanceId)
5167|                    return i;
5168|
5169|                int sampleFrame = _legacyCollisionProbeFrameBuffer[i];
5170|                int age = currentFrame - sampleFrame;
5171|                if ((age < 0 || age > KinematicContactMaxAgeFrames) && staleIndex < 0)
5172|                    staleIndex = i;
5173|
5174|                if (sampleFrame < oldestFrame)
5175|                {
5176|                    oldestFrame = sampleFrame;
5177|                    oldestIndex = i;
5178|                }
5179|            }
5180|
5181|            if (staleIndex >= 0)
5182|                return staleIndex;
5183|
5184|            if (count < _legacyCollisionProbeHitBuffer.Length)
5185|            {
5186|                _legacyCollisionProbeHitCount = count + 1;
5187|                return count;
5188|            }
5189|
5190|            return oldestIndex;
5191|        }
