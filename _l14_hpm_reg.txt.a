5205|        private Vector3 ResolveCollisionContactNormal(Vector3 point, Vector3 rawNormal)
5206|        {
5207|            Vector3 normal = NormalizeVectorRsqrt(rawNormal, Vector3.up);
5208|            Vector3 bodyCenter = _useFixedFrameSpatialCache ? _fixedFrameCapsuleCenterWS : ResolveBodyRuntimePosition();
5209|            Vector3 toBody = bodyCenter - point;
5210|            if (IsFiniteVector(toBody) && toBody.sqrMagnitude > 0.000001f)
5211|            {
5212|                float facing = normal.x * toBody.x + normal.y * toBody.y + normal.z * toBody.z;
5213|                if (facing < 0f)
5214|                    normal = -normal;
5215|            }
5216|
5217|            return normal;
5218|        }
