5193|        private Collider ResolveOtherCollisionCollider(in ContactPoint contact, Collider fallback)
5194|        {
5195|            Collider candidate = contact.otherCollider;
5196|            if (candidate == null || candidate == _capsuleCollider)
5197|                candidate = contact.thisCollider;
5198|            if (candidate == null || candidate == _capsuleCollider)
5199|                candidate = fallback;
5200|            if (candidate == _capsuleCollider)
5201|                return null;
5202|            return candidate;
5203|        }
