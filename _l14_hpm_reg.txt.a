5408|        /// <inheritdoc />
5409|        public void OnOriginShift(in OriginShiftEventData shiftData)
5410|        {
5411|            Vector3 shiftOffset = shiftData.ShiftOffset;
5412|            if (!IsFiniteVector(shiftOffset) || shiftOffset.sqrMagnitude <= 0.000001f)
5413|                return;
5414|
5415|            InvalidateMovementProbeCaches();
5416|            _ladderSplineSnapActive = false;
5417|            _ladderSplineSnapAxisWorld = Vector3.zero;
5418|            _aupSpeculativeHoverTicks = SpeculativeHoverFixedTicksAfterAupShift;
5419|            IPhysicsStateEventService physicsStateEvents = _physicsStateEvents;
5420|            _aupSpeculativeHoverHeightMeters = physicsStateEvents != null
5421|                ? physicsStateEvents.ResolveSpeculativeHoverHeightMeters(
5422|                    SpeculativeHoverBaseHeightMeters,
5423|                    _currentTimer)
5424|                : SpeculativeHoverBaseHeightMeters;
5425|
5426|            _lastTransportPlatformPosition -= shiftOffset;
5427|            _currentTransportPlatformPosition -= shiftOffset;
5428|            _cuttingTensionAnchorRequestedWS -= shiftOffset;
5429|            _cuttingTensionAnchorCurrentWS -= shiftOffset;
5430|            _exosuitGrappleAnchorRequestedWS -= shiftOffset;
5431|            _exosuitGrappleAnchorCurrentWS -= shiftOffset;
5432|            _surfaceLockTargetY -= shiftOffset.y;
5433|            _fallbackWaterSurfaceY -= shiftOffset.y;
5434|            _dynamicWaterSurfaceY -= shiftOffset.y;
5435|            float3 shiftOffset3 = new float3(shiftOffset.x, shiftOffset.y, shiftOffset.z);
5436|            _playerKinematicsNativeState.ApplyOriginShift(_dataVault, shiftOffset3);
5437|
5438|            if (_abyssalThermalFlowSample.IsCableZone != 0)
5439|                _abyssalThermalFlowSample.CableAnchorWS -= shiftOffset;
5440|
5441|            if (_useFixedFrameSpatialCache)
5442|            {
5443|                _fixedFrameBodyPosition -= shiftOffset;
5444|                _fixedFrameCapsuleCenterWS -= shiftOffset;
5445|                _fixedFrameBodyBottomY -= shiftOffset.y;
5446|                _fixedFrameBodyTopY -= shiftOffset.y;
5447|                _fixedFrameBodyEyeY -= shiftOffset.y;
5448|                _groundCheckOrigin -= shiftOffset;
5449|            }
5450|
5451|            if (_renderInterpolationStateInitialized)
5452|            {
5453|                _previousRenderInterpolationState.BodyPosition -= shiftOffset;
5454|                _currentRenderInterpolationState.BodyPosition -= shiftOffset;
5455|            }
5456|
5457|            if (_cinematicFocusActive)
5458|            {
5459|                _cinematicFocusLastDistanceSq = 0f;
5460|                GlobalTelemetryBus.PublishPerformanceWarning(_cinematicFocusTelemetryHash, _cinematicFocusHash, shiftData.Sequence);
5461|            }
5462|
5463|            _sargassumMovementInfluence?.ApplyOriginShiftOffset(shiftOffset);
5464|        }
