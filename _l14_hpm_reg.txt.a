5067|        private void OnCollisionExit(Collision collision)
5068|        {
5069|            if (collision == null)
5070|                return;
5071|
5072|            Collider collider = collision.collider;
5073|            if (collider == null)
5074|                return;
5075|
5076|            int colliderId = unchecked((int)EntityId.ToULong(collider.GetEntityId()));
5077|            if (colliderId == 0)
5078|                return;
5079|
5080|            for (int i = _legacyCollisionProbeHitCount - 1; i >= 0; i--)
5081|            {
5082|                if (GetHitColliderInstanceId(in _legacyCollisionProbeHitBuffer[i]) != colliderId)
5083|                    continue;
5084|
5085|                int last = _legacyCollisionProbeHitCount - 1;
5086|                _legacyCollisionProbeHitBuffer[i] = _legacyCollisionProbeHitBuffer[last];
5087|                _legacyCollisionProbeFrameBuffer[i] = _legacyCollisionProbeFrameBuffer[last];
5088|                _legacyCollisionProbeHitBuffer[last] = default;
5089|                _legacyCollisionProbeFrameBuffer[last] = -1;
5090|                _legacyCollisionProbeHitCount = last;
5091|            }
5092|        }
