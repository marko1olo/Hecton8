1|using Hecton8.Core;
2|using Unity.Mathematics;
3|using UnityEngine;
4|
5|namespace Hecton8.Gameplay
6|{
7|    /// <summary>
8|    /// Zero-allocation reader for frame-cached player input snapshots.
9|    /// </summary>
10|    [System.Runtime.InteropServices.StructLayout(System.Runtime.InteropServices.LayoutKind.Sequential)]
11|    internal struct HectonPlayerInputHandler
12|    {
13|        public bool TryReadFrame(
14|            IInputService inputService,
15|            float jumpBufferSeconds,
16|            out HectonPlayerInputFrame frame,
17|            out bool jumpBuffered)
18|        {
19|            return TryReadFrame(
20|                inputService,
21|                jumpBufferSeconds,
22|                consumeBufferedJump: true,
23|                out frame,
24|                out jumpBuffered);
25|        }
26|
27|        public bool TryReadFrame(
28|            IInputService inputService,
29|            float jumpBufferSeconds,
30|            bool consumeBufferedJump,
31|            out HectonPlayerInputFrame frame,
32|            out bool jumpBuffered)
33|        {
34|            frame = default;
35|            jumpBuffered = false;
36|
37|            if (inputService == null || !inputService.IsPlayerInputEnabled)
38|                return false;
39|
40|            PlayerInputState state = inputService.GetState();
41|            Vector2 moveInput = state.MoveDelta;
42|            Vector2 lookInput = state.LookDelta;
43|            float verticalInput = state.VerticalDelta;
44|            if (!IsFinite(moveInput) || !IsFinite(lookInput) || !math.isfinite(verticalInput))
45|                return false;
46|
47|            frame = new HectonPlayerInputFrame(
48|                state,
49|                ClampUnitInput(moveInput),
50|                lookInput,
51|                math.clamp(verticalInput, -1f, 1f),
52|                state.HasAction(PlayerInputAction.Sprint));
53|            jumpBuffered = consumeBufferedJump && inputService.TryConsumeBufferedAction(PlayerBufferedAction.Jump, jumpBufferSeconds);
54|            return true;
55|        }
56|
57|        public static float ResolveVerticalInput(in PlayerInputState state)
58|        {
59|            return math.clamp(state.VerticalDelta, -1f, 1f);
60|        }
61|
62|        private static bool IsFinite(Vector2 value)
63|        {
64|            return math.isfinite(value.x) && math.isfinite(value.y);
65|        }
66|
67|        private static Vector2 ClampUnitInput(Vector2 value)
68|        {
69|            float lengthSq = (value.x * value.x) + (value.y * value.y);
70|            if (lengthSq <= 1f)
71|                return value;
72|
73|            float inverseLength = math.rsqrt(lengthSq);
74|            return new Vector2(value.x * inverseLength, value.y * inverseLength);
75|        }
76|    }
77|
78|    /// <summary>
79|    /// Value snapshot consumed by the locomotion orchestrator after input service reads.
80|    /// </summary>
81|    [System.Runtime.InteropServices.StructLayout(System.Runtime.InteropServices.LayoutKind.Sequential)]
82|    internal readonly struct HectonPlayerInputFrame
83|    {
84|        public HectonPlayerInputFrame(
85|            PlayerInputState state,
86|            Vector2 moveInput,
87|            Vector2 lookInput,
88|            float verticalInput,
89|            bool sprintHeld)
90|        {
91|            State = state;
92|            MoveInput = moveInput;
93|            LookInput = lookInput;
94|            VerticalInput = verticalInput;
95|            SprintHeld = sprintHeld ? (byte)1 : (byte)0;
96|        }
97|
98|        public readonly PlayerInputState State;
99|        public readonly Vector2 MoveInput;
100|        public readonly Vector2 LookInput;
101|        public readonly float VerticalInput;
102|        public readonly byte SprintHeld;
103|    }
104|}