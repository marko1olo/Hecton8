    <ItemGroup>
      <Compile Remove="@(Compile)" />
      <Compile Include="@(_HectonUniqueCompile)" />
      <_HectonUniqueCompile Remove="@(_HectonUniqueCompile)" />
    </ItemGroup>
  </Target>

