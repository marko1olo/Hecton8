<Project>
  <PropertyGroup>
    <HectonVendorGeneratedWarningProjects>|AmplifyImpostors.Runtime|AstarPathfindingProject|AstarPathfindingProjectEditor|BakeryEditorAssembly|Crest|Crest.Helpers.Editor|Den.Tools|GPUInstancer|GPUInstancer.Editor|Lofelt.NiceVibrations|MapMagic.Editor|MapMagic.Settings|MeshBakerCore|MeshBakerEditor|MoreMountains.Tools|MoreMountains.Tools.Editor|RealtimeCSG|Unity.RenderPipelines.Core.Editor|Unity.RenderPipelines.Universal.Editor|Unity.RenderPipelines.Universal.Runtime|Unity.ShaderGraph.Editor|</HectonVendorGeneratedWarningProjects>
  </PropertyGroup>

  <PropertyGroup Condition="$([System.String]::Copy('$(HectonVendorGeneratedWarningProjects)').Contains('|$(MSBuildProjectName)|'))">
    <NoWarn>$(NoWarn);0618;0649;2008;UNT0006</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Hecton8.Core' And '$(HectonBuildProjectReferences)' != 'true'">
    <DefineConstants>$(DefineConstants);HECTON_CORE_CONTRACTS_DLL_LEGACY</DefineConstants>
    <DefineConstants Condition="!$([System.String]::Copy('$(DefineConstants)').Contains('_MATH_LOD_LOW')) And ($([System.String]::Copy('$(DefineConstants)').Contains('UNITY_ANDROID')) Or $([System.String]::Copy('$(DefineConstants)').Contains('HECTON_LOW_TIER')) Or $([System.String]::Copy('$(DefineConstants)').Contains('HECTON_MATH_LOD_LOW')) Or '$(HectonMathLodLow)' == 'true' Or '$(HectonBuildTier)' == 'Low')">$(DefineConstants);_MATH_LOD_LOW</DefineConstants>
    <NoWarn>$(NoWarn);0414;0436;0618;2002</NoWarn>
    <RunAnalyzers>false</RunAnalyzers>
    <UseSharedCompilation>false</UseSharedCompilation>
  </PropertyGroup>

  <ItemGroup Condition="'$(MSBuildProjectName)' == 'Hecton8.PlayModeTests' And !$([System.String]::Copy('@(ProjectReference)').Contains('Hecton8.Core.csproj'))">
    <ProjectReference Include="$(MSBuildThisFileDirectory)Hecton8.Core.csproj"
                      ReferenceOutputAssembly="true"
                      Private="False" />
  </ItemGroup>

  <Target Name="HectonEnsureGeneratedBuildDirectories" BeforeTargets="CoreCompile;GenerateBuildDependencyFile">
    <MakeDir Directories="$(OutputPath)"
             Condition="'$(OutputPath)' != '' And !Exists('$(OutputPath)')" />
    <MakeDir Directories="$(IntermediateOutputPath)"
             Condition="'$(IntermediateOutputPath)' != '' And !Exists('$(IntermediateOutputPath)')" />
  </Target>

