    <Reference Include="GPUInstancer" Condition="Exists('$(MSBuildThisFileDirectory)Library\ScriptAssemblies\GPUInstancer.dll') And !$([System.String]::Copy('@(Reference)').Contains('GPUInstancer'))">
      <HintPath>$(MSBuildThisFileDirectory)Library\ScriptAssemblies\GPUInstancer.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Hecton8.Bootstrap.Contracts" Condition="Exists('$(MSBuildThisFileDirectory)Library\ScriptAssemblies\Hecton8.Bootstrap.Contracts.dll') And !$([System.String]::Copy('@(Reference)').Contains('Hecton8.Bootstrap.Contracts'))">
      <HintPath>$(MSBuildThisFileDirectory)Library\ScriptAssemblies\Hecton8.Bootstrap.Contracts.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Hecton8.Input" Condition="Exists('$(MSBuildThisFileDirectory)Library\ScriptAssemblies\Hecton8.Input.dll') And !$([System.String]::Copy('@(Reference)').Contains('Hecton8.Input'))">
      <HintPath>$(MSBuildThisFileDirectory)Library\ScriptAssemblies\Hecton8.Input.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Unity.RenderPipelines.Universal.Runtime" Condition="Exists('$(MSBuildThisFileDirectory)Library\ScriptAssemblies\Unity.RenderPipelines.Universal.Runtime.dll') And !$([System.String]::Copy('@(Reference)').Contains('Unity.RenderPipelines.Universal.Runtime'))">
      <HintPath>$(MSBuildThisFileDirectory)Library\ScriptAssemblies\Unity.RenderPipelines.Universal.Runtime.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="WaveHarmonic.Crest" Condition="Exists('$(MSBuildThisFileDirectory)Library\ScriptAssemblies\WaveHarmonic.Crest.dll') And !$([System.String]::Copy('@(Reference)').Contains('WaveHarmonic.Crest'))">
      <HintPath>$(MSBuildThisFileDirectory)Library\ScriptAssemblies\WaveHarmonic.Crest.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="WaveHarmonic.Crest.Shared" Condition="Exists('$(MSBuildThisFileDirectory)Library\ScriptAssemblies\WaveHarmonic.Crest.Shared.dll') And !$([System.String]::Copy('@(Reference)').Contains('WaveHarmonic.Crest.Shared'))">
      <HintPath>$(MSBuildThisFileDirectory)Library\ScriptAssemblies\WaveHarmonic.Crest.Shared.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup Condition="'$(MSBuildProjectName)' == 'Hecton8.World.Contracts'">
    <Compile Remove="Assets\_Project\Scripts\World\Contracts\GroundRadarContracts.cs" />
    <Compile Remove="Assets\_Project\Scripts\World\Contracts\OutpostGenerationContracts.cs" />
    <Compile Remove="Assets\_Project\Scripts\World\Contracts\TerrainChunkGeneratedSignal.cs" />

    <Compile Include="Assets\_Project\Scripts\World\Contracts\GroundRadarContracts.cs" Condition="!$([System.String]::Copy('@(Compile)').Contains('Assets\_Project\Scripts\World\Contracts\GroundRadarContracts.cs'))" />
    <Compile Include="Assets\_Project\Scripts\World\Contracts\OutpostGenerationContracts.cs" Condition="!$([System.String]::Copy('@(Compile)').Contains('Assets\_Project\Scripts\World\Contracts\OutpostGenerationContracts.cs'))" />
    <Compile Include="Assets\_Project\Scripts\World\Contracts\TerrainChunkGeneratedSignal.cs" Condition="!$([System.String]::Copy('@(Compile)').Contains('Assets\_Project\Scripts\World\Contracts\TerrainChunkGeneratedSignal.cs'))" />
  </ItemGroup>

  <Target Name="HectonPruneMissingGeneratedPackageReferences" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <_HectonMissingGeneratedReference Include="@(Reference)"
                                        Condition="'%(Reference.Identity)' == 'Unity.Cecil.Awesome' And '%(Reference.HintPath)' != '' And !Exists('%(Reference.HintPath)')" />
      <_HectonMissingGeneratedReference Include="@(Reference)"
                                        Condition="'%(Reference.Identity)' == 'Unity.Entities' And '%(Reference.HintPath)' != '' And !Exists('%(Reference.HintPath)')" />
      <_HectonMissingGeneratedReference Include="@(Reference)"
                                        Condition="'%(Reference.HintPath)' != '' And !Exists('%(Reference.HintPath)') And ($([System.String]::Copy('%(Reference.HintPath)').Contains('Library\ScriptAssemblies')) Or $([System.String]::Copy('%(Reference.HintPath)').Contains('Library/ScriptAssemblies')) Or $([System.String]::Copy('%(Reference.HintPath)').Contains('Library\PackageCache')) Or $([System.String]::Copy('%(Reference.HintPath)').Contains('Library/PackageCache')))" />
      <_HectonMissingGeneratedReference Include="@(Reference)"
                                        Condition="'%(Reference.HintPath)' != '' And !Exists('%(Reference.HintPath)') And ($([System.String]::Copy('%(Reference.HintPath)').Contains('Temp\bin\Debug')) Or $([System.String]::Copy('%(Reference.HintPath)').Contains('Temp/bin/Debug')))" />
      <_HectonMissingGeneratedReference Include="@(Reference)"
                                        Condition="'$(MSBuildProjectName)' == 'Hecton8.Core' And '%(Reference.Identity)' == 'Hecton8.AI.Ecology.Migration'" />
      <_HectonMissingGeneratedReference Include="@(Reference)"
                                        Condition="'$(MSBuildProjectName)' == 'Hecton8.Core' And '%(Reference.Identity)' == 'Hecton8.Audio.Propagation'" />
      <_HectonMissingGeneratedReference Include="@(Reference)"
                                        Condition="'$(MSBuildProjectName)' == 'Hecton8.Core' And '%(Reference.Identity)' == 'Hecton8.Environment.Fluids.Contracts'" />
      <_HectonMissingGeneratedReference Include="@(Reference)"
                                        Condition="'$(MSBuildProjectName)' == 'Hecton8.Core' And '%(Reference.Identity)' == 'Hecton8.World.GPR'" />
      <Reference Remove="@(_HectonMissingGeneratedReference)" />
      <_HectonMissingGeneratedReference Remove="@(_HectonMissingGeneratedReference)" />

      <_HectonMissingGeneratedAnalyzer Include="@(Analyzer)"
                                       Condition="$([System.String]::Copy('%(Analyzer.Identity)').Contains('com.unity.entities@')) And !Exists('%(Analyzer.Identity)')" />
      <Analyzer Remove="@(_HectonMissingGeneratedAnalyzer)" />
      <_HectonMissingGeneratedAnalyzer Remove="@(_HectonMissingGeneratedAnalyzer)" />
    </ItemGroup>
  </Target>

  <Target Name="HectonCorePruneGeneratedProjectOutputs"
          BeforeTargets="ResolveProjectReferences;ResolveAssemblyReferences;CoreCompile"
          Condition="'$(MSBuildProjectName)' == 'Hecton8.Core' And '$(HectonBuildProjectReferences)' != 'true'">
    <ItemGroup>
      <ProjectReference Remove="@(ProjectReference)" />
      <ReferencePath Remove="@(ReferencePath)"
                     Condition="!Exists('%(ReferencePath.Identity)') And ($([System.String]::Copy('%(ReferencePath.Identity)').Contains('Temp\bin\Debug')) Or $([System.String]::Copy('%(ReferencePath.Identity)').Contains('Temp/bin/Debug')))" />
      <ReferenceDependencyPaths Remove="@(ReferenceDependencyPaths)"
                                Condition="!Exists('%(ReferenceDependencyPaths.Identity)') And ($([System.String]::Copy('%(ReferenceDependencyPaths.Identity)').Contains('Temp\bin\Debug')) Or $([System.String]::Copy('%(ReferenceDependencyPaths.Identity)').Contains('Temp/bin/Debug')))" />
    </ItemGroup>
  </Target>

  <Target Name="HectonCorePruneMissingReferencePaths"
          BeforeTargets="CoreCompile"
          Condition="'$(MSBuildProjectName)' == 'Hecton8.Core' And '$(HectonBuildProjectReferences)' != 'true'">
    <ItemGroup>
      <ReferencePath Remove="@(ReferencePath)"
                     Condition="!Exists('%(ReferencePath.Identity)') And ($([System.String]::Copy('%(ReferencePath.Identity)').Contains('Temp\bin\Debug')) Or $([System.String]::Copy('%(ReferencePath.Identity)').Contains('Temp/bin/Debug')))" />
      <ReferenceDependencyPaths Remove="@(ReferenceDependencyPaths)"
                                Condition="!Exists('%(ReferenceDependencyPaths.Identity)') And ($([System.String]::Copy('%(ReferenceDependencyPaths.Identity)').Contains('Temp\bin\Debug')) Or $([System.String]::Copy('%(ReferenceDependencyPaths.Identity)').Contains('Temp/bin/Debug')))" />
    </ItemGroup>
  </Target>
</Project>
