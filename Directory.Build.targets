  <ItemGroup Condition="'$(MSBuildProjectName)' == 'Hecton8.PlayModeTests' And !$([System.String]::Copy('@(ProjectReference)').Contains('Hecton8.Core.csproj'))">
    <ProjectReference Include="$(MSBuildThisFileDirectory)Hecton8.Core.csproj"
                      ReferenceOutputAssembly="true"
                      Private="False" />
  </ItemGroup>

  <Target Name="HectonEnsureGeneratedBuildDirectories" BeforeTargets="CoreCompile;GenerateBuildDependencyFile">
    <MakeDir Directories="$(OutputPath)"
             Condition="'$(OutputPath)' != '' And !Exists('$(OutputPath)')" />
    <MakeDir Directories="$(IntermediateOutputPath)"
             Condition="'$(IntermediateOutputPath)' != '' And !Exists('$(IntermediateOutputPath)')" />
  </Target>

  <Target Name="FixUnityCircularReferences"
          BeforeTargets="PrepareProjectReferences;ResolveProjectReferences"
          Condition="'$(HectonDisableUnityPackageReferenceShim)' != 'true'">
    <ItemGroup>
      <_HectonUnityPackageProjectReference Include="@(ProjectReference)"
                                           Condition="$([System.String]::Copy('$(HectonUnityPackageCliShimProjects)').Contains('|%(ProjectReference.Filename)|')) And Exists('$(MSBuildThisFileDirectory)Library/ScriptAssemblies/%(ProjectReference.Filename).dll')" />
      <Reference Include="%(_HectonUnityPackageProjectReference.Filename)"
                 Condition="'@(_HectonUnityPackageProjectReference)' != '' And !$([System.String]::Copy('@(Reference)').Contains('%(_HectonUnityPackageProjectReference.Filename)'))">
        <HintPath>$(MSBuildThisFileDirectory)Library/ScriptAssemblies/%(_HectonUnityPackageProjectReference.Filename).dll</HintPath>
        <Private>False</Private>
      </Reference>
      <ProjectReference Remove="@(_HectonUnityPackageProjectReference)" />
      <_HectonUnityPackageProjectReference Remove="@(_HectonUnityPackageProjectReference)" />
    </ItemGroup>
  </Target>

