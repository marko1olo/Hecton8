      <ReferenceDependencyPaths Remove="@(ReferenceDependencyPaths)"
                                Condition="$([System.String]::Copy('%(ReferenceDependencyPaths.Identity)').Contains('Burst.Compiler.IL.dll'))" />
    </ItemGroup>
  </Target>

