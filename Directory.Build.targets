<Project>
  <PropertyGroup>
    <HectonVendorGeneratedWarningProjects>|AmplifyImpostors.Editor|AmplifyImpostors.Runtime|AstarPathfindingProject|AstarPathfindingProjectEditor|BakeryEditorAssembly|BakeryRuntimeAssembly|Crest|Crest.Helpers.Editor|Den.Tools|Den.Tools.Editor|EasySave3|EasySave3Editor|GPUInstancer|GPUInstancer.Editor|JBooth.MicroSplat.Core|JBooth.MicroSplat.Core.Editor|Lofelt.NiceVibrations|Lofelt.NiceVibrations.Demo|Lofelt.NiceVibrations.Editor|MapMagic|MapMagic.Editor|MapMagic.MicroSplat|MapMagic.MicroSplat.Editor|MapMagic.Settings|MeshBakerCore|MeshBakerEditor|MoreMountains.Feedbacks|MoreMountains.Feedbacks.Editor|MoreMountains.Tools|MoreMountains.Tools.Editor|PackageToolsEditor|RealtimeCSG|ShapesRuntime|ShapesEditor|Tayx.Graphy|Tayx.Graphy.Editor|Unity.RenderPipelines.Core.Editor|Unity.RenderPipelines.Universal.Editor|Unity.RenderPipelines.Universal.Runtime|Unity.ShaderGraph.Editor|VolumetricLightBeam|VolumetricLightBeam.Editor|</HectonVendorGeneratedWarningProjects>
    <HectonUnityPackageCliShimProjects>|Unity.RenderPipelines.Core.Editor|Unity.RenderPipelines.Universal.Editor|Unity.RenderPipelines.Universal.Runtime|Unity.ShaderGraph.Editor|</HectonUnityPackageCliShimProjects>
    <HectonOdinCliReferenceProjects>|Assembly-CSharp|Assembly-CSharp-firstpass|Assembly-CSharp-Editor|Assembly-CSharp-Editor-firstpass|Hecton8.Core|Hecton8.Editor|</HectonOdinCliReferenceProjects>
    <HectonVendorEditorRuntimeProjects>|AstarPathfindingProject|EasySave3|GPUInstancer|JBooth.MicroSplat.Core|MoreMountains.Feedbacks|MoreMountains.Tools|ShapesRuntime|VolumetricLightBeam|</HectonVendorEditorRuntimeProjects>
    <HectonStrictWarningAudit Condition="'$(HectonStrictWarningAudit)' == ''">false</HectonStrictWarningAudit>
  </PropertyGroup>

  <PropertyGroup>
    <DefineConstants>$(DefineConstants);$(HectonUnityCliVersionDefines)</DefineConstants>
  </PropertyGroup>

  <!--
    Pin the CLI build to Unity's language level.

    Unity's generated .csproj files set <LangVersion>latest</LangVersion>, but Unity itself
    compiles this project at C# 9. That gap makes the lock-free CLI build unsound in both
    directions and it has already cost real time:
      * FALSE GREEN: `scoped in` compiled clean from the CLI and was a hard CS8773 error in
        Unity, breaking the build (reverted in 249b599f9).
      * PHANTOM WARNINGS: CS9091 is a C# 11 ref-safety diagnostic. Unpinned, the CLI reported
        12 warnings including 10 in World/ChemicalInfluenceGrid.cs that Unity never emits.
        An agent then "fixed" a diagnostic that does not exist on this compiler.

    Directory.Build.targets is imported AFTER the project file, so this overrides the
    generated LangVersion. Override per-invocation with -p:HectonCliLangVersion=<v> if a
    specific project genuinely needs a different level.

    Raise this when Unity's bundled Roslyn language level changes. Verify by compiling a
    known C#-11-only construct: if it succeeds here but fails in Unity, this pin is stale.
  -->
  <PropertyGroup>
    <HectonCliLangVersion Condition="'$(HectonCliLangVersion)' == ''">9</HectonCliLangVersion>
    <LangVersion>$(HectonCliLangVersion)</LangVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'BakeryRuntimeAssembly' Or '$(MSBuildProjectName)' == 'AmplifyImpostors.Runtime' Or '$(MSBuildProjectName)' == 'Den.Tools' Or $([System.String]::Copy('$(HectonVendorEditorRuntimeProjects)').Contains('|$(MSBuildProjectName)|'))">
    <DefineConstants>$(DefineConstants);UNITY_EDITOR;UNITY_EDITOR_WIN</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(HectonStrictWarningAudit)' != 'true' And $([System.String]::Copy('$(HectonVendorGeneratedWarningProjects)').Contains('|$(MSBuildProjectName)|'))">
    <NoWarn>$(NoWarn);0108;0169;0414;0436;0618;0619;0649;2008;UNT0006</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'JBooth.MicroSplat.Core' Or '$(MSBuildProjectName)' == 'JBooth.MicroSplat.Core.Editor'">
    <DefineConstants>$(DefineConstants);__MICROSPLAT__</DefineConstants>
  </PropertyGroup>

