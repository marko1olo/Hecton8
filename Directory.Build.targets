  <Target Name="HectonPruneMissingGeneratedPackageReferences" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <_HectonMissingGeneratedReference Include="@(Reference)"
                                        Condition="'%(Reference.Identity)' == 'Unity.Cecil.Awesome' And '%(Reference.HintPath)' != '' And !Exists('%(Reference.HintPath)')" />
      <_HectonMissingGeneratedReference Include="@(Reference)"
                                        Condition="'%(Reference.Identity)' == 'Unity.Entities' And '%(Reference.HintPath)' != '' And !Exists('%(Reference.HintPath)')" />
      <_HectonMissingGeneratedReference Include="@(Reference)"
                                        Condition="'%(Reference.HintPath)' != '' And !Exists('%(Reference.HintPath)') And ($([System.String]::Copy('%(Reference.HintPath)').Contains('Library\ScriptAssemblies')) Or $([System.String]::Copy('%(Reference.HintPath)').Contains('Library/ScriptAssemblies')) Or $([System.String]::Copy('%(Reference.HintPath)').Contains('Library\PackageCache')) Or $([System.String]::Copy('%(Reference.HintPath)').Contains('Library/PackageCache')))" />
      <_HectonMissingGeneratedReference Include="@(Reference)"
                                        Condition="'%(Reference.HintPath)' != '' And !Exists('%(Reference.HintPath)') And ($([System.String]::Copy('%(Reference.HintPath)').Contains('Temp\bin\Debug')) Or $([System.String]::Copy('%(Reference.HintPath)').Contains('Temp/bin/Debug')))" />
      <_HectonMissingGeneratedReference Include="@(Reference)"
                                        Condition="'$(MSBuildProjectName)' == 'Hecton8.Core' And '%(Reference.Identity)' == 'Hecton8.AI.Ecology.Migration'" />
      <_HectonMissingGeneratedReference Include="@(Reference)"
                                        Condition="'$(MSBuildProjectName)' == 'Hecton8.Core' And '%(Reference.Identity)' == 'Hecton8.Audio.Propagation'" />
      <_HectonMissingGeneratedReference Include="@(Reference)"
                                        Condition="'$(MSBuildProjectName)' == 'Hecton8.Core' And '%(Reference.Identity)' == 'Hecton8.Environment.Fluids.Contracts'" />
      <_HectonMissingGeneratedReference Include="@(Reference)"
                                        Condition="'$(MSBuildProjectName)' == 'Hecton8.Core' And '%(Reference.Identity)' == 'Hecton8.World.GPR'" />
      <Reference Remove="@(_HectonMissingGeneratedReference)" />
      <_HectonMissingGeneratedReference Remove="@(_HectonMissingGeneratedReference)" />

      <_HectonMissingGeneratedAnalyzer Include="@(Analyzer)"
                                       Condition="$([System.String]::Copy('%(Analyzer.Identity)').Contains('com.unity.entities@')) And !Exists('%(Analyzer.Identity)')" />
      <Analyzer Remove="@(_HectonMissingGeneratedAnalyzer)" />
      <_HectonMissingGeneratedAnalyzer Remove="@(_HectonMissingGeneratedAnalyzer)" />
    </ItemGroup>
  </Target>

  <Target Name="HectonPruneNativeCliReferences" BeforeTargets="ResolveAssemblyReferences;CoreCompile">
    <ItemGroup>
      <_HectonNativeCliReference Include="@(Reference)"
                                 Condition="($([System.String]::Copy('%(Reference.Identity);%(Reference.HintPath)').Contains('Assets\_Project\Plugins\Windows\'))) Or
                                            ($([System.String]::Copy('%(Reference.Identity);%(Reference.HintPath)').Contains('Assets\Candice AI for Games\Scripts\Libs\Candice Save System\Plugins\sqlite3.dll'))) Or
                                            ($([System.String]::Copy('%(Reference.Identity);%(Reference.HintPath)').Contains('Assets\Editor\x64\Bakery\'))) Or
                                            ($([System.String]::Copy('%(Reference.Identity);%(Reference.HintPath)').Contains('Assets\Feel\NiceVibrations\Plugins\Windows\'))) Or
                                            ($([System.String]::Copy('%(Reference.Identity);%(Reference.HintPath)').Contains('Assets\MantisLODEditor\Plugins\'))) Or
                                            ($([System.String]::Copy('%(Reference.Identity);%(Reference.HintPath)').Contains('Assets\MapMagic\Tools\Plugins\NativePlugins.dll'))) Or
                                            ($([System.String]::Copy('%(Reference.Identity);%(Reference.HintPath)').Contains('Assets\MapMagic\Tools\Plugins\x86\NativePlugins.dll'))) Or
                                            ($([System.String]::Copy('%(Reference.Identity);%(Reference.HintPath)').Contains('Assets\Plugins\x86_64\'))) Or
                                            ($([System.String]::Copy('%(Reference.Identity);%(Reference.HintPath)').Contains('Assets\Technie\PhysicsCreator\Plugins\VHACD\'))) Or
                                            ($([System.String]::Copy('%(Reference.Identity);%(Reference.HintPath)').Contains('Library\PackageCache\com.unity.burst@')) And $([System.String]::Copy('%(Reference.Identity);%(Reference.HintPath)').Contains('\.Runtime\'))) Or
                                            ($([System.String]::Copy('%(Reference.Identity);%(Reference.HintPath)').Contains('Library\PackageCache\com.unity.collab-proxy@')) And $([System.String]::Copy('%(Reference.Identity);%(Reference.HintPath)').Contains('\Lib\Editor\'))) Or
                                            ($([System.String]::Copy('%(Reference.Identity);%(Reference.HintPath)').Contains('Library\PackageCache\com.unity.visualscripting@')) And $([System.String]::Copy('%(Reference.Identity);%(Reference.HintPath)').Contains('\Dependencies\Assemblies\WIN'))) Or
                                            ($([System.String]::Copy('%(Reference.Identity);%(Reference.HintPath)').Contains('Library\PackageCache\com.unity.xr.')) And $([System.String]::Copy('%(Reference.Identity);%(Reference.HintPath)').Contains('\Plugins\'))) Or
                                            ($([System.String]::Copy('%(Reference.Identity);%(Reference.HintPath)').Contains('Library\PackageCache\com.unity.xr.openxr@')) And $([System.String]::Copy('%(Reference.Identity);%(Reference.HintPath)').Contains('\APILayers~\'))) Or
                                            ($([System.String]::Copy('%(Reference.Identity);%(Reference.HintPath)').Contains('Library\PackageCache\com.unity.xr.openxr@')) And $([System.String]::Copy('%(Reference.Identity);%(Reference.HintPath)').Contains('\RuntimeLoaders\')))" />
      <Reference Remove="@(_HectonNativeCliReference)" />
      <_HectonNativeCliReference Remove="@(_HectonNativeCliReference)" />
    </ItemGroup>
  </Target>

  <Target Name="HectonPruneRuntimeEditorScriptAssemblyReferences"
          BeforeTargets="ResolveAssemblyReferences;CoreCompile"
          Condition="!$([System.String]::Copy('$(MSBuildProjectName)').Contains('Editor'))">
