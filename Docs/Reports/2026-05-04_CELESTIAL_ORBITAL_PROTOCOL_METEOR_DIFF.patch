+            _currentTurbidity = Mathf.Clamp(result.Turbidity, 0.5f, 2f);
+            _currentBiomeFogDensityScale = Mathf.Clamp(result.Density, 0.5f, 2f);
+            biomeAbsorption = Mathf.Clamp01(result.Absorption);
