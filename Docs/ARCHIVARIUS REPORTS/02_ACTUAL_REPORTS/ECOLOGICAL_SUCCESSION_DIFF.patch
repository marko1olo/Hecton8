+                    float verticalDelta = delta.y;
+                    if (verticalDelta < CanopyVerticalMinMeters || verticalDelta > CanopyVerticalMaxMeters)
+                        continue;
+
+                    float radius = math.max(0.25f, CanopyShadowRadiusMeters * math.max(1f, math.abs(canopy.WidthScale)));
