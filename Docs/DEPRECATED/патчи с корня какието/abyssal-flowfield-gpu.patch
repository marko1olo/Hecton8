+RWByteAddressBuffer _AbyssalAggregateMask;
+
+int4 _AbyssalGridResolution;
+float4 _AbyssalFlowCenter;
+float4 _AbyssalFlowSpacing;
+float4 _AbyssalFlowWeatherCurrent;
+float4 _AbyssalFlowWeatherParams;
+int _AbyssalFlowHeatSourceCount;
+int _AbyssalFlowWeatherStateMask;
+
+static const uint WeatherStateThermoclineActive = 1u << 3;
+static const uint WeatherStateHaloclineActive = 1u << 4;
+static const uint WeatherStateBiolumeSurge = 1u << 5;
+static const float Epsilon = 0.0001;
+static const float ThermoclineHalfBandMeters = 8.0;
+static const float ThermoclineVerticalAttenuation = 0.1;
+static const float PressureWaveVelocityThreshold = 8.0;
+
+int3 ResolveGridCoord(uint nodeIndex)
+{
+    int resolutionX = max(_AbyssalGridResolution.x, 1);
+    int resolutionZ = max(_AbyssalGridResolution.z, 1);
+    int cellsPerLayer = resolutionX * resolutionZ;
+    int layer = (int)(nodeIndex / (uint)cellsPerLayer);
+    int rem = (int)(nodeIndex - (uint)(layer * cellsPerLayer));
+    int cellZ = rem / resolutionX;
+    int cellX = rem - (cellZ * resolutionX);
+    return int3(cellX, layer, cellZ);
+}
+
+uint ResolveFlatIndex(int3 coord)
+{
+    return (uint)((coord.y * _AbyssalGridResolution.x * _AbyssalGridResolution.z) +
+        (coord.z * _AbyssalGridResolution.x) +
+        coord.x);
+}
+
+float3 ResolveNodeWorldPosition(int3 coord)
+{
+    int3 halfExtent = int3(_AbyssalGridResolution.x / 2, _AbyssalGridResolution.y / 2, _AbyssalGridResolution.z / 2);
+    float3 offset = float3(
+        (coord.x - halfExtent.x) * _AbyssalFlowSpacing.x,
+        (coord.y - halfExtent.y) * _AbyssalFlowSpacing.y,
+        (coord.z - halfExtent.z) * _AbyssalFlowSpacing.x);
+    return _AbyssalFlowCenter.xyz + offset;
+}
+
+[numthreads(1, 1, 1)]
+void ResetAbyssalFlowAggregate(uint3 dispatchThreadId : SV_DispatchThreadID)
+{
+    _AbyssalAggregateMask.Store(0, 0u);
+}
