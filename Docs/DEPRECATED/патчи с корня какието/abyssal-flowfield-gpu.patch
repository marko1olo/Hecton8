+[numthreads(HECTON_THREADS_PER_GROUP, 1, 1)]
+void DetectBiolumeSurge(uint3 dispatchThreadId : SV_DispatchThreadID)
+{
+    uint nodeIndex = dispatchThreadId.x;
+    if (nodeIndex >= (uint)_AbyssalGridResolution.w)
+        return;
+
+    int3 coord = ResolveGridCoord(nodeIndex);
+    float3 centerVelocity = _AbyssalFlowFieldResult[nodeIndex].xyz;
+
+    [loop]
+    for (int dz = -1; dz <= 1; dz++)
+    {
+        [loop]
+        for (int dy = -1; dy <= 1; dy++)
+        {
+            [loop]
+            for (int dx = -1; dx <= 1; dx++)
+            {
+                if (dx == 0 && dy == 0 && dz == 0)
+                    continue;
+
+                int3 neighborCoord = coord + int3(dx, dy, dz);
+                if (neighborCoord.x < 0 || neighborCoord.y < 0 || neighborCoord.z < 0 ||
+                    neighborCoord.x >= _AbyssalGridResolution.x ||
+                    neighborCoord.y >= _AbyssalGridResolution.y ||
+                    neighborCoord.z >= _AbyssalGridResolution.z)
+                {
+                    continue;
+                }
+
+                uint neighborIndex = ResolveFlatIndex(neighborCoord);
+                float3 neighborVelocity = _AbyssalFlowFieldResult[neighborIndex].xyz;
+                if (length(neighborVelocity - centerVelocity) > PressureWaveVelocityThreshold)
+                {
+                    uint previousValue;
+                    _AbyssalAggregateMask.InterlockedOr(0, WeatherStateBiolumeSurge, previousValue);
+                    return;
+                }
+            }
+        }
+    }
+}
