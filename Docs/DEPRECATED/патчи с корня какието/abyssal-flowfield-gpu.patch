+        private int CaptureAbyssalHeatSources(float3 flowCenter)
+        {
+            if (!_gpuAbyssalHeatSourceUpload.IsCreated)
+                return 0;
+
+            for (int i = 0; i < MaxAbyssalHeatSourceCount; i++)
