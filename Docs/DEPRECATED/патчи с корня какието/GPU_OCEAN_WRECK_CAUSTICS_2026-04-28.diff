+                if (_ownsRuntimeMaterial && _runtimeMaterial != null)
+                {
+                    if (Application.isPlaying)
+                        Object.Destroy(_runtimeMaterial);
+                    else
+                        Object.DestroyImmediate(_runtimeMaterial);
+                }
