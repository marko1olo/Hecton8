+                _runtimeMaterial = null;
+                _ownsRuntimeMaterial = false;
+                _runtimeMaterialSource = null;
+                _runtimeShader = null;
+                _registeredMaterial = null;
+                _batchMaterialId = default;
+
+                if (_materialSource == null || runtimeShader == null)
