+                              record.IsDirty ||
+                              !record.Current.IsCreated ||
+                              !record.Next.IsCreated ||
+                              record.RuntimeStamp != runtimeStamp ||
+                              dimensionsChanged ||
+                              originChanged ||
+                              cellSizeChanged;
